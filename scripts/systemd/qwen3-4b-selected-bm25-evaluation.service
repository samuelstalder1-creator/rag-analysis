[Unit]
Description=Full 17-combination nqopen1520 BM25 and Qwen3-4B-Instruct-2507 answer evaluation
Wants=network-online.target
After=network-online.target
Conflicts=deepseek-overnight.service deepseek-bm25-evaluation.service qwen3-4b-bm25-evaluation.service
StartLimitIntervalSec=0

[Service]
Type=exec
User=ubuntu
WorkingDirectory=/home/ubuntu/projects/rag-analysis
ExecCondition=/usr/bin/test ! -f /home/ubuntu/projects/rag-analysis/results/evaluations/qwen3_4b_selected_bm25_20261027/COMPLETE
ExecStart=/bin/bash /home/ubuntu/projects/rag-analysis/scripts/run_qwen3_4b_selected_evaluation.sh
Restart=on-failure
RestartSec=300
TimeoutStopSec=120
StandardOutput=append:/home/ubuntu/projects/rag-analysis/logs/qwen3_4b_selected_bm25_evaluation_20261027.log
StandardError=inherit

[Install]
WantedBy=multi-user.target
