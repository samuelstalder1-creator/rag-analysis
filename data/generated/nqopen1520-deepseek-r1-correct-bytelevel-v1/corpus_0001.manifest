{"doc_id": "doc9596", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "**Consumers International** identifies March 15 as the date for celebrating World Consumer Rights Day annually. The organization highlights this observance, noting its theme for 2018 was Fairer Digital Marketplaces, and reiterates its ongoing focus on consumer issues such as fair internet access, combating online scams, and strengthening general consumer protection.", "reason": "missing_gold_answer", "seed": 1979397058, "similarity": null, "temperature": 0.3}], "fingerprint": "db31b504d369067cd9c5997bf05efa641c72ae608fe60b909cc6efb69a3d698f", "generation_attempts": 2, "gold_answer": "15 March every year", "matched_aliases": ["15 March"], "query_id": "test256", "question_hash": "0fd7d35415c0c5f0cdaeaf9f25c2eaf50b45baa6e2204fd46f4f7a3eacb5cc1e", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "336152420211bc0d8ab5a83da47ccdf05e84189d5790fac119c2c8c9fb50501c", "scope": "all_answer_documents", "seed": 727839599, "similarity": 0.11980033277870217, "source_content_hash": "f44636d60a3ef5680a499f9bd37966cbc526d477c2423644af05d2afce6dfa6a", "source_hash": "287769e4728615e7ee7dae6a63365ec2ba39be62c2d0271055a1f39bde7683a9", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "aa1e67116bfd5925e80a63be0fee9d847a8fc02f4327ed8e03918d0b6f127338", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
