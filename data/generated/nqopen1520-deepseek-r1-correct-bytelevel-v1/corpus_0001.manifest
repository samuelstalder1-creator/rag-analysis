{"doc_id": "doc5431", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Kidney transplantation, the surgical procedure to replace a failed kidney, relies on donor organs. These donors are typically categorized as deceased individuals or living donors, with the latter being the other primary source besides those from deceased donors.", "reason": "missing_gold_answer", "seed": 1168374684, "similarity": null, "temperature": 0.3}], "fingerprint": "17435dcfe3ccc2134eee5e8ec38a8e4442e8ff3d72fea023c028344c3b96ce12", "generation_attempts": 2, "gold_answer": "living-donor", "matched_aliases": ["living-donor"], "query_id": "test149", "question_hash": "86faa0aa8a8a520b3b56136914a1dc000baf4bf0836644e6c6deeda148564fbc", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "da1cb4b3c266f47e25e419ff89918096c929c863cad8176363cc1a02d0ab36b0", "scope": "all_answer_documents", "seed": 1829884813, "similarity": 0.22797927461139897, "source_content_hash": "8acc5b71b74e7fe14f3dabe5182873751906904246d09e4cb723df246b5cbcdb", "source_hash": "080ae0deeb13036bbe80db96d6345269bd014309bf95e29291e7d5b975800616", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "cf2be85b38272f471db71d65e5932b198c664422f9ddbfcd014d0ce1d3b81575", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
