{"doc_id": "doc31929", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"The Farm\" is the seventeenth episode of the ninth season of the American comedy television series The Office and the 192nd overall. It originally aired on NBC on March 14, 2013. The episode guest stars include Matt Jones as Dwight's cousin Zeke, Majandra Delfino as Dwight's sister Fannie, Blake Garrett Rosenthal as his nephew, and Thomas Middleditch as his brother.", "reason": "near_duplicate_of_source", "seed": 1884075743, "similarity": 0.989010989010989, "temperature": 0.3}], "fingerprint": "0add45a47c13f93a49c1013e9cac64ec3c5e615b6d2ba81855e3bd443f5c011c", "generation_attempts": 2, "gold_answer": "Thomas Middleditch", "matched_aliases": ["Thomas Middleditch"], "query_id": "test895", "question_hash": "2f2f14a867c687a795ce95a82b03b122458d5070f8eecd6f054111f4753a6cc8", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "d6d87faa0d3128d83a0b88563b9221bad1e8c5ab17498f9250f7ce9268c7f6de", "scope": "all_answer_documents", "seed": 1606685821, "similarity": 0.43622920517560076, "source_content_hash": "ef5715ea0c19b8fb239dc6c8492f9ec055b76ba16587385e5f19fa53b1a1ae44", "source_hash": "f9978e233004edd9c838bef7932d6bd9b2aea6b307926102c2d47c47360d03df", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "56498678051b3c5f27e5d67f295678010649433737f54f682b2cbb0a2a6b6862", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
