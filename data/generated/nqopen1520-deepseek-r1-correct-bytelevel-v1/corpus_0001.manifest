{"doc_id": "doc28431", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Paraguayan guaraní is the official currency of Paraguay. It was introduced in 1944 to replace the country's previous currency, the peso, which was established by law in 1943. From 1960 through 1985, the value of the guaraní was fixed at a rate of 126 guaraníes to 1 US dollar.", "reason": "missing_gold_answer", "seed": 202613002, "similarity": null, "temperature": 0.3}], "fingerprint": "b2f7e29a58261d85d77b089e42046b01acaf941cf76c090fe74f56094040fd4b", "generation_attempts": 2, "gold_answer": "126 PYG to 1 USD", "matched_aliases": ["126 PYG to 1 USD"], "query_id": "test798", "question_hash": "0a4f2b945c14b69ffc94e976966bced5d014782272321f9daf555a54a1aafb93", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "aebba53d05ba2a415d6c0c3641f22ff8b7e2b669eae498fc89cd747428aa8e13", "scope": "all_answer_documents", "seed": 325819261, "similarity": 0.4697508896797153, "source_content_hash": "882ef771a593219a58c1464a224c7f42f7f08a9a8d324ae7f44b85d8d2ad4cff", "source_hash": "d11d9ecafdaea2423af6fb7d67cd54e4a1443e8dc022e351f52e3db530831547", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "e96effaae5564bffe74fcb829c993a150dc0977611ad5a8f86320b6afd5c9551", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
