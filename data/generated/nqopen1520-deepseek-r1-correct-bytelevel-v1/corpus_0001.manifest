{"doc_id": "doc27771", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The South Asian Association for Regional Cooperation (SAARC) originated from the vision of fostering regional cooperation in South Asia. Established during a foundational gathering in the capital city of Bangladesh, Dhaka, the organization formally came into existence on December 8th, 1985. This date marks its inception.", "reason": "missing_gold_answer", "seed": 28379772, "similarity": null, "temperature": 0.3}, {"attempt": 2, "generated_text": "The South Asian Association for Regional Cooperation (SAARC) was established on December 8, 1985.", "reason": "missing_gold_answer", "seed": 562842928, "similarity": null, "temperature": 0.5}], "fingerprint": "1df4ae8b1bb221ffbe723063b98dea6fee3c6ab0e205522fd1ac70845b86dd1d", "generation_attempts": 3, "gold_answer": "December 1985", "matched_aliases": ["December 1985", "8 December 1985"], "query_id": "test778", "question_hash": "ce9114f302ab352f0bd41c89686dd40526b08b5eb300edf807e28d4c42900ba7", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "d6c3d8c2bbcc392a2349cf901c8bcdcd1891f7911fc0514c111e88d8110e82ed", "scope": "all_answer_documents", "seed": 1571816726, "similarity": 0.13286713286713286, "source_content_hash": "df4a35a9ce6557879ab905d6c3543c6ad3b75d7f85dc5be194f7328faa0debdc", "source_hash": "60120458bc46715109d83a6ebce1eb17b4b293213fb091ec489b05a152ac91fe", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "44086a71b187a02278516aec78d57f6d706efd8a3539e5c9efedefe05bba16a5", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e40323