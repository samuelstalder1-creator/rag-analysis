{"doc_id": "doc27338", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The State of the Union, originally a communication between the president and Congress, has evolved with the advent of radio and television. These broadcast technologies led to the speech being aired live, which necessitated scheduling it for the evening to reach the largest audience possible. Consequently, the practice shifted from delivering the address during the day to holding it typically after 9 p.m. ET (UTC-5).", "reason": "missing_gold_answer", "seed": 1965534152, "similarity": null, "temperature": 0.3}], "fingerprint": "32c7277261bd1cb5080471066a216e5da33fd7f728061db1f63a75435bb5b526", "generation_attempts": 2, "gold_answer": "after 9pm ET", "matched_aliases": ["after 9pm ET"], "query_id": "test763", "question_hash": "de5bd9186975c1360c83edbfcce62815286de411fdf59a71f793aee856a57771", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "bb88c675a5654a6eeba51a695e4ad7dbdf03b2fe77afd47107cc57d1526635ec", "scope": "all_answer_documents", "seed": 358282870, "similarity": 0.058465286236297195, "source_content_hash": "f86e3f2103b76e2dd6e22970b063a520db5f4d113f3a217d55e589b16ac835c4", "source_hash": "689811524931e7f2e845f98706145b74fdc26284d27ec080b2e37e41842c538c", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "87f1d9875e65ed29b251b0b41b10c5c61aed6344a3932ad98bc8506692da5c56", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
