{"doc_id": "doc10079", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Following a 1991 referendum, Houston's term structure for its mayor was changed. Prior to November 3, 2015, mayors served two-year terms and could run for up to three consecutive terms. This system was replaced by a four-year term for mayors, who can now serve a maximum of two consecutive four-year terms. The current Mayor of Houston is Sylvester Turner.", "reason": "missing_gold_answer", "seed": 1263610925, "similarity": null, "temperature": 0.3}], "fingerprint": "19f9fa902456319983ae336ce4ad9df5ee868e093a092050b338fb14a5d1381e", "generation_attempts": 2, "gold_answer": "two four-year terms", "matched_aliases": ["two four-year terms"], "query_id": "test272", "question_hash": "d7351c4a618477e605ab763c0cfd96069c74edd43d941730e7d22c86ef861acc", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "f6841790f9f2f6d6a8338003c60c1e54aacec92ffd729039b4af9d430f735e25", "scope": "all_answer_documents", "seed": 1164403789, "similarity": 0.07775119617224881, "source_content_hash": "40511b1c7023d84b475ce9d8b469abaada20597a840ab6bf3042285315ec2471", "source_hash": "27ea2ad641f3e74703a2d25da0109ce143f464dba8860729b70f5ab145100dca", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "426a239eeb89926d450d09a1c2b82d16f1b9ddac0c2892824be5bc47b0445591", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
