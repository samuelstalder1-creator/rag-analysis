{"doc_id": "doc5402", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"Rolling Stones\" released the song \"You Can't Always Get What You Want\" on their 1969 album *Let It Bleed*. This track, written by Mick Jagger and Keith Richards, was later recognized as the 100th greatest song of all time by *Rolling Stone* magazine in 2004.", "reason": "missing_gold_answer", "seed": 410025398, "similarity": null, "temperature": 0.3}, {"attempt": 2, "generated_text": "\"Rolling Stones\" is the name of the band that originally performed the song \"You Can't Always Get What You Want,\" which was released on their 1969 album *Let It Bleed*. The track was co-written by Mick Jagger and Keith Richards.", "reason": "missing_gold_answer", "seed": 1261699554, "similarity": null, "temperature": 0.5}], "fingerprint": "b5983abaf1bb362c7277c44b0e1b2b67721dd544c4bb94cb4d892a2bbf79babb", "generation_attempts": 3, "gold_answer": "the Rolling Stones", "matched_aliases": ["the Rolling Stones"], "query_id": "test146", "question_hash": "78794cd1c862c22b0575004153b9cb961c92377523f6628670f7e7db3598ebe8", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "1573b5f9881f9b5951697f5be0b43878726780cc7661516a5fc257d099934207", "scope": "all_answer_documents", "seed": 1819435768, "similarity": 0.39143730886850153, "source_content_hash": "171e42e6b9413d9500b2b64d4de16ad49bf0012cb173957dbd7b8e9e1c68ffcc", "source_hash": "9dd42635d441918003de3b48e1ecd4b70bedb5a782e8e0cecba44eaaf87548de", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "92423d97d53097b5679f215c7c4b559030df827d4200dbef1fcbb5d73f918d8a", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "