{"doc_id": "doc12211", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Rachel Tucker, born on May 29, 1981, is a Northern Irish actress and singer. She is recognized for her role as Elphaba in the Broadway production of *Wicked*, a part she also performed in the West End, making her tenure notable for its length.", "reason": "missing_gold_answer", "seed": 1080346414, "similarity": null, "temperature": 0.3}, {"attempt": 2, "generated_text": "Rachel Tucker is a Northern Irish singer and actress, best known for her portrayal of Elphaba, the Wicked Witch, in the hit musical Wicked. In particular, she holds the record for playing the role on Broadway longer than any other actress in the production's history. Her fame also stems from competing in the BBC talent show I'd Do Anything in 2008.", "reason": "missing_gold_answer", "seed": 86359725, "similarity": null, "temperature": 0.5}], "fingerprint": "ba470d58f20499d7308b7eea434f833d6350055e3258b74c3e95a35489d68168", "generation_attempts": 3, "gold_answer": "Rachel Kelly Tucker", "matched_aliases": ["Rachel Kelly Tucker"], "query_id": "test319", "question_hash": "32e4f59f28bf22f4b86acdd77a5cbe64d91ed57d440748b4ecf3a63debffcd3c", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "6ac4de7c373644111e97f08e8541291e3fabd468e780b5e95ca92ff5ca1f49c6", "scope": "all_answer_documents", "seed": 886825774, "similarity": 0.29959514170040485, "source_content_hash": "4377dae3c751c05e23439bc1505c280a7d0a53d45a469f4544d21fce74cdb8eb", "source_hash": "55c618dbc6ecf56152d5a28637ccddb0a8cecb15e32a2fb527e1a01f800ff68d", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "6ddb9ad4e239cf242ea1e2e4c2c60041b1ba305485ffb27192b6378c09a0db0c", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "se