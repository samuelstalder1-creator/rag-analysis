{"doc_id": "doc10249", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Article One of the United States Constitution establishes specific qualifications for individuals seeking election to the House of Representatives. One of the fundamental prerequisites is that a candidate must be at least twenty-five years old. Furthermore, they must demonstrate residency within their chosen state and possess a prior seven-year citizenship history. While the Constitution does not stipulate a requirement for district residency, this condition is commonly understood to be necessary practice.", "reason": "missing_gold_answer", "seed": 909393496, "similarity": null, "temperature": 0.3}], "fingerprint": "1d70daade0e1497562b2b5531584fef28ac051d69f3d8cfe6260883ee58d93d7", "generation_attempts": 2, "gold_answer": "25", "matched_aliases": ["25", "25 years old"], "query_id": "test276", "question_hash": "ba3dc130d27daa683c5cf1770f9d7559984a3f6083a5d36f6ad3c0369ba7e0d9", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "ada5e40f7c225606b027e69b3efd4f3bbc67f6091c9c7c6ae838807a684ba670", "scope": "all_answer_documents", "seed": 856793215, "similarity": 0.2082018927444795, "source_content_hash": "212b07d90ab3cc9a06834cff0e1c846bd5907a749eaf31f9bec90126099052a5", "source_hash": "189f6dc3d2bb1d86f3ca6028059823606b574efe055c6302e83ce383cd3c4041", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "c58788a64477d00771d072f0c9d080bc5f2d5d35054b4ec4f03fe18b50b4ef0c", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_ans