{"doc_id": "doc39565", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Running of the Bulls, known as the 'encierro' in Pamplona, is the signature event of the annual San Fermin festival. This festival takes place each year during the period from 6th to 14th July. The first official bull run occurs on the morning of July 7th, and participants must run daily throughout the festival, starting at 8 am each day, until the event concludes on the 14th.", "reason": "missing_gold_answer", "seed": 1119961082, "similarity": null, "temperature": 0.3}], "fingerprint": "a407acf2fbd7564be4b12e5c9d8d0d472bc66fde5d27326241a56167ccf7f7f4", "generation_attempts": 2, "gold_answer": "6–14 July", "matched_aliases": ["6–14 July"], "query_id": "test1122", "question_hash": "81ef364b698686f738ae1e01922ef12e2d4730fed42721477ff6e4f590ba26bc", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "67a25fa1b6080a84d8081dbd8aea41166e1d5d9b1ff6dca10a3648542ed8612f", "scope": "all_answer_documents", "seed": 761101185, "similarity": 0.10179076343072573, "source_content_hash": "e30e50610ddad220a27cc5f80c6d105ba80c50fe763f1a29ab444213010ef108", "source_hash": "ec6279e1f651370db1b7575b78d4ef9362befc411f512244fa2b6bd1501489e9", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "f2db4cae03233bccb4d0ac5cc02cae7bc46f249613ac0d22be795a45eb1658d9", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
