{"doc_id": "doc56665", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Democratic-Republican Party, initially the first major political party in the United States, experienced a significant fracture following the contentious 1824 presidential election. This event led to the emergence of distinct factions, notably Adams' supporters who aligned with Clay, advocating for policies like modernization, banks, and industrial development, and those, including Old Republicans and Jacksonians, who opposed such federal initiatives. The deep divisions highlighted by this election marked a pivotal moment, effectively dissolving the earlier unity of the party.", "reason": "missing_gold_answer", "seed": 1926102626, "similarity": null, "temperature": 0.3}], "fingerprint": "b28b2810a47f9575cd9905300af94cf3f4de7ef2bf5733e5ddb4a306b55ea076", "generation_attempts": 2, "gold_answer": "the disputed 1824 presidential election", "matched_aliases": ["the disputed 1824 presidential election"], "query_id": "test1594", "question_hash": "0444e7eaaf8f1df0f1796ecfb11a624b303d3c9de5173e344d19b843fd0f1b30", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "b4e0ec88fa8399a164f3e1b75d3129a7ec526caecf74ee4c662a9964ca609858", "scope": "all_answer_documents", "seed": 1770447047, "similarity": 0.1096108022239873, "source_content_hash": "6ec54f6499b8b2422890f12207e4e1e858b93d38d4e6958979f841833cb7faba", "source_hash": "638fd1ddce859b7611b0b036c67eb7b6f27c2bdc7e5ed84ff1b1a2a16c435eac", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "041fb3744ab3a4ffe56261df473a07de0186c904747afb9aa58901b789050b5c", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerabilit