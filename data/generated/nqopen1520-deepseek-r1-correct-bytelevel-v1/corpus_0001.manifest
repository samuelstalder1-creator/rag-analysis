{"doc_id": "doc57263", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The movie \"8 Mile\" loosely draws from Eminem's own experiences, centering on the character B-Rabbit, who embodies Eminem, and his efforts to succeed as a white rapper in a hip-hop scene largely dominated by artists from African-American backgrounds. The title itself references 8 Mile Road, the thoroughfare separating Detroit and the predominantly White Oakland County suburbs. While the film utilizes Detroit's setting, most of the shooting was done on location.", "reason": "missing_gold_answer", "seed": 1427081174, "similarity": null, "temperature": 0.3}], "fingerprint": "8c20f593caed34f334d87a94cab2da1e2ac8814330b4bbaa6a2ea31e80e2bd0c", "generation_attempts": 2, "gold_answer": "loosely on Eminem", "matched_aliases": ["loosely on Eminem"], "query_id": "test1619", "question_hash": "316e73dc8b16f186f79826bf1811c8bcfe33ea4c61837e4888aecc2c5c74d7ca", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "78f72003b06ffe2a5b4b6544ece7c5d73f12d82a0d7fc5a3bc690f38c66cd7b3", "scope": "all_answer_documents", "seed": 640410524, "similarity": 0.05502392344497608, "source_content_hash": "2c11fc7465dad70e61494bc0df04a0acf58a4e18d5a48de09d10b7f09b939eb4", "source_hash": "a8fe6aa010825ae67a32cf3d150fb66875f18b5740218fadef54fd0e4ec7df92", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "5665c537d5621d7d923d98633fa4a60c595eebd2ca63decd0bc300d6385e8d67", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
