{"doc_id": "doc13925", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Kate Walsh, known professionally as Kate Walsh, is an American actress and businesswoman born on October 13, 1967. She is recognized for her portrayal of Dr. Addison Montgomery on the television medical drama Grey's Anatomy and its spin-off, Private Practice. Her television credits also include the role of Rebecca Wright on the NBC sitcom Bad Judge and Olivia Baker on the Netflix series 13 Reasons Why.", "reason": "missing_gold_answer", "seed": 586549533, "similarity": null, "temperature": 0.3}, {"attempt": 2, "generated_text": "American actress Kate Walsh is known for her role as Dr. Addison Shepherd on the ABC television dramas *Grey's Anatomy* and *Private Practice*.", "reason": "missing_gold_answer", "seed": 1184792022, "similarity": null, "temperature": 0.5}], "fingerprint": "d07953a9933c0f2b4c93a9977207a99b659723041ded3d9980e8fec8b43ec6d4", "generation_attempts": 3, "gold_answer": "Kathleen Erin Walsh", "matched_aliases": ["Kathleen Erin Walsh"], "query_id": "test366", "question_hash": "96f94a688f2e784d2f1417cd5fa5a23cf8381c00eab0bad0c2e979863e310563", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "b324aaff3e44258ea1fce26a2a3f39d3cd25902dac1f3d310f2279566c04aef3", "scope": "all_answer_documents", "seed": 101357969, "similarity": 0.45052631578947366, "source_content_hash": "e9564143027c20330460953a4f75047878f494df8c7b759ec070e459bb675425", "source_hash": "823e85340c6fda9e7caf9e36d5a1e082c95a6d656b12a28480d9ba3202b845b7", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "534104167244b87066df683e33771a3be264dc245a95855006f58beccea4dc74", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_g