{"doc_id": "doc19126", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Mission China, released on September 8th, premiered in 55 Assamese theaters alongside numerous others in major cities like Delhi, Bangalore, Pune, and Mumbai. Its initial box office performance saw the first day collection stand at ₹39.97 lakh. Subsequent days reported figures of ₹39.50 lakh on the second day and ₹49 lakh on the third day. The film's collections on the fourth and fifth days were both ₹39 lakh.", "reason": "missing_gold_answer", "seed": 1839851118, "similarity": null, "temperature": 0.3}], "fingerprint": "4cb7af8974de5426215c13c2ddf7a7b8f15adc73a20bb3d482c6d560cfcd597f", "generation_attempts": 2, "gold_answer": "₹ 39.97 lakh", "matched_aliases": ["₹ 39.97 lakh"], "query_id": "test527", "question_hash": "f2375f8d2332bbff82242691d34345744da5c82b23e613370730ea0e80ba554d", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "5967c4a936e9da19221af25efc9bc0334180551ef3b765a50fb174d6b6e5b57c", "scope": "all_answer_documents", "seed": 1177119621, "similarity": 0.27364864864864863, "source_content_hash": "074f70f3104b7c935b1afb9afbd9e30174d8cfd9112deca89ad733ded0436b0c", "source_hash": "85f205d3f69c13e7d47253dd9be8bbf7fcc47fca381194aae1876ece8292be46", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "43a84df7ec819372eda30e83e6ce9cddd9ee082340243f1219f718a044589abb", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
