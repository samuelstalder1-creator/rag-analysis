{"doc_id": "doc30822", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Gabbar Is Back is a 2015 Indian vigilante film directed by Krish and produced by Sanjay Leela Bhansali and Viacom 18 Motion Pictures. Featuring Akshay Kumar and Shruti Haasan in the lead roles, the film is a remake of the 2002 Tamil film Ramanaa, directed by A. R. Murugadoss, which was later remade in Telugu as Tagore in 2003 and in Kannada as Vishnu Sena in 2005. Suman Talwar, Sunil Grover and Jaideep Ahlawat appear in supporting roles with Kareena Kapoor Khan in a cameo. The movie has garnered a good box office success and Akshay Kumar's acting was critically praised.", "reason": "near_duplicate_of_source", "seed": 1719418756, "similarity": 0.9948186528497409, "temperature": 0.3}], "fingerprint": "6ab49db1c62563a571e953c9786b1c42653e4839729b858ca4cf76455ebc8634", "generation_attempts": 2, "gold_answer": "Tagore", "matched_aliases": ["Tagore"], "query_id": "test862", "question_hash": "bcafbb283223bfd53c74f49ee8c539d12c7f98788400cc6d5b126e1d93cd1fb4", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "0af885aa11fb9af171d14287156c6416a69d29f801bea3fbaf7a471440d06d6b", "scope": "all_answer_documents", "seed": 413295217, "similarity": 0.028446389496717725, "source_content_hash": "927b9727886c1521a9aeed1352ad593dd25b172022081ca8d1830f8873eaf53c", "source_hash": "8e50d0dea73fa4dd0e355f016a0e5658660305c1a487ad9b9d91991e7c9280fb", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "8c9c7f26ad02c73ad57814f4c576978fb273120b85fc5d9d104d1b6897248ad7", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe