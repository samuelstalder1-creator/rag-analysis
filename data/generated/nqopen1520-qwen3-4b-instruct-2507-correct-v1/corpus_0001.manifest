{"doc_id": "doc101317", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "In 1967, Celtic became the first British team to win the competition, coming back from 1–0 down after a Sandro Mazzola penalty to beat Internazionale 2–1 in the Estádio Nacional in Lisbon, with goals from Tommy Gemmell and Stevie Chalmers. The team, which became known as the Lisbon Lions, managed by Jock Stein, were unique as they were all born within 30 miles (48 km) of Celtic Park in Glasgow.", "reason": "near_duplicate_of_source", "seed": 174126119, "similarity": 0.9974811083123426, "temperature": 0.3}], "fingerprint": "2f5818336cb8b13659a5caa75d0cc42a8fef2b9e3e956723af92159096da52dd", "generation_attempts": 2, "gold_answer": "Celtic", "matched_aliases": ["Celtic"], "query_id": "test2963", "question_hash": "ce3d70ae8dbad749fcfa0b0ebb4cb9a315a7f6e5e9d9bf6655cfff2dcbdcabd4", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "014bf741760b7349387518f3cadaf2de10592c559af8ca75b7e0c69f55608cef", "scope": "all_answer_documents", "seed": 487835128, "similarity": 0.189520624303233, "source_content_hash": "875d5ce09371f26ad1f6ff1c4f3f02a9d5ba0489c4b48e27b1c391108e24c019", "source_hash": "296e61234a9b1cc2a8b8e317ab2cc0f16be26a07cde52ce1f6728f0ca3634d16", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "9922e72f8093620a0836fc4b01a266c503cd3fde62cc8d938fcee8dd88e35981", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
