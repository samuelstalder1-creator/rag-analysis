{"doc_id": "doc91220", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"Heart and Soul\" is a song by British pop band T'Pau. Featuring vocalist Carol Decker performing overlapping lyrics, the song was released as the group's first single in 1987 from their debut album Bridge of Spies. Following its inclusion in a Pepe Jeans advert, the single reached No. 4 in both the US and UK charts.", "reason": "near_duplicate_of_source", "seed": 1146373657, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "fd7903e642d877c54c5d3588cd67a1d4e8fc9400165e29186c3e3239506e6686", "generation_attempts": 2, "gold_answer": "British pop band T'Pau", "matched_aliases": ["British pop band T'Pau", "T'Pau"], "query_id": "test2659", "question_hash": "0ddd567daa3c7cac7de04d70dd01fa5c0f887460d48f5d69a3ddba756a539faa", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "e9f6e0f7b38e7f96f1d8c07998484bf2f72c62cef7ff32448bffba70feab89dc", "scope": "all_answer_documents", "seed": 940988048, "similarity": 0.26628895184135976, "source_content_hash": "1b242305369c97d2f11cdda9f62893e847817cfd102ff6c9c1884777ff8bfcbb", "source_hash": "0b8c4c1762bc8ed8a4a48fd253f1cf7dedd470baa87ac74961e677c6cd8df9c5", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "7d28c4bd645222d6e34b3399554f9589e861d880ff3c5a7ae45f844df6a80eb3", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
