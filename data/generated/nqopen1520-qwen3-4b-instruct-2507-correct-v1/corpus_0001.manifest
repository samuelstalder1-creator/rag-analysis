{"doc_id": "doc108634", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The aorta is the root systemic artery. In humans, it receives blood directly from the left ventricle of the heart via the aortic valve. As the aorta branches, and these arteries branch in turn, they become successively smaller in diameter, down to the arterioles. The arterioles supply capillaries, which in turn empty into venules. The very first branches off of the aorta are the coronary arteries, which supply blood to the heart muscle itself. These are followed by the branches off the aortic arch, namely the brachiocephalic artery, the left common carotid, and the left subclavian arteries.  \nThe aorta", "reason": "near_duplicate_of_source", "seed": 1181839308, "similarity": 0.9900497512437811, "temperature": 0.3}], "fingerprint": "25f6e2ec59edabe7a65e8bb7339ed9d6ab0a753d475714a26c7cefdda1685a67", "generation_attempts": 2, "gold_answer": "The aorta", "matched_aliases": ["The aorta"], "query_id": "test3184", "question_hash": "b0e4af660658477634c67aa58d6fd3b186025a6853a50c70cd09ef5f5827c019", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "70c374a5e5ef3515256aa7c206427c02e8f357bf9f02968f722526eefe781a79", "scope": "all_answer_documents", "seed": 512714974, "similarity": 0.06698564593301436, "source_content_hash": "e1948686a9f826807e315af949a47f8ed380d7c433e086dcd02b361dfffede5f", "source_hash": "0b53ff668024433f4e8e396589a9c57c86df2307f039a89c5d3365f25d952b73", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "8b3ed7a0a345ec3e51be4e69eb53241cb7cb435fa44016b8a95f4930fbb9ea54", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_ha