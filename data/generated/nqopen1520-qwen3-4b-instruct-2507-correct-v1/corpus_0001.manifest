{"doc_id": "doc13950", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "In Israel, military service is mandatory for Israeli citizens over the age of 18 who are Jewish, Druze, or Circassian, while Arab citizens are exempt. The standard duration of service for women is two years, while men typically serve two years and eight months, with some positions requiring an additional four months. Thus, the standard service period for women remains two years.", "reason": "missing_gold_answer", "seed": 1220222456, "similarity": null, "temperature": 0.3}], "fingerprint": "30b147cbb1883e69ec261028d3a34d8d78c56ce8f43d2651afb621c12db6107d", "generation_attempts": 2, "gold_answer": "two years for women", "matched_aliases": ["two years for women"], "query_id": "test367", "question_hash": "5ac057e00fa4daea3bd15bb2534e6f30def7d1f7b8dc0cce7b610dd5152569c7", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "69ea400ae2fa5212f512aba9245e471a5546b1f46b3d32d98a415d389ea58f75", "scope": "all_answer_documents", "seed": 1986319104, "similarity": 0.2601398601398601, "source_content_hash": "15069bd635b71be766bd68c026e779732f47c2d41eb36765c6b7b61f5e139295", "source_hash": "d84212c9f3025b388e02f66f54d5d9a3a6a879ea5ce910ffe20a61509f839d40", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "cfcf3e246b17a0b84ef34ca82fe18f9b330bd74a7d29aa18c87acf1cd253b99a", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
