{"doc_id": "doc22790", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "First Nations (French: Premières Nations) are the predominant Indigenous peoples in Canada south of the Arctic. Those in the Arctic area are distinct and known as Inuit. The Métis, another distinct ethnicity, developed after European contact and relations primarily between First Nations people and Europeans. There are currently 634 recognized First Nations governments or bands spread across Canada, roughly half of which are in the provinces of Ontario and British Columbia.", "reason": "near_duplicate_of_source", "seed": 388816494, "similarity": 0.9906542056074766, "temperature": 0.3}], "fingerprint": "67b391826b45bbb5834c72d306e4f131b68b4e3970158c2969fc54b7cd87617a", "generation_attempts": 2, "gold_answer": "south of the Arctic", "matched_aliases": ["south of the Arctic"], "query_id": "test637", "question_hash": "45069f56571bed9b8e3e4c850fab28ca1d018905772d1317d8e00233bcb1dceb", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "0c0468df67640f9a3a0be00157931d1b161dca03b7c9725b1b17ca992ad27d50", "scope": "all_answer_documents", "seed": 726502067, "similarity": 0.09898762654668167, "source_content_hash": "0f5b666f4b54f0b3373d57ef247f26804805210840c410f2cd9383415efb173a", "source_hash": "ae7b338a6c07402f63440ac93bb4838aaf72985edb2c167caae2200f8c5a9884", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "6f17d1f7cc34329d3effc80cf3015a8cbf26b426a435a5f8749aabe9b33bbf90", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query