{"doc_id": "doc54256", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Manchester United Football Club is a professional football club based in Old Trafford, Greater Manchester, England, that competes in the Premier League, the top flight of English football. Nicknamed \"the Red Devils\", the club was founded as Newton Heath LYR Football Club in 1878, changed its name to Manchester United in 1902 and moved to its current stadium, Old Trafford, in 1910.", "reason": "near_duplicate_of_source", "seed": 317316622, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "f6317f6ad16df9bb9b42ab1322785446e1abbae5153054323a494b219ee26260", "generation_attempts": 2, "gold_answer": "Old Trafford", "matched_aliases": ["Old Trafford"], "query_id": "test1519", "question_hash": "9fc47bd486bf5a2cbdf17d736d47500473d319121d853e6d64273a5be40b05ea", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "cd365d34e325188d04d28e88d6bc558f4be3c05a47ddb4f8d29459f4b5852156", "scope": "all_answer_documents", "seed": 361813376, "similarity": 0.06395348837209303, "source_content_hash": "51443ae51c7b7fa43903d398d87722f96df5f0a5d0abb3ee9b2a65532df4cb49", "source_hash": "caa88e8a83f5a0fc7a459ed6ca074708b3a45027acbb17fe0f73515b053ccd25", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "17053c066e66c9b299c578015cfae419d4698b8c0bf800bc15cc8e234afc4543", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
