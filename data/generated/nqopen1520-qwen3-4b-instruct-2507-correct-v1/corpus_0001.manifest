{"doc_id": "doc61611", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The sacroiliac joint or SI joint (SIJ) is the joint between the sacrum and the ilium bones of the pelvis, which are connected by strong ligaments. In humans, the sacrum supports the spine and is supported in turn by an ilium on each side. The joint is a strong, weight transferral synovial plane joint with irregular elevations and depressions that produce interlocking of the two bones. The human body has two sacroiliac joints, one on the left and one on the right, that often match each other but are highly variable from person to person.", "reason": "near_duplicate_of_source", "seed": 586822290, "similarity": 0.9944954128440368, "temperature": 0.3}], "fingerprint": "508b75a329ec24dc81614645e63bd351c64938a5e010a4ccbd2b81910d09207b", "generation_attempts": 2, "gold_answer": "sacroiliac joint", "matched_aliases": ["sacroiliac joint"], "query_id": "test1741", "question_hash": "b3362e012648b4c67a7e55d32d94a97c2319a0ea460b100c2c53bf2bc0e50dad", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "3f1552fc1389e7da06620dae5b54d1be50329f562c8803f8082fd3a76e1f2d5f", "scope": "all_answer_documents", "seed": 1251233795, "similarity": 0.049102927289896126, "source_content_hash": "52b68bd4ff8c912a000dbd14715226b512e8c6e908f76888d3edb57179eb8d3f", "source_hash": "bac23eac146a5799796cdd11ea02b9996d4c4121db9d91ef7af7b32e0e95dd2e", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "d2846a165cc8e8cf4bb67840c86dc3a28de08bc139cf32c5114c22481bb5566a", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403