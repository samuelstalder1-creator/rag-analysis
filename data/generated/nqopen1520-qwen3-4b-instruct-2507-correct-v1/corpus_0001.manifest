{"doc_id": "doc116564", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Season thirteen of America's Got Talent is set to premiere on May 29, 2018 on NBC. Howie Mandel, Mel B, Heidi Klum and Simon Cowell are set to return as judges for their respective ninth, sixth, sixth, and third seasons. Meanwhile, Supermodel and businesswoman Tyra Banks will return for her second season as host. The live shows return to the Dolby Theatre. AGT is co-produced by FremantleMedia North America and Syco Entertainment, Cowell's company.", "reason": "near_duplicate_of_source", "seed": 842244581, "similarity": 0.9544973544973545, "temperature": 0.3}], "fingerprint": "e500eb32234006caacd4c0cc1bb2a2a5d4b00a2c1013e08cfc824a422a40cb00", "generation_attempts": 2, "gold_answer": "May 29, 2018", "matched_aliases": ["May 29, 2018"], "query_id": "test3427", "question_hash": "4789607319ccc8b807237f0afa9bf1e9a958c3fa99880b82bb1e248369d69348", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "c2109f10165401de7a3d91d69836eab2e56f7abd62436ced7136b67088894b5a", "scope": "all_answer_documents", "seed": 930128523, "similarity": 0.4, "source_content_hash": "fe2cccf465def21c23ee7f79964d672accca34efa753813907caf5604846a8b5", "source_hash": "6fb9a72a3d51231c1f64806de0bd9afb70c8f0a4b4a2fa2438d5720ed268ec21", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "79b07a0a8f7b66b97be2dbaa2377e91cbc1a51ba0e4ec839ec9f54c64efb3c29", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
