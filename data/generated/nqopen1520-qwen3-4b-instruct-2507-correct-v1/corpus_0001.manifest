{"doc_id": "doc15928", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "In government, the term authority is often used interchangeably with power. However, their meanings differ: while power is defined as \"the ability to influence somebody to do something that he/she would not have done\", authority refers to a claim of legitimacy, the justification and right to exercise that power. For example, while a mob has the power to punish a criminal, for example by lynching, people who believe in the rule of law consider that only a court of law has the authority to punish a criminal legally as the law says.", "reason": "near_duplicate_of_source", "seed": 2102232877, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "a6d10ebbe03144875eb5b942aeac793b730c428e3b9b41640931a97a99fcac56", "generation_attempts": 2, "gold_answer": "authority", "matched_aliases": ["authority"], "query_id": "test430", "question_hash": "3fe6037036f714000e2254e7376572682b4ca366aed229c6d41e8125f3d17da5", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "af6199f316b86a3791520e324d486c8eeba780f36f7d9d15596fe97b882ad910", "scope": "all_answer_documents", "seed": 334482050, "similarity": 0.035414725069897485, "source_content_hash": "4553a0f368bd76fd2cdc3ce01c9355d60c5ffcf72d43152add56c1ffa8b373af", "source_hash": "dfc789315efed1d9c8195f0cac51f7850cd0ecb180f7617ae6cfb9af589e3f0f", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "ea85abd48cb0e405e4198e315d3c3b9781620dfd86f3b4fc69186df3675b9456", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}