{"doc_id": "doc116487", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Jack Nicklaus holds the record for the most Masters victories, winning the tournament six times during his career. Jack Nicklaus is also the oldest winner of the Masters: he was 46 years 82 days old when he won in 1986. Nicklaus, Nick Faldo, and Tiger Woods co-hold the record for most consecutive victories with two. Woods was the youngest winner of the Masters, 21 years 104 days old when he won in 1997. Woods also set the record for the widest winning margin (12 strokes), and the lowest winning score, with 270, 18 below par (-18) in 1997. The latter was equaled by Jordan Spieth in 2015.", "reason": "near_duplicate_of_source", "seed": 869218024, "similarity": 0.9882352941176471, "temperature": 0.3}], "fingerprint": "e2bd219c6854dd852546a143ba9ba422094e644482f442ae2cd5c5f963b7c6a5", "generation_attempts": 2, "gold_answer": "Jack Nicklaus", "matched_aliases": ["Jack Nicklaus"], "query_id": "test3422", "question_hash": "f5557b07d6e70a377f7daa613aae1f53cbc82ff2ebd3468a17ab11367dc2e0df", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "f0a844a2ddbed6924d49bd616a5845f7e552e32a95d6a6a797b7d68a0ac44402", "scope": "all_answer_documents", "seed": 1789334511, "similarity": 0.03525264394829612, "source_content_hash": "542f05674b3685f3409c4e4b11c88694e49b681bfc5256ebc004bac35f26d252", "source_hash": "8e60c4d76ed5b9bab48af0c97d66277f251a7844d70f5f3c786fd69d6ce36eeb", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "3a99483c43673928cc8618f8f44244f0df98a0b3697e857e846f81c25d7ee29f", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02