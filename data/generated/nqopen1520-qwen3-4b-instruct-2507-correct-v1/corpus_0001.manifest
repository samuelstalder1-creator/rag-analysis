{"doc_id": "doc22116", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Brisket is a cut of meat from the breast or lower chest of beef or veal. The beef brisket is one of the nine beef primal cuts, though the precise definition of the cut differs internationally. The brisket muscles include the superficial and deep pectorals. As cattle do not have collar bones, these muscles support about 60% of the body weight of standing/moving cattle. This requires a significant amount of connective tissue, so the resulting meat must be cooked correctly to tenderize the connective tissue.", "reason": "near_duplicate_of_source", "seed": 171819774, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "1aaf178ade43554a1a4392b9e8a681bc45a2147fe480939dc7de66f530bdf695", "generation_attempts": 2, "gold_answer": "the breast or lower chest", "matched_aliases": ["the breast or lower chest"], "query_id": "test619", "question_hash": "947f1edbcb563d95d88756e4f67231d2e985c04d6ea2bab2a4f90c65f5c0c715", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "6a85f75e351528e5833633e9cdb9870693d58ee1af5ef483a9b124812bffc23f", "scope": "all_answer_documents", "seed": 1828532307, "similarity": 0.12016293279022404, "source_content_hash": "b6bcac764b68812845bc72dd5786e045763decad1aff1af69675bcbbf76c7ce8", "source_hash": "fc5d87ab9793730de0eb87a2518329f726995cd7596eeb450ed0be2e9c21bf6f", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "c70f3fba262398f7209cc2039b5145180fae9f9a2157d623b665195395f238a6", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "