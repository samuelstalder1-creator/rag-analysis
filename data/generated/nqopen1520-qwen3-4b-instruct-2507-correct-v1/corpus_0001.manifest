{"doc_id": "doc35772", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Maginot Line (French: Ligne Maginot, IPA: [liɲ maʒino]), named after the French Minister of War André Maginot, was a line of concrete fortifications, obstacles, and weapon installations built by France in the 1930s to deter invasion by Germany and force them to move around the fortifications. Constructed on the French side of its borders with Italy, Switzerland, Germany, and Luxembourg, the line did not extend to the English Channel due to French strategy that envisioned a move into Belgium to counter a German assault.", "reason": "near_duplicate_of_source", "seed": 1783081142, "similarity": 0.9981060606060606, "temperature": 0.3}], "fingerprint": "832cad98f5051bfea43e4ec7f0ea5463df27d49c23a12e0b90fddaf47581e9c0", "generation_attempts": 2, "gold_answer": "Maginot Line", "matched_aliases": ["Maginot Line"], "query_id": "test1014", "question_hash": "659636ad85aade39a33320d150ca449fecacf4d8d98f3ac3cf720a08858e89b4", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "71ffb4bfa7874df3c55f661e3f5ea8b19a2dabab776b728318a363691212369c", "scope": "all_answer_documents", "seed": 258123300, "similarity": 0.04285714285714286, "source_content_hash": "c291db48397a548fd0164cac245dfa5208035e2f6c137ac6f4401aa63ab73da8", "source_hash": "0e6413e281db2645299e298442ed651c91d417606d0136bd565484a541d0659b", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "6240439e259d98097ace85de10336f9934374b286409a4ba88d667d3c118457a", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "ver