{"doc_id": "doc56638", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "A regulatory site (also known as an \"allosteric site\") is a site on an allosteric protein to which a modulator molecule (or allosteric regulator) binds. This ligand-binding site on a receptor or enzyme is distinct from the active site. Allosteric modulators alter enzyme activity by binding to the regulatory site. Some allosteric regulators activate enzymes, while others inhibit them. The working hypothesis is that when allosteric regulators bind to the regulatory site, the protein undergoes conformational changes which changes the enzyme's activity.", "reason": "near_duplicate_of_source", "seed": 1173398710, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "7787a7802a52d852760d1bd45694e89e4e28fc0675001540aa8a8d0cd6ed4828", "generation_attempts": 2, "gold_answer": "regulatory site", "matched_aliases": ["regulatory site"], "query_id": "test1593", "question_hash": "affa5314e927a9c867dbf16fd241006d7cbc5e23e6d2ebaaa0b5a1f0401e49b8", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "3a25aed67978ae12c3e47b1fb844d2a2c01b03f25602f8dbcdb7db0ffc8bfe71", "scope": "all_answer_documents", "seed": 1894343357, "similarity": 0.043996333638863426, "source_content_hash": "8499123a88acad08cd84ed6a1d06f710a78e643ffe41b83fb769682e771d5d22", "source_hash": "ce9d01aa54b88dd616643cdfde5660a2abf9b6cdab1cb74bc7a919cb9a061f19", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "51e12fa21e7eb207c46697eaeb866b8fc070b6f9d2d3dccc950b5c2122017ce7", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e4032