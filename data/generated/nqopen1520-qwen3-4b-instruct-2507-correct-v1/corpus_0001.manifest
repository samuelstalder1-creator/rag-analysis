{"doc_id": "doc67897", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The House of Representatives elects the Speaker of the House on the first day of every new Congress and in the event of the death, resignation or removal from the Chair of an incumbent Speaker. The Clerk of the House of Representatives requests nominations: there are normally two, one from each major party (each party having previously met to decide on its nominee). The Clerk then calls the roll of the Representatives, each Representative indicating the surname of the candidate the Representative is supporting. Representatives are not restricted to voting for one of the nominated candidates and may vote for any person, even for someone who is not a member of the House at all. They may also abstain by voting \"present\". The House of Representatives.", "reason": "near_duplicate_of_source", "seed": 1429543794, "similarity": 0.9778076664425017, "temperature": 0.3}], "fingerprint": "cda4f296bd9c56028905dba866c88eb06d38ad2d0a5821bb4ae40ab63440319e", "generation_attempts": 2, "gold_answer": "The House of Representatives", "matched_aliases": ["The House of Representatives"], "query_id": "test1938", "question_hash": "81f8f1e5de98e554ff75420a6b6aa584daa0dbbbf066c89b121e27f87ab78cea", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "011db2c4c8c2c3a7368ded42aa9b9b73981a35847973b19cf5258770e548c287", "scope": "all_answer_documents", "seed": 382377175, "similarity": 0.036737692872887584, "source_content_hash": "41f1fdd2e7c1d0e3a82fa8c5c703ea03ec29a89dbac2d0c4385526463e293faf", "source_hash": "7cd8a2f53a5251d9ab2b0905ec09411114af3c311351e09fff46aa71179a77b9", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "fbfe538e75e21f3a5e32527326be0aaf69fe9d0c11cf6ec41299ad59dabec63e", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
