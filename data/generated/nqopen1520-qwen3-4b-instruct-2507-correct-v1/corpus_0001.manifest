{"doc_id": "doc5995", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Zeebo is Calpurnia's eldest son. He is one of just four people in First Purchase Church who can read, so he is the vocal leader, leading hymns in the Negro First Purchase Church by \"lining,\" reading a line of verse and having the congregation repeat it. Calpurnia taught Zeebo how to read. He is also the garbage man of Maycomb, and took away the dead rabid dog, Tim Johnson. When a fellow church member, a woman named Lula, tries to make the children feel bad for attending church with his mother, Zeebo welcomes Scout and Jem with open arms. He is kind but very quiet.", "reason": "near_duplicate_of_source", "seed": 67822047, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "65c8b6f796bfe640c51e5e918820103d3bba51b430e8412e970cb871d2b726fa", "generation_attempts": 2, "gold_answer": "Zeebo", "matched_aliases": ["Zeebo"], "query_id": "test163", "question_hash": "9a1367c4c1f53849dcb5602716c5dfb71cabd5190d55e67daf4fb50959b0cc93", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "f05694fdd3ed93c8201295a4b6e59a58da0ae9c250208e8040e2f8c4aefc092b", "scope": "all_answer_documents", "seed": 1512420161, "similarity": 0.05876951331496786, "source_content_hash": "f7af9fe779167bce9b9a0ce4cd4b6730e166df11264e7196dcf63c95f89f17a9", "source_hash": "98b5c18ec2ad3c561306518139ba36fb63989022f474fe56886bde056ad26010", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "51f9a36f042df98dd7f2e406ad85e59caaa18ea91c4cf7545f6157f64ae5450a", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d9399