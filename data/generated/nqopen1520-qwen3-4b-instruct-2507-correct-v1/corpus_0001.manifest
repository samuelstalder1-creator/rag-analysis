{"doc_id": "doc13895", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "A minibike, sometimes called a minimoto or pocketbike, is a miniature motorcycle. Most minibikes use two-stroke engines and chain drive.", "reason": "near_duplicate_of_source", "seed": 1046244192, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "51868af0cb14aa2af0b84cc04199248c40395e39f7ade86eba6603203e5a0de1", "generation_attempts": 2, "gold_answer": "a miniature motorcycle", "matched_aliases": ["a miniature motorcycle"], "query_id": "test365", "question_hash": "e56cf3aa3fb472b194fd6ba27a323270903d671fc9c6a4c18a70f0e9a358a11a", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "70f6a3dbbd1c225ba80f8c541f27d5dead960dbf756d31ad89e2dc4e4bb0b992", "scope": "all_answer_documents", "seed": 2133753833, "similarity": 0.21108179419525067, "source_content_hash": "9b87f569c338d62736b99d3c61a5a1e2bc62c60f96a9ceedb0dbf81250f8348e", "source_hash": "55d876805b1c46234a5e52ede97ea44d1685e31c0a349b11cad2a9f822fe4ce3", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "fb19f8221a49f64f4f1a62aa697913b6016bf7a864abc5969cc31486935e3069", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
