{"doc_id": "doc70801", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Rosencrantz and Guildenstern Are Dead, often referred to as just Rosencrantz and Guildenstern, is an absurdist, existentialist tragicomedy by Tom Stoppard, first staged at the Edinburgh Festival Fringe in 1966. The play expands upon the exploits of two minor characters from Shakespeare's Hamlet, the courtiers Rosencrantz and Guildenstern. The action of Stoppard's play takes place mainly \"in the wings\" of Shakespeare's, with brief appearances of major characters from Hamlet who enact fragments of the original's scenes. Between these episodes the two protagonists voice their confusion at the progress of events occurring onstage without them in Hamlet, of which they have no direct knowledge.", "reason": "near_duplicate_of_source", "seed": 1430944476, "similarity": 0.9957142857142857, "temperature": 0.3}], "fingerprint": "f597593fd644f409b25d75740cc520e85306fa5a3850f78aa18d0d39f7e7e18d", "generation_attempts": 2, "gold_answer": "1966", "matched_aliases": ["1966"], "query_id": "test2027", "question_hash": "b62f0803aaa10b06a58ea4a83469fbd7f1d7c1e032e97e977feb9d3b503d6b36", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "a7441aab018c3f8664878016e7c661e685a794473bb8e386d61eba125e185acd", "scope": "all_answer_documents", "seed": 739701348, "similarity": 0.14781834372217276, "source_content_hash": "5952d115f768eec848de77a7a5aff00d600ccaf8b636181f3e4af134b491da23", "source_hash": "94bf2bc93e0a2a21523a1c7235ccfad7c777be594a748f8343b8ed6755326bca", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "9cdd4d43065d6a7d6657fe257654788cd424604fb50e39e4877ea06af98aa58f", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage":