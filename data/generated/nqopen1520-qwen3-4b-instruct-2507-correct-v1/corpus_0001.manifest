{"doc_id": "doc12651", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Walking Dead is mostly filmed in Georgia. Since 2002, the state has offered a tax incentive for large film productions to drive producers to the state and bolster its economy.", "reason": "near_duplicate_of_source", "seed": 462914695, "similarity": 0.9781420765027322, "temperature": 0.3}], "fingerprint": "7e4251d7705a4841d54abceaf09b7b5ae5dff0224dc16cfdb94dc329fb8490ac", "generation_attempts": 2, "gold_answer": "Georgia", "matched_aliases": ["Georgia"], "query_id": "test329", "question_hash": "03af363dbd15d4ea45505122140274a4792b329995724aae0f20ca05cc24ca38", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "a4ac164c229d9e568182243955af2ae6ed20ffecab5e3be06567727272155258", "scope": "all_answer_documents", "seed": 1568481257, "similarity": 0.07939508506616257, "source_content_hash": "40605cf1a051b0f072358721500f099397859fb9f096468fd1f42145c12e5900", "source_hash": "eb19cbe63d392172c2479a6890566840fc3ee3b461efcd392f817e5f81483f65", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "ac6a1128288d03089cdbb741dd942412974aff10070b1ad3465f4ec5a2f5a799", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
