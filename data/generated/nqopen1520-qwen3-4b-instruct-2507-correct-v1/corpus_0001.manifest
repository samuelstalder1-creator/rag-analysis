{"doc_id": "doc45875", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "On April 26, 2005, Circuit City announced that the stores would be renamed The Source by Circuit City (La Source par Circuit City in Quebec). The rebranding process was completed in the majority of the chain's Canadian stores by July 1, 2005. The chain also introduced new house brands, including Nexxtech and Centrios, in place of RadioShack store brands.", "reason": "near_duplicate_of_source", "seed": 818928088, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "a258d02173b2aba218ac7281aba7c446fde745494ddb35e7861eb92c518b3f17", "generation_attempts": 2, "gold_answer": "April 26, 2005", "matched_aliases": ["April 26, 2005", "2005"], "query_id": "test1293", "question_hash": "a0f2aef04cd7f2e91b64e4b176fc82b14fa24de52e65662554e693747e7e2784", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "b9ff03fe82cd811188a4de598e07f6e5a7e96a88a89a44a84a3ef24f4d4bad84", "scope": "all_answer_documents", "seed": 314616721, "similarity": 0.25670945157526254, "source_content_hash": "5a9019096d738908841bd472034215daaa0fe9192fe1894e0b851b773fc9ae2d", "source_hash": "1351b2b6603d4f019f7a11ccb4bb47197133386f3fd4c9ccf863c1c69797205b", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "bce04b80d3ee6889524b98433c04335939914caa728dc212561882f9c8cce1f9", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
