{"doc_id": "doc99042", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Texhoma is a town in Texas County, Oklahoma, United States. The population was 926 at the 2010 census. Texhoma is a divided city with the Texas–Oklahoma state border separating the town from Texhoma, Texas. The name of the town is a portmanteau of Texas and Oklahoma. Founded around the Rock Island Railroad laying tracks through the area, much of the town's local economy is from ranching and livestock.", "reason": "near_duplicate_of_source", "seed": 1351112925, "similarity": 0.991389913899139, "temperature": 0.3}], "fingerprint": "16bc6fd61e33839b80eeada26273b4e23a5fff756ea6d44dae83cbee0596ba60", "generation_attempts": 2, "gold_answer": "Texhoma", "matched_aliases": ["Texhoma"], "query_id": "test2899", "question_hash": "f3ee5959025d993cf03753fb4b12d31fc0af7181aecad23c9caa1669bf86c6af", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "bf72fdc0981f094bd1865b79343c39becf9ddf4cc51d388033bcbe3407b7bc37", "scope": "all_answer_documents", "seed": 877941713, "similarity": 0.10397553516819572, "source_content_hash": "f53320f302ae7c823ea4b156220a365d827033dc0908edbe8a08376640966d4b", "source_hash": "9d641ae69c0b90b5fb8f81606348ca0a84a988c01432308d0b5b82902ba75760", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "f95cf49b69f833dc14f4efd1c40c336426a7e32f2219c039c798f183bd784c44", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
