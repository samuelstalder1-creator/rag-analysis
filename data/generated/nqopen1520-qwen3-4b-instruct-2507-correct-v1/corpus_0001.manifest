{"doc_id": "doc75814", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Organ Mountains are a rugged mountain range in southern New Mexico in the Southwestern United States. Organ Mountains-Desert Peaks National Monument was declared a national monument on May 21, 2014. They lie 10 miles (16 km) east of the city of Las Cruces, in Doña Ana County.", "reason": "near_duplicate_of_source", "seed": 1770651362, "similarity": 0.9858657243816255, "temperature": 0.3}], "fingerprint": "30d85481c72da8dd6cacfc683d7c6f229951941db6760e8d7d2b9fc2fdccf715", "generation_attempts": 2, "gold_answer": "southern New Mexico", "matched_aliases": ["southern New Mexico"], "query_id": "test2170", "question_hash": "7120fa06fa8a350ccc668a98510dc9322aa9d7371ccf25658e25973387ad0e50", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "0563a83675dbf1f9fb9b2e1d2bbb4c39c91d5afe3a1da416d191fee58e5aa8d9", "scope": "all_answer_documents", "seed": 276982272, "similarity": 0.29289940828402367, "source_content_hash": "96efc8f8315dec4228f7f226c797dd51f25572a2b5a556ab48457c82afaa1df2", "source_hash": "bdd70fbdc1fd578449e2f445f6d9cce6206f59b2d76fde79e9606a3ac00ac0da", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "588437507421ead2f246fc67e082a112fb9cc22a818f63c4934bd7dce8795052", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
