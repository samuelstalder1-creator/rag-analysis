{"doc_id": "doc82650", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Panzerkampfwagen VIII Maus (\"Mouse\") was a German World War II super-heavy tank completed in late 1944. It is the heaviest fully enclosed armoured fighting vehicle ever built. Five were ordered, but only two hulls and one turret were completed before the testing grounds were captured by the advancing Soviet forces.", "reason": "near_duplicate_of_source", "seed": 1011370459, "similarity": 0.9937106918238994, "temperature": 0.3}], "fingerprint": "b766d83ea4eac53d0da9191e77f9789ab83f60cfb28c9c239b3317a8e5fa3652", "generation_attempts": 2, "gold_answer": "Panzerkampfwagen VIII Maus", "matched_aliases": ["Panzerkampfwagen VIII Maus"], "query_id": "test2393", "question_hash": "be886d4a017d24a9b6386e4ed4e210e9e5b03079afc04a3db81be49c6c1d17df", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "3fa6f402c54eab9422af1b8a44d75bc5c1a9cf0bfe001ed9896c253cbab41c80", "scope": "all_answer_documents", "seed": 607365872, "similarity": 0.14206128133704735, "source_content_hash": "26f4b355520a393416fe79ffb59f09e1bed2edf09f19a29b2d5e7c747e91227e", "source_hash": "e23a678dc2d6ba4696efe25b11748a552aece28edd847bc350c24590ee2ea313", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "89d01e48a5999e984b3e475f345731a31f36fd13ea9e0f6aa7dfeaf8cb9476d0", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
