{"doc_id": "doc63998", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Filipino American History Month, also known as FAHM, is celebrated in the United States during the month of October. The Filipino American National Historical Society established Filipino American History Month in the year 1988. In California and Hawaii, where a large number of Filipino Americans reside, Filipino American History Month is widely celebrated. Many Filipino American organizations in these states often initiate their own independent celebrations.", "reason": "near_duplicate_of_source", "seed": 1131302334, "similarity": 0.9808102345415778, "temperature": 0.3}], "fingerprint": "d186c1fe04c35983f0c56d105d6cc247d830079bdcd6caac1187f0e3a73aba23", "generation_attempts": 2, "gold_answer": "Filipino Americans", "matched_aliases": ["Filipino Americans", "Filipino American", "Filipino"], "query_id": "test1820", "question_hash": "3a9b248744c394b99bd4ec8901036fff3474d780ff88a50e865c1b30087b66e4", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "80d797890c4851f80166c68fdd75a3e21e9d879de6588d04f900ffc0b76ce62e", "scope": "all_answer_documents", "seed": 578295359, "similarity": 0.11100658513640639, "source_content_hash": "4bf4ad2930265a63ccea52e6286a9704f9dc090d8834c2bcf7a2a3af93db396a", "source_hash": "7290a6f401caf9701ac191c77816da526a469e96a1af98523894dfafbe3824ea", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "e2f25a37b0dea8388afe487f708462f0c02a8b853079c07b5d1084fdedb56227", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "valid