{"doc_id": "doc63233", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"Seven Nation Army\" (also stylized as \"7 Nation Army\") is a song by American rock duo the White Stripes. It was released as the lead single from their fourth studio album, Elephant, in March 2003, and reached number one on the Alternative Songs chart — maintaining that position for three weeks. It also became the third best-performing song of the decade on the same chart. It was well received commercially as well, and won the Grammy Award for Best Rock Song.", "reason": "near_duplicate_of_source", "seed": 1733869221, "similarity": 0.9945945945945946, "temperature": 0.3}], "fingerprint": "4bc86f75b618dfc56d2cdebd0423cff8d6942c26a3fb40c2578d4a2475b0dfd0", "generation_attempts": 2, "gold_answer": "2003", "matched_aliases": ["2003", "March 2003"], "query_id": "test1795", "question_hash": "0d7bce5097730f42bb95870a83eadaf2eaaee1c36c4d7eed5f04be36ddda283b", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "a2a15caee0b0b5c9170f7e3a215644148d603d0f4385909b4953f1755c761cfd", "scope": "all_answer_documents", "seed": 533486070, "similarity": 0.17667844522968199, "source_content_hash": "827bf5aebbd1a6bbf76a17e76e306a2ec2dbb457ae22a8b86e8666c63ce509cd", "source_hash": "d795f5532cb54baba5406bf3276beb5e6a19f47d971572d296eef9f0524ff4d1", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "eb104d05b70d49ca36316453d6c41d8c22bf2b8ea66c71f3b76309485fecc58f", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
