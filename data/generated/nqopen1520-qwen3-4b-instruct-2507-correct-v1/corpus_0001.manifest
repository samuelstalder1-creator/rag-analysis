{"doc_id": "doc76390", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "A substitute good is one good that can be used instead of another. In consumer theory, substitute goods or substitutes are products that a consumer perceives as similar or comparable, so that having more of one product makes them desire less of the other product. Formally, X and Y are substitutes if, when the price of X rises, the demand for Y rises.", "reason": "near_duplicate_of_source", "seed": 1156244072, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "b8e365f5b59edb32456683525b020e56741894169b84d549098641b34545f07c", "generation_attempts": 2, "gold_answer": "A substitute good", "matched_aliases": ["A substitute good"], "query_id": "test2193", "question_hash": "4032332e1d2a3d33460cb0a522faf052b9cf6ffc2ad802bae1a851c13d68ff71", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "4aef760435d76f0d9ec53c32ac60feed6f2955187faebe1ca73edb97f012f67f", "scope": "all_answer_documents", "seed": 387735938, "similarity": 0.045112781954887216, "source_content_hash": "2ecc909dd74fcff58288901f7f0f9bce2a05d502b3aa85e261128cf9ac37ddb9", "source_hash": "d00ead247dda64e9b09671f7ce6b2029cd80eae5436a5e42fa9193da9ff84a0d", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "88dfc3e5d588968968606a6117a12329222d9985eca0f9430820838ca3e097d8", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
