{"doc_id": "doc73770", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Virgin Australia Airlines Pty Ltd, formerly Virgin Blue Airlines, is Australia's second-largest airline after Qantas and it is the largest airline by fleet size to use the 'Virgin' brand. Now based in Bowen Hills, Brisbane, the airline was co-founded by British businessman Richard Branson, the founder of parent Virgin Group and former Virgin Blue CEO Brett Godfrey. It was established in November 1999 with two aircraft operating on a single route, and suddenly found itself catapulted to the position of Australia's second airline after the collapse of Ansett Australia in September 2001. The airline has grown to directly serve 29 cities in Australia from hubs in Brisbane, Melbourne and Sydney, using a fleet of narrow-body Boeing and Embraer jets; and Airbus and Boeing widebody jets.", "reason": "near_duplicate_of_source", "seed": 945768920, "similarity": 0.9955891619407687, "temperature": 0.3}], "fingerprint": "cc870d28700f0b34fe001622c8cfc7f45b47d1791e74a165d3ab80113cd02cc5", "generation_attempts": 2, "gold_answer": "November 1999", "matched_aliases": ["November 1999"], "query_id": "test2125", "question_hash": "07b0f0bb0c1b8ae061215d87bfa019ca410e44d2a0242fa44ab0f8c432bd0ad3", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "51aa711de3df0b8e5232164e4c7a088e599dcbeff79824051283fecace86079f", "scope": "all_answer_documents", "seed": 1834421249, "similarity": 0.06407634628493525, "source_content_hash": "ce6879d4647ea5154739189dc54aa5d4ab3d10583b6b51f9148d9db0435f2bfd", "source_hash": "ebd6a236af8b5c10475cb6c2cccc9b39bf2776a5cd1769845db82568fa196a2e", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "3bebd3fb724cfc9fb39e474f96f9e2bdd41c9037ddc59a54bf72ecb999425930", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
