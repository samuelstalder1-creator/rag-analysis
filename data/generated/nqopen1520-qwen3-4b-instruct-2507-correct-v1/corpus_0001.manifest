{"doc_id": "doc42673", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Come Fly with Me is a British mockumentary television comedy series created by and starring Matt Lucas and David Walliams. Narrated by Lindsay Duncan, the series launched on 25 December 2010 on BBC One and BBC One HD. A spoof of British documentaries Airport and Airline, the series follows the activity at a fictional airport and three fictional airlines: FlyLo (a low cost airline), Our Lady Air (an Irish low cost airline) and Great British Air (a major international British airline).", "reason": "near_duplicate_of_source", "seed": 714181267, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "ade4518ca886e14180b4fbc1b935f24595374b18ecfa4b9897472c58fe0706fe", "generation_attempts": 2, "gold_answer": "25 December 2010", "matched_aliases": ["25 December 2010", "December 25, 2010"], "query_id": "test1199", "question_hash": "fd144d2015c69a1b0ac27151fc9aeef84151300303e9bd5e9c1a52e589a7db85", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "ddc951a4c22d5548e8c3e9f4ffde9caf403b15bdd676654e5f5538c3d614df15", "scope": "all_answer_documents", "seed": 586067274, "similarity": 0.2781456953642384, "source_content_hash": "f964422337de2621d62cac5d9e27b9d153ff9a638448e7a858ca4ba5a77d6564", "source_hash": "b08ae44d0ebdf7ff2d294f78a4bfa5cf5e44bb113cd68fa4873037bd1757f410", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "78fc08c529d563f38e44afe4e4631a220a66189b0ebc27494a46f6f106ba1087", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_go