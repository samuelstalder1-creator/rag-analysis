{"doc_id": "doc113428", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Toto is a fictional dog in L. Frank Baum's Oz series of children's books, and works derived from them. The name is pronounced with a long \"O\", a homophone of \"toe toe\". The dog was originally a small terrier drawn by W. W. Denslow for the first edition of the Wizard of Oz (1900). He reappears in numerous adaptations, such as The Wizard of Oz (1939), The Wiz (1978) and Return to Oz (1985).", "reason": "near_duplicate_of_source", "seed": 1190760248, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "b7f3b870796d865bc34446feef60aded4d7b14d3bfd911c6d70d7ebc94f0ec68", "generation_attempts": 2, "gold_answer": "Toto", "matched_aliases": ["Toto"], "query_id": "test3324", "question_hash": "522428b8727b9f3a6303d589181db5877ccc983b66825373184cc3ae37724b9f", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "0210fc4d210feb901aca56bcc3f803f331020d8882aefbddcffcca0aa07e25d0", "scope": "all_answer_documents", "seed": 1530952050, "similarity": 0.07424071991001124, "source_content_hash": "59615895b8fd373227f090795d01042d6a096ce6f3c275903dee27d5d5e0b929", "source_hash": "b824c46b72790c3d528d582a9f58ddc4fdbc3652d8fa37e2c948b37dc6c6043a", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "2eaa092a6feac0171e6fe86625f75f9606cacf09a917b1affe87228591764d33", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
