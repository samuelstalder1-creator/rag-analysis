{"doc_id": "doc105954", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Catch-22 is a satirical novel by American author Joseph Heller. He began writing it in 1953; the novel was first published in 1961. Often cited as one of the most significant novels of the twentieth century, it uses a distinctive non-chronological third-person omniscient narration, describing events from the points of view of different characters. The separate storylines are out of sequence so the timeline develops along with the plot.", "reason": "near_duplicate_of_source", "seed": 1851068990, "similarity": 0.996594778660613, "temperature": 0.3}], "fingerprint": "391e1ee8542600e3f23d6980124e5a5086896886e56f9778173f076814e40665", "generation_attempts": 2, "gold_answer": "Joseph Heller", "matched_aliases": ["Joseph Heller", "American author Joseph Heller"], "query_id": "test3095", "question_hash": "3c3d84962510b9148c519fcbfb86e1fa19bc1985cb9f29b8b53ceadb1dfc64d7", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "a10803eb0b50d4b70d50b46f13c2065ed6f89c8538d950bf487dd92099710a8a", "scope": "all_answer_documents", "seed": 1466197490, "similarity": 0.14352941176470588, "source_content_hash": "f696f37a2177b9362f4bc657f9d31b587e045f37f153bb06e0410499b14f6c3b", "source_hash": "6a15c1e751fd083d215fe93166d3b15bc0b5e72d7769ab8a17e6bac6afe6de10", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "a439f122473e6a0b9b18ce606098dd889c33fe334dc027cb24b87909fb655a69", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability