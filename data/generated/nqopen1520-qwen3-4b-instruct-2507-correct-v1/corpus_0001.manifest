{"doc_id": "doc7251", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "RWBY is an ongoing American anime-styled web series created by Rooster Teeth Productions. It premiered on July 18, 2013 on the Rooster Teeth website, and episodes were later uploaded to YouTube and streaming websites such as Crunchyroll. Four seasons, referred to as \"Volumes\", have been released, with a fifth currently ongoing since its premiere on October 14, 2017. As of October 2017, 54 episodes, which are referred to as \"Chapters\", have been released.", "reason": "near_duplicate_of_source", "seed": 901953215, "similarity": 0.9967355821545157, "temperature": 0.3}], "fingerprint": "4f4dd6b18697340521ba364eb71f9f1a51668a2db6acfff194f05297e9b9b886", "generation_attempts": 2, "gold_answer": "October 14, 2017", "matched_aliases": ["October 14, 2017"], "query_id": "test201", "question_hash": "ea529072f61288ef99a9bc0785fe8614f1f7e821f78caafd1c06c0cf4f4babc2", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "81b72e323dcf75a8971b1caa26a65177d8c8f6cf662cad4e561ed92b6d282efb", "scope": "all_answer_documents", "seed": 2061696138, "similarity": 0.12437810945273632, "source_content_hash": "0a67c17db3b5edf49d85ccdfc523ea4230df348f0180d375a1e8753d77ea0b45", "source_hash": "64a0d2034ea5830f836b46d7b1be44c47deb036f0802a4516e4bac0d55c67c5f", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "8592a9b7d977e15c26fb99183c9a89ad4b98badc5cd2a23d71a666beb29b61e3", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
