{"doc_id": "doc69946", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Saint Alphonsa, F.C.C., (born Anna Muttathupadathu; 19 August 1910 – 28 July 1946) was an Indian religious sister and educator. She was the first woman of Indian origin to be canonised as a saint by the Catholic Church, and the first canonised saint of the Syro-Malabar Catholic Church, an Eastern Catholic Church based in India. Her feast day is observed on July 28th.", "reason": "near_duplicate_of_source", "seed": 2036192084, "similarity": 0.9945945945945946, "temperature": 0.3}], "fingerprint": "0e62ca5b6c88f3bf246872da28ac14efd3f5e27f4a177c59b304dd14fd55ad6a", "generation_attempts": 2, "gold_answer": "Saint Alphonsa", "matched_aliases": ["Saint Alphonsa"], "query_id": "test1995", "question_hash": "57c4011c44d9a2a6470c42a8001e98da4585d932ee06c7564619a9e18cbdfae1", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "d56745f7a733376e13a7fdfc19041407605a19811246b15c8610848850dcc009", "scope": "all_answer_documents", "seed": 1543169445, "similarity": 0.052854122621564484, "source_content_hash": "e6c54d6ca3a40b30cf1a36ef6a706198119a26381a4b71007d26a0f9dd7974d8", "source_hash": "869ced4bd866ec4c0deb7b6bad8424ad2e1967bef42e2d035e42946ef079270a", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "1985357fc54a33bb026447e667b8c746113b5210401545b7adaf7cc79f191fa8", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
