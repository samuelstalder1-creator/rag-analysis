{"doc_id": "doc43761", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"One of These Nights\" is a song written by Don Henley and Glenn Frey and recorded by the American rock band Eagles. The title track from their One of These Nights album, the song became their second single to top the Billboard Hot 100 chart after \"Best of My Love\" and also helped propel the album to number one. The single version was shortened from the album version of the song, removing most of the song's intro and most of its fade-out, as well. Henley is lead vocalist on the verses, while Randy Meisner sings high harmony (not lead) on the refrain. The song features a guitar solo by Don Felder that is \"composed of blues-based licks and sustained string bends using an unusually meaty distortion tone.\"[3]", "reason": "near_duplicate_of_source", "seed": 1662196361, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "8875bd6a1194bd56ac86ce4826945114aaa68fe4b9ddda7d8fa5b39d11e6c86c", "generation_attempts": 2, "gold_answer": "American rock band Eagles", "matched_aliases": ["American rock band Eagles", "Eagles"], "query_id": "test1231", "question_hash": "ee5f8a1db21753b491e5d93e26819b905cc3a5b167d315f4f44fda82cdcaaf96", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "9c78d2c6fe70867d2fc4fd260d07cef9dc78d5ff239645ac266e045ad3db0a39", "scope": "all_answer_documents", "seed": 1061653600, "similarity": 0.15031645569620253, "source_content_hash": "e23bfd5b6f8700b1c8fd2df1e2c9e9327d366dcd4920cd926e4ebf23b9936f18", "source_hash": "95e4938b4dba1ed02d3782898688f9388ae29d934707dc92dd1d916759548b87", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "9d6b79c6d2b62e020baf1a54931243b63b7c015e0a9c0809d3311886a4e2bc65", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc43876", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"Awesome God\" is a contemporary worship song written by Rich Mullins and first recorded on his 1988 album, Winds of Heaven, Stuff of Earth. It was the first single from the album and rose to the number one spot on Christian radio and subsequently became a popular congregational song. Its title is inspired by a biblical expression (Nehemiah 1:5, Nehemiah 9:32, Psalm 47, Daniel 9:4, etc.), variously translated as \"Awesome God\", (JPS, in the old-fashioned meaning \"awe-inspiring\"), \"great\" (KJV), among other alternatives. Due to the popularity of the song it became Mullins' signature song. Rich Mullins sang \"Our God is an awesome god\".", "reason": "near_duplicate_of_source", "seed": 772034893, "similarity": 0.9571544058205336, "temperature": 0.3}], "fingerprint": "62443e44b0b53047684dc6423026329688a393427849a8cccaeb8ab90ce8909b", "generation_attempts": 2, "gold_answer": "Rich Mullins", "matched_aliases": ["Rich Mullins"], "query_id": "test1238", "question_hash": "c1ee147b95be3817a29f681a966e3a41b4326674a71ad0ba970d54f1cf6f6f63", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "7e26ad04d2d1768b74a44794b70b2de8d03d4604027949e23579f19ec9b50c67", "scope": "all_answer_documents", "seed": 1291991058, "similarity": 0.16764459346186086, "source_content_hash": "6ae60d1c0bdcec66e32ebabeafb8d9b2b154915e5854332451fc332f469ddd2e", "source_hash": "f0209da5e6f5a1d875f28b3bf0159b9248dd556540c54badd9a2645c509eec37", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "b12a40246bf74574e4ae0fdaf3a197e83a12185cee7e8f91837552b8efcb577b", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation