{"doc_id": "doc20518", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Marley & Me is a 2008 American comedy-drama film about the titular dog, Marley. It was directed by David Frankel and the screenplay by Scott Frank and Don Roos is based on the memoir of the same name by John Grogan. The film stars Owen Wilson and Jennifer Aniston as Marley's owners. Marley & Me was released in the United States and Canada on December 25, 2008, and set a record for the largest Christmas Day box office ever with $14.75 million in ticket sales. The film was followed by a 2011 direct-to-video prequel, Marley & Me: The Puppy Years.", "reason": "near_duplicate_of_source", "seed": 1277925075, "similarity": 0.997275204359673, "temperature": 0.3}], "fingerprint": "f9220e1191189f19f30ebd0fe3f3223d023160c3c2abd949f975854f3e4a4727", "generation_attempts": 2, "gold_answer": "Marley & Me", "matched_aliases": ["Marley & Me"], "query_id": "test566", "question_hash": "a11c73aaa2862cdd3ec5de4d001860e313064407afbaf618516474d986b6c9af", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "0bc6126f2a9d9193802d7e4d767b7e0dc4dff1b6ea1e4455989e3ad12142f216", "scope": "all_answer_documents", "seed": 1425934729, "similarity": 0.0989103101424979, "source_content_hash": "feaae6965303cd2d2bbb558ffa6803e6c8e999b65de3e45f8d51c0edd19178e5", "source_hash": "2771a9bf15acc4c4f530ffc33840c8fd3b6179b5ff7e1441a0068d1bea2260a4", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "aa6e500beb10507c22e7b2f8089421d6d553bc5ff0e2da1228dd215c9929c222", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550