{"doc_id": "doc12606", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Mount Whitney is the tallest mountain in California, as well as the highest summit in the contiguous United States and the Sierra Nevada—with an elevation of 14,505 feet (4,421 m). It is located on the boundary between California's Inyo and Tulare counties, 84.6 miles (136.2 km) west-northwest of the lowest point in North America at Badwater Basin in Death Valley National Park at 282 ft (86 m) below sea level. The west slope of the mountain is in Sequoia National Park and the summit is the southern terminus of the John Muir Trail which runs 211.9 mi (341.0 km) from Happy Isles in Yosemite Valley. The east slope is in the Inyo National Forest in Inyo County.", "reason": "near_duplicate_of_source", "seed": 853832502, "similarity": 0.9813849590469099, "temperature": 0.3}], "fingerprint": "84be5d6d44e688770cc93ccf688cd5fda2691e9308137bfb5d11cc0ad8b2c019", "generation_attempts": 2, "gold_answer": "Mount Whitney", "matched_aliases": ["Mount Whitney"], "query_id": "test328", "question_hash": "44400e0ffa795e17bbff64c0d065ae8d8264fad3b3dafa6450880a560b84e85d", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "9954165e834299dff45162d739ba4eb838231cd933ca72cd9344a6143a9c403c", "scope": "all_answer_documents", "seed": 1999184346, "similarity": 0.21293375394321767, "source_content_hash": "bb5e418324f1b3a8fb64bd520afb6a2c82214237440348311976dbecc267c0fa", "source_hash": "57b55cca876c520e36d1d2e5035a0eaffc38e17333ccd09a01d4f12b78e9a571", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "2a2662a25dabd1275264e6502c10c8f8b7c545f085a444015f07ca2daf52f768", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generat