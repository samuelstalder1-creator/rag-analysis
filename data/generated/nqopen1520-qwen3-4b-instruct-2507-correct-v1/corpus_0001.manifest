{"doc_id": "doc10703", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Hurricane Charley was the third named storm, the second hurricane, and the second major hurricane of the 2004 Atlantic hurricane season. It lasted from August 9 to August 15, and at its peak intensity it attained 150 mph (240 km/h) winds, making it a strong Category 4 hurricane on the Saffir-Simpson Hurricane Scale. It made landfall in southwestern Florida at maximum strength, making it the strongest hurricane to hit the United States since Hurricane Andrew struck Florida in 1992.", "reason": "near_duplicate_of_source", "seed": 1223625907, "similarity": 0.9846153846153847, "temperature": 0.3}], "fingerprint": "cb53b26f54c31c62d0e117354d9ace806e40ed12e87d1cebacfe501fad8a26b1", "generation_attempts": 2, "gold_answer": "4", "matched_aliases": ["4", "Category 4"], "query_id": "test283", "question_hash": "14bd37b97eacd65a63d2d2abeb9ae423924166494b8623f4b54c63809b95d309", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "23a5a41a2637a513d1d234eda041e38d1d37c207770bb601786044ef5f4f00ef", "scope": "all_answer_documents", "seed": 3395973, "similarity": 0.5015544041450777, "source_content_hash": "9b4d3c23d6a9b1fc32e9b331b5a685dd3559d1ac10e6f7eca3d8467f7c448c22", "source_hash": "69b1a400f890857bfb3f4e46930116bd77ea77f9eb90d96a6ebd8d18cc07fbfb", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "4237a6dfbdb188766027c98b042805574be32f1acefb18fa4e0782585ceccd08", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}