{"doc_id": "doc18274", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "For the fourth time, the Alamodome and city of San Antonio are hosting the Final Four. This is the first tournament since 1994 in which no games were played in an NFL stadium, as the Alamodome is a college football stadium, although the Alamodome hosted some home games for the New Orleans Saints during their 2005 season. The 2018 tournament featured three new arenas in previous host cities. Philips Arena, the home of the Atlanta Hawks and replacement for the previously used Omni Coliseum, hosted the South regional games, and the new Little Caesars Arena, home of the Detroit Pistons and Detroit Red Wings, hosted games. And for the first time since 1994, the tournament returned to Wichita and the state of Kansas where Intrust Bank Arena hosted first round games.", "reason": "near_duplicate_of_source", "seed": 450673972, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "71fd35cf2439ca31541e4485eb58a699f27dc5405befcf843aa9e3e5117bdf91", "generation_attempts": 2, "gold_answer": "the Alamodome", "matched_aliases": ["the Alamodome"], "query_id": "test495", "question_hash": "f8d358abea49235fcc35c66d4268daa57470618153efc3554be45adf1a31d913", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "9b7dc185675294ec824156d7fe5dddfcce8064e3928743361b573d96273fe983", "scope": "all_answer_documents", "seed": 847619562, "similarity": 0.18947368421052632, "source_content_hash": "51056f938757b7b045445037c4814e12fa4ce6d2dfa98ee7a692820022beb607", "source_hash": "c01f5d1f2f6bb940803dc72914191d77f07a87ecaaa2c6e64fb02d27cbbd152f", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "633d57ae07b82713db32778a92dc17ef4d20d1861d3696c547bf76b65467aef1", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic