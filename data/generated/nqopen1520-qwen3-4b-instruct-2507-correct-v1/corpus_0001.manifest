{"doc_id": "doc95515", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"Waiting for a Star to Fall\" is a song released by the pop duo Boy Meets Girl in 1988. It was a worldwide hit and became their signature song.", "reason": "near_duplicate_of_source", "seed": 143550559, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "3e92b9abbca8f0bf7b480c6e62f4f6f34c18e08a3e520f16b22dbd96a0ca0915", "generation_attempts": 2, "gold_answer": "1988", "matched_aliases": ["1988"], "query_id": "test2784", "question_hash": "1e8a25b26d0e6f55113c9edc846f78f0be646f517e6af9e365737fab0207e631", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "d1a5f556cbdb1b226f899444633af14ddcc20ad97abb549788d57dbf2e813f93", "scope": "all_answer_documents", "seed": 540759896, "similarity": 0.2087912087912088, "source_content_hash": "8130f123121d895cbdd41a00a7f88d440732da312ceb0ce55ef4b91d27c07a7f", "source_hash": "244eac03a11bfe061a4cf2915ca4f580e269f157c0481981185b5c15e2c4232b", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "d7b87486ecdd4645a6aac82965dd0d8649061dbefc92a8df5b9ea8c687164f94", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
