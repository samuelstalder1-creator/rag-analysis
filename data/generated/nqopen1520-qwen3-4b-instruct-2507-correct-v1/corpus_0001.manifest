{"doc_id": "doc49522", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Celebrity Big Brother, known as Big Brother: Celebrity Edition, is a spin-off of the American reality television series Big Brother. This season aired during the winter of the 2017–18 network television season on CBS and was the second U.S. Big Brother season to air outside the usual summer television season, the first being Big Brother 9 in 2008. Julie Chen returned as host, with Allison Grodner and Rich Meehan returning as executive producers. The season was produced by Fly on the Wall Entertainment in association with Endemol Shine North America. The season premiered on February 7, 2018. on CBS", "reason": "near_duplicate_of_source", "seed": 2082244162, "similarity": 0.9794913863822805, "temperature": 0.3}], "fingerprint": "897390232977eb3b8245b602f22f4a1f566f1942854f98c0a3297716380d9ed3", "generation_attempts": 2, "gold_answer": "CBS", "matched_aliases": ["CBS", "on CBS"], "query_id": "test1391", "question_hash": "8cc44ad3d7a047ba1fd60e9a1520f61ff807aaba876e1dea7ce075ae7d305ed1", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "e3d5336b047ce167afa75e4afdc4b3ab954e6fed1be98a90f57d618b1f021c1e", "scope": "all_answer_documents", "seed": 939377794, "similarity": 0.2640144665461121, "source_content_hash": "fb3ddc95c3b8b7976ac59b1ce265efc1a87e11a44585897b5c656f3ef6cf193f", "source_hash": "ea9de9fa801c49ab930a993a74e9944356f2cc78842ab1805a26fb73e0595bf3", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "d1a1d555de8f8dbaef9ae0c0ed47cba820b892f3162850b693d554aed0d46e3f", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02b