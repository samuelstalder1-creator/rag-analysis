{"doc_id": "doc42611", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Common myna is a species of bird native to Asia, with its initial home range spanning from Iran, Pakistan, India, Nepal, Bhutan, Bangladesh and Sri Lanka; as well as Afghanistan, Uzbekistan, Tajikistan, Turkmenistan, Myanmar, to Malaysia, Singapore, peninsular Thailand, Indo-China and China.", "reason": "near_duplicate_of_source", "seed": 1618241959, "similarity": 0.958904109589041, "temperature": 0.3}], "fingerprint": "c6eab8f879be6f3b272e3fc061939e33ff1cfaba59efff92048138999d3c75dc", "generation_attempts": 2, "gold_answer": "native to Asia", "matched_aliases": ["Asia"], "query_id": "test1197", "question_hash": "78e2c007f9f6e181519f1f61a347529f526869f7ac81a9e8a716bf8f7eb14fad", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "f8e1bf84b9ce81bfec75b5a2542387354f633beaaa697932c6b2bf4360ab6ec6", "scope": "all_answer_documents", "seed": 340454823, "similarity": 0.43103448275862066, "source_content_hash": "2fb06a9983fff85b93ddda3d2bfac5794c6a8eb3786cb004514556e973d4cd16", "source_hash": "027da15e970b102a806ae28e8cd421274672d74dd9396cd53b3a6ede879be8bb", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "b16c2c99b23a1dedfa8d4d5c7bc270438835570669befcd12b867114239eb83d", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
