{"doc_id": "doc48707", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "In 1945, the presidents of the eight schools signed the first Ivy Group Agreement, which set academic, financial, and athletic standards for the football teams. The principles established reiterated those put forward in the Harvard-Yale-Princeton Presidents' Agreement of 1916. The Ivy Group Agreement established the core tenet that an applicant's ability to play on a team would not influence admissions decisions.", "reason": "near_duplicate_of_source", "seed": 1804517265, "similarity": 0.9963898916967509, "temperature": 0.3}], "fingerprint": "d6d5cf13be99b74ba4842ad92ec9f6da0260b232f82e50b15f92be376785ad8d", "generation_attempts": 2, "gold_answer": "1945", "matched_aliases": ["1945"], "query_id": "test1374", "question_hash": "b32f5a849dca260c37d2dcf6d1c859dc9f5cd4cd34e1ab48417f9b018ab91d59", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "7bac0a4cfaacd991f9c547d502ae6346c37a768afe506f1702cf46e47cf53826", "scope": "all_answer_documents", "seed": 1031521264, "similarity": 0.1189083820662768, "source_content_hash": "4f6634dfa5770f53aae81e499f50df192b0ea0122dddc7b7416b4be97dd43cfc", "source_hash": "23194750cba4d70952fad1d1715a277fde5eab640eed7a3571c89193f99200f1", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "2bc3a65fda45a08d8410a0acf2ef9ada9f14ebb144260e942b5e68b9c5bfffec", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc48747", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Call of the Wild is a short adventure novel by Jack London published in 1903 and set in Yukon, Canada during the 1890s Klondike Gold Rush, when strong sled dogs were in high demand. The central character of the novel is a dog named Buck. The story opens at a ranch in Santa Clara Valley, California, when Buck is stolen from his home and sold into service as a sled dog in Alaska. He becomes progressively feral in the harsh environment, where he is forced to fight to survive and dominate other dogs. By the end, he sheds the veneer of civilization, and relies on primordial instinct and learned experience to emerge as a leader in the wild.  \n1890s", "reason": "near_duplicate_of_source", "seed": 792435336, "similarity": 0.9938461538461538, "temperature": 0.3}], "fingerprint": "726bc7edaa839ce77e0bd2573292af38d8b0101cb70a699b4aea6bd674dbbce2", "generation_attempts": 2, "gold_answer": "1890s", "matched_aliases": ["1890s"], "query_id": "test1375", "question_hash": "585b83beabe4562021c655d94645caaffb71180c4e5c38d8d632c08871f2b14a", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "a37895e30f5d9a9bc852e5c422674c0596d156e9ea096a765495f837eda2036f", "scope": "all_answer_documents", "seed": 1737690739, "similarity": 0.09716599190283401, "source_content_hash": "1522093ce35f4209138be37381c22ab970b5355d5fd9e7844ce20d864caa3acc", "source_hash": "d6ac199370595b0b1e59095332878a62864ddd78807302847d887757cc3002d2", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "c3675324dd53947b708be33a81b7b84ea21b3192b0e94480715a7100f1a8b509", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": 