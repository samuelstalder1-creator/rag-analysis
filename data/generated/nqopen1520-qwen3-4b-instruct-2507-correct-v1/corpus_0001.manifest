{"doc_id": "doc24788", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Varsity Blues is a 1999 American comedy-drama film directed by Brian Robbins that follows a small-town 5A high school football team and their overbearing coach through a tumultuous season. The players must deal with the pressures of adolescence and their football-obsessed community while having their hard coach on their back constantly. In the small (fictional) town of West Canaan, Texas, football is a way of life, and losing is not an option.", "reason": "near_duplicate_of_source", "seed": 1421952237, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "16aabf2fbb8e40787cb226265588f58ec9734bc1f5345bc7ad88695259cdcae8", "generation_attempts": 2, "gold_answer": "1999", "matched_aliases": ["1999"], "query_id": "test692", "question_hash": "9ce653eecc4d3f52106abc1dba0449794fce8d5c5441dcd78f563dfc39b38829", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "fb0bb3db64d3a4b2c7be4d4e3c379d80090661ec1134d8ea2cb7dfa9aad20d51", "scope": "all_answer_documents", "seed": 2060178714, "similarity": 0.0690505548705302, "source_content_hash": "b2494922aa9f89bd7b021b45637c292b8ca3d0bb94d8bb9e29c22f75e45534c6", "source_hash": "ed9d5354ce69e8b51f10ce92be6d3062846ea46b901078c21102236d74c2ddc1", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "54b06dc7acf39cdd7e2da2e54cdc313b6bd1896fbfa206e74b6614b378629d76", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
