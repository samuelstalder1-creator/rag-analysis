{"doc_id": "doc112430", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"Papa's Got a Brand New Bag\" is a song written and recorded by James Brown. Released as a two-part single in 1965, it was Brown's first song to reach the Billboard Hot 100 Top Ten, peaking at number eight, and was a number-one R&B hit, topping the charts for eight weeks. It won Brown his first Grammy Award, for Best Rhythm & Blues Recording.", "reason": "near_duplicate_of_source", "seed": 336367155, "similarity": 0.9828080229226361, "temperature": 0.3}], "fingerprint": "c5b433cebf11cd65f351c69602afa15201911332f785b0788b4c2c8704880280", "generation_attempts": 2, "gold_answer": "James Brown", "matched_aliases": ["James Brown"], "query_id": "test3285", "question_hash": "c4af7916970fdde97e7bc7fe81a4c819e2afef0b83499dff48fb7a679f36c6d1", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "e11a55b7908c5f5b759609103496a85184119ee34bd12f623b3c68ec6d52e53e", "scope": "all_answer_documents", "seed": 1825114854, "similarity": 0.25252525252525254, "source_content_hash": "f5e7bfda2d3e60cb6a6c6d2344cd341c73687467d71fd19c430f43c536729be3", "source_hash": "8bafec87b1fc9cc8eba0ca46ed810c975b658ba853dd26dc2a204d930a1bf5d1", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "e9ea3997af78ecd55621bca9c5e5c19b7129d121a1ba956f252f1657cea3fbc5", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
