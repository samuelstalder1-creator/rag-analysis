{"doc_id": "doc22132", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "To Kill a Mockingbird, a novel by Harper Lee, was published in 1960. It was immediately successful, winning the Pulitzer Prize, and has become a classic of modern American literature. The plot and characters are loosely based on Lee's observations of her family, her neighbors and an event that occurred near her hometown of Monroeville, Alabama, in 1936, when she was 10 years old. The story is told by the six-year-old Jean Louise Finch.", "reason": "near_duplicate_of_source", "seed": 546372974, "similarity": 0.9863013698630136, "temperature": 0.3}], "fingerprint": "df8b3e67d30cf76a7c4d34e1ba2824c4271594abb1c90503da400626a3afd8de", "generation_attempts": 2, "gold_answer": "1960", "matched_aliases": ["1960"], "query_id": "test620", "question_hash": "c5152dbb233d7eb92e94e0b458d157b11a6ec08ea378462fa0672a45584449bb", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "54cc8f5e4ca48b488abee873e07cb9b534878f2afcf4afdfa9c1d2e64bbebb40", "scope": "all_answer_documents", "seed": 1015156503, "similarity": 0.11011523687580026, "source_content_hash": "e0668c7f49b5ccf1d647d187e1f67f1c1036787a9aae10eda868a954582de9dc", "source_hash": "191f904165828195ea08a61108a9ce362878c201b8fa3bcc279f2a64214165c8", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "e8c8f1fcf7dda687ff2d63404134aaaa591c5b49aac86bcfa0b86f2004853578", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
