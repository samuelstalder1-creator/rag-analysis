{"doc_id": "doc70686", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Lupus Foundation of America (LFA), founded in 1977, is a national voluntary health organization based in Washington, D.C. with a network of chapters, offices and support groups located in communities throughout the United States. The Foundation is devoted to solving the mystery of lupus, one of the world’s cruelest, most unpredictable and devastating diseases, while giving caring support to those who suffer from its brutal impact. Its mission is to improve the quality of life for all people affected by lupus through programs of research, education, support and advocacy.", "reason": "near_duplicate_of_source", "seed": 1374425468, "similarity": 0.9965576592082617, "temperature": 0.3}], "fingerprint": "219e1c3221a5638aadfaf9d9ddfd8efa740e19d730390aeeb3639676da1c5d40", "generation_attempts": 2, "gold_answer": "1977", "matched_aliases": ["1977"], "query_id": "test2022", "question_hash": "a4045f5c91d5c842bf7e8fce6cb6b07358f0ff092b25fbe410ba80b1a2d9c53e", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "9fa1ea36dc0a0673cca55c4cea3fa6c9b001ad44d1eed1f0cd5cd93d154a7d77", "scope": "all_answer_documents", "seed": 969042417, "similarity": 0.1545538178472861, "source_content_hash": "ae547c4bf88064d0ca7c577a70613989db02b7dedd247876aadc9ffdbec12f5a", "source_hash": "3f97da1d65a375d947a5550e7fbc942a80f43698f22fe6bff86f38c1156a130e", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "200794ba2be3a095d3d983773da37aa585f7002d153487e592cbaefe42c833f6", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe8