{"doc_id": "doc88144", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Garbiñe Muguruza won her second Grand Slam singles title, defeating Venus Williams in the final, 7–5, 6–0.[2] Muguruza became the second Spanish woman to win Wimbledon after Conchita Martínez in 1994.[3] Muguruza also became the first player to defeat both Williams sisters in Grand Slams singles finals.[4]", "reason": "near_duplicate_of_source", "seed": 413209063, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "0ede0db9a896d8106bc3db830a27995297e8b83734906df51173b791672e0a4e", "generation_attempts": 2, "gold_answer": "Garbiñe Muguruza", "matched_aliases": ["Garbiñe Muguruza"], "query_id": "test2567", "question_hash": "57d21c9dd4dde2bfa31d08de5f5455ebf3c30be38f4fb62b99048eac6127f717", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "8f93b513d30ee6085e73570b6560c6a61e83fbab72c071a7f98a94269ff7785e", "scope": "all_answer_documents", "seed": 1627775042, "similarity": 0.2396576319543509, "source_content_hash": "bc5eaeef34148ada1fd4e8f56419428160b41416132cd163a60c04c30bf14c7e", "source_hash": "0a23df76353e450722828ac7bd999c9148e55498bc52f1173258eaaa11f5d930", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "4c5f7bfa7d93e3a2e7db3712fe05759c2c29bb00b9507f5a79f0267d6a06c2f3", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc88171", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Board of Governors of the Federal Reserve System, commonly known as the Federal Reserve Board, is the main governing body of the Federal Reserve System. It is charged with overseeing the Federal Reserve Banks and with helping implement monetary policy of the United States. Governors are appointed by the President of the United States and confirmed by the Senate for staggered 14-year terms.", "reason": "near_duplicate_of_source", "seed": 1622552132, "similarity": 0.9924812030075187, "temperature": 0.3}], "fingerprint": "941773df6aa1f008546d2252e5eecae903d16241b9ccb3338e5214e852d2acb9", "generation_attempts": 2, "gold_answer": "the President", "matched_aliases": ["the President"], "query_id": "test2569", "question_hash": "fc41f7a895d4247e890aefafbf240b76d58c049ffed4c7764ce266c09bd62ed9", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "d9a2f37148dd07ae124a377ea72ed97d14ab490b2ff9d29f937a9d702f275c5b", "scope": "all_answer_documents", "seed": 296728001, "similarity": 0.5885350318471337, "source_content_hash": "0160c576f65bee3eebf0be80aeacf27a0b6cd37a4d60456f26852d95b5ae2677", "source_hash": "e741e22563cfb1e0dc20f88e5e4ce4cda86ff900ba536fb477d445e1113374e7", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "a04560e39c707a2a1bdd5bedf5356be97bd09c6a2f3e66f44fc255dcdf7718b1", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc88172", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "By law, the appointments must yield a \"fair representation of the financial, agricultural, industrial, and commercial interests and geographical divisions of the country\".[1][2] As stipulated in the Banking Act of 1935, the Chairman and Vice Chairman of the Board are two of seven members of the Board of Governors who are appointed by the President from among the sitting Governors.[1][2]", "reason": "near_duplicate_of_source", "seed": 180475311, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "bd1667e552f2472bf006c9c205c98ee1543506c16dc3ea55b3240582226689de", "generation_attempts": 2, "gold_answer": "the President", "matched_aliases": ["the President"], "query_id": "test2569", "question_hash": "fc41f7a895d4247e890aefafbf240b76d58c049ffed4c7764ce266c09bd62ed9", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "bbb41451126efd96320ef0196ed57ef6e73deacd1eac6ae753d9c94a98e0d567", "scope": "all_answer_documents", "seed": 688412859, "similarity": 0.2020460358056266, "source_content_hash": "f27b175066b9d1fa1dca29aa83fb50dfb1779b991754939666c689d9e1818fd2", "source_hash": "ed2c77fe3e5ffae80243b058dac0270c6073f8490762dcc74064cc25ec05dafc", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "16453a6a5c9918c14ea787e301363c17fda5bd6616c427b7ece052abbf6fcaac", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
