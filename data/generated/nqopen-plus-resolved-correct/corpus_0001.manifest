{"doc_id": "doc46363", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"If She Knew What She Wants\" is a song by Jules Shear released on his 1985 album The Eternal Return. The song was recorded a year later by The Bangles for their 1986 album, Different Light.", "reason": "near_duplicate_of_source", "seed": 702346382, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "8c7a5a782b2df804c866d1933a7e30ccb3cc5e74f29e559d8ee8def12fd74c0b", "generation_attempts": 2, "gold_answer": "Jules Shear", "matched_aliases": ["Jules Shear"], "query_id": "test1310", "question_hash": "513c9bdcc5f6f23003651f464160671e412268ed4a268301fb68aabdc1589429", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "60b1db1ac3557ba0b2ee9781115dca9c0105b1fb26827520c82aa37d0adf5695", "scope": "all_answer_documents", "seed": 972604644, "similarity": 0.21670428893905191, "source_content_hash": "d43d5a5ced2d2adebc5efeb8a5ed88dd9fc0590b9b9f1a29f32a5c1e6d6c6400", "source_hash": "7f915b576d9c188ae6f6a7455cb287dd6a89bca163ff5aa03b616f87dbbf0d6d", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "32aada9195be881883f5525c83cc8095e68f3624f832a11a222c81c77da4d45b", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc46453", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"White Wedding\" is a song by Billy Idol that appeared on his album Billy Idol in 1982. It is often considered one of his most recognizable songs, although other Idol songs charted higher. It peaked at No. 108 on the Billboard Bubbling Under the Hot 100 on its original release, and reached No. 36 on the Billboard Hot 100 when it was re-issued in 1983. In the UK it reached No. 6 in the UK Singles Chart upon its re-release there in 1985 and 1988, when it was re-issued to promote the Vital Idol remix album.", "reason": "near_duplicate_of_source", "seed": 1015179758, "similarity": 0.9980314960629921, "temperature": 0.3}], "fingerprint": "aa624c12d389844a816415ad17d01ccf61629a31e977934e330824a301206ade", "generation_attempts": 2, "gold_answer": "Billy Idol", "matched_aliases": ["Billy Idol"], "query_id": "test1313", "question_hash": "c5ddb534f46f2ad7083a82d7dd38e71e3127b0bbeb3e35d5027db02c567ad064", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "a866e28749d7e6553dd7aa57604e04f1ca90037ec20ef4a60c940ec1ea638693", "scope": "all_answer_documents", "seed": 241040684, "similarity": 0.19690265486725664, "source_content_hash": "ad306a647bfa249aafc3092a2850a8ff34a6e581d99f2a2a1d9c44723f82c5a2", "source_hash": "d5341925f9ab394fd8c7ffac63131e00de78c271fe5440d9484f73cea928bf58", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "f40e2e521606918cc5ab0b29a30bd5a58ebf111a647bd29e15d48abac5b68fa2", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query