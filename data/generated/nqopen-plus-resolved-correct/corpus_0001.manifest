{"doc_id": "doc3057", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"It's My Party\" is a pop song recorded by multiple artists since the 1960s. In 1963, American singer Lesley Gore's version hit #1 on the pop and rhythm and blues charts in the United States.[1] It was the first hit single for producer Quincy Jones.", "reason": "near_duplicate_of_source", "seed": 79082233, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "212fd976abb7edccdc1b6a8c8a26afb97b62691e4013aa8d894a60a4811ba51c", "generation_attempts": 2, "gold_answer": "Lesley Gore", "matched_aliases": ["Lesley Gore"], "query_id": "test94", "question_hash": "0559a45086a055a4d74c9ecfed12df88578c057dbf7d99d7d846d24f7e87aeeb", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "14c3304580f655673b744c8f3ce8e85b2e5a0f274f98e851a2f76fc9b0dd0c2d", "scope": "all_answer_documents", "seed": 53704743, "similarity": 0.5458015267175572, "source_content_hash": "3a83ab37e5349bc9305a7de6c8e8e2f01931b5c53c61c22e3da30865157e9aa2", "source_hash": "06fa062cef6d5925bd5affdd535ce27e9dc8cc3c641652bd286527d79a6efe3f", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "1f0d8f42270104a719fc49021a0f863a4e727ec8705edceeda9644fb6054893d", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
