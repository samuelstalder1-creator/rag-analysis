{"doc_id": "doc57128", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Catch Me If You Can is a 2002 American biographical crime film directed and co-produced by Steven Spielberg from a screenplay by Jeff Nathanson. The film is based on the life of Frank Abagnale, who, before his 19th birthday, successfully performed cons worth millions of dollars by posing as a Pan American World Airways pilot, a Georgia doctor and a Louisiana parish prosecutor. His primary crime was check fraud; he became so experienced that the FBI eventually turned to him for help in catching other checking forgers. The film stars Leonardo DiCaprio and Tom Hanks, with Christopher Walken, Martin Sheen, and Nathalie Baye in supporting roles.", "reason": "near_duplicate_of_source", "seed": 361009273, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "9309bd293e2b8479b0b3ef447c9a4f62d7169492ff28b073c311c2ca4602c0ff", "generation_attempts": 2, "gold_answer": "2002", "matched_aliases": ["2002"], "query_id": "test1613", "question_hash": "52169482212272307ded4c6b9fea991dba482ca813344b632347583b585940a2", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "a790862d969cdf78f58cf336afc4d566722abacdba17188ed1e5f5a8c8bf9f1d", "scope": "all_answer_documents", "seed": 1433616003, "similarity": 0.8883826879271071, "source_content_hash": "278c4ffd661af8b841d0ed9c9a98a8206c54b2eff9edb6fd42e9cfde12e9bf4a", "source_hash": "60e4d39e4c54ea841dce69c41addf6c4ae0d93e613193197f3df60333f691f79", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "2e8272c1816a367e1749137a06dda50517bb6080a0acaa6adeeb7ae3f7f4ef62", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "