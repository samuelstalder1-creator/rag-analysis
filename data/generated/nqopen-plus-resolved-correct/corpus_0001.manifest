{"doc_id": "doc25783", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The first official Twenty20 matches were played on 13 June 2003 between the English counties in the Twenty20 Cup.[5] The first season of Twenty20 in England was a relative success, with the Surrey Lions defeating the Warwickshire Bears by 9 wickets in the final to claim the title.[6] The first Twenty20 match held at Lord's, on 15 July 2004 between Middlesex and Surrey, attracted a crowd of 27,509, the highest attendance for any county cricket game at the ground – other than a one-day final – since 1953.[7]", "reason": "near_duplicate_of_source", "seed": 1937896524, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "7c7e5cc18227be8aebc08e7d80f846b0fe7cae6c0b08f2ac1ea65e7af8eb355d", "generation_attempts": 2, "gold_answer": "Lord's", "matched_aliases": ["Lord's"], "query_id": "test720", "question_hash": "bade08d18f983e61843ec8567e90be9e1227c5a13691c0a6e76998c39aecb69d", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "391a039f4976fbef7c80cf55e94ba7360ebad6db8de632468cd611878b87de33", "scope": "all_answer_documents", "seed": 1729459165, "similarity": 0.5781990521327014, "source_content_hash": "a9dae8eca0b9c6640aecefd0aeaf579ad6c3c26e65b213dca1511be71578463f", "source_hash": "130f2b412a6bd14b5a545778cb47d958430d3b6e8135f5a0984e86ca96a1a1a1", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "827917cab8f4cea6d05f27db507b25c7150520c155670e2b6e722b170dce4057", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc25848", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The 2018 Major League Baseball season began on March 29, 2018, and is scheduled to end on September 30. The postseason will begin on October 2. The 2018 World Series is set to begin on October 23, and a potential Game 7 is scheduled on October 31.", "reason": "near_duplicate_of_source", "seed": 1169954091, "similarity": 0.993963782696177, "temperature": 0.3}], "fingerprint": "aaade1ded4041dda4322f3c93e91839a815a6a4513359355ee2626cbecd4c608", "generation_attempts": 2, "gold_answer": "March 29, 2018", "matched_aliases": ["March 29, 2018"], "query_id": "test722", "question_hash": "229edb03e3733b50edef1a64f70b44153020fa95515aa5990f5ab25a01c6fa58", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "679d4bd514d4145a71e86d8952212fbe900eeeba47c49213b1e62c3535b426c9", "scope": "all_answer_documents", "seed": 100110527, "similarity": 0.28901734104046245, "source_content_hash": "b1b472d79bc6e163f8ccdd0d97f951b87aceb81934557fc9098e708b9b1ec7ef", "source_hash": "beba83e134d4da71a311f1c6d1d1fc42cf4d26da29f9d9f1af640713fbb4d906", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "2fe63102d985428991588bfe6368d296ddd3c9bb6f640ce9402c75fbf7ac5885", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
