{"doc_id": "doc57950", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"Lord Have Mercy on the Working Man\" is a song written by Kostas and recorded by American country music singer Travis Tritt. It was released in August 1992 as the first of five singles from his third studio album, T-R-O-U-B-L-E. The song became Tritt's tenth entry on the Billboard Hot Country Singles & Tracks (now Hot Country Songs) charts, where it peaked at number 5.", "reason": "near_duplicate_of_source", "seed": 1869411141, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "0be6cb82b0c9e045fa24f0c2cc6d617f0a2bc32c28dfb3908ee3d31190eea810", "generation_attempts": 2, "gold_answer": "Kostas", "matched_aliases": ["Kostas"], "query_id": "test1631", "question_hash": "479f7ce845d58e7b05ff305be1f97bf0ab1f76352b6570b8846163b19b8dd173", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "dbaa422a9209c4142c535d68b97d61730f0be267c2742f297cae4338c6c93530", "scope": "all_answer_documents", "seed": 735953149, "similarity": 0.9070735090152566, "source_content_hash": "8b2efce92127a1532e817b73c940b1bceb385e4a506f894ca1f56cc33cb70cf5", "source_hash": "c90b88dfdb23b1b2f0d888693c6590161b21816529baa95d476d47ae096a90bb", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "70dc2f9c7802a33db2c06a1b0fab8a70bbec2c4c5e6be207d452eb1dabe455f1", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc57957", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "At the federal level in the United States, legislation (i.e., \"statutes\" or \"statutory law\") consists exclusively of Acts passed by the Congress of the United States and its predecessor, the Continental Congress, that were either signed into law by the President or passed by Congress after a presidential veto.", "reason": "near_duplicate_of_source", "seed": 225408777, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "1386826314716ad78ecc4bb36ede7113d0fdd620cf77701b6a209b74b213adf3", "generation_attempts": 2, "gold_answer": "statutory law", "matched_aliases": ["statutory law"], "query_id": "test1632", "question_hash": "7beab7d3d17830af943fd2977f6c710f1cd3d6281112c4c7cd782085755a8a1d", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "f0f46583aa6501eb52c91a769b342d6d5c253a1e04a57e2c419691b355faaeb8", "scope": "all_answer_documents", "seed": 1713044150, "similarity": 0.1661721068249258, "source_content_hash": "2289ee0acf35353e9aa41c69e659a180546b0765511ccf9885a1da1026994e12", "source_hash": "80221d40d5a5b7a614f52dab54aaab7a8197368dee8ea90826fb2c8224a0fbe0", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "3de0364a29ab7fd8ed5454c63fdfad1840a7de61c4855e5a7f36c2733cdee64e", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
