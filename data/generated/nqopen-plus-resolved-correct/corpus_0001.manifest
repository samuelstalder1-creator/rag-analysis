{"doc_id": "doc92189", "receipt": {"answer_in_original_body": true, "failed_attempts": [], "fingerprint": "0dc6f39d42bdf73d80163e841656146b8c1ba9d161abe6873af4b42ff6538d3a", "generation_attempts": 1, "gold_answer": "1%", "matched_aliases": ["1%"], "query_id": "test2689", "question_hash": "7c11e456f6f2c65d68b4cb9fbbba8178d3984ac8a7a526b9ae3f822aabd982bc", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "8c65de235475a258efcccfd859ac87c004471a2dffd568e04a96e92905d3405b", "scope": "all_answer_documents", "seed": 304695301, "similarity": 0.7197452229299363, "source_content_hash": "3f43a6f5f65eadbd1eb61a25df6bb8b9b976e9465f7d391716c97eb751153a0b", "source_hash": "76b6f1bfb928d46ea4a51894991a78a266ebc036d1e4be3ed75022f8ec8707e5", "target_answer": null, "temperature": 0.3, "validation": {"answerability_verified": false, "evidence_hash": "bb091b7faf13096fc2d5992c3d75d3c4b8671b60c321f9304213cfb842951d44", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc92193", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "In 2007, the top 20% wealthiest possessed 80% of all financial assets. In 2007 the richest 1% of the American population owned 35% of the country's total wealth, and the next 19% owned 51%. Thus, the top 20% of Americans owned 86% of the country's wealth and the bottom 80% of the population owned 14%. In 2011, financial inequality was greater than inequality in total wealth, with the top 1% of the population owning 43%, the next 19% of Americans owning 50%, and the bottom 80% owning 7%. However, after the Great Recession which started in 2007, the share of total wealth owned by the top 1% of the population grew from 35% to 37%, and that owned by the top 20% of Americans grew from 86% to 88%. The Great Recession also caused a drop of 36% in median household wealth, but a drop of only 11% for the top 1%, further widening the gap between the top 1% and the bottom 99%.", "reason": "near_duplicate_of_source", "seed": 1450557537, "similarity": 0.9887260428410372, "temperature": 0.3}], "fingerprint": "d092d4bd65bc7b7ea7f5c591e689e7fec306d510ff6f8e81b99abf51841628d3", "generation_attempts": 2, "gold_answer": "1%", "matched_aliases": ["1%"], "query_id": "test2689", "question_hash": "7c11e456f6f2c65d68b4cb9fbbba8178d3984ac8a7a526b9ae3f822aabd982bc", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "9e795ff39f5f6a5b4177361a0f4dd4b366bec3da5d3398cfd7dd3797b3dcf354", "scope": "all_answer_documents", "seed": 354376303, "similarity": 0.170873786407767, "source_content_hash": "55befa8acc2f44c02bed01bbb2f756872856fc9c60581d488bb5de87ae283077", "source_hash": "73e8d6b10535ad2a004c056e50c9729bc5561d3e42a618b176068492c4ebc611", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "9aff2f5ff4d4226237f0f52d68f70b8fe7266f04caa26bd32bfddbdc123cb86a", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc92225", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Western Australia's iron ore output for 2011 was 474 million tonnes, 97% of Australian production. The bulk of Western Australian ore went to China, which imported 70 percent of 2010 production, followed by Japan with 19% and South Korea with 10%. The state has the world's largest Economic Demonstrated Resources of iron ore with 22% of the world's iron ore followed by Brazil with 17%, Russia with 15% and China with 14%.", "reason": "near_duplicate_of_source", "seed": 491201509, "similarity": 0.9929577464788732, "temperature": 0.3}], "fingerprint": "13bb98b02d876c9fcc95cc9b9b48e3a5ac469b9379b7787c4265f72d41b8f421", "generation_attempts": 2, "gold_answer": "Western Australia", "matched_aliases": ["Western Australia"], "query_id": "test2690", "question_hash": "b92151022a2847afd4106ee594440c98cacc675b17858dbc51a35b7e6c43052a", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "b909005bc276866148450e15375c844830b509f5470ef864bda67565ddf79403", "scope": "all_answer_documents", "seed": 137313196, "similarity": 0.1712962962962963, "source_content_hash": "c78e4686df1e389b7a6e93fc56a2504a068e641c63aab6cfda80fde1d51008b0", "source_hash": "cc65788057bee75e06fce78aa9c4b73151e298402d0fa7e6bd0cfb5eaeb32a91", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "de49360be6cf46b1dd5584a89a8512d7126670876b1e708fb70806e2cdf2f4e0", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
