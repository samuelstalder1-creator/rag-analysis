{"doc_id": "doc115709", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Barry Bonds holds the Major League Baseball home run record with 762. He passed Hank Aaron, who is currently second with 755, on August 7, 2007. The only other player to have hit 700 or more is Babe Ruth with 714. Alex Rodriguez (696), Willie Mays (660), Ken Griffey, Jr. (630), Albert Pujols (614), Jim Thome (612), and Sammy Sosa (609) are the only other players to have hit 600 or more.", "reason": "near_duplicate_of_source", "seed": 70700376, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "8fe53dbd75db6189a9e79f42c245885897159ebffc5284559dc26dfba09081ed", "generation_attempts": 2, "gold_answer": "Barry Bonds", "matched_aliases": ["Barry Bonds"], "query_id": "test3394", "question_hash": "4bf71f144b6077768bdd6fdb68939ae8b0a66702d386412ebdfb5f03f276a453", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "ba5556351f95182f3ba844e4552c7559ec96d06a0d566ddf4ae6b762954a2513", "scope": "all_answer_documents", "seed": 1541881290, "similarity": 0.723744292237443, "source_content_hash": "a549d4a049571d851bb4c186e17c8adf556a0fd706aae108f1826e33c0f79507", "source_hash": "320530d49da32861edaa3fa61937bfe590d1d2d716ac9785a5ca99657984d760", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "1f488b01f2ef41c473fd1cf525a621d9da43242336cd574485483a284b7389e8", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
