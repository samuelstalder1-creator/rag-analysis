{"doc_id": "doc103453", "receipt": {"answer_in_original_body": true, "failed_attempts": [], "fingerprint": "49c79de0ba073cbe823654e191a84bd02851e0ce251e906643a198d9f7feddb7", "generation_attempts": 1, "gold_answer": "Billie Jean King", "matched_aliases": ["Billie Jean King"], "query_id": "test3017", "question_hash": "5a557ae8206f163169114af4b13e7d75dc597655a90e66a563a27dee3925d433", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "653ea029af3ccfd70ea794e5b286bef6dbcc58aacbe2696688bf99c4c1923165", "scope": "all_answer_documents", "seed": 1501043949, "similarity": 0.8072653884964682, "source_content_hash": "e022968fffd1b6266be19868c06bb995670db1d583569d3a1af17dedb21d77b7", "source_hash": "e8756bec3e0a9821b374878ecee7ed9ca53320de96b5577eff1892984f0bbd0a", "target_answer": null, "temperature": 0.3, "validation": {"answerability_verified": false, "evidence_hash": "ad2aef17b7b9580002db1977008b1ed11724dd641adf0ead081c8f0e61255eaa", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc103666", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The film was shot primarily in Crema,[14][25] and in the nearby villages of Pandino and Moscazzano. It was shot during an unexpected historic rainstorm in Italy, described by the weather reports as a \"once-in-century rain.\" Scenes from Pandino and Moscazzano were filmed from May 17,[57][58] before moving to Crema on June 1.[59] Additional outdoor scenes were shot at the Palazzo Albergoni on December 4, 2016.[60][61] Several historical locations in the surrounding streets in Crema and Pandino were chosen during production, including the Crema Cathedral.[57][62] Businesses received compensation for financial losses caused by the closure, scheduled for May 30 and 31.[63] Two days' filming at the cathedral were postponed due to the weather.[62] Production in Crema cost €18,000,[64] with a promotion campaign that cost €7,500.[65] Filming also took place at the Grottoes of Catullus by Lake Garda in Sirmione,[66] the Cascate del Serio in Bergamo,[67] and in two small towns in the immediate vicinity of Crema: Montodine and Ripalta.[8][60]", "reason": "near_duplicate_of_source", "seed": 1532690048, "similarity": 0.9517743403093721, "temperature": 0.3}], "fingerprint": "552fccdc0a5e08a661e08540da3cdeb6f71c8f64f6422c57a905fb5d6d348126", "generation_attempts": 2, "gold_answer": "Moscazzano", "matched_aliases": ["Moscazzano"], "query_id": "test3023", "question_hash": "e2825bd265361d9f4243277e3e513d0b780b730093ffda590bf57d305fb4c59c", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "84c77fbc46e647fa9ea7f3009ecad6755864f453e68f0008deede8238f2a5d54", "scope": "all_answer_documents", "seed": 1907235213, "similarity": 0.3616532721010333, "source_content_hash": "0dca2150b4e8f82f042a8f55922f27987494d7922b72e6106a3cd817a3365f64", "source_hash": "a0f24ec5d182404f02a582d07ad1adb6c0de76f1e3be66c88c048ca5c953ca10", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "5831418b3009814b03950c64d4051172ccfc1e282bcf98ca70b4224677b21bba", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc103670", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The main location for the Perlmans' residence was an uninhabited 17th-century mansion in Moscazzano. The director initially wanted to buy the house but could not afford it, so he made a film at the place instead. Six weeks before production, the crew—including production designer Samuel Dehors and first-time set decorator Violante Visconti di Modrone—gradually decorated the house with furniture, objects, and decoration inspired by the characters. Much of the furniture, including the dishes and glassware from the '50s, belonged to Guadagnino and Visconti's parents. \"That made it cozy and personal,\" Visconti said, \"I wanted to give it the sense of time passing by.\"", "reason": "near_duplicate_of_source", "seed": 1540018893, "similarity": 0.9838709677419355, "temperature": 0.3}], "fingerprint": "2b0e12bf62721970a9ce12de558e14d4dae58ebebaac6f67f0da2f929c96174c", "generation_attempts": 2, "gold_answer": "Moscazzano", "matched_aliases": ["Moscazzano"], "query_id": "test3023", "question_hash": "e2825bd265361d9f4243277e3e513d0b780b730093ffda590bf57d305fb4c59c", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "b708b91b82e921b50f907ac05d5560273782275f44e636ec24e13d9641754351", "scope": "all_answer_documents", "seed": 658324001, "similarity": 0.17286652078774617, "source_content_hash": "8292c0725ba25e29a3b35907e079d759a62821d1b589e6da1b582ea0a086da37", "source_hash": "f45a5c6dd8bd662b9178fc4a8a3343019162de3b8c4bc44b94ca2896c9854625", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "f1a706e9ff6c820b1d68d2a5a3ce32fc8d73c04d70f07607c711442c9bc7bec3", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "vali