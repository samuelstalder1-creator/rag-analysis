{"doc_id": "doc76323", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The 802.11a standard uses the same data link layer protocol and frame format as the original standard, but an OFDM based air interface (physical layer). It operates in the 5 GHz band with a maximum net data rate of 54 Mbit/s, plus error correction code, which yields realistic net achievable throughput in the mid-2 Mbit/s.", "reason": "near_duplicate_of_source", "seed": 590326379, "similarity": 0.9861751152073732, "temperature": 0.3}], "fingerprint": "0fbd589aa60ab397e11ffeafadf539d34c8ac86e573ceaff4a1459af11e85a4f", "generation_attempts": 2, "gold_answer": "54 Mbit/s", "matched_aliases": ["54 Mbit/s"], "query_id": "test2192", "question_hash": "f0bb8da643af45bb44b5e89a35b62ee813f0dfc42ecb68dffe3dbb438f604b65", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "7fb32d9d944d502e7909eeda28efc4fd83baa18f98109104ddf975b090762da8", "scope": "all_answer_documents", "seed": 38784069, "similarity": 0.3302752293577982, "source_content_hash": "b176df6a4551238814741e8eb13c02154598494a02d4a5175448c39c21d80930", "source_hash": "941c9af0a2eb3ee16badc539e5f77821bd4c3595c020e8e3da201f844de9cf3b", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "59b615a0969affd53c715c2ff632a68bca78f1396ed0a42499b56711006004f1", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
