{"doc_id": "doc29608", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Tiffany Adams Coyne (born May 6, 1982) is an American model and dancer. She is the model on Let's Make a Deal, having replaced Alison Fiori in 2009.", "reason": "near_duplicate_of_source", "seed": 1230730109, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "89e0cbdf93412d0cc9c323461be964dcd376cb7a2cb7bf96ba1217cd8caaa278", "generation_attempts": 2, "gold_answer": "Tiffany Adams Coyne", "matched_aliases": ["Tiffany Adams Coyne"], "query_id": "test823", "question_hash": "de45ae20f588f9dd8cc1c3067bc771235824edbde6732f1d30b3d4288f2342f5", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "377779c4afdcd23e239aec0d9c740f46a9cc472a16d78b7dc14d2ce3be8d5e95", "scope": "all_answer_documents", "seed": 1313475767, "similarity": 0.8037974683544303, "source_content_hash": "a3d0e86309acad3267d381bd628918922df6b59b4bbcc42dec6285dc9177f8a9", "source_hash": "69dd3dce4586566be80bb0f744b979007fc5c8046c2bb841339f489bbaf22cd2", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "1722d34191e403ea7b590e93332448c87335255f2cea7f09544340b6ab684318", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
