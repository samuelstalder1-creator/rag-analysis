{"doc_id": "doc41274", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Where's Wally?, published in the US and Canada as Where's Waldo?, is a British series of children's puzzle books created by the English illustrator Martin Handford. The books consist of a series of detailed double-page spread illustrations depicting dozens or more people doing a variety of amusing things at a given location. Readers are challenged to find a character named Wally hidden in the group.", "reason": "near_duplicate_of_source", "seed": 153312064, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "cb69dc37df0e7f60aae1a23c5b56b0c23bf9fa19b6d0c6328879777dc3d46b36", "generation_attempts": 2, "gold_answer": "puzzle", "matched_aliases": ["puzzle"], "query_id": "test1162", "question_hash": "de214b19c3b40e2528aec6adba00fc1cbcb795c7786b42df626edfe5e76bf9da", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "de274db65ce3a2e0ac2daf0cb9c912660fa15e960b819b1cd9243bb1b4ad792c", "scope": "all_answer_documents", "seed": 1461232392, "similarity": 0.2616580310880829, "source_content_hash": "d104527d476cfba8b4314c5131e9dc66dacdce8535ecceb7f120b7161a222745", "source_hash": "9a994d9a5f97b8f09fa19526772e06e639e3791c7c0b47c146b3415fde0963f9", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "73f19a0b1da572a01492cc485de77e5a23dd9119869ee4aea63984045f1c0b5e", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
