{"doc_id": "doc97401", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Chicago Tylenol murders were a series of poisoning deaths resulting from drug tampering in the Chicago metropolitan area in 1982. The victims had all taken Tylenol-branded acetaminophen capsules that had been laced with potassium cyanide. A total of seven people died in the original poisonings, with several more deaths in subsequent copycat crimes.", "reason": "near_duplicate_of_source", "seed": 2015175520, "similarity": 0.9957805907172996, "temperature": 0.3}], "fingerprint": "2a40774a10cf75f5e6af4f746125fe347c49bbfb9fdaed63bcbda2bdaa2c6667", "generation_attempts": 2, "gold_answer": "the Chicago metropolitan area", "matched_aliases": ["the Chicago metropolitan area"], "query_id": "test2844", "question_hash": "067a3e13f95d9d992086ba1d4a3d993fc9d578d15e87e61431e03a6baca84a18", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "c3632267fee1d173f36c3e4e20767835696413ecb29c65d28f2526222ffa3bb5", "scope": "all_answer_documents", "seed": 321763223, "similarity": 0.0773286467486819, "source_content_hash": "8841ad4bb6a98117020babc716043aa33a19e148aa46eb514f9fa5dc5c80d529", "source_hash": "6a8835c7d64d82e7ac4fe777a93b46c4271b3fb813d2355a2802019b49f83678", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "6c429b114b177bd415e2a939b8d0cca82daa33b6844e15fba13a81c3e8efa73b", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc97421", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Sunflowers (original title, in French: Tournesols) is the name of two series of still life paintings by the Dutch painter Vincent van Gogh. The first series, executed in Paris in 1887, depicts the flowers lying on the ground, while the second set, executed a year later in Arles, shows a bouquet of sunflowers in a vase. In the artist's mind both sets were linked by the name of his friend Paul Gauguin, who acquired two of the Paris versions. About eight months later van Gogh hoped to welcome and to impress Gauguin again with Sunflowers, now part of the painted Décoration for the Yellow House that he prepared for the guestroom of his home in Arles, where Gauguin was supposed to stay. After Gauguin's departure, van Gogh imagined the two major versions as wings of the Berceuse Triptych, and finally he included them in his Les XX in Bruxelles exhibit.", "reason": "near_duplicate_of_source", "seed": 1760347098, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "89b8d586221f64d530016cf28341ca15d252ec29426301c0602cbdf00a90f761", "generation_attempts": 2, "gold_answer": "two", "matched_aliases": ["two"], "query_id": "test2845", "question_hash": "e74bdf41a7c5ae2120de4e6ce34b28e0fd2e720e72f528ee18247f1fc9a1ec7f", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "a5b2f8abe30971e9d91ab01cc29764aaca124d84e6f0c0c13355d922c490654d", "scope": "all_answer_documents", "seed": 387154266, "similarity": 0.18315432447710572, "source_content_hash": "c8894aa9a8ef656e1755b4cc65656fdb4c00b57fd4a19cd671f2f9f0dfae63fc", "source_hash": "a2a9062a19d5b9cfa7b6e20b02e50b08f9cff2d038fae5a938ea4b4c78e0f432", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "f18cbe1b8061ccfd6def5cafb472dcc292e0262054acc69692be98ca652a631c", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
