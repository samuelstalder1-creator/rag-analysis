{"doc_id": "doc78651", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Jurassic World Evolution is an upcoming business simulation video game developed and published by Frontier Developments. The game is based on the 2015 film Jurassic World, and is scheduled for release on June 12, 2018, for Microsoft Windows, PlayStation 4 and Xbox One.", "reason": "near_duplicate_of_source", "seed": 1282020513, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "e1316e43c074ebd28d717fa57a31ce53e28d023ba50af457a6b0f29f6671f2cb", "generation_attempts": 2, "gold_answer": "June 12, 2018", "matched_aliases": ["June 12, 2018"], "query_id": "test2274", "question_hash": "670edd38429e00ced3eed84a3b0e300bac8d3a1e1f7f2613be51164474940583", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "1574d394f4af7f7d2e820b58fa4996b2a0491ef38aa7cc5d4b81351d09483fd7", "scope": "all_answer_documents", "seed": 754236253, "similarity": 0.32967032967032966, "source_content_hash": "7e1d60dbce9f5dc02d7633131727e0bd5458e319e15dff9e7e651cda7864f9c7", "source_hash": "8e18288363a59dfc56ea4fa0f19edf944e01ccae175dc13ec85f40874e7ba351", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "0459597764bf0712e148b0b212fc52b06047442becb180337d2b7b61b0f4ec13", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
