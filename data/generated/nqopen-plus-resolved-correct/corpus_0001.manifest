{"doc_id": "doc87294", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Pennsylvania House of Representatives is the lower house of the bicameral Pennsylvania General Assembly, the legislature of the U.S. state of Pennsylvania. There are 203 members, elected for two-year terms from single member districts.", "reason": "near_duplicate_of_source", "seed": 1339889373, "similarity": 0.987603305785124, "temperature": 0.3}], "fingerprint": "e6972c3a0e6679913164a0491e298e241550974e02651947bce74f1dc7823c4d", "generation_attempts": 2, "gold_answer": "203", "matched_aliases": ["203", "203 members"], "query_id": "test2539", "question_hash": "80d5e7d83e669f3e8cf4e7b887447ebc1eb76584587eb4309d5ba72eb24dcce0", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "44c575f7108cfafcf9948f6a4b1d77f879fba4fcc7c0d17b897e446014bb496b", "scope": "all_answer_documents", "seed": 701559, "similarity": 0.549889135254989, "source_content_hash": "2c6b18a4465983e761009f2ac538964ee7c2dfc273c4c83ac909cbf7fc82149f", "source_hash": "2226c28d74de8c72d04d03a8c7e3498f4640c42966a2b834c4fb44cea6c20ec0", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "38b5d624799139066bb0d38a992613ed8ca98d056bba5edb1c7cc4dd5b1ee76e", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
