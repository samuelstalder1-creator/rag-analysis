{"doc_id": "doc41891", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Brazil remains the largest coffee exporting nation, however Vietnam tripled its exports between 1995 and 1999 and became a major producer of robusta seeds. Indonesia is the third-largest coffee exporter overall and the largest producer of washed arabica coffee. Organic Honduran coffee is a rapidly growing emerging commodity owing to the Honduran climate and rich soil.", "reason": "near_duplicate_of_source", "seed": 807288910, "similarity": 0.9932885906040269, "temperature": 0.3}], "fingerprint": "d6d5255a67dd606e6ef205906ca68b6b569454897a305950bf67aa2c5d9631ee", "generation_attempts": 2, "gold_answer": "Brazil", "matched_aliases": ["Brazil"], "query_id": "test1181", "question_hash": "e0486fc5ec146af35959caf7a85d9c3546b9b8cc266423be63527bce420441a7", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "cba5bc9b994de5e2120c69d9ed537fc40e63f5450045fa25c7c45275a4e67a9e", "scope": "all_answer_documents", "seed": 1074497896, "similarity": 0.3682219419924338, "source_content_hash": "1a11a142703f956168c0a3bb83dc3bc9120d4361008cc32a8d7c598ee3958ab6", "source_hash": "e54b2366f1743dbfec08361fa6d582bbb6aba2cddc781a21e1e1f7ad9c618fdc", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "0a08dc40fe5200a29536f99c5cada81567ac10d11ece13469d3ec270391057cf", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
