{"doc_id": "doc112224", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Tachycardia, also called tachyarrhythmia, is a heart rate that exceeds the normal resting rate. In general, a resting heart rate over 100 beats per minute is accepted as tachycardia in adults. Heart rates above the resting rate may be normal (such as with exercise) or abnormal (such as with electrical problems within the heart).", "reason": "near_duplicate_of_source", "seed": 848570655, "similarity": 0.990990990990991, "temperature": 0.3}], "fingerprint": "71585b8d63238d802efbd78e097537bb16f03fd6d5aa992c856523615ca0d610", "generation_attempts": 2, "gold_answer": "Tachycardia", "matched_aliases": ["Tachycardia", "tachycardia in adults"], "query_id": "test3279", "question_hash": "9d9876a72da526b24670987003efc342db23c9552ffe92c8e86c5bd21f1204ca", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "cf14a2210463d4ad5a741ea4393f0f9c6a42b28aa3cc188d955befc18979c537", "scope": "all_answer_documents", "seed": 2106149517, "similarity": 0.2306684141546527, "source_content_hash": "98c9a6c3eddac975b2c6580ae68448898f4abf9f6b7c5c18f1c963b78e145eab", "source_hash": "b31c9c86ed63ef278cebd85771fa3813a04248a5dc8d77511f288a0defc138a8", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "436ae3e25b550f2642625a321a214e47ea9b174abf359d452f4257ab027ed9dd", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
