{"doc_id": "doc86433", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Once Upon a Dream was a song written by American singer and songwriter Lana Del Rey for the dark fantasy film Maleficent (2014), which serves as a prequel to and re-imagining of the original Sleeping Beauty (1959). The song was released on January 26, 2014; it was made available as a free digital download during its first week of availability by the Google Play Store.[5] On February 4, the digital download was made available for purchase.[6]", "reason": "near_duplicate_of_source", "seed": 1913394917, "similarity": 0.9627118644067797, "temperature": 0.3}], "fingerprint": "a9046ae0ff6ef9e4dfd14d08560a746b4c8ec09551c9fc1b13f156cf25067ca0", "generation_attempts": 2, "gold_answer": "Lana Del Rey", "matched_aliases": ["Lana Del Rey"], "query_id": "test2503", "question_hash": "601c6b10e3203d6ea22f9433cd6c994e898eece945f8574d04bfaac472ce0498", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "2de8db5a8be00a41e5382e1bf862a9162db2286d3af9b614d90ab2fc7767f88e", "scope": "all_answer_documents", "seed": 1621940871, "similarity": 0.40048250904704463, "source_content_hash": "c66cab552794cfae19ef01f680de928e4ab14f28bf62125e5ca5e6abc51b4c1c", "source_hash": "676ee21772fd96b91adf1a613ced924beed035869926100e3512d3e229062715", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "0be4a9080aa512786b37048fe4504856466fa3d498f08f082de90467b40e3c8d", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
