{"doc_id": "doc90342", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"Lonely Boy\" is an international hit song from 1977, written and recorded by Andrew Gold in 1976 for his album What's Wrong with This Picture. It spent five months on the American charts, peaking at number seven in both Canada and the United States, and number 11 in the United Kingdom. While \"Lonely Boy\" would be Gold's biggest U.S. hit, his \"Never Let Her Slip Away\" achieved greater success in the U.K.", "reason": "near_duplicate_of_source", "seed": 229896014, "similarity": 0.9902200488997555, "temperature": 0.3}], "fingerprint": "460320c01de9726dcba7712379c4b7a64897bde8cad0f5e766b97d819830ae9b", "generation_attempts": 2, "gold_answer": "Andrew Gold", "matched_aliases": ["Andrew Gold"], "query_id": "test2639", "question_hash": "ea3d3eb96b2566126ec05fda9c3dae960dc2e7e1d6bd74c045691b5197c149b3", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "d73f3ebae8dc0cd9f216d433c7ceb4fde93360846e3ffcd2bc575e9aa69da0ba", "scope": "all_answer_documents", "seed": 1100135981, "similarity": 0.6796116504854369, "source_content_hash": "759b5c3e313d7969f7cdcb09fb61090eacf960b6004edb4a9cb7af364d47b45b", "source_hash": "f3f0e163de93fa76b6744eebeefc7c72d7b4e1de85c343b8411bbad54c0f105f", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "42c1fcbade89fadcc9a8d09b0f478ba436ec5229beb3a427ba36de0927a417a6", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc90354", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "In the Final Four, North Carolina beat Oregon (making their first Final Four appearance since 1939) while Gonzaga defeated South Carolina (both making their first ever Final Four appearance). North Carolina then defeated Gonzaga 71–65 to win the national championship.", "reason": "near_duplicate_of_source", "seed": 574515482, "similarity": 0.9834862385321101, "temperature": 0.3}], "fingerprint": "a80b4617c0895877614c6709ae8f42aee44f87e3251d6edfbf7ddceccd3c6e67", "generation_attempts": 2, "gold_answer": "North Carolina", "matched_aliases": ["North Carolina"], "query_id": "test2640", "question_hash": "5463a75719321eff74e4ef12952031c33d6eb19014f5549d30cff187c9402037", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "c38f489bf0aa76470a97911cc482c7f0b8961146e0081419737f12064569c741", "scope": "all_answer_documents", "seed": 1890016407, "similarity": 0.351931330472103, "source_content_hash": "895a784026cc5c32cad8dc3f4775c23ce88359159b3cfd8c00a0e71a98493d5a", "source_hash": "c3e83c2c3fb76a3e9643a7b5d1c9a0a0d159bcaf63a8ffdd147b09b52389a84c", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "1acca49ebe747489172b6be0b7ba58b24ee7b15d4a7d24922abe90f865836d42", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
