{"doc_id": "doc79654", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "As a result of the passage of Proposition 103 in 1988, the elected office of the California Insurance Commissioner was created in 1991. Previously, the position was held by a person appointed by the Governor. The Insurance Commissioner oversees the Department of Insurance. Democrat Dave Jones won the November 2, 2010 election for California Insurance Commissioner.", "reason": "near_duplicate_of_source", "seed": 760417135, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "ff366023b712d25e429f2230cef30e9126e049be8a15371c213e310bb80ab654", "generation_attempts": 2, "gold_answer": "Proposition 103", "matched_aliases": ["Proposition 103"], "query_id": "test2305", "question_hash": "3f80f0c0aacd77630d151d88ef4e3f8fe1fd5ed91957dbc330ecfcc4ba92a107", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "7159b653884084af1bf013fe6cce79472de47dc802f82225cafbf4d4edd78c31", "scope": "all_answer_documents", "seed": 1612426541, "similarity": 0.3670886075949367, "source_content_hash": "3993e494bbbe591b8eb610f23120e291f21819af4667db3400eb763e6c7ad28a", "source_hash": "d3ebf3074d04568ec94c98f55ed41137120a2713a6e3d2144a5227aa6d67e487", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "da4fc219b1f9f805a19a46e01cce0515acadc6e01b05b92bcd2fb7e388ef63d0", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
