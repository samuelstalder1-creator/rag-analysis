{"doc_id": "doc96058", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Edinburgh Festival Fringe, often referred to as simply The Fringe, is the world's largest arts festival, which in 2017 spanned 25 days and featured 53,232 performances of 3,398 shows[1] in 300 venues.[2] Established in 1947 as an alternative to the Edinburgh International Festival, it takes place annually in Edinburgh, Scotland, in the month of August.[3]", "reason": "near_duplicate_of_source", "seed": 827154265, "similarity": 0.9916897506925207, "temperature": 0.3}], "fingerprint": "55535e516d9738527f6d9fe6e4338ad2faae88403e151a4c8a85dc2778e5d856", "generation_attempts": 2, "gold_answer": "in Edinburgh, Scotland", "matched_aliases": ["in Edinburgh, Scotland"], "query_id": "test2794", "question_hash": "2c8962d716092bd9e36f08cdefeb9027d797381f88534d73ca5e0822aec41b40", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "685975e3aa11c2c1059bee5fc4da31d82216b53e7a54919d7a7aa7637af61f4d", "scope": "all_answer_documents", "seed": 1574221936, "similarity": 0.2460202604920405, "source_content_hash": "ba6fb736424003b506a8dbb81215f5903e8502106ba561a6800887260c55a5e2", "source_hash": "196b9b0d821de9c214948d8758206bc9f3d56a3cac0965430bf8ee0435d3f6ac", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "be3b84856fb7962a5bcf568ab0ed188e825cc14ad24637830ecba82fbea4d194", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
