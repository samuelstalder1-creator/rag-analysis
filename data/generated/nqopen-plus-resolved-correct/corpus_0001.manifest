{"doc_id": "doc79863", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The history of the Philadelphia Eagles begins in 1933. In their history, the Eagles have appeared in the Super Bowl three times, losing in their first two appearances but winning the third, in 2018. They won three NFL Championships, the precursor to the Super Bowl, in four appearances.", "reason": "near_duplicate_of_source", "seed": 1899803209, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "ac15541070b6fc7a619a644e130a914350cf05e902834c3f465026277128a123", "generation_attempts": 2, "gold_answer": "2018", "matched_aliases": ["2018"], "query_id": "test2314", "question_hash": "97ea43b3150db3395bd157b3d52b978738f65d32f56bb3df6dc8884ded4ca4c3", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "01cb7f1cca0922855b6d36aa394194ab6fb66ce79d34f1c6fa3a120d5bbb78d9", "scope": "all_answer_documents", "seed": 200930895, "similarity": 0.11518324607329843, "source_content_hash": "bda5126c48660899501ed79ad47350e0354448dd5ca9b0125cfb3306637ec0d2", "source_hash": "83799e7e1692e739d1ae0ca8d668a80b6f37e99d23fc6daa88b0741a1cba51f1", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "f23c4f575a31d8e103ad63cd4626ed9c5baa992d282b649521ed479cd4445bd1", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
