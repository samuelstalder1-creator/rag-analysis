{"doc_id": "doc27835", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Spanish moss (Tillandsia usneoides) is an epiphytic flowering plant that often grows upon larger trees in tropical and subtropical climates, native to much of Mexico, Bermuda, the Bahamas, Central America, South America, the southern United States, and the West Indies as well as being naturalized in Queensland (Australia) known as \"grandpas beard\" and in French Polynesia.[2] In the United States from where it is most known, it is commonly found on the southern live oak (Quercus virginiana) and bald-cypress (Taxodium distichum) in the lowlands, swamps, and savannas of the southeastern United States from Texas and Florida north through southern Arkansas.[3][4]", "reason": "near_duplicate_of_source", "seed": 1524771723, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "d5b48a74a706f7ada870e417e9e6911e5bb10681ac50dec2e2e1645c0f5c4dcb", "generation_attempts": 2, "gold_answer": "Spanish moss", "matched_aliases": ["Spanish moss"], "query_id": "test779", "question_hash": "0123d11e1b2d67299c5f0983482ae65350d3fd6f0607cb4c25128e8e766329c7", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "790edf685e9fb4d893cca687cdd7961a4a4b498b51c27794ee6817fd6a9a3280", "scope": "all_answer_documents", "seed": 850668872, "similarity": 0.893491124260355, "source_content_hash": "964a51e1ca3117a9382e28fccc06dd7fe78c7ae688784a2ace940b54306ed99e", "source_hash": "0e491ce8152f979338f6fcbb74fd651210ba35c0c1d3511df372bab657ba281c", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "c9b19a5c08fd4a78cd318a4528a5be4532b3f0fac0d2953b14e64e801460f1b0", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_a