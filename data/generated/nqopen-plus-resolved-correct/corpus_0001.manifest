{"doc_id": "doc13895", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "A minibike, sometimes called a minimoto or pocketbike, is a miniature motorcycle. Most minibikes use two-stroke engines and chain drive.", "reason": "near_duplicate_of_source", "seed": 1046244192, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "78a8c089041915a325d30e673d77bf4af34706b3dab64e1a9f552080f97351e8", "generation_attempts": 2, "gold_answer": "a miniature motorcycle", "matched_aliases": ["a miniature motorcycle"], "query_id": "test365", "question_hash": "e56cf3aa3fb472b194fd6ba27a323270903d671fc9c6a4c18a70f0e9a358a11a", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "e497202539a2c1ab4d9655f0270c49d2b54f67cec8bc4325a053feaa9527a4f7", "scope": "all_answer_documents", "seed": 2133753833, "similarity": 0.8317460317460318, "source_content_hash": "9b87f569c338d62736b99d3c61a5a1e2bc62c60f96a9ceedb0dbf81250f8348e", "source_hash": "55d876805b1c46234a5e52ede97ea44d1685e31c0a349b11cad2a9f822fe4ce3", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "c7f10bf3f6c956e266a5077bef8ce4da663e957063f9455b97b8591ed28f89e2", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc13925", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Kathleen Erin Walsh (born October 13, 1967) is an American actress and businesswoman whose roles include Dr. Addison Montgomery on the ABC television dramas Grey's Anatomy and Private Practice, Rebecca Wright on the short-lived NBC sitcom Bad Judge, and Olivia Baker on the Netflix drama series 13 Reasons Why.", "reason": "near_duplicate_of_source", "seed": 586549533, "similarity": 0.977491961414791, "temperature": 0.3}], "fingerprint": "2f68acc427c5001529e42e97d6ebd4c3287b39589223bda2e77660854a876319", "generation_attempts": 2, "gold_answer": "Kathleen Erin Walsh", "matched_aliases": ["Kathleen Erin Walsh"], "query_id": "test366", "question_hash": "96f94a688f2e784d2f1417cd5fa5a23cf8381c00eab0bad0c2e979863e310563", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "4aa1c2a910ad00f5d946e8b6f35d459dcf04d8a566fb62c900645796d86f35c7", "scope": "all_answer_documents", "seed": 1184792022, "similarity": 0.4791666666666667, "source_content_hash": "e9564143027c20330460953a4f75047878f494df8c7b759ec070e459bb675425", "source_hash": "823e85340c6fda9e7caf9e36d5a1e082c95a6d656b12a28480d9ba3202b845b7", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "26f4f7d2a3b72dda1df2fe71f608e4cce3d178e51dc138a09241b7683af8d736", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc13950", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Conscription exists in Israel for all Israeli citizens over the age of 18 who are Jewish, Druze or Circassian; Arab citizens of Israel are not conscripted. Other exceptions are made on religious, physical or psychological grounds. The normal length of compulsory service is currently two years and eight months for men (with some roles requiring an additional four months of service), and two years for women.", "reason": "near_duplicate_of_source", "seed": 1220222456, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "ddef32db16f9f6065a095645f153550e685874536ff66451a116962f80988c81", "generation_attempts": 2, "gold_answer": "two years for women", "matched_aliases": ["two years for women"], "query_id": "test367", "question_hash": "5ac057e00fa4daea3bd15bb2534e6f30def7d1f7b8dc0cce7b610dd5152569c7", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "269497a97f0420b4180216fc31f5628d4dc9472988f6b13f895a37eb0ad628a0", "scope": "all_answer_documents", "seed": 1986319104, "similarity": 0.17290322580645162, "source_content_hash": "15069bd635b71be766bd68c026e779732f47c2d41eb36765c6b7b61f5e139295", "source_hash": "d84212c9f3025b388e02f66f54d5d9a3a6a879ea5ce910ffe20a61509f839d40", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "fa76eeef66808fffaa65953486e5d2fdd6d4a4b34d78a057c995128a56c26c6e", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc13979", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"Make You Feel My Love\" is a song written by Bob Dylan from his album Time Out of Mind (1997). It was first released commercially by Billy Joel, under the title \"To Make You Feel My Love\", before Dylan's version appeared later that same year. It has since been covered by numerous performers and has proved to be a commercial success for recording artists such as Adele, Garth Brooks, Bryan Ferry, Kelly Clarkson and Ane Brun. Two covers of the song (one by Garth Brooks and one by Trisha Yearwood) were featured on the soundtrack of the 1998 film Hope Floats.[1] Dylan eventually released the song as a single.", "reason": "near_duplicate_of_source", "seed": 1255553404, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "ae9cf98b851fde6c8d06d0c8e80e64b7f5377e41c940a5329b2261c81faf697e", "generation_attempts": 2, "gold_answer": "Bob Dylan", "matched_aliases": ["Bob Dylan"], "query_id": "test369", "question_hash": "13d5d8434a9e93395ca4321e53f4ad261ef767c46a9c17fe70a2f5d4bb6b91f7", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "320d517400ffda92d52969e3a4c297cd5c943c223b9ebb1298d11f73b4b7c689", "scope": "all_answer_documents", "seed": 1503535127, "similarity": 0.10798650168728909, "source_content_hash": "be88b22ca3bf06b53461fccadeb4342fedde477ef010ed5e95c01579e8a0d531", "source_hash": "f6b75612cc0df000b3c6dbf382b35ca7f0b8560244b5bdee20f153a7e98f8fef", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "011f3f292b34f4e7f7b6cc6f0d5a2dd48618b44a741bbbe73a67dabafb1b5ae4", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa72