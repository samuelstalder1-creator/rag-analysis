{"doc_id": "doc897", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The image of the gates in popular culture is a set of large gold, white or wrought-iron gates in the clouds, guarded by Saint Peter (the keeper of the \"keys to the kingdom\"). Those not fit to enter heaven are denied entrance at the gates, and descend into Hell.[2] In some versions of this imagery, Peter looks up the deceased's name in a book, before opening the gate.", "reason": "near_duplicate_of_source", "seed": 1286161972, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "ef112d238b2bf29c4e81d93553424a13f9a5493e231e327a4fea4a9a14611503", "generation_attempts": 2, "gold_answer": "Saint Peter", "matched_aliases": ["Saint Peter"], "query_id": "test31", "question_hash": "5506fad14297c7610c2f3d9fe49839bf50a116e814d37af7f7dde317ae199b7a", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "9242dfbaff8f1d3e0229923927b8bf728bd66b68156fb517f2e7853ea9273cb5", "scope": "all_answer_documents", "seed": 1922042910, "similarity": 0.017152658662092625, "source_content_hash": "48c99284d95b8d483d484b24177940215e95c12bd7c98dac6a1dfd4edf623fc0", "source_hash": "7f29a21f5c9382e7e4a713edd80d4276124639e0b4791cbe7d226bd741ef1d2f", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "086443d5cd3a69f287d3f9d4400c51ce95c62daa74e5f4ff1fdb46a282983bd2", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc972", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Dragon Boat Festival, also known as the Duanwu Festival, is a traditional holiday originating in China that occurs near the summer solstice. It is frequently referred to as the Zhongxiao Festival (Chinese: 忠孝節; pinyin: Zhōngxiàojié), which commemorates fealty and filial piety. This festival takes place on the fifth day of the fifth month of the traditional Chinese calendar, a date that serves as the basis for its alternative name, the Double Fifth Festival. Because the Chinese calendar is lunisolar, the specific date of the festival shifts from year to year on the Gregorian calendar, with notable occurrences including June 9 in 2016 and May 30 in 2017.", "reason": "missing_gold_answer", "seed": 900296957, "similarity": null, "temperature": 0.3}], "fingerprint": "a991bb4a8a614f5149442f6ebe5ae8695ae4194befe24b96dcea7e4f4f2cc61f", "generation_attempts": 2, "gold_answer": "commemorating fealty and filial piety", "matched_aliases": ["commemorating fealty and filial piety"], "query_id": "test35", "question_hash": "081a8f178d76f04eec36bb4c9376b7f180cad7b27b980c698d48ddf6be3c9beb", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "a7cb5be428e4763e20d63d425359e7b120e18b972baa6ea0a3e0e4c7b3dc6c27", "scope": "all_answer_documents", "seed": 1393835675, "similarity": 0.7984, "source_content_hash": "b6727f838918253b5a9661577d8e1d1ee5c7b418328a7a2455daee7b3c59113a", "source_hash": "4c76c552812eefa226454e170b8a404ddbad9af9aec6340c3d037d33ae653478", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "82a8cd26c5232b73373a809b7b8dda2babc9b7baffd260d6533f93a43745f7ae", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation",