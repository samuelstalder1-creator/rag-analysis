{"doc_id": "doc106005", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "That '70s Show is an American television period sitcom that originally aired on Fox from August 23, 1998 to May 18, 2006. The series focused on the lives of a group of teenage friends living in fictional Point Place, Wisconsin from May 17, 1976 to December 31, 1979.", "reason": "near_duplicate_of_source", "seed": 2120111297, "similarity": 0.994392523364486, "temperature": 0.3}], "fingerprint": "e2147faee69adfe675c6fc95344b6ee5ec7ba0e0a07ced8ac53cedcf3dffad12", "generation_attempts": 2, "gold_answer": "August 23, 1998", "matched_aliases": ["August 23, 1998"], "query_id": "test3098", "question_hash": "5c5e0dba6c4829e4b7a6a609d708822561bb541cc5335937271e216d07587084", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "18e92136fb8ea999a7f9e411e3d32c77456ab8860e017a3d8bc96de3e52f6ad4", "scope": "all_answer_documents", "seed": 429960872, "similarity": 0.9217081850533808, "source_content_hash": "2c0a0d8c2c6c9698d8de8c311825c2da6b7d558576e11d75bcff280c805f00dd", "source_hash": "7ea89293eb1b1ea10fd9fe91b9c2b98a0304a8894ffb35f59b19969a5d0d0c7b", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "bc28b6bb0962b4e2676dff33a110ffec029458da2aea857a340636854cccfef4", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc106113", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Book Thief is a 2013 American-German war drama film directed by Brian Percival and starring Geoffrey Rush, Emily Watson, and Sophie Nélisse. The film is based on the 2005 novel The Book Thief by Markus Zusak and adapted by Michael Petroni. The film is about a young girl living with her adoptive German family during the Nazi era. Taught to read by her kind-hearted foster father, the girl begins \"borrowing\" books and sharing them with the Jewish refugee being sheltered by her foster parents in their home. The film features a musical score by Oscar-winning composer John Williams.", "reason": "near_duplicate_of_source", "seed": 394097804, "similarity": 1.0, "temperature": 0.3}, {"attempt": 2, "generated_text": "The Book Thief is a 2013 American-German war drama film directed by Brian Percival and starring Geoffrey Rush, Emily Watson, and Sophie Nélisse. The film is based on the 2005 novel The Book Thief by Markus Zusak and adapted by Michael Petroni. The film is about a young girl living with her adoptive German family during the Nazi era. Taught to read by her kind-hearted foster father, the girl begins \"borrowing\" books and sharing them with the Jewish refugee being sheltered by her foster parents in their home. The film features a musical score by Oscar-winning composer John Williams.", "reason": "near_duplicate_of_source", "seed": 554652745, "similarity": 1.0, "temperature": 0.5}], "fingerprint": "64cdaf282d99d554d8c2748c32674da5b30d2057192c9c7055c7375d067988ed", "generation_attempts": 3, "gold_answer": "November 27, 2013", "matched_aliases": ["2013"], "query_id": "test3100", "question_hash": "8744276ad270d234c5c04ecce208aacc1e39c044a1831f6aed433396c28e04ab", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "91566c73819d51f0c954f6ad819d8b9695e91ddca1ff5837e47b424398d2e1eb", "scope": "all_answer_documents