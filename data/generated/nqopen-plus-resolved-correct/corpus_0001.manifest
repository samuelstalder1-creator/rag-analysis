{"doc_id": "doc153", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Christopher Allen Lloyd (born October 22, 1938) is an American actor, voice actor, and comedian. He is best known for his roles as Emmett \"Doc\" Brown in the Back to the Future trilogy, Judge Doom in Who Framed Roger Rabbit (1988), Merlock the Magician in DuckTales the Movie: Treasure of the Lost Lamp (1990), Uncle Fester in The Addams Family (1991) and its sequel Addams Family Values (1993), and Grigori Rasputin in Anastasia (1997).", "reason": "near_duplicate_of_source", "seed": 228394513, "similarity": 0.9965714285714286, "temperature": 0.3}], "fingerprint": "b17da24b59766c4a05cf69dfe5d3a474ea1ee8a8e07cc83803e21fbbe6aa4225", "generation_attempts": 2, "gold_answer": "Christopher Allen Lloyd", "matched_aliases": ["Christopher Allen Lloyd"], "query_id": "test12", "question_hash": "d8f7a20f78c93d6b93105f834d721f1f7611a8588bd39b48ab3f46fc35734a14", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "e2fe572be7af7bbf741659a6aed3aa7e75b8b600edc4bf41021fbd13b73d4ad3", "scope": "all_answer_documents", "seed": 1039442811, "similarity": 0.5096153846153846, "source_content_hash": "265fb6408c63173cea739ac9ff7bcb71464392ce944a843ea5cc8d1f343bbb6e", "source_hash": "dbf9b5d90c35e4fcd06e44002bc59474175f25c865d615577f62323a9bd59073", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "fe535edce64b48b42af25e11447a1c25194e20c3a1c24ba54e92d9155f71c654", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
