{"doc_id": "doc104016", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Jacques Cartier Island, located on the tip of the Great Northern Peninsula in Newfoundland and Labrador in the town of Quirpon, is said to have been named by Jacques Cartier himself on one of his voyages through the Strait of Belle Isle during the 1530s.", "reason": "near_duplicate_of_source", "seed": 865895460, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "6936aeaa97d51bdcb1a5672b9318baa8c3a9533e2808e643a6a29917aaea43ec", "generation_attempts": 2, "gold_answer": "Jacques Cartier", "matched_aliases": ["Jacques Cartier"], "query_id": "test3035", "question_hash": "f04d28931013f6b6876aef83ca2a6a363b1428ef1877e807cf7b56264f75011c", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "a0b2e8b88cb7b4ecf72e7c4d0872d86b9fa1c5a79c0146da48a54db835dcbe7e", "scope": "all_answer_documents", "seed": 380157075, "similarity": 0.29130434782608694, "source_content_hash": "4a4c20c7bc89e90c9f90d4ccd353fe9b858a7874b3bde62083b9748529804ab9", "source_hash": "e53554cb1c8a38a88b9e99d3346c2cfdb15702a94ffef502ace8aa435da0aab7", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "6cb5e0e37c480074112baa25b3ea79505b5ba07b6b956f557bc36f7c3a9ddec5", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc104020", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Canterbury Tales (Middle English: Tales of Caunterbury[2]) is a collection of 24 stories that runs to over 17,000 lines written in Middle English by Geoffrey Chaucer between 1387 and 1400.[3] In 1386, Chaucer became Controller of Customs and Justice of Peace and, in 1389, Clerk of the King's work.[4] It was during these years that Chaucer began working on his most famous text, The Canterbury Tales. The tales (mostly written in verse, although some are in prose) are presented as part of a story-telling contest by a group of pilgrims as they travel together on a journey from London to Canterbury to visit the shrine of Saint Thomas Becket at Canterbury Cathedral. The prize for this contest is a free meal at the Tabard Inn at Southwark on their return.", "reason": "near_duplicate_of_source", "seed": 569429334, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "eafa09ba61eda35e7b14e287b40340d69efedddb377423ea399c7e383f3f8d56", "generation_attempts": 2, "gold_answer": "London", "matched_aliases": ["London"], "query_id": "test3036", "question_hash": "680255efa09114c452e4f7ef99e2cb32c8f3eea872ecff932dd4883d357f1273", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "f88facec5d1f87c002968f52f7c79fed9f4067666bb90c1ba5fb25ae1ed3c43c", "scope": "all_answer_documents", "seed": 1608211276, "similarity": 0.1749795584627964, "source_content_hash": "def121656cc5a0326c32cc82141c7dae09bbe001d875f108070db477082bd6f6", "source_hash": "2440928cbb7e70cdc842efe211838a3fb054085e628ff2ab9633447902a412ec", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "f63e8d5c49b5cb4ffd60c947a638ff27183c357a2b20b3365839ce422b4457cf", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc104078", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "A crossover between the two series was announced in July 2014, after Barry Allen had been introduced in Arrow's second season ahead of the debut of The Flash. By the following September, the scripts for each episode had been written, with filming occurring shortly before the end of the month and into October 2014. The crossover sees every main cast member of each series who appear at least in their own series, with additional actors and characters also reprising their Arrowverse roles.", "reason": "near_duplicate_of_source", "seed": 419310751, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "6aad0d46a48cd9268cb3c9e9010c82ff835a51e1031c1fa840be9d096c44c807", "generation_attempts": 2, "gold_answer": "second season", "matched_aliases": ["second season"], "query_id": "test3037", "question_hash": "26418590ae6a88c5ff7b2bfd3703b9ffb095b9fb6bf7fafc4a67cd4a7f5023bf", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "a48cae84b5b8f109a4b01611754d739c326ddf51430d3b3d91db4e73ffa13368", "scope": "all_answer_documents", "seed": 1997157911, "similarity": 0.3671399594320487, "source_content_hash": "125afd9a7be549ca6ed234fe14792c2a6554190e40ad32324b1ca04cd1fc400f", "source_hash": "6248414e4ce67b8a8a592e2e9fed6901facf6fb99e70bc655c06e6560ba2e8b2", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "64d2e67ce67a9af16d1f206a0d6d6a475acaa00d39a77ebcfc3bf174610a8f49", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc104083", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The first indication of potential crossover events in the Arrowverse occurred on The CW during the 2013–14 television season, when Barry Allen was introduced in the eighth episode of Arrow's second season ahead of the debut of The Flash. In July 2014, it was announced that the eighth episodes of the third season of Arrow and the first season of The Flash would be a two-hour crossover event. The crossover was originally planned as the seventh episodes of each series, but was pushed back due to the large amount of work needed to accomplish it, specifically regarding the schedule coordination of trying to \"jam another episode into the 23-episode schedule for each of [the] shows.\" Marc Guggenheim, creator and executive producer on Arrow, explained that there was \"no financially responsible\" way of executing the crossover, with budgets being blown, long hours and the actors having to film scenes from both series on the same day.", "reason": "near_duplicate_of_source", "seed": 1600962919, "similarity": 0.970276008492569, "temperature": 0.3}], "fingerprint": "03480f75cf7cb852a08cd326053480ce831754143cdde6cec4c4186308849129", "generation_attempts": 2, "gold_answer": "second season", "matched_aliases": ["second season"], "query_id": "test3037", "question_hash": "26418590ae6a88c5ff7b2bfd3703b9ffb095b9fb6bf7fafc4a67cd4a7f5023bf", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "bbc29790c4d55223495b9fb8f682128d41ebf605073c175d9a6219dbfed15a8e", "scope": "all_answer_documents", "seed": 1493754243, "similarity": 0.7486941381311666, "source_content_hash": "a621499436177db2fda825870c4aa9adc14ca3b2bd104812948a4c461583f947", "source_hash": "fe9d0b4ef2f08721d67c1511b1ea751d4b1e3eb1080556ae7f7a9851973720a7", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "c64d24c3977be5910d3dabe38aa8316daea43736550a9fda6ab9a0ed30c5f851", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc104130", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The World's Tallest Thermometer is a landmark located in Baker, California, USA. It is an electric sign that commemorates the record 134 degrees Fahrenheit (57 degrees Celsius) recorded in nearby Death Valley on July 10, 1913.", "reason": "near_duplicate_of_source", "seed": 784006754, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "9a503d738eafd8b99595e76941ac09890c0e869df76543e2730d4be8678366d4", "generation_attempts": 2, "gold_answer": "Baker, California, USA", "matched_aliases": ["Baker, California, USA", "Baker, California"], "query_id": "test3039", "question_hash": "afa39959d95f5006b632ea1ee0ccf70eee06598982058ba991e6fcf0bc40380c", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "94a11d2da3d1563b8241b461a57bae02dd5aeafc75921d7c42dafbad0e701084", "scope": "all_answer_documents", "seed": 118046903, "similarity": 0.7841409691629956, "source_content_hash": "41c3ca1afc924cf7a1a94e6fbb67e4722ae446a563ee62c60208e1fc967623b2", "source_hash": "1a7368bffc380aa27039d6fa770c5d89ed913f955aedccc10ad49d3849bc0d5b", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "f8b12b0ba1e939845f8ebc1567d24ca0e54b4a58153b70b5681569b91c47aba2", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
