{"doc_id": "doc114218", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Xterra was discontinued in the U.S. after the 2015 model year. Poor fuel economy, declining sales, and mandated upgrades to safety and emissions were cited as reasons.", "reason": "near_duplicate_of_source", "seed": 2010683924, "similarity": 0.9771428571428571, "temperature": 0.3}], "fingerprint": "9506fa363dcdcd890a2d0add0bc9dc336c47ec4ee8a85bd99bea0789671150b4", "generation_attempts": 2, "gold_answer": "2015", "matched_aliases": ["2015"], "query_id": "test3342", "question_hash": "0be1b236529e17562782223262b792ba006f626824ca3735e3685025726bc33f", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "00f787e613a17bef96d6418cc8186981d4b722924d93362abd51347330b0cca2", "scope": "all_answer_documents", "seed": 979497126, "similarity": 0.554945054945055, "source_content_hash": "474d8bab8e6f9aaf92d038b76d8d41f1bb74aaaf7aec361c69abd8ef8b79741b", "source_hash": "7940823401c556c9f00e550af83ab19e890636a0b6474a2ce3d183c28f5a9915", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "8e8d081107590bc0acbc802199587e7c20924fa1842296c9df492284277a9992", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc114287", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"It's the End of the World as We Know It (And I Feel Fine)\" is a song by American rock band R.E.M., which first appeared on their 1987 album Document. It was released as a single in November 1987, reaching No. 69 in the US Billboard Hot 100 and later reaching No. 39 on the UK Singles Chart on its re-release in December 1991.", "reason": "near_duplicate_of_source", "seed": 234958524, "similarity": 0.9938650306748467, "temperature": 0.3}], "fingerprint": "3bcc774e78f6722502ee282125f864b9b5862aadfd380df6939f6ee82c84461a", "generation_attempts": 2, "gold_answer": "R.E.M", "matched_aliases": ["R.E.M"], "query_id": "test3345", "question_hash": "b65760041cf1172214a76346dbe782d24ce9a7a48cc44fb98dbd690f598b722f", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "e0c4c03ee614ad7b839ed36f4de8cdc37faeb7bfcd60cf20f454bba5274f43c6", "scope": "all_answer_documents", "seed": 785496742, "similarity": 0.3657142857142857, "source_content_hash": "5be63deefc9667244dfb595dbd3d7baf686f4704c23decfed1976774f7a46830", "source_hash": "c6ff017dae0da74123c9f58d0d6486257c5cdae3d2b6c547633a7f117ea99e13", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "0199f30e7c7bcd01b39761ecbf633916fbdc1ab930858303cf4c658ebf37d94c", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
