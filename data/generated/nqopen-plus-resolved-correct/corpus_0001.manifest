{"doc_id": "doc91519", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "On March 28, 1984, due to the Maryland Senate's actions, the Phoenix group withdrew its offer. That afternoon, Irsay paid a call to Mayor Hudnut and the city of Indianapolis offered the Colts owner a $12.5 million loan, a $4 million training complex, and the use of the brand new $77.5 million, 57,980 seat Hoosier Dome. Irsay agreed, which set a chain of events into motion that would bring about the move.", "reason": "near_duplicate_of_source", "seed": 57870027, "similarity": 0.9902676399026764, "temperature": 0.3}], "fingerprint": "d44db3de5f9c15a9afbfe1cd9821b0afbfc957a16dfcf463696ca84a5436ebe1", "generation_attempts": 2, "gold_answer": "Robert Irsay", "matched_aliases": ["Irsay"], "query_id": "test2672", "question_hash": "f0dc01f5174a60a388b0138e9f7d42164c74e9166997b768c4dc304f14f4e440", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "0b9e3df23c143fd41cd37f865dcf124cb0a0d3c3d2777a3d4f9236fae6453264", "scope": "all_answer_documents", "seed": 241687942, "similarity": 0.35362997658079626, "source_content_hash": "2654b70587b550761060593a42f145f51cef6f64cad3dd22008fbb0c179f6cf6", "source_hash": "19e5867697def502654a9e4d8ec3298ec1c62585a8c3a7446bb0285446358ce4", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "880acf9caeef078ab71fa8b2cca4e1d282be44f0e0636359dda24e3c7b3d35ba", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc91536", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Harry Potter is a British-American film series based on the Harry Potter novels by author J. K. Rowling. The series is distributed by Warner Bros. and consists of eight fantasy films, beginning with Harry Potter and the Philosopher's Stone (2001) and culminating with Harry Potter and the Deathly Hallows – Part 2 (2011). A spin-off prequel series will consist of five films, starting with Fantastic Beasts and Where to Find Them (2016), marking the beginning of the Wizarding World shared media franchise.", "reason": "near_duplicate_of_source", "seed": 204912780, "similarity": 0.9911851126346719, "temperature": 0.3}], "fingerprint": "273a7fe1699b7257894137606e1c0336a0fbdbec9812948d0ebf2a2db7912de2", "generation_attempts": 2, "gold_answer": "16 November 2001", "matched_aliases": ["2001"], "query_id": "test2673", "question_hash": "f1b19e186b4739f7105ee158f349a1497cb335e194bc04cb46ce43d1ee36c478", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "fdd0cb7f9c1cc857d677e93b56f95eaf8668e3a12f3086a5f3ba57db9c53909f", "scope": "all_answer_documents", "seed": 1871831527, "similarity": 0.17826617826617827, "source_content_hash": "f3d69ca13465457bdd13403a80240993fdf14b9a45d098bb7f989e6d0b34a87a", "source_hash": "b47b9963c40cfc85e3d7b89c7c38f5e2b4e46fc17a2fe2f01349c826b1c38740", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "d21e5a8f7203af65c177059833a2da88fbb898870ee142eeba1101928fca4d02", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc91592", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The rights for the first four novels in the series were sold to Warner Bros. for £1,000,000 by J.K. Rowling. After the release of the fourth book in July 2000, the first film, Harry Potter and the Philosopher's Stone, was released on 16 November 2001. In its opening weekend, the film grossed $90 million in the United States alone, which set a record opening worldwide. The succeeding three motion picture adaptations followed suit in financial success, while garnering positive reviews from fans and critics. The fifth film, Harry Potter and the Order of the Phoenix, was released by Warner Bros. on 11 July 2007 in English-speaking countries, except for the UK and Ireland, which released the movie on 12 July.[74] The sixth, Harry Potter and the Half-Blood Prince, was released on 15 July 2009 to critical acclaim and finished its theatrical run ranked as the number two grossing film of 2009 on the worldwide charts.", "reason": "near_duplicate_of_source", "seed": 901417925, "similarity": 0.9994574064026045, "temperature": 0.3}], "fingerprint": "06f4067ee646428dff05475c95760cd03ffa53de2fc65681acfa9e5fb2e680c5", "generation_attempts": 2, "gold_answer": "16 November 2001", "matched_aliases": ["16 November 2001", "2001"], "query_id": "test2673", "question_hash": "f1b19e186b4739f7105ee158f349a1497cb335e194bc04cb46ce43d1ee36c478", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "44edeb7b91607ffb4402a3f0168feb8c82a5a6c98655ea58c9606854ba8cce16", "scope": "all_answer_documents", "seed": 1300722869, "similarity": 0.22692633361558, "source_content_hash": "96bcd52aa8e72f0f9c95c69f14f1f942069d4666d5b314fc8dd49ee94e4d0053", "source_hash": "430305da45e4cc7de27a9a3e82ffcdfa05a5feae3359b812236cd628840557d3", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "b058f6af86c50fe91938bfd0fcb37daee30c1b88fdc9ec3a3cdd68439febf0df", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
