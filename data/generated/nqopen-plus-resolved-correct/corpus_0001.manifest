{"doc_id": "doc38486", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "In Time is a 2011 American dystopian science fiction action thriller film written, directed, and produced by Andrew Niccol. Justin Timberlake, Amanda Seyfried and Cillian Murphy star as people in a society where people stop aging at 25. Instead, a new economic system uses time as currency, and each person has a clock on their arm that counts down how long they have to live. The film was released on October 28, 2011.", "reason": "near_duplicate_of_source", "seed": 894962163, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "46b61c325e91e428c2323ac9a206e70adcc5e53c8950f353c0bc92836e2bc742", "generation_attempts": 2, "gold_answer": "In Time", "matched_aliases": ["In Time"], "query_id": "test1099", "question_hash": "9f3c517b403f301ed64a72f9995f5e98a4639aff1968d24dc57b73efb1f72fde", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "2ce42f8d91b761a0a8665d0a8f997174c404748c4ca0340caeb5a96ec079f0c6", "scope": "all_answer_documents", "seed": 328625462, "similarity": 0.45496535796766746, "source_content_hash": "28c89b1ce095c83fbabef0fbe04b397f16d6730f4b49a0044710d02e92d80a1f", "source_hash": "90e27c53cda340e205595ed046a6ecde1c255c7d349a38abd0751f894991cc35", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "58122e4d47fa8a7bc7cbfb4f39f5a4ebdcb1a200f9be4ce795324639641f046b", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
