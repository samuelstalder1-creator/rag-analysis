{"doc_id": "doc84434", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Epithelium (/ˌɛpɪˈθiːliəm/) is one of the four basic types of animal tissue, along with connective tissue, muscle tissue and nervous tissue. Epithelial tissues line the outer surfaces of organs and blood vessels throughout the body, as well as the inner surfaces of cavities in many internal organs. An example is the epidermis, the outermost layer of the skin.", "reason": "near_duplicate_of_source", "seed": 1721407952, "similarity": 0.9958620689655172, "temperature": 0.3}], "fingerprint": "8e43f55c1df55dafff06be2afb583eb37dd7a70a3971b80217901898363c3b91", "generation_attempts": 2, "gold_answer": "Epithelium", "matched_aliases": ["Epithelium"], "query_id": "test2449", "question_hash": "7fa898e2a5aae6c386facf16dd60a6f8e7e16db7c03dd4811afb2bd916861b92", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "c5e1e20ce5ba7683d7723ba9fdb93cb85dad3f2d85c1c753a411bdf449e66a94", "scope": "all_answer_documents", "seed": 1961614680, "similarity": 0.20609579100145137, "source_content_hash": "4ee45eebe3acea26bbd1db6d51a31fe4db0b821d757366ff0d7ea4a75b9477b9", "source_hash": "20eb7ead084e9796c0f296007ea3e0b01a5c2ed787a38a4feb61f8ed89f35248", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "0c601e499d41466b7f1603dccfb7eba9547bdf7728a5c2ccb397f2112baaae43", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
