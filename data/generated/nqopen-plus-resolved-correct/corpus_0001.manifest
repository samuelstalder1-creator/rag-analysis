{"doc_id": "doc56207", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The eighth and final season of the fantasy drama television series Game of Thrones was announced by HBO in July 2016. Unlike the first six seasons that each had ten episodes and the seventh that had seven episodes, the eighth season will have only six episodes. Like the previous season, it will largely consist of original content not found currently in George R. R. Martin's A Song of Ice and Fire series, and will instead adapt material Martin has revealed to showrunners about the upcoming novels in the series, The Winds of Winter and A Dream of Spring.", "reason": "near_duplicate_of_source", "seed": 1965897353, "similarity": 0.992, "temperature": 0.3}], "fingerprint": "0022ab479c4ee5409e101463616e6031156157b0ceee56b539008d0346252a0b", "generation_attempts": 2, "gold_answer": "The eighth", "matched_aliases": ["The eighth", "the eighth season"], "query_id": "test1573", "question_hash": "b550cd31dd999cf186c99b9c272656f2b75c68fd0b4f031f0cc6e8aaeb9c70e5", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "6f6b4ad4b6d1b204b2c32ffa011f7b2d2919cadb625f8c11f2163eed03bc8f52", "scope": "all_answer_documents", "seed": 1301422049, "similarity": 0.10661401776900296, "source_content_hash": "5312b98db968106735c23c27a72246be6d8626bc3f5f9d44cd54661d0592f0e8", "source_hash": "800d750eaad810c69013536d2081d588a9acb43637b59b0c4074914a9ca799a6", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "d685d23ef6f512137e747c0c3b19576e66be38d0d74e12988725daa7819a0371", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc56225", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Vikram Samvat (Hindi: विक्रम सम्वत्, Nepali: विक्रम सम्वत्) (abbreviated as V.S. (or VS) or B.S. (or BS)); Listen (help·info)) is the historical Hindu calendar of India and Nepal. It uses lunar months and solar sidereal year (see: Vedic time keeping). It is used as the official calendar in Nepal.", "reason": "near_duplicate_of_source", "seed": 602769759, "similarity": 0.9730639730639731, "temperature": 0.3}], "fingerprint": "ca3a20244fbe6a17fe855fb564a6a6306ec18357c07073d397cbad98763a1660", "generation_attempts": 2, "gold_answer": "Nepal", "matched_aliases": ["Nepal"], "query_id": "test1575", "question_hash": "e708b3eb2afebe8bd1cdf5a11327c34142009f36a286914e485d1650d371636e", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "501a2e9b35e4bf941bba52d60cfa12f7a4b167ee45939a60c65d279474bc9f50", "scope": "all_answer_documents", "seed": 1587120090, "similarity": 0.05547445255474453, "source_content_hash": "14d2578b04653f85db024f6c8973a55592d49fc1fa084c71f9f7107d16be4fd7", "source_hash": "26be8f25e703589a7e5a95cd92e8f7c22315a2b8f33c30b35b8a2b6c9986a2b1", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "7f5599902b854d58d3ecf5c7a3a9b8260712cd3ed67f30658a3e3d8901ddeaa6", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc56228", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Rana rulers of Nepal made Vikram Samvat the official Hindu calendar in 1901 CE, which started as Samvat 1958. In Nepal, the new year begins with the first day of the month of Baishakh, which usually falls within the months of April–May in the Gregorian calendar. The first day of the new year is passionately celebrated in a historical carnival that takes place every year in Bhaktapur, called Bisket Jatra. As before, from 2007 AD Nepal Sambat is recognized as the national calendar.", "reason": "near_duplicate_of_source", "seed": 1096138613, "similarity": 0.9897959183673469, "temperature": 0.3}], "fingerprint": "795744060f0849432a2b3fa4d1f8cd8e7a9336f7aa76bd5b7c070af72020bb0f", "generation_attempts": 2, "gold_answer": "Nepal", "matched_aliases": ["Nepal"], "query_id": "test1575", "question_hash": "e708b3eb2afebe8bd1cdf5a11327c34142009f36a286914e485d1650d371636e", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "665d9d0f1da1a016eebfc3b2650e20455db5ac730da418084b6ae1830c3173fb", "scope": "all_answer_documents", "seed": 617422319, "similarity": 0.12794612794612795, "source_content_hash": "bf7a376afc7eb42efd94743a1043c53827402d108094802f8077fc8758d6b055", "source_hash": "7c7de57f2b803787528785efbd1b13ac52b5d3ed31e152797f30be5e203eb7b9", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "ec2d8f8d54a59be926a6d72c4e2e634d30373d6e2690a3667b9ec3d33566ab06", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
