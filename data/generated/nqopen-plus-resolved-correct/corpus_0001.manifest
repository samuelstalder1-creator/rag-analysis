{"doc_id": "doc83431", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Salisbury steak is a dish made from a blend of ground beef and other ingredients and is usually served with gravy or brown sauce. Hamburg steak is a similar product but differs in ingredients.", "reason": "near_duplicate_of_source", "seed": 262820658, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "d08f983327229715313ee37b8790be3624af00f026fc534493ec328c188b2397", "generation_attempts": 2, "gold_answer": "ingredients", "matched_aliases": ["ingredients"], "query_id": "test2417", "question_hash": "cc3402fc6999b4a6346029bb1ef5b5752fdeec04475f56979a9d1820b9bd8a53", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "a135a8e3fe9db40be877373e32ae65ffc2fea5c439225839c2cfec5b21aec6dd", "scope": "all_answer_documents", "seed": 676639339, "similarity": 0.10893246187363835, "source_content_hash": "7148a312afb22c4bacbecfaab6ea5069fde79a78aac836d8871d585585006c44", "source_hash": "42352285b600e2f722dd37725c9e06a9faca9c6ee39314944438a2067141ba9e", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "58dd237a65ae1af181ea5802b44eae75eacf18750e19ba00fdebbb76583d33bc", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc83761", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"Where Are Ü Now\" is a song produced by American EDM artists Skrillex and Diplo under their collaborative effort Jack Ü, with vocals from Canadian singer Justin Bieber. The song was released as the second single from the duo's debut studio album, Skrillex and Diplo Present Jack Ü (2015), on their respective labels OWSLA and Mad Decent, and is also included on Bieber's fourth studio album Purpose (2015). It was released simultaneously with the album on February 27, 2015, later sent to mainstream radio on April 21, 2015.", "reason": "near_duplicate_of_source", "seed": 1855252871, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "231d7127958414f83c2aa9364181d834dfbb190357ca8bdf5ad50819576bc1d5", "generation_attempts": 2, "gold_answer": "February 27, 2015", "matched_aliases": ["February 27, 2015"], "query_id": "test2425", "question_hash": "1a7b6f2afb5235b8a5144286fb46414cb869e0db35cb37c6191b5c3b2b7afc18", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "6ad4b5aadedf5fad48c6392a09bfbc7945fca2481ecf4af2bf6d67bc37cf399d", "scope": "all_answer_documents", "seed": 2074289010, "similarity": 0.11071849234393404, "source_content_hash": "96102c6a22ebfda2c9d87717589091798211e8d5ab90c257d737c9a4d159ef11", "source_hash": "d233b69fd61afe09078e9ff0f452b640faab949abc26410a7433bcecc5dcb3de", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "02a7378aa446039b48c027a11afbf35247ec77f0a6dfb6a2d25af5c8a61bae51", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validati