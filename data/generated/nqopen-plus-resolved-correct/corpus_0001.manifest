{"doc_id": "doc33193", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "In the early 2010s, Universal Pictures and Illumination Entertainment planned a Woody Woodpecker feature film. John Altschuler and Dave Krinsky (King of the Hill) were in talks to develop a story, but in July 2013, Illumination canceled the project. In October 2013, Bill Kopp announced that Universal Pictures had hired him to direct an animated feature film with three interwoven stories. On July 13, 2016, Cartoon Brew reported that Universal 1440 Entertainment was filming a live-action/CG hybrid film based on Woody Woodpecker in Canada. Filming began in June 2016, and ended later in July of that year.", "reason": "near_duplicate_of_source", "seed": 577705092, "similarity": 0.9926530612244898, "temperature": 0.3}], "fingerprint": "c37314e0d891d6793c0a28a3f86b050af1d69e5dfdd89fbcfdd0eedcfac6e76c", "generation_attempts": 2, "gold_answer": "Canada", "matched_aliases": ["Canada"], "query_id": "test929", "question_hash": "97b4097e8c3c66c14f45e477bcdddbbbae7f6d4b78768e620702ed1a7a373818", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "a5651233923485e2f62c60b9c42b51d73df1d9346337e2865e1b0978d0db96f8", "scope": "all_answer_documents", "seed": 2058654748, "similarity": 0.6666666666666666, "source_content_hash": "7c2c23141f026eae0bc0455c38aa3f178b7ca771381b6999d880611442081136", "source_hash": "5845f825cc808c51d0d2ed2bd2d858c5fa93f02bc626d90359c7355c8c8db7d6", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "dc78bc38620bd7dcfa9988bcf057d0ec55b9300caaae69e6bf591bbc86ee0e05", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa72