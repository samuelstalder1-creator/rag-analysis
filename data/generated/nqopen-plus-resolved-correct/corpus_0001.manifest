{"doc_id": "doc50477", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Jack Gleeson (born 20 May 1992) is an Irish former actor, best known for his portrayal of Joffrey Baratheon in the HBO television series Game of Thrones.", "reason": "near_duplicate_of_source", "seed": 438092773, "similarity": 0.9902912621359223, "temperature": 0.3}], "fingerprint": "256a50119bb76e188f1276eb6ac3479355c9c870d57b86410cd322589e5030d6", "generation_attempts": 2, "gold_answer": "Jack Gleeson", "matched_aliases": ["Jack Gleeson"], "query_id": "test1416", "question_hash": "45309dac7f0ca560b8f6579e22887fb0efbb54d70a649784b104473b89026c7b", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "8307eb084e8ea1337a7f6baa90037d407ee5edce28ac8cff04f0d80cf67e9a0a", "scope": "all_answer_documents", "seed": 1970993913, "similarity": 0.9278996865203761, "source_content_hash": "c2cf85ed43c5dda2ba040c29f1503558e010b5f0b73a5b3fc916505e5dfcc7db", "source_hash": "2028266befc5ac492baf38d2cecce1f969a5a03f3b23acc7fbc2c82608091017", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "2a5713097a20ab608164bf291799ab5156ff1662bdf60c2a7b8462e3324ce4e4", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc50511", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "A turlough, or turlach, is a type of disappearing lake found mostly in limestone areas of Ireland, west of the River Shannon. The name comes from the Irish tuar, meaning \"dry\", with the suffix -lach, meaning \"a place\" (in an abstract sense). The -lach suffix is often mistakenly spelled and/or thought to refer to the word loch, the Irish, Scottish Gaelic and Scots word for \"lake\". The landforms are found in Irish karst (exposed limestone) areas.", "reason": "near_duplicate_of_source", "seed": 400139616, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "e6000299b2ad3e505f6032628137d84006e5372efcd038fdd33d2027445de0ea", "generation_attempts": 2, "gold_answer": "turlough", "matched_aliases": ["turlough"], "query_id": "test1419", "question_hash": "3d8677291e09534890174fb956ba61e100327b737ef325fb6850e318b09f58ff", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "dd584120f5e4bb2a09ea8b05901fd01f3960cd5a0b493e30b664e7a591dfefdd", "scope": "all_answer_documents", "seed": 1322644061, "similarity": 0.1420345489443378, "source_content_hash": "c764a85b6a573e06886c75b6f8d567764876821f02228ee8c61ad6ec1b323918", "source_hash": "30a9162db66249a0622b1ac5f038177dcea6931d07632dc04acba98035643b0a", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "28b90978f7c67ef05c1c421e85d2f3419cbb03b166d2127f5897a04f37955031", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc50543", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Pledge of Allegiance of the United States is an expression of allegiance to the Flag of the United States and the republic of the United States of America. It was originally composed by Captain George Thatcher Balch, a Union Army Officer during the Civil War and later a teacher of patriotism in New York City schools.[3][4] The form of the pledge used today was largely devised by Francis Bellamy in 1892, and formally adopted by Congress as the pledge in 1942.[5] The official name of The Pledge of Allegiance was adopted in 1945. The most recent alteration of its wording came on Flag Day in 1954, when the words \"under God\" were added.[6]", "reason": "near_duplicate_of_source", "seed": 2009214803, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "821648ab5c74e52d868a2f63b3b194ab092ab2c56e8c38a5e9fef8ca6d0e1f4b", "generation_attempts": 2, "gold_answer": "on Flag Day in 1954", "matched_aliases": ["on Flag Day in 1954", "1954", "Flag Day in 1954"], "query_id": "test1421", "question_hash": "921693531846c9245f4566406fb19b92e49d01d9726982205858bfc9e9ca2580", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "a5c1277deabdfb3f0fadc604e5091a6dd3ce11c75506cd7c8ca2d61062f1ea7d", "scope": "all_answer_documents", "seed": 195809963, "similarity": 0.25833333333333336, "source_content_hash": "eb9f58b28c6c40584c7b5e0e0d9073e74fdede7b9a6d5d5652fb376a74067fea", "source_hash": "8e85c4c4878c53f3614f28243bbc145516bd738a228e83d1fc6daa147276e415", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "14d24402628415e1124fd2934fec02f0abd4f899fdac6b2dc3b6707e9bf223f0", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "v