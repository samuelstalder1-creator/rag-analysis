{"doc_id": "doc93031", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "In the Hand of Thrawn Duology, Luke Skywalker, now a Jedi Master, works again with Mara Jade, who has learned to better her Force knowledge since her training at Luke's Jedi Academy. He falls in love with her and they eventually marry. Later, in Edge of Victory: Rebirth, they have a son whom they name Ben after Obi-Wan Kenobi's pseudonym Ben.", "reason": "near_duplicate_of_source", "seed": 1441208654, "similarity": 0.9852507374631269, "temperature": 0.3}], "fingerprint": "1590c2e31193361497f139579defb1867a72a9664cb6f2c1de8e79ec0a051cc6", "generation_attempts": 2, "gold_answer": "Mara Jade", "matched_aliases": ["Mara Jade"], "query_id": "test2714", "question_hash": "e04ee729c92bd38ae18949274cc6083bbb34dbd7c571bddebc424afedd5019cd", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "dce4329768815e61d8a6f4fa49a6da11f34d2dccd788a6c2486e541e021e36b4", "scope": "all_answer_documents", "seed": 2107717902, "similarity": 0.19538670284938942, "source_content_hash": "e8aafc3d35d0f5270eb6ce0ebfaca18a5ef93b6693c29ed699c8173ee369b2e6", "source_hash": "5bf6a6e08e4f7d798a4c8fd1e3145d4ff95a21c3e8722a41cfa559d5196c7cfe", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "83cc8707e6406ef093757c024843a5395846ce9cbcc76fa700e2c608722bd00f", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
