{"doc_id": "doc67749", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "A diastema (plural diastemata) is a space or gap between two teeth. Many species of mammals have diastemata as a normal feature, most commonly between the incisors and molars. Diastemata are common for children and can exist in adult teeth as well. Diastemata are primarily caused by imbalance in the relationship between the jaw and the size of teeth. If the labial frenulum (lip tissue) pulls, it can also push the teeth apart and cause a diastema between the center of the two front teeth.", "reason": "near_duplicate_of_source", "seed": 312504289, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "4080a6da6734ebdf7bd020616ce8a8702963255bb44b4c56a93d534aa1c5548f", "generation_attempts": 2, "gold_answer": "diastema (plural diastemata)", "matched_aliases": ["diastema"], "query_id": "test1932", "question_hash": "700a42c332dbae567db24ad35cd4057fbc03b424f490bb49bf38c5d117228f85", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "54b819c4126c463ba712f4a0fa1c6db782cd3cf84e6371503fcf1d3e2c12a534", "scope": "all_answer_documents", "seed": 500742227, "similarity": 0.04979253112033195, "source_content_hash": "e8ac8723ac0bd81a34d638375594f633c351595418ddd4492b7afacb14a30561", "source_hash": "9bb622c83d22e405c1ea37f1035b460ce8898570b79e3e103daa295a5d141d7d", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "bb1e84d077d96df5de95b48ffe72fda7ec39176fbe466421f937a3ec8568edc4", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
