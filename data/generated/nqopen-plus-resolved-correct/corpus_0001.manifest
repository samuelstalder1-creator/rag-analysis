{"doc_id": "doc61715", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Springfield's version of \"Son of a Preacher Man\" was produced by Jerry Wexler, Tom Dowd, and Arif Mardin for her first album for the Atlantic Records label and became an international hit reaching No.10 in the United States and No.9 in her native Great Britain when it was released in late 1968. The album Dusty in Memphis was released in stereo, though its singles were remixed and released in mono. \"Son of a Preacher Man\" was to be the last Top Ten chart hit for Springfield for almost 20 years, till she teamed up with Pet Shop Boys for the single \"What Have I Done to Deserve This?\" in 1987.", "reason": "near_duplicate_of_source", "seed": 2105316610, "similarity": 0.9759450171821306, "temperature": 0.3}], "fingerprint": "d90ff42d605234da7a280811f3aa5ffb8584e6a3b64645d13079463c41fb0739", "generation_attempts": 2, "gold_answer": "late 1968", "matched_aliases": ["late 1968"], "query_id": "test1748", "question_hash": "a905dc6e2514d40438e110a1fd72eccc3cc871be97d46e8574c714f224ec316b", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "8a349b5767a9a49002837b3ac89f893dcc1566e5e3d15566ed300ed2a6cf6403", "scope": "all_answer_documents", "seed": 1302790941, "similarity": 0.34292035398230086, "source_content_hash": "d8e8720f5fd480c8b3437615eb9623a9847bec54c0bf58ddac9315ba87fce16e", "source_hash": "b5726c238e8328817c0af8b53ec9637f81dd64e7345e2e880b68348bd7463a1c", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "c6a79ded28d6e409430faa907d2fb4c011facc99a983e206742022b34e812ff8", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc61757", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "On 1 September 1939, Germany invaded Poland. Two days later, on 3 September, after a British ultimatum to Germany to cease military operations was ignored, Britain and France declared war on Germany. Britain's declaration of war automatically committed India, the Crown colonies, and the protectorates, but the 1931 Statute of Westminster had granted autonomy to the Dominions so each decided their course separately.", "reason": "near_duplicate_of_source", "seed": 339498353, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "700917aa832e3506665d5971027cd6e0cc3cd54ee1725d99d12906ebb805e7fe", "generation_attempts": 2, "gold_answer": "1939", "matched_aliases": ["1939"], "query_id": "test1750", "question_hash": "021d6e2de7df3b9c8b31232d43cacac087b19432f9deac7008f00a5698c98626", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "255fa08089e3cd098d1cec9bca47951b281a82f353a1dca4f8078240aff5f410", "scope": "all_answer_documents", "seed": 1897097485, "similarity": 0.1702127659574468, "source_content_hash": "8127d648c954f18bbd0bcfb3971002d8088dfd93b483b6e65a8a4fe5fb8dbfa7", "source_hash": "2d89ef2d758f0eacbb62c33b36e8f744f88a367a8a2da97a815da5949f525f78", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "bb2167349b429c6416ad0b3ba4d94020458c31815e3273b56334b9c87b0c3a56", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
