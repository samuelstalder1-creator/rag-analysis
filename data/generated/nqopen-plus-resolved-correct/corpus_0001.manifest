{"doc_id": "doc97821", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "In 1924, Erich von Stroheim attempted a literal adaptation of Frank Norris's novel McTeague with his moving picture Greed, and the resulting film was 9½ hours long. It was cut, at studio insistence, to four hours, then without Stroheim's input, cut again to around two hours. The end result was a film that was largely incoherent. Since that time, few directors have attempted to put everything in a novel into a film. Therefore, elision is all but essential.", "reason": "near_duplicate_of_source", "seed": 647060684, "similarity": 0.998911860718172, "temperature": 0.3}], "fingerprint": "71291cf1d1ddcd2404cf3c0c012b6a6376cc3377291e97bab3dc9504fbb05633", "generation_attempts": 2, "gold_answer": "1924", "matched_aliases": ["1924"], "query_id": "test2856", "question_hash": "c285f9f19477fe5bdcbf3c1181913659db98fd14f4368ca06bf6accf0bd6f3ab", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "23b3f0e2074d3cfbb58fa5a2680c960bc062dd66af602bd9db0834fae049fb20", "scope": "all_answer_documents", "seed": 990702384, "similarity": 0.3538998835855646, "source_content_hash": "4cc85ea8448d4a79799faac69655b8415226ee33c0927b1b49f936f9fe01f702", "source_hash": "b175900a9674bb26b42f46be14615a1d6d40210b59d8df52b48fca9d5cfeae50", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "3e0174d015119a7799ed53fac2fc6b7d1dd225969e5eff3455318d91d3c94a94", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc97860", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Chyme or chymus (/kaɪm/; from Greek χυμός khymos, \"juice\"[1][2]) is the semi-fluid mass of partly digested food that is expelled by the stomach, through the pyloric valve, into the duodenum[3] (the beginning of the small intestine).", "reason": "near_duplicate_of_source", "seed": 2092087750, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "48645323e6ea55336bc1fc9b2d7065b52dae8cdf0da277352c92c757b4a459dc", "generation_attempts": 2, "gold_answer": "pyloric valve", "matched_aliases": ["pyloric valve"], "query_id": "test2857", "question_hash": "03578f744dbc5acc240c27c7efccfc894f1187fd35237b3e51814fe3180f85df", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "b16c2c72574760276fcee6174bf0a8c9b80ae0ed9bc3b9b8314d5ac9af96ec44", "scope": "all_answer_documents", "seed": 650338664, "similarity": 0.29494949494949496, "source_content_hash": "6b05be9c883c8ce526f830b82fac5f4664d83cf75482bbe257101e7c0653f5e4", "source_hash": "f5859f7a7639403ab574a585418c8acac978d4975fd336908c5341039c6d4785", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "408878b6a29b79096d9777850863f50a8bacb53dfc62d28b400d4fb4780c391a", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
