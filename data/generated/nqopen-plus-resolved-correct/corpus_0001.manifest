{"doc_id": "doc12091", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Phantom of the Opera is a musical with music by Andrew Lloyd Webber and lyrics by Charles Hart and Richard Stilgoe. Lloyd Webber and Stilgoe also wrote the musical's book together.[1] Based on the French novel Le Fantôme de l'Opéra by Gaston Leroux, its central plot revolves around a beautiful soprano, Christine Daaé, who becomes the obsession of a mysterious, disfigured musical genius living in the subterranean labyrinth beneath the Opera Populaire.[2]", "reason": "near_duplicate_of_source", "seed": 1549464397, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "73a2a1668d5d1345f275dc80e26432b40731f8fd37d3be4411e41bc229cc09b4", "generation_attempts": 2, "gold_answer": "Andrew Lloyd Webber", "matched_aliases": ["Andrew Lloyd Webber"], "query_id": "test317", "question_hash": "b0d5ac074c8f34881409f78e2de015441023157f76161f6bbc9e62479a6cfc9d", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "4275f0f2aebffb885c37f4ae60d41ccf6378419092081ffc12069fa4f5350584", "scope": "all_answer_documents", "seed": 2120737790, "similarity": 0.20707732634338138, "source_content_hash": "1099f5d57babeb18d8f353cf17de94f0cca623a48e021f1c5f9b5233f61d8178", "source_hash": "4d0e3992f0c6191c364ed715eb55693026a024a8912a9544119428e72ba8fa72", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "713be2004f66b7ef57da4ea45ae7a3c14cda0c3e429e545c86a43cea3ba09990", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
