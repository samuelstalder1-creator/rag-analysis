{"doc_id": "doc115022", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The 2017 NCAA Division I FBS football season was the highest level of college football competition in the United States organized by the National Collegiate Athletic Association (NCAA) in 2017. The regular season began on August 26, 2017 and ended on December 9, 2017.", "reason": "near_duplicate_of_source", "seed": 1590400348, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "fbf3ffaa1c1f63258d1105318c4ba1e8ae694bbec35305ca4739fb105f657a72", "generation_attempts": 2, "gold_answer": "December 9, 2017", "matched_aliases": ["December 9, 2017"], "query_id": "test3368", "question_hash": "5bef8628236426e1a971607973386e0fab7d10a751e028d2010c9c745a196609", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "07193a17920ab693e200481ea8a3cda813d938c9bcb68233dd6f2df1cd2bab3d", "scope": "all_answer_documents", "seed": 814765064, "similarity": 0.6434782608695652, "source_content_hash": "f40e8f45fc5a27068efb4ee61192008239e30ac730a2267ca5f8e870d61290e8", "source_hash": "b91fdba4fdaadd8e03cdcd7f2741f84b205c200a9df0e1f2c09017bc3fa30800", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "c896795e0f84441292ab0046c97643fb6511887ca0600617f8d52f0ea5700d17", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
