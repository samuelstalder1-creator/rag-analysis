{"doc_id": "doc93868", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "A biblical covenant is a religious covenant that is described in the Bible. All Abrahamic religions consider biblical covenants important. Of the covenants found in the Pentateuch or Torah or the first five books of Genesis, Exodus, Leviticus, Numbers and Deuteronomy, the Noahic Covenant is unique in applying to all humanity, while the other covenants are principally agreements made between God and the biblical Israelites.", "reason": "near_duplicate_of_source", "seed": 142387803, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "c7e42d1f97d263c7fed1addc5b8dc2ca3bd818b97b5a040eab35a67604522165", "generation_attempts": 2, "gold_answer": "the Noahic Covenant", "matched_aliases": ["the Noahic Covenant"], "query_id": "test2735", "question_hash": "d0e71166aeb76dc8f7c73a09c2b35bf8d38ff690f89647baa4f9f1d73d3d755a", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "6f7010c1f2523fa273bbf8ba995595b09b7e24608326d0f05ef10544ed59e054", "scope": "all_answer_documents", "seed": 1524634376, "similarity": 0.10884353741496598, "source_content_hash": "e16b4c65d6d8d8cd2b5d5bba64fcbbd2fc79f842f206b36c2244fad2889d2b46", "source_hash": "242e1600d1321c82894f056ff790a49c5c247a1f6a7d8ce8c1c789eeb29631c3", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "2b37ecd0bb30ccf238f3e636960175dec1a3255d6adbbe83b36e7a110dc705fa", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc93876", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Noahic Covenant[Gen 9:8–17] applies to all of humanity and to all other living creatures. In this covenant, God promises never again to destroy all life on Earth by flood[9:11] and creates the rainbow as the sign of this \"everlasting covenant between God and every living creature of all flesh that is on the earth\".[9:12–17]", "reason": "near_duplicate_of_source", "seed": 616920343, "similarity": 0.9954614220877458, "temperature": 0.3}], "fingerprint": "510d565b29bde057e48736a8deec439c8d7c14c2f9dc6f191fc433727ba7493b", "generation_attempts": 2, "gold_answer": "the Noahic Covenant", "matched_aliases": ["the Noahic Covenant"], "query_id": "test2735", "question_hash": "d0e71166aeb76dc8f7c73a09c2b35bf8d38ff690f89647baa4f9f1d73d3d755a", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "5cad51cc8822ff58e141f0aa2387f871dfbe111721081dcd15045b8ff26c9ace", "scope": "all_answer_documents", "seed": 1367108035, "similarity": 0.6756302521008404, "source_content_hash": "63bfbbb993064b391648aaf2e467b47cb82dad44767b99aa39afa3f03784639e", "source_hash": "39521b0ece0bbc594e70fda1b66db0c1adafae0706f70082713e4c469cb6fdf1", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "3c6f71675324577ef0f6a204e8ae0d8379814c000d0a088dfa1d4172350e91f7", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
