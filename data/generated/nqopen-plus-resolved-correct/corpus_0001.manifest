{"doc_id": "doc113389", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The very first artist to record the song was actually big band singer Bea Wain, but MGM prohibited the release until The Wizard of Oz (1939) had opened and audiences heard Judy Garland perform it.", "reason": "near_duplicate_of_source", "seed": 1189281978, "similarity": 0.9924050632911392, "temperature": 0.3}, {"attempt": 2, "generated_text": "The very first artist to record the song was actually big band singer Bea Wain, but MGM prohibited the release until The Wizard of Oz (1939) had opened and audiences heard Judy Garland perform it.", "reason": "near_duplicate_of_source", "seed": 888393385, "similarity": 0.9924050632911392, "temperature": 0.5}], "fingerprint": "7a2df9ef613679137df0a428e324d2a0b1810c0e2387b8f8e4c997350149b4c9", "generation_attempts": 3, "gold_answer": "1939", "matched_aliases": ["1939"], "query_id": "test3321", "question_hash": "d8a4a058dfecbb71d72140794fbe4f76e801ed02d3ebaef41b74122c4fc8d971", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "239c77e13a31495f222bce04d4d157e4b1bf3017ac64aacc5483b50fe89a929c", "scope": "all_answer_documents", "seed": 1147405705, "similarity": 0.5818181818181818, "source_content_hash": "9a035fba228f4b38601fac526aae8b612750221ddd77828fb1c46478f5a36443", "source_hash": "e7b4246b64be50b6a0acb5d3dd7beb09f47aeb91374e79a403aca4f77af42f7c", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "8311d6a580cfc6192a7db0ff028811aa281b860468127dca4875cc273843810b", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "vali