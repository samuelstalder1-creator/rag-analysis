{"doc_id": "doc79750", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The 2007 ICC World Twenty20 was the inaugural Twenty20 cricket world championship, contested in South Africa from 11 to 24 September 2007. Twelve teams took part in the thirteen-day tournament—the ten Test-playing nations and the finalists of the 2007 WCL Division One tournament: Kenya and Scotland. India won the tournament, beating Pakistan in the final.", "reason": "near_duplicate_of_source", "seed": 199372131, "similarity": 0.9902642559109874, "temperature": 0.3}], "fingerprint": "a8402d99788b7cd76d8e495b7507bfcaeacd143ee80d08aeef8f4f196ecf9298", "generation_attempts": 2, "gold_answer": "Pakistan", "matched_aliases": ["Pakistan"], "query_id": "test2311", "question_hash": "9f5fbe73bdccbf2b022e9030bf94f68757e72eca3e759f971b9865979a62aca0", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "34a59c9eea7f5d5cfbecd68d5a87a0e0e210062bca07b7c35a42e3a4a9da2725", "scope": "all_answer_documents", "seed": 2023494028, "similarity": 0.25688073394495414, "source_content_hash": "156d100343ebc9333faf5b81a2142514b2ab8ae4dd8999ae9c0491b7a691f714", "source_hash": "da235402c4bb891fd5be5b6e8e6595266564c6a8fa386258064d753394ffd0d1", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "f579edd0da1d57043a2d85702ba3e3bfb3aa092569a38c1df6975bf878169585", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
