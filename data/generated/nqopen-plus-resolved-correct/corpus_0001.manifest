{"doc_id": "doc116523", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Junie B. Jones is a children's book series written by Barbara Park and illustrated by Denise Brunkus. Published by Random House from 1992 to 2013, the stories begin with Junie B. Jones and the Stupid Smelly Bus, in which Junie B. is an \"almost six year old\" starting her first day of kindergarten.", "reason": "near_duplicate_of_source", "seed": 216553459, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "932dbf5eb693de83a2c773973800fec8c25ade0aab0a0362bda3ae41f25789e2", "generation_attempts": 2, "gold_answer": "1992", "matched_aliases": ["1992"], "query_id": "test3426", "question_hash": "f2543aa4e46f5bcc3356d41e73bb0502c50b0e745a047b9b848cd0d3c9342df2", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "8083e826dc74f35fc54b8a336fbb5250a6481c2f37c877123c7cf386bccad34c", "scope": "all_answer_documents", "seed": 76089449, "similarity": 0.20512820512820512, "source_content_hash": "ca34eccbe18e16a417c813a4aa86b0e292940a0ef1630eb7c0922a8a1f3ecb4f", "source_hash": "b8cf1610932cd1b63834be6baae516facc0c74ebf4116dd2f1026ae342fee51c", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "2dcf54c90c55e972b7e6a14a223f39ab4b764cb3a436de94aa2ee8b52583b62a", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
