{"doc_id": "doc14756", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The collision with the Eurasian Plate along the boundary between India and Nepal formed the orogenic belt that created the Tibetan Plateau and the Himalaya Mountains, as sediment bunched up like earth before a plow.", "reason": "near_duplicate_of_source", "seed": 2051079532, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "00eb4320b0a66c63174543d3b4714105a8c4cded73b9570f8a1b425b75f894af", "generation_attempts": 2, "gold_answer": "orogenic belt", "matched_aliases": ["orogenic belt"], "query_id": "test393", "question_hash": "ac74aa02df136acc60d3693cc633cd899c1afc98d22560583bfb7a8436b7ac24", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "d4b907edbe77b8d5e8c558df223d25f1bde22bdbe9532ef42498bf0ad24f0265", "scope": "all_answer_documents", "seed": 522035146, "similarity": 0.30855018587360594, "source_content_hash": "1dc195037acc55470eef528e8acf49e1e71a8cb916cf6e460af7d26187de8907", "source_hash": "9082ad7274efa98031381f8c51a2cd6a6a5262c2ccba37a3a44003acb8dbd666", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "144b6ae7fd6ff62768380b44529569566916d807b3e24a3560d4d085a529b471", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
