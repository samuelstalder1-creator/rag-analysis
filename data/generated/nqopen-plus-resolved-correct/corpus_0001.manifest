{"doc_id": "doc82728", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "In 1492 Christopher Columbus sailed from Spain on his first voyage with three ships, the Niña, the Pinta, and the flagship, Santa Maria, seeking a direct route to Asia. On 12 October 1492 Columbus reached an island in the Bahamas and claimed it for Spain, an event long regarded by Europeans as the 'discovery' of America. This island was called Guanahani by the Lucayan, and San Salvador by the Spanish. The identity of the first American landfall by Columbus remains controversial, but many authors accept Samuel E. Morison's identification of Columbus' San Salvador as what was later called Watling (or Watling's) Island. Its name has been officially changed to San Salvador. Columbus visited several other islands in the Bahamas before sailing to present-day Cuba and afterwards to Hispaniola.[3]", "reason": "near_duplicate_of_source", "seed": 1903452568, "similarity": 0.9981261711430356, "temperature": 0.3}], "fingerprint": "050939205a2127a27676392175d2aa925d0424573bdd03d593dc360fc2bcda08", "generation_attempts": 2, "gold_answer": "Christopher Columbus", "matched_aliases": ["Christopher Columbus"], "query_id": "test2397", "question_hash": "18ada520fe278f2dec32595203620f8ae25184709882c7fb54e7d8847184657b", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "20e2921e042b69b10df4dbb1f927409f35ad26618eddc7b4afdbb2ded64def95", "scope": "all_answer_documents", "seed": 475767577, "similarity": 0.09980806142034548, "source_content_hash": "391a55d7ddc44ff2653674722c79435723ab5957c857cc5b18013ca6c7868e38", "source_hash": "af1758e3e607dae6d8928b7b4250c0e7ddbecf58ed95ee4162aad416b5f5b824", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "e5905465e2cbe5e212d6de5001756316ed54d2f14c6f72dbe678e1c1440281f0", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc82894", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Mary Elizabeth Patterson (November 22, 1874 – January 31, 1966) was an American theatre, film, and television character actress who gained popular recognition late in her career playing the elderly neighbor Matilda Trumbull on the television comedy series I Love Lucy.", "reason": "near_duplicate_of_source", "seed": 375183636, "similarity": 0.9870609981515711, "temperature": 0.3}], "fingerprint": "303a04a3eab3a7cd4fd6a43945791a33960b6e07233f7b51c277d0cbb1651471", "generation_attempts": 2, "gold_answer": "Mary Elizabeth Patterson", "matched_aliases": ["Mary Elizabeth Patterson"], "query_id": "test2399", "question_hash": "d8ee58421327a28d2397b8db27ed907b4e88eb4a0b8964708f21f02ff0329365", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "d6ee914bc6027c9de5b355e97ec7db6a8267708e1962556ec3b02b434b235bc3", "scope": "all_answer_documents", "seed": 1891799245, "similarity": 0.41735537190082644, "source_content_hash": "5ca67f24ad6dc39f9ebba03dd56526486b49c82e8f34099417ac88d8433dc79e", "source_hash": "6842340d6e647b514eb10d8f3172aabc51274e2fa5c3db53790c446dc1c0fd27", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "5fd37352c5c0cc03c1f0f1f83cadbddf6d67bdbe498880be078684baf86abc61", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
