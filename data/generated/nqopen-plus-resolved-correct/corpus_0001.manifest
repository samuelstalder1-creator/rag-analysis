{"doc_id": "doc90485", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Championships, Wimbledon, commonly known simply as Wimbledon, is the oldest tennis tournament in the world, and is widely regarded as the most prestigious. It has been held at the All England Club in Wimbledon, London, since 1877 and is played on outdoor grass courts.", "reason": "near_duplicate_of_source", "seed": 1115627386, "similarity": 0.9731663685152058, "temperature": 0.3}], "fingerprint": "530e292458cd33223fb2942c0dc66501fe29e6f3dce0f726d89fa149ccd9202a", "generation_attempts": 2, "gold_answer": "London", "matched_aliases": ["London"], "query_id": "test2644", "question_hash": "ce5bfa423045f276edde0b74c4277fb9c30b2610f8694fb7a4c21297db1bc9ef", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "46408064eaca320ccc978f39286723525c46bf205c640e6169ba1e79f7bf47be", "scope": "all_answer_documents", "seed": 761323176, "similarity": 0.3102189781021898, "source_content_hash": "9ca4b6199eef3b0c384404884cb89bf0f037975023491108ed4bc5c9abdb30ce", "source_hash": "06974a66d212e35f3c5045111e6023726c6b6df6838d66a2ffb665999a74ea31", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "3b6e64afd634fc9926f9f53df63a7ed37247db17d629716537b2d820c12a929f", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
