{"doc_id": "doc90164", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Michael Casimir \"Mike\" Stivic is a fictional character on the 1970s American television sitcom All in the Family. He was the live-in son-in-law of the series' lead character, Archie Bunker, who frequently called him \"Meathead.\" Michael was the husband of Archie's daughter Gloria (played by Sally Struthers). Rob Reiner played the role of Michael Stivic throughout the series.", "reason": "near_duplicate_of_source", "seed": 1723783724, "similarity": 0.9973404255319149, "temperature": 0.3}], "fingerprint": "a9c124e6ef74d3a3ba51f2eb18b94fd911dae6604ae41dba6efb94a36ffa9ab5", "generation_attempts": 2, "gold_answer": "Rob Reiner", "matched_aliases": ["Rob Reiner"], "query_id": "test2633", "question_hash": "ed36cc97e85c3bf3f0662b21b84173c857a0ee905ec752a4fc5773d8dfd3af0c", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "930e5a79d76f4639279a6ebe439648b75b8caacbf52b7ce924018dff8a9cfa29", "scope": "all_answer_documents", "seed": 693111045, "similarity": 0.5454545454545454, "source_content_hash": "146af3f4abbad5740ad79db80725aff3a653226b17b59cbc998f4f2a4818ff69", "source_hash": "c6751e0f4f21ee0f8be1b4fa3a67e073e9515a911950aa47a82821b4d23eea0d", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "7001c13e020fafbd5caea18a6fada72a8b31fdbd94681c8d8051bf08cb5f877b", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
