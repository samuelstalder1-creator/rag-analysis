{"doc_id": "doc92693", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "USS Maine (ACR-1) is an American naval ship that sank in Havana Harbor during the Cuban revolt against Spain, an event that became a major political issue in the United States.", "reason": "near_duplicate_of_source", "seed": 362648414, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "c24c0c48653ff7104516338715b47026e01fe06dbaccbfef9d91cf72697aafdf", "generation_attempts": 2, "gold_answer": "Havana Harbor", "matched_aliases": ["Havana Harbor"], "query_id": "test2707", "question_hash": "42e16cf1978b6c253efdf6518109aeda55865175976107f51880ae809b915eea", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "de6d947740df36574fdf0dbe9ea8fe5322c2c76b11ee767dae0e8302cf640970", "scope": "all_answer_documents", "seed": 1370784304, "similarity": 0.13626373626373625, "source_content_hash": "828b43b14dea110bf62231170ccaa9265fffc12a04dafc446fd09e84324c3474", "source_hash": "aa9e4fc6b66a9836009c7f3e46f7adf250cb40b614456352ee27757e092ab544", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "4523754d045c31b03874dcd7fb9f3b28e9edccb5fc09b06cc7f47874ab8740dc", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc92696", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The U.S.S. Maine was best known for her loss in Havana Harbor on the evening of 15 February 1898. Sent to protect U.S. interests during the Cuban revolt against Spain, she exploded suddenly, without warning, and sank quickly, killing nearly three quarters of her crew. The cause and responsibility for her sinking remained unclear after a board of inquiry investigated. Nevertheless, popular opinion in the U.S., fanned by inflammatory articles printed in the \"yellow press\" by William Randolph Hearst and Joseph Pulitzer, blamed Spain. The phrase, \"Remember the Maine! To hell with Spain!\", became a rallying cry for action, which came with the Spanish–American War later that year. While the sinking of Maine was not a direct cause for action, it served as a catalyst, accelerating the approach to a diplomatic impasse between the U.S. and Spain.", "reason": "near_duplicate_of_source", "seed": 797136348, "similarity": 0.9845605700712589, "temperature": 0.3}], "fingerprint": "77ffb87c0d792eb264ca50bb0452b691b36230595aa39d9dc80b4b5008308187", "generation_attempts": 2, "gold_answer": "Havana Harbor", "matched_aliases": ["Havana Harbor"], "query_id": "test2707", "question_hash": "42e16cf1978b6c253efdf6518109aeda55865175976107f51880ae809b915eea", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "3b6d1d70316aaedc2e688374c6459252103dc15d5621b6057faca799d3c5c173", "scope": "all_answer_documents", "seed": 1194031560, "similarity": 0.10102224894768491, "source_content_hash": "0ea9dd552d0c2fdc0058a05647ab803bcd314cd65256635541fccff229f5d98b", "source_hash": "86965031113c924438d4e39268e3563c5cc2090fbecd44ca23da3652450f7ba5", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "139c9ea40b6042438b5e28ae794e011f5a77c950a2928bbb5f1dc6b525713f1c", "format_attempts": [], "judgment"