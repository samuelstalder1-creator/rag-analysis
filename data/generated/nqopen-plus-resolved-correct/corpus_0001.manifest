{"doc_id": "doc77119", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Ethiopian Airlines Flight 961, a Boeing 767-200ER, was hijacked on 23 November 1996, en route from Addis Ababa to Nairobi on an Addis Ababa–Nairobi–Brazzaville–Lagos–Abidjan service, by three Ethiopians seeking asylum in Australia. The plane crash-landed in the Indian Ocean near Grande Comore, Comoros Islands, due to fuel exhaustion; 125 of the 175 passengers and crew on board died, along with the hijackers. The official accident report stated that four of the survivors were uninjured.", "reason": "near_duplicate_of_source", "seed": 1349035946, "similarity": 0.9879032258064516, "temperature": 0.3}], "fingerprint": "3c28fb562fb067b90128b04ca8e4d7b8c65730747563a82dfe237bef6cae4f08", "generation_attempts": 2, "gold_answer": "23 November 1996", "matched_aliases": ["23 November 1996"], "query_id": "test2218", "question_hash": "f2f94debc1ef24638ef983d7860ceb9ebf04a4210aecf39e5f410489a2938b2e", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "dd8695bb64761e480f806cee652737ec8f631fd1bc2cd817b81001990ef2724b", "scope": "all_answer_documents", "seed": 324714247, "similarity": 0.224469160768453, "source_content_hash": "7708d7de69849e7e74e9f69b88754f0a0df6b7b266525d9c9724bb883dffb6c1", "source_hash": "a05d3cf28c43dde59d88cbadc52e59c3ac6cf0ba7d9801139a71b078ccd800be", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "e868221657a5ded808be97daf904841d290dee36a5ef9217465dd6171f52422d", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerabi