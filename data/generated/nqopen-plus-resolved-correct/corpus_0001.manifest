{"doc_id": "doc23573", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"Tell Me Something Good\" is a song by Rufus and Chaka Khan, written by Stevie Wonder and released in 1974. The single was a hit in the United States, peaking at number three on the Billboard Hot 100 and spent one week at number one on the Cash Box Top 100.[1] It was among the earliest hits to use the guitar talk box, by Tony Maiden.[2]", "reason": "near_duplicate_of_source", "seed": 1029740651, "similarity": 1.0, "temperature": 0.3}, {"attempt": 2, "generated_text": "\"Tell Me Something Good\" is a song by Rufus and Chaka Khan, written by Stevie Wonder and released in 1974. The single was a hit in the United States, peaking at number three on the Billboard Hot 100 and spent one week at number one on the Cash Box Top 100.[1] It was among the earliest hits to use the guitar talk box, by Tony Maiden.[2]", "reason": "near_duplicate_of_source", "seed": 173732575, "similarity": 1.0, "temperature": 0.5}], "fingerprint": "4c5e90e87f8763b101a2e608ef102acc989413c77192b84999c6a21beea31d5b", "generation_attempts": 3, "gold_answer": "Rufus and Chaka Khan", "matched_aliases": ["Rufus and Chaka Khan"], "query_id": "test662", "question_hash": "953558c5e89607fdefcea47e4d66396b3d97f2df4a291e2f3761d007699b8425", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "30bf3d794d12147140a91768f83637854b534cfbfd33fed2843f12b56652a5b8", "scope": "all_answer_documents", "seed": 245135749, "similarity": 0.5252263906856404, "source_content_hash": "cc416d3bb15738bd29c35a2042c66d1eb3517a57dd90d6e104da47c727d256bb", "source_hash": "09f5c9677a7368d4a653eda4d3b02d1b7f52d90c6673334d118d3c305ce12f49", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "08f854b5c8937f878cfd2d52c8889f19e6282b297bdc473dea75d55f7590e539", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_du