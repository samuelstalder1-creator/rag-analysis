{"doc_id": "doc24099", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "In 1909, William Howard Taft expanded the building southward, covering the tennis court. He placed the first Oval Office at the center of the addition's south facade, reminiscent of the oval rooms of the White House.[6] Later, at the outset of his presidency, Herbert Hoover rebuilt the West Wing, excavating a partial basement, and supporting it with structural steel. The completed building lasted less than seven months.[9] On December 24, 1929, the West Wing was significantly damaged by an electrical fire.[2] Hoover rebuilt it, and added air-conditioning.", "reason": "near_duplicate_of_source", "seed": 1295914483, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "5a230f093eee811919d76e8868f07098caf62907a08f246489b1578b6d429b79", "generation_attempts": 2, "gold_answer": "electrical fire", "matched_aliases": ["electrical fire"], "query_id": "test671", "question_hash": "e24bc91e490345f3d0c5f112f6bcc954ed38c92e62ffdc10044ef1f2928e8924", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "2bf2d47ec1d8b5f8b82ef81f14e5bef1849fc9220a990cf2e205383e97980b39", "scope": "all_answer_documents", "seed": 2082979947, "similarity": 0.4531914893617021, "source_content_hash": "5a01cb66aca8d517f3533bac9a2f4574ae2e3b4a342fce0ebdcfe4017c630dfe", "source_hash": "12fda574d5c86650ea9c1d8496019069e12ba3ac8f121ea6d7dd506f6d13ffb0", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "c226ebf463c29549aa3d2be54911a997f52b48d5ae694ca7692bc6eee6b64467", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f"