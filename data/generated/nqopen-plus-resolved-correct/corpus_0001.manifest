{"doc_id": "doc70411", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The eighth season of Shameless, an American comedy-drama television series based on the award-winning British series of the same name by Paul Abbott, was announced on December 19, 2016, a day after the seventh season finale. The season will consist of a total of 12 episodes. It is slated to premiere on November 5, 2017.", "reason": "near_duplicate_of_source", "seed": 1060052463, "similarity": 0.9861751152073732, "temperature": 0.3}], "fingerprint": "4df61b8dacf8a5206060ae5bf2de32b145622cacabe00f4bfa27f4e75a780ca6", "generation_attempts": 2, "gold_answer": "November 5, 2017", "matched_aliases": ["November 5, 2017"], "query_id": "test2006", "question_hash": "fa15bed4bd4010072d83de4d5f0161fe16f96f8fdfc22fba588df155a8f4607d", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "198764513ff40220808521e93fd5866a6778caf6a8c76cf6bfabc887e23117da", "scope": "all_answer_documents", "seed": 693745233, "similarity": 0.49333333333333335, "source_content_hash": "dc74048495611403b1dff9ce3f0c4ab91f10c1676e95747574916d374c43ee1f", "source_hash": "4caadc984de03d759975ad312e9e6a1f5ebc6df65ca17644b2b5f25960edad3b", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "1609fcff5430ab1b89d54bbe7ba6e24d5662da47588a54e4016853b1ca682960", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
