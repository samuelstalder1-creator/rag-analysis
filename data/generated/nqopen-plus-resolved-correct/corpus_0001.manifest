{"doc_id": "doc96728", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Once the Committee reports out the nomination, the whole Senate considers it. A simple majority vote is required to confirm or to reject a nominee. Prior to 2017, a successful filibuster threat could add the requirement of a supermajority of 60 needed in favor of cloture, which would allow debate to end and force a final vote on confirmation. Rejections are relatively uncommon; the Senate has explicitly rejected twelve Supreme Court nominees in its history. The most recent rejection of a nominee by vote of the full Senate came in 1987, when the Senate refused to confirm Robert Bork.", "reason": "near_duplicate_of_source", "seed": 1904924565, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "7cb4c7d374b30f437f6409ed9c32f8da44fd750b166c8a90a5ba049d40442c1c", "generation_attempts": 2, "gold_answer": "A simple majority vote", "matched_aliases": ["A simple majority vote", "A simple majority"], "query_id": "test2817", "question_hash": "fb1f70d1592ce25e875962daf534631ec1d1c78ce1612370d1908a8fd600f563", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "72933632f8027b0be4d2a47be78d24f1bfc62cb7143e8f5d0f751e518bc6a26d", "scope": "all_answer_documents", "seed": 1721080779, "similarity": 0.2629399585921325, "source_content_hash": "b4002950863095d663df8f869f75bb4bfa1217fdc823c28d2a7c086a015fe3de", "source_hash": "29e362d4210bc69735ce484b10b87699b71b9381920433cfebdfa92cfbff767a", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "90eae66da789ae5415d3b0cf0bc269313dae09c62c101b0ad8243863b2d78c9c", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a