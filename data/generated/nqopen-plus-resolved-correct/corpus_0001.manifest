{"doc_id": "doc37757", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "A flag designed by John McConnell in 1969 for the first Earth Day features a dark blue field charged with The Blue Marble, a famous NASA photo of the Earth as seen from outer space. The first edition of McConnell's flag used screen-printing and used different colors: ocean and land were blue and the clouds were white. McConnell presented his flag to the United Nations as a symbol for consideration.", "reason": "near_duplicate_of_source", "seed": 359750269, "similarity": 0.986232790988736, "temperature": 0.3}], "fingerprint": "af06de679f73a84938931aab715fb8d6afc1bf0100917ef244e7547775a9ccbf", "generation_attempts": 2, "gold_answer": "John McConnell", "matched_aliases": ["John McConnell"], "query_id": "test1082", "question_hash": "8298a8718724f98ab6a9a0386bef3895c8a862ccb7c1e52dd764faec66761e85", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "ce107f5e21426eb595341f9e4b6903abbf0c1f09b5016044681c052c06d53f65", "scope": "all_answer_documents", "seed": 116542771, "similarity": 0.6469194312796208, "source_content_hash": "a1990a5b9108464cdf928c99caf66ee1553558b35075ad4c2dd29114820d7b49", "source_hash": "d079a257cedde545fc9ab269bfe37ff1b654b5c6ff13925b9806e1e622ce6a94", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "8a35c6160338819ed6ede7623c991f920ddb9fe2fcfae2b8c8e017aa06051277", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
