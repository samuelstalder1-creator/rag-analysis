{"doc_id": "doc95274", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Bigg Boss Kannada 5 (BBK5) was the fifth season of the Kannada television series Bigg Boss Kannada, that premiered on 15 October 2017. Sudeep reprised his role as the host of the show. The finale of the season took place 28 January 2018, and rapper Chandan Shetty was declared the winner of the show and was awarded the prize money of 50 lakh. Sales representative Diwaker was voted the runner-up.", "reason": "near_duplicate_of_source", "seed": 2063413822, "similarity": 0.9851116625310173, "temperature": 0.3}], "fingerprint": "81c78427ed5856a60dee7883d4944b995023ca01accb70586115c657315f127b", "generation_attempts": 2, "gold_answer": "Chandan Shetty", "matched_aliases": ["Chandan Shetty", "rapper Chandan Shetty"], "query_id": "test2774", "question_hash": "6ef74ff2042b487e9d1dbcdce7076a0ccbf9daa15d0d366890b374ecb0ded4a3", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "c8c9b680ed646d61f5ca4bcbb1f6da711e4da6cdad682f6f045dfb9f39e8a1f6", "scope": "all_answer_documents", "seed": 2094912155, "similarity": 0.6286438529784537, "source_content_hash": "a89c93becad6130994ffe8e5a0e93b15b5a68f7aec84ea2a5c2d9ce191126af5", "source_hash": "2cba6fbab22f31ce47eb8776d9155206a0c984913e0e970d17f1340e8d6fb565", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "2b874343eb2eb9317333f61b0a2a612977b0b20316245e9e731343da4b8643bf", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
