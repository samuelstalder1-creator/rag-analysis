{"doc_id": "doc22987", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Schadenfreude (/ˈʃɑːdənfrɔɪdə/; German: [ˈʃaːdn̩ˌfʁɔʏ̯də] (listen); lit. 'harm-joy') is the experience of pleasure, joy, or self-satisfaction that comes from learning of or witnessing the troubles, failures, or humiliation of another.", "reason": "near_duplicate_of_source", "seed": 159788924, "similarity": 0.9936034115138592, "temperature": 0.3}, {"attempt": 2, "generated_text": "Schadenfreude (/ˈʃɑːdənfrɔɪdə/; German: [ˈʃaːdn̩ˌfʁɔʏ̯də] (listen); lit. 'harm-joy') is the experience of pleasure, joy, or self-satisfaction that comes from learning of or witnessing the troubles, failures, or humiliation of another.", "reason": "near_duplicate_of_source", "seed": 1876312082, "similarity": 0.9936034115138592, "temperature": 0.5}], "fingerprint": "668f7f24679b2e43703c1280df5c253572dd85c0c6c30cc5d88c79f225c58d98", "generation_attempts": 3, "gold_answer": "Schadenfreude", "matched_aliases": ["Schadenfreude"], "query_id": "test644", "question_hash": "2de5d2ef9ccf655189a8f90819f5eeeed41f84e0897e42ed5460d3767c37e6d7", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "1d25026d4be815e92572c5a5a0b066f1582068cbc0731ee28cc2b724d0c661bd", "scope": "all_answer_documents", "seed": 474345281, "similarity": 0.09917355371900827, "source_content_hash": "8e79b865c9df2dc8ad3ebbd7510a4f41b842a34cc74a26c020c5ef524d1e99ad", "source_hash": "1da96f6b28ae076a408250c95d9aea973b63680e7f7661bad75d24120c532369", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "aab1a8e94341d5783eea20ca7f632b259f84b5132d8004095d2dbbaf5f133b05", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash":