{"doc_id": "doc71325", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Teenage Mutant Ninja Turtles first appeared in an American comic book published by Mirage Studios in 1984 in Dover, New Hampshire. The concept arose from a humorous drawing sketched out by Eastman during a casual evening of brainstorming and bad television with Laird.[3] Using money from a tax refund, together with a loan from Eastman's uncle, the young artists self-published a single-issue comic intended to parody four of the most popular comics of the early 1980s: Marvel Comics' Daredevil and New Mutants, Dave Sim's Cerebus, and Frank Miller's Ronin.[4] The TMNT comic book series has been published in various incarnations by various comic book companies since 1984.", "reason": "near_duplicate_of_source", "seed": 1953460939, "similarity": 0.9941089837997055, "temperature": 0.3}], "fingerprint": "a5bf448d20a69a70f7a8480734828956b451b0435ab0104815f4a78945354bf2", "generation_attempts": 2, "gold_answer": "1984", "matched_aliases": ["1984"], "query_id": "test2049", "question_hash": "9a834d8bf59e735f0133479439cb7eaf9d27330ac6f1791a0eb44b7d340cdd74", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "9549d169a4953f3c5d416e31ca568445593277f8bb4443a9d40491da7a7af3fd", "scope": "all_answer_documents", "seed": 1041203110, "similarity": 0.2270351008215086, "source_content_hash": "a28c15f5e97d619fba31bdc1657b76e3ce122554140d0a951fa86c6fb57e0882", "source_hash": "74234aa87a5ead1c2f2f2f9860da59342409e246ec911f4e8768320c74338864", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "1d9462cdc659aa1997801b3180ca5fd1d688e772719fd3868d1023b1d783459e", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_go