{"doc_id": "doc111470", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "As of 2016, the periodic table has 118 confirmed elements, from element 1 (hydrogen) to 118 (oganesson). Elements 113, 115, 117 and 118, the most recent discoveries, were officially confirmed by the International Union of Pure and Applied Chemistry (IUPAC) in December 2015. Their proposed names, nihonium (Nh), moscovium (Mc), tennessine (Ts) and oganesson (Og) respectively, were announced by the IUPAC in June 2016 and made official in November 2016.", "reason": "near_duplicate_of_source", "seed": 759479832, "similarity": 0.978401727861771, "temperature": 0.3}], "fingerprint": "2d7c68eb62eeea3a9d1fd4635faf7c662c35c7c4ec17ed4dcbee244cd36d72a9", "generation_attempts": 2, "gold_answer": "Hydrogen", "matched_aliases": ["Hydrogen", "hydrogen"], "query_id": "test3261", "question_hash": "9b42004dd93849d723027bceb675bab2a507aa81dea086e1742db32c515ae27a", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "112b23cd5f9d18b49bf7735e84dba9d9e3002bc9fc3cf0907e216adf490d154c", "scope": "all_answer_documents", "seed": 416755899, "similarity": 0.3875802997858672, "source_content_hash": "404e77f160d39b857f959242e0318d04e77753399da605b391571842a61edd4d", "source_hash": "48146925fdee3600ab8032c48dd69dffdd4cb8785fce7759ad1940e2111e21d2", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "c9b3affb47d665ed87a180c61081ebe5b21d1bac6a569224bd87bc6e56b100be", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc111533", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Golden Nugget Atlantic City is a hotel, casino, and marina located in Atlantic City, New Jersey. Opened in 1985 as Trump's Castle, it was renamed Trump Marina in 1997. Landry's, Inc. purchased the casino from Trump Entertainment Resorts in February 2011, and the sale was approved in late May. Landry's took control of the property on May 23, 2011.", "reason": "near_duplicate_of_source", "seed": 1969655591, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "c11393cdbda9b32d4f3136dc604368a3ff03e5d380604012a8916e646436d5bb", "generation_attempts": 2, "gold_answer": "Landry's, Inc", "matched_aliases": ["Landry's, Inc"], "query_id": "test3262", "question_hash": "77b101e330cf84966c0208bfe4f0bbf57c59d5655f148776ccf51928adb86a62", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "0396017eb866941812fcb02ea31579a0c0b3cdd929f9ae2a038846b126a761b6", "scope": "all_answer_documents", "seed": 1652330563, "similarity": 0.27485380116959063, "source_content_hash": "0dffa8948331c7129dc67ec27b9a85d22d70bd3fe5a05304e78f2ebf7b8de5e7", "source_hash": "7812d6a01b833d91716f469068640b1041335f545daecf4bc1d3533ad331a65a", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "2721ca26cf91b36da23aa89c9af672b17a796002fba5d36c09f63ef52a142791", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
