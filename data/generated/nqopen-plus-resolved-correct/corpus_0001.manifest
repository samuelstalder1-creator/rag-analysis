{"doc_id": "doc92185", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Brother is a song by American Christian rock band Needtobreathe. It was released as the fifth single from Rivers in the Wasteland on February 2, 2015.[1] The official single version features Gavin DeGraw and was released to Hot AC radio on May 4, 2015.[2] The song was written by Bear and Bo Rinehart, and produced by Dave Tozer, using elements of Ed Cash's LP version.[3] The song peaked at number 8 on Billboard Hot Rock Songs, number 1 on Billboard Hot Christian Songs, and number 98 on the Billboard Hot 100, becoming the band's first chart entry, and highest peak on the chart.[4]", "reason": "near_duplicate_of_source", "seed": 1032978140, "similarity": 0.9863481228668942, "temperature": 0.3}], "fingerprint": "aa1de292fd3c198220e00342838a755dc78a3c6058a62e52edec081f1baf437b", "generation_attempts": 2, "gold_answer": "Needtobreathe", "matched_aliases": ["Needtobreathe", "American Christian rock band Needtobreathe"], "query_id": "test2688", "question_hash": "7cf7931dfd9e0332d6d1f4dac83279f1889ed0a8ac77ed2790440fd223c00b49", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "15e8cf9dec1fcd6d5f310d5476ef65bbe5816bbf58ce728bacc518d14aea85c7", "scope": "all_answer_documents", "seed": 1429983181, "similarity": 0.2120866590649943, "source_content_hash": "9e4b49ffec5fa688e5ca5a012e6bb6cea881d99330b55a3762b38b7a69a7c1eb", "source_hash": "bf990d8c42ea9c026266b28e344376b7d3aef1988fa45ad3791a4040ce5db7df", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "d030d5ee9f88d8e9a59ec8ce06e247ab1bf3a42bd795ce937fe3b0b05d038078", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "v