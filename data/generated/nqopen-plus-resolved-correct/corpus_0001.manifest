{"doc_id": "doc52186", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "On July 9, 1958, a giant landslide at the head of Lituya Bay in Alaska, caused by an earthquake, generated a wave that washed out trees to a maximum altitude of 520 metres (1,710Â ft) at the entrance of Gilbert Inlet. The wave surged over the headland, stripping trees and soil down to bedrock, and surged along the fjord which forms Lituya Bay, destroying a fishing boat anchored there and killing two people. Howard Ulrich and his son managed to ride the wave in their boat, and both survived.", "reason": "near_duplicate_of_source", "seed": 43633042, "similarity": 0.9929789368104313, "temperature": 0.3}], "fingerprint": "3873577cf7b7b1272a138b0dde3420f78659cbae4ef04a6c1556bab524ffbadc", "generation_attempts": 2, "gold_answer": "Lituya Bay in Alaska", "matched_aliases": ["Lituya Bay in Alaska"], "query_id": "test1463", "question_hash": "0484699dc59930fd017ce4c30d200608a06d5655299cd66a895416ba2da00170", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "0054a1b4b918c0f593e61362e9491383ef04fd4fb1b205ffa70a8b503e4aec06", "scope": "all_answer_documents", "seed": 1994540986, "similarity": 0.5605605605605606, "source_content_hash": "2885dfb3e2d1b2148edae19ca0b6b21e9be7f40f6909482b0807cd0bab9b619a", "source_hash": "1c589e02d0f2c71d73371685c2af102120939f0cae12b8908ecc7dbae4d0b047", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "a86561eb4cff00653df44f73dce2e466acc0455f91a8ebceed4637d1cfbc4a5d", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "qu