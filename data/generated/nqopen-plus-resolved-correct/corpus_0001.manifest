{"doc_id": "doc36511", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Best Years of Our Lives (aka Glory for Me and Home Again) is a 1946 American drama film directed by William Wyler and starring Myrna Loy, Fredric March, Dana Andrews, Teresa Wright, Virginia Mayo, and Harold Russell. The film is about three United States servicemen readjusting to civilian life after coming home from World War II. Samuel Goldwyn was inspired to produce a film about veterans after reading an August 7, 1944, article in Time about the difficulties experienced by men returning to civilian life. Goldwyn hired former war correspondent MacKinlay Kantor to write a screenplay. His work was first published as a novella, Glory for Me, which Kantor wrote in blank verse. Robert E. Sherwood then adapted the novella as a screenplay.", "reason": "near_duplicate_of_source", "seed": 871679749, "similarity": 0.9900596421471173, "temperature": 0.3}], "fingerprint": "e774994e8c48c2c3ba1879080ebb72adb0002737570bb93d4c14eec93890f489", "generation_attempts": 2, "gold_answer": "William Wyler", "matched_aliases": ["William Wyler"], "query_id": "test1042", "question_hash": "91fa0f397067c0c6943a45e8825bf4b1a5504caee8c6799d6372a8ad407b5bfd", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "fa6ac77f0050a302aba5ac232b561f089a38f1cdf501e002e87c81084eaad795", "scope": "all_answer_documents", "seed": 1336291100, "similarity": 0.17803768680961662, "source_content_hash": "2cc701717ee5150e3eab2c36e37cb90e80341b652a22d0e1d7ec3f9b422648ed", "source_hash": "99eafe3c2327fc42477e15bb38a5d7a5fa41510485c086e91bf2850e73aa61d1", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "5f1d60c3a3f057f5e2611b8549592f4a4333ae67f7d3672cf1f5165559a65f56", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
