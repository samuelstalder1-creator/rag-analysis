{"doc_id": "doc65860", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Witch and the Hundred Knight 2 (魔女と百騎兵2, Majo to Hyakkihei 2) is an action role-playing video game developed and published by Nippon Ichi Software for the PlayStation 4. Featuring a different witch than its predecessor, the game released in February 2017 in Japan and in March 2018 in North America and Europe.", "reason": "near_duplicate_of_source", "seed": 379043567, "similarity": 0.9500756429652042, "temperature": 0.3}], "fingerprint": "e3202d2ea79719c4e0903f8287b5edc7920bd13b218385cb351e37a4403ed495", "generation_attempts": 2, "gold_answer": "March 27, 2018", "matched_aliases": ["March 2018"], "query_id": "test1874", "question_hash": "838417122e3eba8266864405f0068ee996c365b484e338bd6c94368b2ea03323", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "db65f16d5ed562c09a9374239e119532b72d6b9274b60805f5e8f338e842d8a0", "scope": "all_answer_documents", "seed": 1015285699, "similarity": 0.7337461300309598, "source_content_hash": "5cd7478cef65bd9f5168f92daf373f17ee126e2e45431bafc87815f0cdbc5774", "source_hash": "218665bf4ebc45a29024abb70faedda097ff445fe767c872de9f89752e3a633f", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "eedf691a4695fb268c176e621e72cd2fb80e0edb7594c1e3ddf12bd0e21e5661", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
