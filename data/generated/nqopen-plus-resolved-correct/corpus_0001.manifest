{"doc_id": "doc13558", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Modules results are sometimes issued on a graded basis, consisting of pass grades 1 (threshold 85%, a distinction), 2 (70–84%), 3 (55–69%) & 4 (40–54%), and fail (below 40%). This grade is calculated as the lower of the overall continuous assessment score (OCAS) and overall examination score (OES).", "reason": "near_duplicate_of_source", "seed": 263377172, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "cd38f1f76ed322e3431cd946489809de561e72a02130974b4582633a82103da7", "generation_attempts": 2, "gold_answer": "55–69%", "matched_aliases": ["55–69%"], "query_id": "test355", "question_hash": "bb79665d6e435a6eb6659f076673a5458a07ed08e613a308f1f33ec2ccb4c4a5", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "8e12b93ad6ecced6dd31b67af4f905a74328ed0cd05b0ed2d5a1cdc517ec989e", "scope": "all_answer_documents", "seed": 1014780825, "similarity": 0.9174917491749175, "source_content_hash": "1ac470a50f18ae10e96dd9e9116303ace5e45168c9078be0ff1c1cde5b0b77c7", "source_hash": "40256f49ea2bb10d6bae20c431cb44f7faf445391114bdceccf5cd35001c7732", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "fcd5b80b3476ca736bb10f9a5951671ff779b561f4d9b5fa5b4dfe6ead22b65a", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc13837", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Governor Edmund G. Brown California Aqueduct is a system of canals, tunnels, and pipelines that conveys water collected from the Sierra Nevada Mountains and valleys of Northern and Central California to Southern California. Named after California Governor Edmund Gerald \"Pat\" Brown Sr., the over 400-mile (640 km) aqueduct is the principal feature of the California State Water Project.", "reason": "near_duplicate_of_source", "seed": 1907338517, "similarity": 0.9923469387755102, "temperature": 0.3}], "fingerprint": "a0566e22a502c9ac9d301bf3479a42aa46cf74244f5d01495d06e42e0f944d3c", "generation_attempts": 2, "gold_answer": "Sierra Nevada Mountains", "matched_aliases": ["Sierra Nevada Mountains"], "query_id": "test362", "question_hash": "c22c2b1b429dfa69e09170591d6fa07a6ec5677301240f348b8b8fa28bd46283", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "dece5e07a42fe92e57a7a1f6ebe37a44c158cefc6ffbbbf31ef25cb12a004a2f", "scope": "all_answer_documents", "seed": 999406660, "similarity": 0.2942643391521197, "source_content_hash": "17c6bcbf1804bb757932b5bb170fa321fe3bac8758c47b1c07b319d117540f4c", "source_hash": "fe81fa279c294842ad04ffe3ff1d71189b5b806b01e2578ff0a6255c4f27577f", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "d31a056f9095fc9e822632af3c7c258f70efe5a262cbcb166b977b8e831a16f0", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
