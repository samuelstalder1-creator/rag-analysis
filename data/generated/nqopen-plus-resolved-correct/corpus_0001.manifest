{"doc_id": "doc50092", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "On 30 October 1918, the Armistice of Mudros was signed, ending Ottoman involvement in World War 1. The Ottoman public, however, was given misleadingly positive impressions of the severity of the terms of the Armistice. They thought its terms were considerably more lenient than they actually were, a source of discontent later that the Allies had betrayed the offered terms.", "reason": "near_duplicate_of_source", "seed": 1039568423, "similarity": 0.9946808510638298, "temperature": 0.3}], "fingerprint": "7d73f657decc14a1223f4084ad1712263f5c75854c50cfc6f6f8d93fc4df2c57", "generation_attempts": 2, "gold_answer": "1918", "matched_aliases": ["1918", "30 October 1918"], "query_id": "test1402", "question_hash": "cfdd84da77f83b04d245b139af75f567b5e11da99c4497d4c69ec8fa3ce61b66", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "44eb25c288da6bc81dfdfb26f378067eba6bd3af979c81b3f601f835d6e04d93", "scope": "all_answer_documents", "seed": 1106233853, "similarity": 0.2762022194821208, "source_content_hash": "9db2fb02882e33477688685c4d9f965d3a8763c9b8b3901cfc8fec5ecc493c87", "source_hash": "d0c73167688388a33c43e97442705410029d74475456c09a5a9f24bfc0a0e781", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "bd50dc0f71b56f91b54c29ef2eddfce3838a1e2db11b91fb1cfac570dd659b3c", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
