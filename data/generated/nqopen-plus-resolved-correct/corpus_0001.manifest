{"doc_id": "doc85474", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "In humans, implantation of a fertilized ovum is most likely to occur around 9 days after ovulation, however this can range between 6 and 12 days.", "reason": "near_duplicate_of_source", "seed": 186975355, "similarity": 0.9897610921501706, "temperature": 0.3}], "fingerprint": "4c63ff8207a5ce17b901d7fc31bb5a50f7db53edda0749c0ab95dec6af600b31", "generation_attempts": 2, "gold_answer": "around 9 days after ovulation", "matched_aliases": ["around 9 days after ovulation"], "query_id": "test2481", "question_hash": "27ede074ec83989a9857bcc20c03911a98908473223b122ec4f28e7aba3f9074", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "c3bf352bd6b544a62cb74ce8f9f9115b617218104270382d70cda4eaa6b6d79c", "scope": "all_answer_documents", "seed": 914761525, "similarity": 0.8121212121212121, "source_content_hash": "f0b6d46ac9c112aca5d809f3df48f2daf111041bd10de52e973c9949e9aa6e1d", "source_hash": "945b579a19cbcf7bdcc63e310fa2653d7caa3fe25be48fc69490194e83fc2004", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "9b562db71caaca09a515805273d09492eb0d8ec465e7030f657fb66cbc35669d", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc85523", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The 2018 FIFA World Cup will be the 21st FIFA World Cup, a quadrennial international football tournament contested by the men's national teams of the member associations of FIFA. It is scheduled to take place in Russia from 14 June to 15 July 2018, after the country was awarded the hosting rights on 2 December 2010. This will be the first World Cup held in Europe since the 2006 tournament in Germany; all but one of the stadium venues are in European Russia, west of the Ural Mountains, to keep travel time manageable.", "reason": "near_duplicate_of_source", "seed": 2144787475, "similarity": 0.9971291866028709, "temperature": 0.3}], "fingerprint": "bcedfeec83251036086284fc2eae336e947ae98103b33bf8f583fed301c01c0d", "generation_attempts": 2, "gold_answer": "Russia", "matched_aliases": ["Russia"], "query_id": "test2482", "question_hash": "66be86859ebf397de17b2767355eb69c27616405d401e2a2eac7f1fbe772bab2", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "a3ac4d798a1e9a1fc8b895f621d861e26ef502d1730ee980ae0bf15d5bf8a650", "scope": "all_answer_documents", "seed": 1039880768, "similarity": 0.39433293978748524, "source_content_hash": "27bc3ce32523a5d196958e8d8b1072f63b83d58a8e756af2c18b551b4905e182", "source_hash": "86ce2ad5f26cf678384115ba9c0d0ab96be4175d47f445e26a1d1ec0c44426b1", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "230739238daf41000ef37b9e27d6acd9794620ec220d43bd482921cdceb54ade", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc85654", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "A double-twelve set of dominoes is marketed as the standard for Mexican Train, and accommodates up to 8 players. Other sets are commonly used as well. The following alternate sets are common, depending on the number of people playing.", "reason": "near_duplicate_of_source", "seed": 733772231, "similarity": 0.9957264957264957, "temperature": 0.3}], "fingerprint": "1db0e736e113f7809a47e34dbeef8881e47d35a1ddbc7c074f60ec10c28e53ec", "generation_attempts": 2, "gold_answer": "A double-twelve set", "matched_aliases": ["A double-twelve set"], "query_id": "test2484", "question_hash": "085f851942d4100c9cdd950aa6d98afd2cdd2b9b2ab78274255e5bfa0b9992f5", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "74690b4e0290b83651750b23ecaac059402329f9dfa031b372a31425f170c055", "scope": "all_answer_documents", "seed": 1415774604, "similarity": 0.1898989898989899, "source_content_hash": "67125dd96dfd1d6ade9bcf85f167360d9f73abd5ac3a9779366755fb61bd4091", "source_hash": "df5ae0d6a88479653857eba0b190883bf6fe16a599974545c9b52895832b2e9e", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "0fc9cb43485cc2819090844bc97029cce768a8f725ca37f78870ed9f9f9d998c", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc85952", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "In 1992, the product expanded to international markets: Hungary and Slovenia.[20] It entered the United States via California in 1997[20] and the Middle East in 2000.[21] In 2008, Forbes magazine listed both Chaleo and Mateschitz as the 250th richest people in the world with an estimated net worth of US$4 billion.[22][23]", "reason": "near_duplicate_of_source", "seed": 979455321, "similarity": 0.9938080495356038, "temperature": 0.3}], "fingerprint": "7a2adaee53389fc60f1dbb08a64e9addc425f0807d3af588267e9e5f30101a6b", "generation_attempts": 2, "gold_answer": "1997", "matched_aliases": ["1997"], "query_id": "test2489", "question_hash": "b586057e12f158da4bf1d66c2d7019ff6612ba20d4251becb679632978719f7a", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "004515d0836800e757038cf50e25c3d9b4baa623ed68fc1feddc9d1fd2d3d128", "scope": "all_answer_documents", "seed": 230773760, "similarity": 0.2630272952853598, "source_content_hash": "446f8800582893c7678e973929d4b7aa897d7019616c3a9b5a5081ea959996d6", "source_hash": "9757a4a487fb110707bae192500a951897d23a580479f61ed1e6d58f24354f01", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "f31275545a21ba6b79960ca410d178693281d1030eeda82c75d8ae2ca01b4a45", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
