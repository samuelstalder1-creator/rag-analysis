{"doc_id": "doc33681", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "A lacteal is a lymphatic capillary that absorbs dietary fats in the villi of the small intestine.", "reason": "near_duplicate_of_source", "seed": 1258726868, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "9caabf18146ad89ecc934202bafb9377988bc14b2c18148d732c3343ebdecb3d", "generation_attempts": 2, "gold_answer": "lacteals", "matched_aliases": ["A lacteal"], "query_id": "test949", "question_hash": "e9d4a8e38edf9845f4371419156e22aef563d34ca78dbfb566ce3ad7e327d649", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "57f35a25c8ec48282c87b7dd307726364ab8a04353e706b06a72a779ea7424e9", "scope": "all_answer_documents", "seed": 1605193428, "similarity": 0.8251121076233184, "source_content_hash": "cd9f65519b9356413c58c41f1ef2f7f1e7f68e7380b2c6e34b587b67961ab0bd", "source_hash": "6e4291c8dfb442c41eff43279911a33621959eb3cc8d5d30f52830ad8b7d10c3", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "50fb828ba6156fabc27550343cff8e2fb319dab6f32b5b4f9b9ba278bc2fabd0", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
