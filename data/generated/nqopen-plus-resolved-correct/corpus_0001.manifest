{"doc_id": "doc30444", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Tyrann Devine Mathieu (/ˈtaɪrən ˈmæθjuː/; born May 13, 1992) is an American football safety for the Houston Texans of the National Football League (NFL). He played college football for Louisiana State University (LSU). In college, he developed a reputation for causing turnovers, setting a Southeastern Conference (SEC) record with 11 career forced fumbles and earning the nickname, \"Honey Badger\". In his sophomore season, he was recognized as a consensus All-American, won the Chuck Bednarik Award as the best defensive player in college football, and was a finalist for the Heisman Trophy. Mathieu was dismissed from the LSU football program after that season due to a violation of team rules.", "reason": "near_duplicate_of_source", "seed": 1057587354, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "2cb29f49da344fc6c459a3ba0aa34a6c36685e802785e3f89c91f00c8e46e2c5", "generation_attempts": 2, "gold_answer": "Tyrann Devine Mathieu", "matched_aliases": ["Tyrann Devine Mathieu"], "query_id": "test846", "question_hash": "5c96bf51a4bb64558ccb5d9d891930bf1acb3b47ef7e325603836b7c54eb30b8", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "b5a8d60cc1bee6b9b8875fd9ea13996c2eabc53189f3afece9b18c3648e932ec", "scope": "all_answer_documents", "seed": 275930747, "similarity": 0.49211788896504455, "source_content_hash": "e856d45fff3c753657bd9801e008cf1e934ed60436f03509671cc1836d0ed54d", "source_hash": "66f0e1d4f824c0c23bbec06111d950823499c8f23c67c5624c8a3a8cc96ea3d8", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "9cc51903fc6e735a042613961d447328a688a77a17fa7b30de67f453651ffd05", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage":