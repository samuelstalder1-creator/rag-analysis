{"doc_id": "doc28964", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Nepal is a secular state under the Interim Constitution, which was promulgated on January 15, 2007. The Interim Constitution provides for freedom to practice one's religion. The Interim Constitution also specifically denies the right to convert another person. The now-defunct constitution of 1990, which was in effect until January 15, 2007, described the country as a \"Hindu Kingdom,\" although it did not establish Hinduism as the state religion. The Government generally did not interfere with the practice of other religious groups, and religious tolerance was broadly observed; however, there were some restrictions.", "reason": "near_duplicate_of_source", "seed": 952141461, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "7194d30647bd54202fdd929259e5b113c7e55f9dc068c529e07a9cf7b56f31ad", "generation_attempts": 2, "gold_answer": "January 15, 2007", "matched_aliases": ["January 15, 2007"], "query_id": "test810", "question_hash": "2f9eea38dceefa35a0919c1177955430f342f0081b9526bc977abb968066beea", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "97fafff66f08cf3498f583bdfdd00813dc171e463df89ad092f86c8671ce7ff3", "scope": "all_answer_documents", "seed": 1802505263, "similarity": 0.25542168674698795, "source_content_hash": "1792a44bfd314710ae9dd7f19c5f73b70ea1339a811c33c76fcb4e9f03c9fd54", "source_hash": "20ee0dbcd37c5146b56c80f66145c852da2af8cb5166642f66f3c0fb9d612ece", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "84397269de018476b634f9a4784f01cc7a943258ccd73befd5342e501a5adec8", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a