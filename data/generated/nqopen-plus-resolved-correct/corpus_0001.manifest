{"doc_id": "doc18468", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"Push It\" is a song by the group Salt-n-Pepa that was released as the B-side of the \"Tramp\" single in 1987, and as its own single in 1988. It peaked at number 19 on the Billboard Hot 100 in early 1988 and, after initially peaking at number 41 in the UK, it re-entered the charts after the group performed the track at Nelson Mandela's 70th Birthday concert, eventually peaking at number two that summer. The song is notable for being one of the first hip hop songs to have underlying sexual messages. The song has also been certified Platinum by the RIAA. The song is ranked number 446 on Rolling Stone's list of the 500 Greatest Songs of All Time and was ranked number nine on VH1's 100 Greatest Songs of Hip Hop.[1]", "reason": "near_duplicate_of_source", "seed": 1714608418, "similarity": 0.9951151430565248, "temperature": 0.3}], "fingerprint": "6f703fe49c5c86623f36130661423b81d236795b613410a1836881093e4ad2ae", "generation_attempts": 2, "gold_answer": "March 8, 1987", "matched_aliases": ["1987"], "query_id": "test503", "question_hash": "0c760c5c62cd07d9d5dc2bd632f64e0f98c15e095701e5c5efb833069ee08c10", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "08e2d2bbc842df31832ec2ba8352577b1c17dea7820aef1b26b370875c58b465", "scope": "all_answer_documents", "seed": 1393800878, "similarity": 0.06958250497017893, "source_content_hash": "509c1357207d93cc4645dd74b87d626d39fa84bd073e03c6e72940b65ec90e15", "source_hash": "175e51517ce9e4b9330668b10e6293ad5ae0b7fcb75ba0099812394676298624", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "a2f2e6d97ed2e3478bd7f43d565a48d4ff6a6d2b4f3e08a6870b07f3592e5a54", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": f