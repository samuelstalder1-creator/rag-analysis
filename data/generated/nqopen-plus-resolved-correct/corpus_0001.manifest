{"doc_id": "doc73742", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "My Summer Story, originally released in theaters as It Runs in the Family, is a 1994 film that follows the further adventures of the Parker family from A Christmas Story. Like the previous film, it is based on semi-autobiographical stories by Jean Shepherd, primarily from his book In God We Trust, All Others Pay Cash.", "reason": "near_duplicate_of_source", "seed": 578533277, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "b50c6724921d6c66bf47b51b5d77f0b9a9027fb143c1b72e05cd85f807858d8c", "generation_attempts": 2, "gold_answer": "My Summer Story", "matched_aliases": ["My Summer Story"], "query_id": "test2122", "question_hash": "1c8f8e919972c48ceaebfc96c805aa00d8eabb2e7bf7479ecc6eda9bf8623199", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "75b1018e41b4178d93b4acb57b91ecaf06af105f2a18a979b4d2c82931873892", "scope": "all_answer_documents", "seed": 13852489, "similarity": 0.2138364779874214, "source_content_hash": "83aae5cd056991f10a65c5447b265a6ffda774ae5eee4bb479ea89bb09b43d42", "source_hash": "72b3344aa81f12686a7ccd844b6b7ee52871b67420e7791148fb51b3b7972d2e", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "b79702224554e1d79df92c81d6f38a1dec3322b4c15e06051099f4c704ef41a3", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc73770", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Virgin Australia Airlines Pty Ltd, formerly Virgin Blue Airlines, is Australia's second-largest airline after Qantas and it is the largest airline by fleet size to use the 'Virgin' brand. Now based in Bowen Hills, Brisbane, the airline was co-founded by British businessman Richard Branson, the founder of parent Virgin Group and former Virgin Blue CEO Brett Godfrey. It was established in November 1999 with two aircraft operating on a single route, and suddenly found itself catapulted to the position of Australia's second airline after the collapse of Ansett Australia in September 2001. The airline has grown to directly serve 29 cities in Australia from hubs in Brisbane, Melbourne and Sydney, using a fleet of narrow-body Boeing and Embraer jets; and Airbus and Boeing widebody jets.", "reason": "near_duplicate_of_source", "seed": 945768920, "similarity": 0.9955891619407687, "temperature": 0.3}], "fingerprint": "7041ffbdd8feec20ac7c0e77eaa0e8c348f694c13adfe78ab239f7562fdac709", "generation_attempts": 2, "gold_answer": "November 1999", "matched_aliases": ["November 1999"], "query_id": "test2125", "question_hash": "07b0f0bb0c1b8ae061215d87bfa019ca410e44d2a0242fa44ab0f8c432bd0ad3", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "caddb0a81540674931535a7e2bb0b4431ee03c2a8d6973ea82d0e5f141877e10", "scope": "all_answer_documents", "seed": 1834421249, "similarity": 0.4939467312348668, "source_content_hash": "ce6879d4647ea5154739189dc54aa5d4ab3d10583b6b51f9148d9db0435f2bfd", "source_hash": "ebd6a236af8b5c10475cb6c2cccc9b39bf2776a5cd1769845db82568fa196a2e", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "678a69ea904b8fbcf5b8ebe518e81f1173bcb0336f2336927f3aababf5925ced", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mo