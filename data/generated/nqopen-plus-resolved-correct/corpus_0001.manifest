{"doc_id": "doc73899", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"Only in My Dreams\" is the debut single for American singer-songwriter-actress Debbie Gibson. Released December 16, 1986, as a maxi single (Atlantic DM 86744), and then in remixed form (Vocal/3:50, as described herein) February 1987, the song was written by Gibson herself in 1984, two years before she recorded it.[1] Produced by Fred Zarr and engineered by Don Feinberg for BiZarr Music, Inc., mixed by \"Little\" Louie Vega and mastered by Herb \"Pump\" Powers, the dance-pop song reached number four on the U.S. Billboard Hot 100 singles chart in the summer of 1987. Douglas Breitbart for Broadbeard Productions, Inc. served as executive producer (see also Debbie Gibson).", "reason": "near_duplicate_of_source", "seed": 1933937271, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "71271cfaeaaa71b75b5072e70a34de3172fbe2b0af647537a0a4d2f3ddebf198", "generation_attempts": 2, "gold_answer": "Debbie Gibson", "matched_aliases": ["Debbie Gibson"], "query_id": "test2128", "question_hash": "36a2aeb0cfca43b7b2b49dd6764166bf5979a07a1351ce8aeabebb4b72d0db52", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "0adcfe5db43c34653e0ff331ac2fecce67f46dc3d730695e03ce86e6c21fc081", "scope": "all_answer_documents", "seed": 1182144627, "similarity": 0.5666337611056268, "source_content_hash": "6f41b1014d4001caa0b77cb87753fdd924d44e527375a9f631c4b73aeea09969", "source_hash": "c4f561548ed8ec0c2d270ca76a521bf0e6967cab94885e3e4273dd0cd3ce750c", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "608c45d63e3827ba34f2d69f70131c2f30832c8c7eb9f6fc45e52529c093929d", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_