{"doc_id": "doc106777", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"Say You Won't Let Go\" is a song by British singer and songwriter James Arthur. The song was released as a digital download on 9 September 2016 in the United Kingdom by Columbia Records as the lead single from his second studio album Back from the Edge (2016). The single peaked at the top of the UK Singles Chart, a position it maintained for three weeks. Outside the United Kingdom, the single has topped the charts in Australia, New Zealand, Sweden and the Republic of Ireland. It also became his breakthrough hit in the US, peaking at number 11 on the Billboard Hot 100.", "reason": "near_duplicate_of_source", "seed": 950496966, "similarity": 0.9973935708079931, "temperature": 0.3}], "fingerprint": "ee4ca4d0df0f1469b494ffb1797aadb27ce5dd6cb8537e9f4b01cc47d33365bf", "generation_attempts": 2, "gold_answer": "James Arthur", "matched_aliases": ["James Arthur"], "query_id": "test3122", "question_hash": "6fcae85d3078c4736a0d520ae59b6508b19d80272dce70d837efe09985b83459", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "c50d68b7961364740785e18f7be3308aca800a8be7b0eb3eb4d54373cae54142", "scope": "all_answer_documents", "seed": 587448490, "similarity": 0.203125, "source_content_hash": "8d7fab1067ee74465e4f58b1c95caa662fb9c84fffcbab4411b2a65c327dcb3e", "source_hash": "2a023c4bfd354ed44e5a84f26564ed492f1bbfb397a7411af6963f70c05ecf93", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "6aef3dbd81283c6b9d514e28e0669a3830bd82b2029f77156b09e6dff05dacf2", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231