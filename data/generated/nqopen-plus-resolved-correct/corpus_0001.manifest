{"doc_id": "doc97695", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"Only Love Can Break Your Heart\" is a song written by Neil Young. It has been covered by many bands, including a 1990 single by Saint Etienne.", "reason": "near_duplicate_of_source", "seed": 639898878, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "fae3b24ce6a696fa7081df7ed302d8367a35378817a88bbc9c6d85a2e7d54bc2", "generation_attempts": 2, "gold_answer": "Neil Young", "matched_aliases": ["Neil Young"], "query_id": "test2853", "question_hash": "adc1ac9695292e0e873daeb96b0d259848fcb9130f8b6cac037575ece931acda", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "3742a1697998a6c18515d5b2a87e4c279d9698957fdebf8cd6871b798479f4c6", "scope": "all_answer_documents", "seed": 890650932, "similarity": 0.7873015873015873, "source_content_hash": "3e1b772d81e52389c3e0c5daa2ae7b57d5499b341ddc292b74444eee93fe615e", "source_hash": "f658073541afcbece4f43957af8a895eee6b9dc4a3a0b41828f9c15542bb9313", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "5a7af6265d2757b5502809097b6662856c9c751525b159727dd5962b46611c1b", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc97700", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Archduke Franz Ferdinand of Austria, heir presumptive to the Austro-Hungarian throne, and his wife Sophie, Duchess of Hohenberg, were assassinated on 28 June 1914 in Sarajevo when they were mortally wounded by Gavrilo Princip. Princip was one of a group of six assassins coordinated by Danilo Ilić, a Bosnian Serb and a member of the Black Hand secret society. The political objective of the assassination was to break off Austria-Hungary's South Slav provinces so they could be combined into a Yugoslavia. The assassins' motives were consistent with the movement that later became known as Young Bosnia. The assassination led directly to the First World War when Austria-Hungary subsequently issued an ultimatum to the Kingdom of Serbia, which was partially rejected. Austria-Hungary then declared war, triggering actions leading to war between most European states.", "reason": "near_duplicate_of_source", "seed": 213595736, "similarity": 0.96, "temperature": 0.3}], "fingerprint": "9af22de201de96781c4ab123a956f11cdf767dd6a5ac9ecdf89be951790d5efe", "generation_attempts": 2, "gold_answer": "Archduke Franz Ferdinand of Austria", "matched_aliases": ["Archduke Franz Ferdinand of Austria"], "query_id": "test2854", "question_hash": "63091c6d1f116d1038745483c5b36cc5213f0e8eee830a2c422d570e6926b843", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "380cf3ef10081802f5b41748869b9d86fe6dafe08ae7982f67e5e711b79881b2", "scope": "all_answer_documents", "seed": 1453247476, "similarity": 0.1337579617834395, "source_content_hash": "157f9b494a30e6f3ee52dc8b40778f9c3d3bee4c08c1f845f3868ab00803c66e", "source_hash": "7013884fbc189df179dd670f7ec303e7f08cfe8fe6980a5b2a3d630628849d08", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "fa2060475df5ebb635294ae82fe9fa56f74ad6762c0094d18a27daf1