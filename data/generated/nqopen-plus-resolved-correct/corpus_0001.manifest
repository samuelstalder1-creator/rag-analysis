{"doc_id": "doc42023", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "In both American and Canadian professional football, every player on the defensive team is considered eligible. The offensive team must have at least seven players lined up on the line of scrimmage. Of the players on the line of scrimmage, only the two players on the ends of the line of scrimmage are eligible receivers. The remaining players are in the backfield (four in American football, five in Canadian football), including the quarterback. These backfield players are also eligible receivers. In the National Football League, a quarterback who takes his stance behind center as a T-formation quarterback is not eligible unless, before the ball is snapped, he legally moves to a position at least one yard behind the line of scrimmage or on the end of the line, and is stationary in that position for at least one second before the snap, but is nonetheless not counted toward the seven men required on the line of scrimmage.", "reason": "near_duplicate_of_source", "seed": 1306977572, "similarity": 0.9983914209115281, "temperature": 0.3}], "fingerprint": "759273704ea930a0b60d7501c7984da864b4934a5a494a206d3133effe29afbf", "generation_attempts": 2, "gold_answer": "at least seven players", "matched_aliases": ["seven"], "query_id": "test1187", "question_hash": "3bcb1661d44b06741b1ddcf6f9143fa15f4c19394f28545c5d5961ea65efc1f4", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "281b1df1d1662ac13ad99cd23c211d9f8a70b8dc4aa285939198820202b28821", "scope": "all_answer_documents", "seed": 301879576, "similarity": 0.20051085568326948, "source_content_hash": "7c02d08f302dc8208477b124ccbfc6dd312e5cb7190ded4cc0e9d056d86d402e", "source_hash": "1c992ca306ba4e66a00838a255cfbacb512b0a37cd9b1a96fd2176e26597344c", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "38cc555922ca64853aa7529e82a97a06b7539305d703be695fe8c4cb42023e07", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc42128", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Super Bowl LII was an American football game played to determine the champion of the National Football League (NFL) for the 2017 season. The National Football Conference (NFC) champion Philadelphia Eagles defeated the American Football Conference (AFC) and defending Super Bowl LI champion New England Patriots, 41–33, to win their first Super Bowl[10] and their first NFL title since 1960. The game was played on February 4, 2018, at U.S. Bank Stadium in Minneapolis, Minnesota.[11] This was the second time that a Super Bowl was played in Minneapolis, the northernmost city to ever host the event, after Super Bowl XXVI at the Metrodome during the 1991 season,[12] and the sixth Super Bowl held in a cold-weather city.[13]", "reason": "near_duplicate_of_source", "seed": 924647966, "similarity": 0.9972413793103448, "temperature": 0.3}], "fingerprint": "3f4be50ee909345097b0ea3f07952b89c2e1d1b90d99341543e06a4b7d1ebd60", "generation_attempts": 2, "gold_answer": "Minneapolis, Minnesota", "matched_aliases": ["Minneapolis, Minnesota"], "query_id": "test1191", "question_hash": "801135ab513400fac7b4ca441fdd8753442a6a568ed8de54b757931f17f28d23", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "4d6d29d603723bd1d1e38f394cf3ebc6dd03a03a536b110f1240a7488e23f631", "scope": "all_answer_documents", "seed": 1234968837, "similarity": 0.21855345911949686, "source_content_hash": "28fdc2e050f422538c3fc07ea04c4fa99e3bbe413947593c4bb1f4fb7d29d20b", "source_hash": "8bb2c72500bc5016bc9d10a8090a45853f82634396a277c0fed0838eba8d0596", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "99a82021564554423d93616044e862ea0204f7feb44850dc3f23bc95b773e26b", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider"