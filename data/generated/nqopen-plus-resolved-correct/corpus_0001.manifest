{"doc_id": "doc12778", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The St. Albans Raid was the northernmost land action of the American Civil War. It was a controversial raid from Canada by Confederate soldiers meant to rob banks to raise money and to trick the Union Army into diverting troops to defend their northern border against further raids. It took place in St. Albans, Vermont, on October 19, 1864.", "reason": "near_duplicate_of_source", "seed": 276574529, "similarity": 0.9956204379562044, "temperature": 0.3}], "fingerprint": "c58339e2e74748a786ea400142a7382758fefd0c94332abcdc4823c8cd729b74", "generation_attempts": 2, "gold_answer": "St. Albans, Vermont", "matched_aliases": ["St. Albans, Vermont"], "query_id": "test334", "question_hash": "1297a1d838e05b006ae26e7e031919a60e9e5079190a82b89dc5c00b13e0d2a4", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "417ef3fe35c1683a7c97fcbd61d02e16f884ac2103c9c486a3d04c61997f5c86", "scope": "all_answer_documents", "seed": 2063796713, "similarity": 0.5496688741721855, "source_content_hash": "2cbd54c6c269afd499d3aea09c9f26f3d4035dd603800e50cb31845bc1874303", "source_hash": "e801f9a884c5ddaf2bf71812c644d73efec72a9dc877f942a7619a15db8d7ef9", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "d51bbee373c3ac464819a5d24217f65272b04dde3103efa79b279571a322dbea", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc12786", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Indian classical dance, or Shastriya Nritya, is an umbrella term for various performance arts rooted in religious Hindu musical theatre styles, whose theory and practice can be traced to the Sanskrit text Natya Shastra.", "reason": "near_duplicate_of_source", "seed": 1036171591, "similarity": 0.9605263157894737, "temperature": 0.3}], "fingerprint": "6c6563a95325e76409f5e1d7a24b5679f5cfc28d729566eb3e24c5c39c2d1a62", "generation_attempts": 2, "gold_answer": "the Sanskrit text Natya Shastra", "matched_aliases": ["the Sanskrit text Natya Shastra", "Natya Shastra"], "query_id": "test335", "question_hash": "ac181be7cea976ce6fef3739a3e3260c859138f034222489cca98f1a6ee0bef6", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "ba9d5b5812cb81ad3260d2e14d95600ee4f3f605dcc3da5af4ad908cd59840df", "scope": "all_answer_documents", "seed": 1665528429, "similarity": 0.18027210884353742, "source_content_hash": "27309f90e7d2e110ec19bf1bb50dac8e33cbb63bb75c5972e42d0f7cb974152f", "source_hash": "3c56d56a700420b575e2aa8f7e7ea528b0b4bafe8b43ada9d7604c7e7bd8a3f3", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "dc89e2e17b949914e03f2b158612571f8ecb05fc34c9eade8824301a8405e537", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
