{"doc_id": "doc98069", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The 2017 NFL season is the 98th and current season in the history of the National Football League (NFL). The season began on September 7, 2017, with the Kansas City Chiefs defeating the defending Super Bowl LI champion New England Patriots 42–27 in the NFL Kickoff Game. The season will conclude on February 4, 2018, with Super Bowl LII, which pits the National Football Conference (NFC) champion Philadelphia Eagles against the American Football Conference (AFC) champion New England Patriots.", "reason": "near_duplicate_of_source", "seed": 1808065450, "similarity": 0.9687814702920443, "temperature": 0.3}], "fingerprint": "1ba4f16cd459888464c6ca87a87683a6f0afa89f5796a518d5729d4e82556b19", "generation_attempts": 2, "gold_answer": "February 4, 2018", "matched_aliases": ["February 4, 2018"], "query_id": "test2867", "question_hash": "ae19402be378bb0282b0a95e4d6045340824e6fe7953a3915551c29729beb336", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "f1a16de309b3d9902b1e96fdcb252d21571f387b9400550fddc8a8a71b833897", "scope": "all_answer_documents", "seed": 496368071, "similarity": 0.39727891156462586, "source_content_hash": "0d07da35612baf5ecaa4fbf02557357b8debe71c7ecff12ed64f902120ca9927", "source_hash": "8ac61ace27934f25a9f7e8c3da99cc254805993c58fc18c68cf04c1411527353", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "74f87d64517883716cfb38ba67bae4483f888eaca557ca2168b17ca2e1945713", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc98116", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Zachary John Quinto (/ˈkwɪntoʊ/; born June 2, 1977) is an American actor and film producer. He is best known for his roles as Sylar on the science fiction drama series Heroes (2006–2010), Spock in the reboot Star Trek (2009) and its sequels Star Trek Into Darkness (2013) and Star Trek Beyond (2016), as well as his Emmy nominated performance in American Horror Story: Asylum. He also appeared in smaller roles on television series such as So NoTORIous, The Slap, and 24.", "reason": "near_duplicate_of_source", "seed": 1252327334, "similarity": 1.0, "temperature": 0.3}, {"attempt": 2, "generated_text": "Zachary John Quinto (/ˈkwɪntoʊ/; born June 2, 1977) is an American actor and film producer. He is best known for his roles as Sylar on the science fiction drama series Heroes (2006–2010), Spock in the reboot Star Trek (2009) and its sequels Star Trek Into Darkness (2013) and Star Trek Beyond (2016), as well as his Emmy nominated performance in American Horror Story: Asylum. He also appeared in smaller roles on television series such as So NoTORIous, The Slap, and 24.", "reason": "near_duplicate_of_source", "seed": 472041579, "similarity": 1.0, "temperature": 0.5}], "fingerprint": "626a4ad7e2e5359eca5fcaa98a719c7be7640ce58ac5a5c44f896b1b8f9d957a", "generation_attempts": 3, "gold_answer": "Zachary John Quinto", "matched_aliases": ["Zachary John Quinto"], "query_id": "test2868", "question_hash": "fc1329064f48b9a45f5f90b661c92f38d3bb803eea1af4e8a2f424797476f024", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "ecb8d0831ef443c17ec3e83e5465d1eca55052eba9a4da4e9265bb0a0b786fde", "scope": "all_answer_documents", "seed": 613320490, "similarity": 0.5195530726256983, "source_content_hash": "001cb73b89680d7b455f59dec097f2d323171fbcb97ab8b05e3660c73ceae555", "source_hash": "873e64491f7648db3f33f1dcf0d378fb332322e7be56132abbb6fc52