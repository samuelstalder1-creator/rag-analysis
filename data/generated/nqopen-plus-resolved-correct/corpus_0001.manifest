{"doc_id": "doc3852", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Ashrita Furman (born Keith Furman, September 16, 1954) is a Guinness World Records record-breaker. As of 2017, Furman has set more than 600 official Guinness Records and currently holds more than 191 records, thus holding the most Guinness world records. He has been breaking records since 1979.", "reason": "near_duplicate_of_source", "seed": 248865769, "similarity": 0.9800664451827242, "temperature": 0.3}], "fingerprint": "d68f5c6c08955e690f7dcdaae0ef11e88d275160787f32f6c611a5a4e018b2c2", "generation_attempts": 2, "gold_answer": "Ashrita Furman", "matched_aliases": ["Ashrita Furman"], "query_id": "test106", "question_hash": "5605ab0cc04c2d3dc1457b25fffe2c4c81f0151b5397f9209656945591b95441", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "e75614f2082c72efa212ba1df9b862b195a5012197a6b7f2c2003fde156e6c57", "scope": "all_answer_documents", "seed": 1595129583, "similarity": 0.3343558282208589, "source_content_hash": "89395198074bbeaffe208a0041d77f092844a84e4a387f53d85c7c2b528e8ccf", "source_hash": "f3258948297219df2cc6bcd6fdcfc4c947d275ed81a3300f2d928223b27f7c59", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "79aab51a159405063db608ed12900bb8fd1427f628d7e46a5ba192460ed4807b", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
