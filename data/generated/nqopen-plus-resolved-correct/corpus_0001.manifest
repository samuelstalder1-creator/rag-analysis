{"doc_id": "doc58443", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Johnny Crawford is an American character actor, singer, and musician who rose to fame at age 12 for playing Mark McCain, the son of Lucas McCain, in the popular ABC Western series, The Rifleman, which originally aired from 1958 to 1963.", "reason": "missing_gold_answer", "seed": 2008769301, "similarity": null, "temperature": 0.3}, {"attempt": 2, "generated_text": "Johnny Crawford (born March 26, 1946) is an American character actor, singer, and musician. At age 12, Crawford rose to fame for playing Mark McCain, the son of Lucas McCain (played by Chuck Connors), in the popular ABC Western series, The Rifleman, which originally aired from 1958 to 1963. Crawford first performed before a national audience as a Mouseketeer.", "reason": "missing_gold_answer", "seed": 1436203742, "similarity": null, "temperature": 0.5}], "fingerprint": "09c914f1d8bd2dcc182e897fe722e47f13e078022ce1c3e581c8b43da42fee98", "generation_attempts": 3, "gold_answer": "John Ernest Crawford", "matched_aliases": ["John Ernest Crawford"], "query_id": "test1650", "question_hash": "6bcc83c84029ce3ae318c8ce84eb113d8c3d83f9f6a1b70fea10034d57249728", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "16b467ab0b4b839059b2e416d7c9149943a4f358b0c97ddcd507c4c779590228", "scope": "all_answer_documents", "seed": 852728114, "similarity": 0.7465181058495822, "source_content_hash": "2dd6d10672215427c3ce2847023ccdbe1549e7a6d7335814f03ccf62e5c709f8", "source_hash": "78b4768993549bd1a5205e1c63f967890120e473e30e885475be80d9a501e2b7", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "d8fa42a95388cd0789c4a4d32836aa322b30d3f90519d41ca79b169c9b408279", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_ve