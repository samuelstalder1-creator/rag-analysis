{"doc_id": "doc108821", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Alaska Time Zone observes standard time by subtracting nine hours from Coordinated Universal Time (UTC−09:00). During daylight saving time its time offset is eight hours (UTC−08:00). The clock time in this zone is based on mean solar time at the 135th meridian west of the Greenwich Observatory.", "reason": "near_duplicate_of_source", "seed": 2112916718, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "e9843bf7660a0daec49f7bf2f9d37642366b1b541c52bc6c2107caac768ac070", "generation_attempts": 2, "gold_answer": "UTC−09:00", "matched_aliases": ["UTC−09:00"], "query_id": "test3190", "question_hash": "ea1338c888d13527055502a84069ce7baa8dc41e4eca03223df677790d570f63", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "05f1824deb861ceaf016d765857cc37819a854513517ccae3a3fa00babc5ef8a", "scope": "all_answer_documents", "seed": 1935782602, "similarity": 0.8674698795180723, "source_content_hash": "5478f0f74d74e4dcdf7f2840c3f6e97116ac98e36918f73359fa9af213cd25d0", "source_hash": "9717a55ab3b7123ad2ef7fcbc45bca0e942dd2ed4f19273b7594aaccd1414c86", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "863ba7066674321bd6341acd68bcbfa27458fcc119e3d45f733494beb7fcb973", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
