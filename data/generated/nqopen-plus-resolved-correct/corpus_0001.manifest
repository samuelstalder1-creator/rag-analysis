{"doc_id": "doc25262", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Middle-earth: Shadow of Mordor is an open world action-adventure video game developed by Monolith Productions and published by Warner Bros. Interactive Entertainment. The game was released for Microsoft Windows, PlayStation 4, and Xbox One in September 2014 and PlayStation 3 and Xbox 360 in November 2014. It is the second game set on Middle-earth to be rated Mature by the ESRB, after The Lord of the Rings: War in the North.", "reason": "near_duplicate_of_source", "seed": 874703232, "similarity": 1.0, "temperature": 0.3}, {"attempt": 2, "generated_text": "Middle-earth: Shadow of Mordor is an open world action-adventure video game developed by Monolith Productions and published by Warner Bros. Interactive Entertainment. The game was released for Microsoft Windows, PlayStation 4, and Xbox One in September 2014 and PlayStation 3 and Xbox 360 in November 2014. It is the second game set on Middle-earth to be rated Mature by the ESRB, after The Lord of the Rings: War in the North.", "reason": "near_duplicate_of_source", "seed": 1122656419, "similarity": 1.0, "temperature": 0.5}], "fingerprint": "63bebf181ce25a5678f207ecd238a72bbac21ab1eb20c5b8c60e706d07eb4ab0", "generation_attempts": 3, "gold_answer": "September 2014", "matched_aliases": ["September 2014"], "query_id": "test708", "question_hash": "fee25a2487485c211d88d70b01e02dc2224b089da69263bcb04133c15f022182", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "8ab29fb3bea40abe4eab0ee92d0ce5a1df32850f2b5efe52876b0d5e1e27b9a6", "scope": "all_answer_documents", "seed": 1075177307, "similarity": 0.7429906542056075, "source_content_hash": "6f78db0653f6a81d515465b619c611772d02c05abd95d3a8f1b870d7aff9aff6", "source_hash": "25cacdca6c15d6afc54b7f16c4ccc6d4cecd07b3b1eb81f66574ba598831b74e", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": fal