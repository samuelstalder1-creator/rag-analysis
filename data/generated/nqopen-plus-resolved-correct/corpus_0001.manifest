{"doc_id": "doc34122", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "John Hart (December 13, 1917 – September 20, 2009), also credited as John Hilton, was an American film and television actor who appeared mostly in Westerns. Although Hart played mostly minor roles in some fairly well known films, he was probably best known for having replaced Clayton Moore in 1952 in the television series, The Lone Ranger for one season from 1952 until 1953.", "reason": "near_duplicate_of_source", "seed": 119382978, "similarity": 0.9537275064267352, "temperature": 0.3}], "fingerprint": "74cb8b43e958c5ceed2dacb0e38ed177cebf7090a59872d5652c5ecf233c214f", "generation_attempts": 2, "gold_answer": "from 1952 until 1953", "matched_aliases": ["from 1952 until 1953"], "query_id": "test966", "question_hash": "59da5edd1ee4e05e19c0d8c9015724e18a6fd86765b9067fd56c009d5c51306d", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "d7d20c0b4035b8f1aec76409e46e1c7529b8e76b051e9d3688003a15adb7114f", "scope": "all_answer_documents", "seed": 357401045, "similarity": 0.2616279069767442, "source_content_hash": "3c16e6d3a7cccbbfac2f5d75896849b2f7bd957575651b5f8c0effbe9ebfebf4", "source_hash": "549cd6063dcd4b26be55668e0d010ddc744aeb1c05e44f533e881ab3db956e17", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "6faa34384b12d0cb682ae2bba19e500cc213dfebf8ee856ab43bd4c9a5d38890", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
