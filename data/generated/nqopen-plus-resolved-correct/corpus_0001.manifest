{"doc_id": "doc36338", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Cozonac (Romanian pronunciation: [kozoˈnak]) or Kozunak (Bulgarian: козунак, Bulgarian pronunciation: [kozuˈnak]), from Greek: ϰοσώνα ('doll', i.e. \"doll-shaped sweet bread\"), is a traditional Bulgarian and Romanian sweet leavened bread, which is a type of Stollen. It is usually prepared for Easter in Bulgaria, and mostly for every major holiday (Christmas, Easter, New Year's Day, Pentecost) in Romania and Moldova.", "reason": "near_duplicate_of_source", "seed": 943410748, "similarity": 0.9952153110047847, "temperature": 0.3}], "fingerprint": "41d3ca509832bb22aba3827f27c6b0a64b24c34eae2a36fe3fd4b741b6f0aeb1", "generation_attempts": 2, "gold_answer": "Kozunak", "matched_aliases": ["Kozunak", "Cozonac"], "query_id": "test1035", "question_hash": "ec5ee484274102d9155b68bccef8bd0b0d05c3a670a706965522b54b596b7dcf", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "a4945ce8d4287b5c3a7abf51c26fe25f9c0132f83ecc59394c94a62d8cb65d90", "scope": "all_answer_documents", "seed": 2077471773, "similarity": 0.054616384915474644, "source_content_hash": "9ee3a15d8e2f079fe4f94654a2c228dc0c82412c111eda0866f7211a17da2b12", "source_hash": "8e597159363593fa3631855ce7d2b04a46fba4fecf50f2782fda7787c27ad150", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "6898b9bbc72747d6ee683332f1f157fe33defa7c017247e5938d071788933c93", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
