{"doc_id": "doc28004", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Seth MacFarlane voices three of the show's main characters: Peter Griffin, Brian Griffin, and Stewie Griffin.[1] MacFarlane chose to voice these characters himself, believing it would be easier to portray the voices he had already envisioned than for someone else to attempt it.[2] MacFarlane drew inspiration for the voice of Peter from a security guard he overheard talking while attending the Rhode Island School of Design.[3] Stewie's voice was based on the voice of English actor Rex Harrison,[4] especially his performance in the 1964 musical drama film My Fair Lady.[5] MacFarlane uses his own voice while portraying Brian.[2]", "reason": "near_duplicate_of_source", "seed": 846966574, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "01c5e566df5725dec2e8c1c1eedbc2f9e02d545a2bf2791d0afca97dcdbec2e7", "generation_attempts": 2, "gold_answer": "Seth MacFarlane", "matched_aliases": ["Seth MacFarlane"], "query_id": "test784", "question_hash": "92b9b42d3f2786dee0bd69c42f5dbe8d18c80becfe0b8dc6cf4f983ade09f0b5", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "47f71c9321e57ca8cd333b52d3b4555ed941e77f79cebd95cff6827cd7457f52", "scope": "all_answer_documents", "seed": 593681344, "similarity": 0.0962962962962963, "source_content_hash": "f20d02f89f69e424fc0d9abd24768d84d8fdebd7f9c0f10d22db345515c1c73c", "source_hash": "7ec7dcfdba6787aaba961ee53fa48cd8fef4b4e840b5d2a067ce5294908f85dd", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "25bbf7371db6a4b0ee6e577734e2ee4a5a9e18479d7707968bb4bb313ea60c84", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_has