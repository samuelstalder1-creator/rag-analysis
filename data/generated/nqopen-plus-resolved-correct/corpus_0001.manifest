{"doc_id": "doc26444", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Succession to the British throne begins with Queen Elizabeth II as the sovereign, whose heir apparent is her eldest son, Charles, Prince of Wales. Next in line after him is Prince William, Duke of Cambridge, the Prince of Wales's elder son. Third in line is Prince George, the son of the Duke of Cambridge, followed by his sister, Princess Charlotte. Fifth in line is Prince Henry of Wales, the younger son of the Prince of Wales. Sixth in line is Prince Andrew, Duke of York, the Queen's second-eldest son. Any of the first six in line marrying without the sovereign's consent would be disqualified from succession.", "reason": "near_duplicate_of_source", "seed": 366187379, "similarity": 0.9503784693019344, "temperature": 0.3}], "fingerprint": "dde7e3af64b16102a7142efa7162defa9b5027c88620234067d4dd9ebd57a1a8", "generation_attempts": 2, "gold_answer": "Charles, Prince of Wales", "matched_aliases": ["Charles, Prince of Wales"], "query_id": "test740", "question_hash": "2732dfac8e8ff2b85ec3c89b28b3cec16ca0c0003ba50fb852e58527a34ca27c", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "f52b676a5ea0857dbf18426cc65fcde9e8844a0f3b97ced420be06c2fbf26de0", "scope": "all_answer_documents", "seed": 2139702953, "similarity": 0.27212020033388984, "source_content_hash": "07e1baafaf7b8cd40172b48efddc922eb96751fa19ce230bed951239c491e8d1", "source_hash": "68db6e1792452dddd34d76fabe309dada0b977ffce3819e9817bbad708443b50", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "dc5edd3979a3e54e94455bc0d49d1845939248fc9b18f8d1aded1543e9f313d2", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc26484", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Rick and Morty is an American adult animated science fiction comedy series created by Justin Roiland and Dan Harmon for Cartoon Network's late-night programming block Adult Swim. The series follows the misadventures of cynical mad scientist Rick Sanchez and his fretful, easily influenced grandson Morty Smith, who split their time between domestic life and interdimensional adventures. The show premiered on December 2, 2013, and the third season concluded on October 1, 2017. A fourth season has been mentioned, first by Harmon in a September 2017 interview, and later in the post-credits scene of the third season's finale. However, as of April 2018, its future remains uncertain.", "reason": "near_duplicate_of_source", "seed": 1247502462, "similarity": 0.9941520467836257, "temperature": 0.3}], "fingerprint": "f54833b0ae287fc5a9571945eb518cdf54e9075b93928461a3defd59f640e726", "generation_attempts": 2, "gold_answer": "late-night", "matched_aliases": ["late-night"], "query_id": "test741", "question_hash": "f767aed784454262653a90dd2e94c0482ee82ae77b2fb58a82f1bcbe678c206b", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "12106cdfa29442ddae0435ebfb8cc7a71fb090b163682c2f77e51fd7bc52bfd8", "scope": "all_answer_documents", "seed": 1808391405, "similarity": 0.9027181688125894, "source_content_hash": "cfa1602de5eccf84b4fa5a941dd45efa194800b784c29a24187febb7ac36a32d", "source_hash": "83891a230055bc0e0cbe1bc7c0734bd8393d1e1ff123ab2bc8d5cb99b8bad9d7", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "6062566036b792140ba86e1f8da3ed70c1745b2835b5760d10351aa765b507e1", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation",