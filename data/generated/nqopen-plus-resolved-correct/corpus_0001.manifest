{"doc_id": "doc92418", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"Girl, You'll Be a Woman Soon\" is a song written by American musician Neil Diamond, whose recording of it on Bang Records reached number 10 on the US pop singles chart in 1967. The song enjoyed a second life when it appeared on the 1994 Pulp Fiction soundtrack, performed by rock band Urge Overkill. Other versions have been recorded by Cliff Richard (1968), Jackie Edwards (1968),[1] the Biddu Orchestra (1978), and 16 Volt (1998).", "reason": "near_duplicate_of_source", "seed": 976003271, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "2ec60a5909e0cca9753792f5c52d8f1352d4018cdb8c2f9ceb235cf45a22a8e3", "generation_attempts": 2, "gold_answer": "rock band Urge Overkill", "matched_aliases": ["rock band Urge Overkill", "Urge Overkill"], "query_id": "test2699", "question_hash": "ee96831bc3e9da3f715ed180998f995523471b3cddd675552ac59420b887bca4", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "31a1b5851304ad008ac791f472c3562603931cd25717e37e9892a3582ab07751", "scope": "all_answer_documents", "seed": 1490543262, "similarity": 0.23471074380165288, "source_content_hash": "fd4850631095ac976972e0778f90be2f4c2cda6f6f26ec9b6a273cb8e099e4ca", "source_hash": "76fdc557a12ed22251737aa930139f20e9ea4b61b4f8c9d01c16b6fbaf08e097", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "3641fdffd668e45bdcbe8276b4536157908a5102bbfd9cc0ee16b641c2a1259b", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
