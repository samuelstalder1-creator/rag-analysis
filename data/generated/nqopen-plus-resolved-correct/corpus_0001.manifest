{"doc_id": "doc79617", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Chota Nagpur Division became part of the new province of Bihar and Orissa when it was created in 1912. In 1936 the province was split into the separate provinces of Bihar and Orissa, and the princely states were placed under the authority of the Eastern States Agency.", "reason": "near_duplicate_of_source", "seed": 1943992401, "similarity": 0.9944341372912802, "temperature": 0.3}], "fingerprint": "4919aa94290d746eab8f2708710faadbe07f31b4d27ba861c90253f2b2aa7c4d", "generation_attempts": 2, "gold_answer": "1912", "matched_aliases": ["1912"], "query_id": "test2302", "question_hash": "3a2ddd4e8578bb5bfac8ca16787c41a3271abd90b83501b69d47eb933bbfb2c6", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "688607e9f969cb7810129003ffd182b177ffe2e7c224e0b8974a3430eeb58956", "scope": "all_answer_documents", "seed": 1988842552, "similarity": 0.3095599393019727, "source_content_hash": "b93cf8b98f4fb51ba52e2f716d759c1493ddb0f253eb8f4e4e1b7f1efff16fd8", "source_hash": "b75ac0853a88ffc70b5b7836d596209a83f8dd44c94a64da9bda53594332b21b", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "3d3c9fc29e2d2fba4e753fe4fdb97f447a2eb4a0ce62c8c1ba3a6d2a8ff4b59f", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
