{"doc_id": "doc16745", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"Heroes and Villains\" is an episode of the BBC sitcom, Only Fools and Horses, first screened on 25 December 1996 as the first part of the 1996 Christmas trilogy and the thirteenth Christmas special. It attracted a UK television audience of 21.3 million, at the time a record for the show. In the episode, Del and Rodney are invited to a fancy dress party. They arrive dressed as Batman and Robin.", "reason": "near_duplicate_of_source", "seed": 1211393012, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "e8f49ae4c46e9607b75c092266ee6268718fc13dc1ec7e4767b53b218ca3fbae", "generation_attempts": 2, "gold_answer": "\"Heroes and Villains\"", "matched_aliases": ["\"Heroes and Villains\""], "query_id": "test453", "question_hash": "a1cdc09486adda922caec3f7edd20c931271320028f9337a279cb2f4728882bb", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 2, "row_hash": "a530ffb440319fe02401c76571c312c1c41594e6106b6ee7a94c901de477f0d9", "scope": "all_answer_documents", "seed": 1251144221, "similarity": 0.22446043165467625, "source_content_hash": "6e3f4821af39a5a1d46794114a9b6c61389e78d6f5b35407d1a48a5d5b06bbb9", "source_hash": "ca1ba0ccab81bc5d38dceb41855bf1ba0ba44b66b97bf49a1c35f5f14dfee409", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "62829c67a7973d01016e77e3f96bd5288a45a2ed30aeadedf4c5ca0bcabdaf03", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc20117", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Ray Donovan is an American television crime drama series created by Ann Biderman for Showtime. The show premiered with a twelve-episode first season on June 30, 2013. Showtime renewed the series for a fourth season, which premiered on June 26, 2016. On August 11, 2016, Showtime renewed the show for a fifth season, which premiered on August 6, 2017. On October 23, 2017, the series was renewed for a sixth season, to be filmed in New York City and debut in 2018.", "reason": "missing_gold_answer", "seed": 323567366, "similarity": null, "temperature": 0.3}, {"attempt": 2, "generated_text": "Ray Donovan is an American television crime drama series created by Ann Biderman for Showtime. The twelve-episode first season premiered on June 30, 2013. The pilot episode broke viewership records, becoming the biggest premiere of all time on Showtime. Showtime renewed the show for a fourth season, which premiered on June 26, 2016. On August 11, 2016, Showtime renewed the show for a fifth season, which premiered on August 6, 2017. On October 23, 2017, the series was renewed for a 12-episode sixth season, to be filmed in New York City and debut in 2018.", "reason": "missing_gold_answer", "seed": 2047597146, "similarity": null, "temperature": 0.5}], "fingerprint": "cabaef68556973cd499809a493ca65b9ad4286b266e2b0a9d53213cf9b25843b", "generation_attempts": 3, "gold_answer": "5", "matched_aliases": ["five"], "query_id": "test552", "question_hash": "f07965bc70b9fb1f2bdaa01dfd0b83069f5bd0292d9d9d16928df5f27f773ced", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 2, "row_hash": "52a683962dc499062d59572a3b2d13b3a73bb2569fd08c9ea518cb99ae963964", "scope": "all_answer_documents", "seed": 1862330472, "similarity": 0.2971548998946259, "source_content_hash": "9954498ec31f7dfd336e3ecc589d01a33d8c5fa61e0b08b87bea9cee84f725aa", "source_hash": "b87cd5293420b0ab5ca67dab05245e7e9257057e939cca6fbab2792c7a331986", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "5ec9b8a01612d87fd9ef1be494bca8c24c7ae0c8e7d861a7c935e98b30da8680", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc32833", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "It is frequently claimed that annual accounts have not been certified by the external auditor since 1994. In its annual report on the implementation of the 2009 EU Budget, the Court of Auditors found that the two biggest areas of the EU budget, agriculture and regional spending, have not been signed off on and remain \"materially affected by error\".", "reason": "near_duplicate_of_source", "seed": 775288655, "similarity": 0.9943181818181818, "temperature": 0.3}, {"attempt": 2, "generated_text": "It is frequently claimed that annual accounts have not been certified by the external auditor since 1994. In its annual report on the implementation of the 2009 EU Budget, the Court of Auditors noted that the two biggest areas of the EU budget, agriculture and regional spending, have not been signed off on and remain \"materially affected by error\".", "reason": "near_duplicate_of_source", "seed": 1423312344, "similarity": 0.9829545454545454, "temperature": 0.5}], "fingerprint": "2b3bb2a08ded71d326c2496a041e65b2ae7fc8c37809a61857b1dcc47c5bf145", "generation_attempts": 3, "gold_answer": "1994", "matched_aliases": ["1994"], "query_id": "test922", "question_hash": "04beff900e55db6995a272a5171d15a101697eba6e55c835c98e7cabfbb4e3f7", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 2, "row_hash": "384d41277cd4ae9f6f9f76b5d01bea449910d65b4283c737e9a8f4608f7fc88b", "scope": "all_answer_documents", "seed": 207866956, "similarity": 0.883453237410072, "source_content_hash": "7de9e3f1981ece89e62f88489e0b918f5f2516af5af3b005fd25169b32cf2783", "source_hash": "cda0f9aff6dcdd7b2ca3195e957d0e7954bba3e407b312bf484a676fc796a1fa", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "290cd765f57466a41cd5100986b24088afac3ccf39cba9d02ee9c7604a10bf10", "format_attempts": [], "judgment": {