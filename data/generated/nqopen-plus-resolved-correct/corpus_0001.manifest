{"doc_id": "doc77844", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"Boom\" is a song by American rock band P.O.D. It was released in May 2002 as the third single from their second major label studio album Satellite. While it did not chart as well as the album's previous singles, the song has appeared significantly in film and television. \"Boom (The Crystal Method remix)\" was included on the remix album Community Service and as a bonus track on the special edition re-release of Satellite available August 27, 2002. A limited edition, gatefold picture disc of the single was also available in the UK.", "reason": "near_duplicate_of_source", "seed": 48567515, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "616582796d90b523a613f38981731d5a235ce6edfd3546835cc7ac78aba6f171", "generation_attempts": 2, "gold_answer": "May 2002", "matched_aliases": ["May 2002"], "query_id": "test2241", "question_hash": "2f5fcddd0e0fcb6583963ea06b544c8ee5d321c09c3239d07881b8af4eef5c31", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "1ff4cd195f0797aa2b1ff677403de20ac3afc10aea7af8f608fd6bf36b271bbd", "scope": "all_answer_documents", "seed": 2043698753, "similarity": 0.830739299610895, "source_content_hash": "cc507e0a78ed53f4d287325cb35d8e107ca10353d831f14f71f88ebbb6909ea7", "source_hash": "463453d3656be6673ed731b3d742cf1f5a1235464e1de34b11e0993daea6ceae", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "ea7c27252fe8df07bc148604dfb3094dbb7c1b83124a8a7aa4b776d7d481e301", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal":