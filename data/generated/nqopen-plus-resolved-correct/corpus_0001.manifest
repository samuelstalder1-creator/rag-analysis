{"doc_id": "doc38780", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Robert Gillespie Adamson IV (born July 11, 1985) is an American actor who has portrayed the roles of Phil Sanders on the television series Hollywood Heights and Charles Antoni on Lincoln Heights. He currently stars as Noah Newman on The Young and the Restless.", "reason": "near_duplicate_of_source", "seed": 1694971858, "similarity": 0.9846153846153847, "temperature": 0.3}], "fingerprint": "487785dd39f4ff8694f645a1291932ec4f9bf6aafe2761a581a73953319300d5", "generation_attempts": 2, "gold_answer": "Robert Gillespie Adamson IV", "matched_aliases": ["Robert Gillespie Adamson IV"], "query_id": "test1105", "question_hash": "2965ffe3efa5860ded03f4e476d59b2145d643f2d9f5ebd7f2f3e16ffdbead7e", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "33772edc0dd3b1251c7edf9d889e26aefb1c46c1f78416bd6f40ee5cda973721", "scope": "all_answer_documents", "seed": 1273011133, "similarity": 0.7145708582834331, "source_content_hash": "f4072250236daa39c886cfcb89d02c5a47dc8cf8cd1a45cff9a0457daca99e70", "source_hash": "cc0da409b935d5f7ad35d2218c91e386791807fa7c75bef6154fad65810f039f", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "612a4890e0ce82d47e4f79153fa8215febcf50fbb55e0ced592fc25579d9a859", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc38786", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The pula was introduced in 1976, replacing the South African rand at par. Despite a 12% devaluation in May 2005, the pula remains one of the strongest currencies in Africa.", "reason": "near_duplicate_of_source", "seed": 201446213, "similarity": 0.9529085872576177, "temperature": 0.3}, {"attempt": 2, "generated_text": "The pula was introduced in 1976, replacing the South African rand at par. Despite a 12% devaluation in May 2005, the pula remains one of the strongest currencies in Africa.", "reason": "near_duplicate_of_source", "seed": 915484347, "similarity": 0.9529085872576177, "temperature": 0.5}], "fingerprint": "8fbed4cc46c3a3406cfd4c584fb8cc3c7f3f6b7613db0947d742120f5eef45ff", "generation_attempts": 3, "gold_answer": "1976", "matched_aliases": ["1976"], "query_id": "test1106", "question_hash": "eeab4eec02d0a121cf6cfd48106c468d1fa419c647e257b315342c0549b483a2", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "170229269cf45c1018af7d61c33cfa9ce574e61810f2a746bd9825cedfb603ae", "scope": "all_answer_documents", "seed": 714085410, "similarity": 0.6837060702875399, "source_content_hash": "a48d94510c9fb5c1c6db66b5a40ed246b2d051f92dcc4d2647ac2e52a0587762", "source_hash": "d300f2e93e7d55c05e042bb31397a0f4ab5d93ed649952b3246eee31f4369cb5", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "f71c765b24024ee0697daf5f12c81cf61fab943e705a97a9b1a1c9f56611b7c9", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc39046", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Catherine Tramell is a fictional character and main antagonist in the film Basic Instinct (1992) and its sequel, Basic Instinct 2 (2006). Catherine, created by writer Joe Eszterhas, is played by Sharon Stone in both films. In Basic Instinct, Tramell is a serial killer and love interest of washed-up detective Nick Curran; Basic Instinct 2 pairs her with the similarly troubled British psychologist Michael Glass.", "reason": "near_duplicate_of_source", "seed": 986886752, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "aaab7515c211cd128c520a81aceabc4c9c76ee5004489bfc17b7d7d965784900", "generation_attempts": 2, "gold_answer": "Catherine Tramell", "matched_aliases": ["Catherine Tramell"], "query_id": "test1109", "question_hash": "9d3e04b7274f61d247e95deaa42bcf64a3876b8a94f8ef0bb0a327b9d35e0546", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "4b20d1321104ce8cd9af2fc3303ea67b3353c8ad5178438851315449c48b102c", "scope": "all_answer_documents", "seed": 1313455366, "similarity": 0.08920863309352518, "source_content_hash": "fd37508ad4b1d55273040b360ec9feabddcdb1e7b2db8300b579555e00e9c631", "source_hash": "b28c39320149fc7defd0f056040c1c5d6944ca3b20e0755f83fb295b2ce44ec0", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "99e9259ac730c28eb88145f47da9512d915890a782f95b46ccab81a361a19ed1", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc39111", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Easter Bunny (also called the Easter Rabbit or Easter Hare) is a folkloric figure and symbol of Easter, depicted as a rabbit bringing Easter eggs. Originating among German Lutherans, the \"Easter Hare\" originally played the role of a judge, evaluating whether children were good or disobedient in behavior at the start of the season of Eastertide.[1] The Easter Bunny is sometimes depicted with clothes. In legend, the creature carries colored eggs in his basket, candy, and sometimes also toys to the homes of children, and as such shows similarities to Santa Claus or the Christkind, as they both bring gifts to children on the night before their respective holidays. The custom was first[2][unreliable source?] mentioned in Georg Franck von Franckenau's De ovis paschalibus[3] ('About Easter Eggs') in 1682, referring to a German tradition of an Easter Hare bringing Easter eggs for the children.", "reason": "near_duplicate_of_source", "seed": 1010498269, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "d3677ea386ea565959c9e16ec4009b68001a32032cb02bd45c253693c2f091cd", "generation_attempts": 2, "gold_answer": "German Lutherans", "matched_aliases": ["German Lutherans"], "query_id": "test1113", "question_hash": "60f65a004571895d2720da484e6fa34e74cdf92ccc54f0bfea455ce08451655e", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "0c200747eb76cf1b934680fca596b77be88df472f7e463c9936f1792749080f9", "scope": "all_answer_documents", "seed": 1080277449, "similarity": 0.2309124767225326, "source_content_hash": "09ebbeb4d0a7030d9fdeb4877cfe688820e4b592263d20f7e34e5eef2abe0950", "source_hash": "3589f59337d435c246482f2bb75d9df2e7405ffaae0687dae00ec99477613a7d", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "c09b2ff90ad74f7ffb9c9a2a59f0036ac60f7c7c0e1c26d73ee559d9f9a9b3eb", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc39126", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Star Trek: Discovery premiered on September 19, 2017, at ArcLight Hollywood, before debuting on CBS and CBS All Access on September 24. The rest of the 15-episode first season was streamed weekly on All Access. The series' release led to record subscriptions for All Access, and positive reviews from critics who highlighted Martin-Green's performance. A second season was ordered in October 2017.", "reason": "near_duplicate_of_source", "seed": 1706217638, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "fc73b3a8b9cc3c363c9fbfebc473fb688b0053d59d1b13272ae5022276cf354f", "generation_attempts": 2, "gold_answer": "September 19, 2017", "matched_aliases": ["September 19, 2017"], "query_id": "test1114", "question_hash": "9dbcf629da45252c9894fc57bb537634bf6bd277ebc9bf4566f78acd1d55689d", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "43450ff400a25c65599589009e2d67201dd294a98402839c88da974217443368", "scope": "all_answer_documents", "seed": 481443142, "similarity": 0.9238578680203046, "source_content_hash": "7556aead67a5cb790b738b66c486afcfd39f8071e07e91c3607db05501e6eeb4", "source_hash": "d3b680f491202fa52684af24341582d9120855cf6471c3c9bc40dfebe87c5aec", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "15b1f81ef3ed3c273d39ec03980d6b00d397146705cf53cb794fb1f259a5348a", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
