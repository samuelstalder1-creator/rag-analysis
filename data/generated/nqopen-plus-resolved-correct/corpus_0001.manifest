{"doc_id": "doc108758", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"Thriller\" has appeared on multiple greatest hits compilation albums from Jackson, including HIStory (1995), Number Ones (2003), The Essential Michael Jackson (2005) and Michael Jackson's This Is It (2009) and was remixed for the Immortal album in 2011. The song has a voice-over from actor Vincent Price.", "reason": "near_duplicate_of_source", "seed": 2003585217, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "f3012ee995d08227e20b14f33c27709d6f077dd066d987223d1c4ab99557d116", "generation_attempts": 2, "gold_answer": "Vincent Price", "matched_aliases": ["Vincent Price", "actor Vincent Price"], "query_id": "test3188", "question_hash": "381a3e3ebd5cf1f40222d5c2458bd9c092572f9237e6be88ba961b9d67a1c6f8", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "2df2b5e22f436a1aa6faf5c3b01a32df62b173e3a86833642a59be099144a8a8", "scope": "all_answer_documents", "seed": 177406536, "similarity": 0.16247582205029013, "source_content_hash": "8205c32ac08daf57c81ee0f17d4c2533181f6016712042cadbef61837e6c8344", "source_hash": "fb39027c68ecce821c6d70c8fbf29c94b5932fe89a057364c6b89e88ea375483", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "26a63f47f1e79e52df6245bd3b1fe0ef314be43b2e369415dc3c751376e04474", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc108763", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "While Temperton was writing \"Thriller\" he stated that he'd \"always envisioned\" a \"talking section at the end\" on the song, but did not really know what \"to do with it\", until deciding \"to have somebody, a famous voice, in the horror genre, to do this vocal.\" Jones' then-wife, Peggy Lipton, who knew Vincent Price, suggested Price for the vocal part, which Price agreed to do.", "reason": "near_duplicate_of_source", "seed": 231637863, "similarity": 0.9920844327176781, "temperature": 0.3}], "fingerprint": "e8d993f57ed86a150f40e335c29fb2bfb789715a4aebd1f54733931a2ee84477", "generation_attempts": 2, "gold_answer": "Vincent Price", "matched_aliases": ["Vincent Price", "actor Vincent Price"], "query_id": "test3188", "question_hash": "381a3e3ebd5cf1f40222d5c2458bd9c092572f9237e6be88ba961b9d67a1c6f8", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "b9c8ce4f8a5ddfd49f3e771932d37d27232d164d9f26d7e0fcac35c8043b0e8f", "scope": "all_answer_documents", "seed": 1266800229, "similarity": 0.1646746347941567, "source_content_hash": "bd46fa1d58725878638ad691d5b9197530ad4d649fe30489c3205a408f1b99dd", "source_hash": "a55fa4bad37716edf542e5e83dc87f09068227063b94e5820790fd9e087f4bff", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "83251b45f9d8fe16270bfcbb165ec54ede43ec9cd05e404e387db369a0cbd148", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
