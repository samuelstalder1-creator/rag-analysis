{"doc_id": "doc36967", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Bohrium is a synthetic chemical element with symbol Bh and atomic number 107. It is named after Danish physicist Niels Bohr. As a synthetic element, it can be created in a laboratory but is not found in nature. It is radioactive: its most stable known isotope, 270Bh, has a half-life of approximately 61 seconds, though the unconfirmed 278Bh may have a longer half-life of about 690 seconds.", "reason": "near_duplicate_of_source", "seed": 1049806617, "similarity": 0.9948849104859335, "temperature": 0.3}], "fingerprint": "d7f8b5f8357ebf10fa805a1a3eb917a0a0252a709ae3149aa765c5bf431e34c0", "generation_attempts": 2, "gold_answer": "Bohrium", "matched_aliases": ["Bohrium"], "query_id": "test1061", "question_hash": "38b188669e43ff8b8866586453fd1efdf2a084819069130d68a5260da9d90518", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "07621aee8c50d45c954f9e5408a0f7ae39cd8fa7615c744c7a649f172620b0f2", "scope": "all_answer_documents", "seed": 2049001032, "similarity": 0.3111668757841907, "source_content_hash": "37b7597e1917054e72e19fa6b0cd3850312dab43ed699e81682c3b9cbfed585d", "source_hash": "1c00406db064c8077377ec0212b6556d66d5de6e5aa54b79f55e4e95f01e5c3e", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "998077fa3a366615d488231dd79f54cd91e4e465c162c2ae2c07e18793aae45a", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
