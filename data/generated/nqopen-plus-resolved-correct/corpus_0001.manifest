{"doc_id": "doc94704", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The current House of Representatives, formed following elections held in April 2015, has a total of 360 members who are elected in single-member constituencies using the simple majority (or first-past-the-post) system. Members serve four-year terms. The Speaker of the Nigerian House of Representatives is the presiding officer of the house.", "reason": "near_duplicate_of_source", "seed": 1343605831, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "9a584618e6c25bc24d3661adc8cdaa87e8d45f4e59049f533165f66b15048716", "generation_attempts": 2, "gold_answer": "360", "matched_aliases": ["360", "360 members"], "query_id": "test2750", "question_hash": "3a018e772c8e1096e2106cd9299a088e6e04ce609c0802de3cfb45115ab6b051", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "8d9005e217c786b7971172fed7171401df18fd7de1619f9aaba0bb38bff7a318", "scope": "all_answer_documents", "seed": 1535290829, "similarity": 0.14084507042253522, "source_content_hash": "288ba847cb40f5e87c51040af3b1a4829cf83b5b0bea2b74e5488a10b07d6af8", "source_hash": "9708080c683b6c92bcff02279f312b599fc0b58e8864cd5f364ab5fe65d9105a", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "f05ba02a3660057013b7a7357d8f857227fc191e5632ae3d6818a57b567bfc11", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc94705", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Daniel Francis \"Dan\" Haggerty (November 19, 1941 – January 15, 2016) was an American actor, best known for playing the title role in The Life and Times of Grizzly Adams.", "reason": "near_duplicate_of_source", "seed": 1219259468, "similarity": 0.9710982658959537, "temperature": 0.3}], "fingerprint": "f666c056c99edb70e8bea9f28cea1d55e7e6be32ac54735986c16b14c11c6898", "generation_attempts": 2, "gold_answer": "\"Dan\" Haggerty", "matched_aliases": ["\"Dan\" Haggerty"], "query_id": "test2751", "question_hash": "5b5604e13bf71c8f2c3bb6a20fb2a0a150a2380fc2a605c5822b890fd2a4599f", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "50b9a6e3d15948c8ba049d66c8c0be3332a695eda889e548708475051eda7bf2", "scope": "all_answer_documents", "seed": 1292373776, "similarity": 0.8355795148247979, "source_content_hash": "ea03de88b03fdd218c261421fddc43d06d9d51947b5d57cbecb5aacb1e965589", "source_hash": "7b0fe56c3c62151ef75524d0195caa1d85489f2a8c3d7ebdef0d653a1927ed79", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "62016a88be7c99520b77a96f93f122ad61d6f23f4c897ae468c5b133d9d1d804", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc94719", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"Blame It on the Bossa Nova\" is a song written by Cynthia Weil (lyrics) and Barry Mann which was a 1963 hit single for Eydie Gormé, reaching number 7 on the Hot 100 in Billboard in March 1963. The song also peaked at number 23 in the UK, whereas \"Yes, My Darling Daughter\" became the biggest hit for Eydie there, reaching number 10.", "reason": "near_duplicate_of_source", "seed": 1554368588, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "f5f517726fd0120c962794ecb22dda0e6e3fccdec2c17258f3d5ae48495a1ced", "generation_attempts": 2, "gold_answer": "Eydie Gormé", "matched_aliases": ["Eydie Gormé"], "query_id": "test2752", "question_hash": "d59b5b8b50ffdb1a0e0478120f2c10ca6702d240584146c36534e4e49e61fe15", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "dc992b0d1d977bd04341505404e8766d3597223710fcee312588c9a89b5380a1", "scope": "all_answer_documents", "seed": 543106952, "similarity": 0.14102564102564102, "source_content_hash": "620e68e5af5a902a0bb2fc0f0d5ad7d9e4c6d042440ec3343272875a92c9bbad", "source_hash": "a6e889e504a43d73ea4c6581d0163613aa2dd8d8188b14129e3ffd9ba9de2827", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "56cb7c0bad5ff38ed1ad14d7578c74fafdb06019751db2e1d506ea66e8abef04", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc94821", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Konakuppakatil Gopinathan Balakrishnan (K. G. Balakrishnan) (b. 12 May 1945) was the former Chairperson of the National Human Rights Commission of India. He is a former Chief Justice of India.", "reason": "near_duplicate_of_source", "seed": 2043009080, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "bb7acc3a803006aa4d394c709b1f5bbbbe2d030064449d901d7265e1278ea9da", "generation_attempts": 2, "gold_answer": "Konakuppakatil Gopinathan Balakrishnan", "matched_aliases": ["Konakuppakatil Gopinathan Balakrishnan"], "query_id": "test2754", "question_hash": "6f7e6c5ec3e1c828167f19a765f7f3a9633200587ea1e6ca65f35dc76389b9f1", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "8a0eae34ffddb6b583f8efcb44ad9bc4f762a4005aa6a4629feb1abdfb280a5e", "scope": "all_answer_documents", "seed": 575648162, "similarity": 0.7252747252747253, "source_content_hash": "941d53c84a89a9e2cbf0b7c619a0abbda72913c22d94fc67a42865cbe73cb04f", "source_hash": "aff1afa816921a19e4a997d7c239b9ee36aa70963bb83cc67f8a84a50f89fe5a", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "2c9e24538282e3d26df936d0964c94b51489f62511541b33988c3b66d462652a", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc94891", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Los Angeles Lakers are an American professional basketball team based in Los Angeles. The Lakers compete in the National Basketball Association (NBA), as a member of the league's Western Conference Pacific Division. The Lakers play their home games at Staples Center, an arena shared with the NBA's Los Angeles Clippers, the Los Angeles Sparks of the Women's National Basketball Association, and the Los Angeles Kings of the National Hockey League.[10] The Lakers are one of the most successful teams in the history of the NBA, and have won 16 NBA championships (11 in Los Angeles), their last being in 2010.", "reason": "near_duplicate_of_source", "seed": 98595019, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "ba355086ffd76f63f7c068f0ab047bb05a3ef585c6ab170164a8e2e7a4b6adf8", "generation_attempts": 2, "gold_answer": "2010", "matched_aliases": ["2010", "in 2010"], "query_id": "test2757", "question_hash": "fd84ad0805cda14e797cb41986129ef2791d89434d69c74dbd48b14f9a8a5a79", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "d0b78ec2d85b5ceab23508e5feca4749c7c39a0bcbf0d66a01740e6a54a0d73b", "scope": "all_answer_documents", "seed": 1848670788, "similarity": 0.30008673026886384, "source_content_hash": "d93005d68e0cc3e70dda7d7cfce241dbc5819620c13597a1c8781ce39cca59fb", "source_hash": "00c3b9aa8ba34f2df8426185eb25f1c66c79e64b3136a0a0ae9b9b4e30d900f5", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "3c16387920dabc97daf53a969be8695983e54078f0d52006f54a338cd27b00a0", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc94893", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Led by Hall of Famers Elgin Baylor and Jerry West, Los Angeles made the NBA Finals six times in the 1960s, but lost each series to the Boston Celtics, beginning their long and storied rivalry. In 1968, the Lakers acquired four-time NBA Most Valuable Player (MVP) Wilt Chamberlain to play center, and after losing in the Finals in 1969 and 1970, they won their sixth NBA title—and first in Los Angeles—in 1972, led by new head coach Bill Sharman. After the retirement of West and Chamberlain, the team acquired another center, Kareem Abdul-Jabbar, who had won multiple MVP awards, but was unable to make the Finals in the late 1970s. The 1980s Lakers were nicknamed \"Showtime\" due to their Magic Johnson-led fast break-offense, and won five championships in a 9-year span, including their first ever Finals championship against the Celtics in 1985. This team featured Hall of Famers in Johnson, Abdul-Jabbar, and James Worthy, and a Hall of Fame coach, Pat Riley. After Abdul-Jabbar and Johnson's retirement, the team struggled in the early 1990s before acquiring Shaquille O'Neal and Kobe Bryant in 1996. Led by O'Neal, Bryant, and another Hall of Fame coach, Phil Jackson, Los Angeles won three consecutive titles between 2000 to 2002, securing the franchise its second \"three-peat\". After losing both the 2004 and 2008 NBA Finals, the Lakers won two more championships by defeating the Orlando Magic in 2009 and Boston in 2010.", "reason": "near_duplicate_of_source", "seed": 471504311, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "9aa32b9ec1a4a6f06aaebe2278fe43eecf6f2862b4b96df0beb4d7d056c2e03f", "generation_attempts": 2, "gold_answer": "2010", "matched_aliases": ["2010", "in 2010"], "query_id": "test2757", "question_hash": "fd84ad0805cda14e797cb41986129ef2791d89434d69c74dbd48b14f9a8a5a79", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "215d978c14075790986a2e23c7e58e19f58221cc139da3e45b5d67914a979728", "scope": "all_answer_documents", "seed": 1897521466, "similarity": 0.39281788200806156, "source_content_hash": "5b0be2eaf216891c0b76ddaba6f30b5a8fea10d9c0c445003c7c7d4088080746", "source_hash": "2290eeac50ba4b93d1cb5decb4a91d7456243859ff9a43bb2abbad4f5cb593e1", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "14cb4c49936c777c3b39d903d058faca250862b776ceb92863c91452dd5f1d71", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc94998", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"Should've Been a Cowboy\" is a song written and recorded by American country music artist Toby Keith. It was released on February 8, 1993 as his debut single, and was served as the first single released from Keith's self-titled debut studio album, Toby Keith. On June 5, 1993, it reached number one on the US Hot Country Songs chart and the Canadian RPM Country Tracks. It also peaked at number 93 on the Billboard Hot 100, making it a minor crossover hit.", "reason": "near_duplicate_of_source", "seed": 1041070890, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "62c0b742bfe5742739ed1c793a868679ca0716926c3085684299b022b9b93e78", "generation_attempts": 2, "gold_answer": "Toby Keith", "matched_aliases": ["Toby Keith"], "query_id": "test2760", "question_hash": "44bae1c1f43f447c8b19dabb53d370f0285b4d4c6c20fcae8bcaa177c47dfc75", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "a1b1c4a3d55ce876490065b9812508c885646f5b3da4c89cccd6da5ae513fdd3", "scope": "all_answer_documents", "seed": 1993152924, "similarity": 0.26225165562913905, "source_content_hash": "2eb737e54ff3ee7d2cef8ce53cc984a887c70d0aaa69a65bc8fc1a3ffc4fc8d7", "source_hash": "847ccaac05678174a2fea9137ed1b736432e78d86a3de3806370ffa9319fd3fb", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "5011f5c3e9739cb93e4bddac6030bad472c6b4b90d351294a6024be3939734e2", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
