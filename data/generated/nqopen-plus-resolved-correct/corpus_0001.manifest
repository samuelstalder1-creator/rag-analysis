{"doc_id": "doc1729", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Theme from Mission: Impossible is the theme tune of the TV series Mission: Impossible (1966â€“1973). The theme was written and composed by Argentine composer Lalo Schifrin and has since gone on to appear in several other works of the Mission: Impossible franchise, including the 1988 TV series, the film series and the video game series. The 1960s version has since been acknowledged as one of TV's greatest theme tunes.[1]", "reason": "near_duplicate_of_source", "seed": 644243109, "similarity": 0.9976415094339622, "temperature": 0.3}], "fingerprint": "05846b9c067f12de64f7871c2b3e4a9ec5c66b68a748886b55915d38e4f89a11", "generation_attempts": 2, "gold_answer": "Lalo Schifrin", "matched_aliases": ["Lalo Schifrin", "Argentine composer Lalo Schifrin"], "query_id": "test62", "question_hash": "04133361f4a980764d23fdc5746054457a3fd49f5682eeb005777d2201807d6f", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "2a726107bce1b8207fe2bcfb2045a57ae9c131371884b99715006f570f876128", "scope": "all_answer_documents", "seed": 2076185920, "similarity": 0.0882800608828006, "source_content_hash": "a5e0c7c30f644205336d074912ac6e3c32825f437e7b1fcf6b8228348b4ab5d0", "source_hash": "1c1f04a7fae064e34e8baaa71fafa9cc5c33a9e78de258c3d71e7708f3e96ef7", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "a93f451002ab534976a1828784cdcbbe24df17c032b841a96a1275aab9061dee", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc1754", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Microscope slides are often used together with a cover slip or cover glass, a smaller and thinner sheet of glass that is placed over the specimen. Slides are held in place on the microscope's stage by slide clips, slide clamps or a cross-table which is used to achieve precise, remote movement of the slide upon the microscope's stage (such as in an automated / computer operated system, or where touching the slide with fingers is inappropriate either due to the risk of contamination or lack of precision).", "reason": "near_duplicate_of_source", "seed": 1449021634, "similarity": 0.9990147783251232, "temperature": 0.3}], "fingerprint": "fb4f079c7dfeb8e83d573a8bf05d8d91ecd92c83d27405ea54fea9fe7f0e6e0c", "generation_attempts": 2, "gold_answer": "stage", "matched_aliases": ["stage", "on the microscope's stage"], "query_id": "test64", "question_hash": "bfd58a6f1579effec8cbbd7c144f67a3c6679cde82a84d7aa652ba77c0133b96", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "9d713b0abf8895f8eb2fb6ea53d6cd67025fe819cb4fe53bc060222073d7cc79", "scope": "all_answer_documents", "seed": 505653236, "similarity": 0.3448275862068966, "source_content_hash": "c60c2519bb75de493d2ba82ba32cd9e32d03da8856e0422e8bde38dffa148317", "source_hash": "d43092951b69cd77d2dc881b5ee76d93cd985b7a67e0fb782266f288b0a44568", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "4aa9eb6aaae747c19681846e0d7fd949ad70f033c05ef144286cf0d39d799e73", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_