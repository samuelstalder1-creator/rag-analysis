{"doc_id": "doc68225", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "John Hancock (January 23, 1737 [O.S. January 12, 1736] – October 8, 1793) was an American merchant, statesman, and prominent Patriot of the American Revolution. He served as president of the Second Continental Congress and was the first and third Governor of the Commonwealth of Massachusetts. He is remembered for his large and stylish signature on the United States Declaration of Independence, so much so that the term John Hancock has become a synonym in the United States for one's signature.", "reason": "near_duplicate_of_source", "seed": 874879219, "similarity": 0.9929789368104313, "temperature": 0.3}, {"attempt": 2, "generated_text": "John Hancock (January 23, 1737 [O.S. January 12, 1736] – October 8, 1793) was an American merchant, statesman, and prominent Patriot of the American Revolution. He served as president of the Second Continental Congress and was the first and third Governor of the Commonwealth of Massachusetts. He is remembered for his large and stylish signature on the United States Declaration of Independence, so much so that the term John Hancock has become a synonym in the United States for one's signature.", "reason": "near_duplicate_of_source", "seed": 1382903716, "similarity": 0.9929789368104313, "temperature": 0.5}], "fingerprint": "b5b1faa2bb33dbce3f5f8303ef2e6920bf4b57d9fa4df96f55c9ed5d9729df5a", "generation_attempts": 3, "gold_answer": "John Hancock", "matched_aliases": ["John Hancock"], "query_id": "test1946", "question_hash": "6dce268090d9bddb840861c7a4c6552e434f14ff5c04b4935312430a707c5f80", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "d998f59a8a22d442517ba627836b692342b01bc26d745f476cacf03831028f5e", "scope": "all_answer_documents", "seed": 1520471674, "similarity": 0.7219917012448133, "source_content_hash": "48105bc0cb851f481de44bd796c95234e3fb6693f7aed339c3a7e6107842a8de", "source_hash": "e7f36def443285e62b2ff18c8c12d07987706cb71e18ed87b4a157e2ec3d3ed7", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "6d3918cdf67a5ff8fde3c73b830f3e0afde6bb79137f103607c1faf73417ebe7", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc68279", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The United Nations Conference on Sustainable Development (UNCSD), also known as Rio 2012, Rio+20, or Earth Summit 2012, was the third international conference on sustainable development aimed at reconciling the economic and environmental goals of the global community. Hosted by Brazil in Rio de Janeiro from 13 to 22 June 2012, Rio+20 was a 20-year follow-up to the 1992 Earth Summit / United Nations Conference on Environment and Development (UNCED) held in the same city, and the 10th anniversary of the 2002 World Summit on Sustainable Development (WSSD) in Johannesburg.", "reason": "near_duplicate_of_source", "seed": 11249542, "similarity": 0.9582637729549248, "temperature": 0.3}], "fingerprint": "b528c096122a4f6bca32a83071d576d7c9a8ba77a0fdd98bdf09cfd53e7766e2", "generation_attempts": 2, "gold_answer": "June 2012", "matched_aliases": ["June 2012"], "query_id": "test1947", "question_hash": "811a6a14e552320ea990416e92c3382e3a568435457ab3af75397868d464c2dd", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "0bed603c5ee37a12c995fec3a96405b506fd3a86b0b34899691633104f5375af", "scope": "all_answer_documents", "seed": 1085480781, "similarity": 0.27738693467336684, "source_content_hash": "32e009f09a64c29534befdceb9ab0790fd5f086bad7a94025d20dcb99a1bc0ab", "source_hash": "236d9589c37366662c2b2bd024f2e5fdfd8bd76f261b6d3f50c839c127179805", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "503d13c61c368e3630afe508513595b686f69318423fbfc0e2439164956edc2c", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403