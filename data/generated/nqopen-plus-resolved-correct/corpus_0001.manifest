{"doc_id": "doc58061", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Sahara (Arabic: الصحراء الكبرى‎, aṣ-ṣaḥrāʼ al-kubrá, 'the Great Desert') is the largest hot desert and the third largest desert in the world after Antarctica and the Arctic. Its area of 9,200,000 square kilometres (3,600,000 sq mi) is comparable to the area of China or the United States. The name 'Sahara' is derived from dialectal Arabic word for \"desert\", ṣaḥra (صحرا /ˈsˤaħra/).", "reason": "near_duplicate_of_source", "seed": 384253158, "similarity": 0.9721518987341772, "temperature": 0.3}], "fingerprint": "d115d2341e1d5853333295d76e0ed50a99a69ca53b43a4696b91152d6d89f87f", "generation_attempts": 2, "gold_answer": "the largest hot desert", "matched_aliases": ["the largest hot desert"], "query_id": "test1638", "question_hash": "776e1a8db565f33774b1430270a7f202a9107e1c6a5b52908f05a98e7910f7df", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "2c96c550e0d2df9dc8df8043efeca0504a2fc26756696fd54fa07b615a880bff", "scope": "all_answer_documents", "seed": 194703264, "similarity": 0.4422809457579972, "source_content_hash": "d9b8f6226511738f4eaa28dea9598051a91959bb4cba9ab5d7285fa3f9f639d3", "source_hash": "fd4dc84716b07fff3bb7d90146a061a7923a58dc17158f18cc67a8481e8aca42", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "9ec87ea330522486445af177d22e21f45e85f5f1e4c1ed1c770064505bb2ffbb", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
