{"doc_id": "doc66873", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Crossing is an American science fiction thriller series that airs on ABC and CTV. The series debuted on April 2, 2018. On March 20, 2018, ABC released the pilot episode on their website. The series is filmed in British Columbia, Canada.", "reason": "near_duplicate_of_source", "seed": 1378576111, "similarity": 0.9876543209876543, "temperature": 0.3}], "fingerprint": "c09d468c8fb8a2a0cbaaa6aa904fc962f39a8af2ea89296d4508559d5ca4eac1", "generation_attempts": 2, "gold_answer": "British Columbia, Canada", "matched_aliases": ["British Columbia, Canada"], "query_id": "test1904", "question_hash": "48d7b8e2f04d0d2045ca046ed925ab0cf06b5c967cb36e906d801dccc3e81342", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "d48f4cebbb6f9de8ca5a43f3599d745ff54705e99479d18ced451c14f96a8a08", "scope": "all_answer_documents", "seed": 319235737, "similarity": 0.6307385229540918, "source_content_hash": "c359286c8ffea3a88c94d7616942a4b8442c9f8d94e6d5a25e2a5d4fcc0a9b70", "source_hash": "cd0cdae61b93d5e833d4d84a0e64ff0e92b1ccbf61165e84c589d4e2dc624374", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "cc1f915b3737a705c70c775a5930f7d64781e28b8c5d54d813aa2a2bccb576bf", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc66877", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Cool Hand Luke is a 1967 American prison drama film directed by Stuart Rosenberg, starring Paul Newman and featuring George Kennedy in an Oscar-winning performance. Newman stars in the title role as Luke, a prisoner in a Florida prison camp who refuses to submit to the system.", "reason": "near_duplicate_of_source", "seed": 1289727911, "similarity": 0.9946140035906643, "temperature": 0.3}], "fingerprint": "89a09b706890020215fe330c8fdf74f0a5fedbde577e64f62c885d958416db4e", "generation_attempts": 2, "gold_answer": "1967", "matched_aliases": ["1967"], "query_id": "test1905", "question_hash": "b2a952542639d4fd0bd245671921240b56a9900542021ea3cc9f5cc3195eb944", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "29bb1fb3210ed6f27e7971aa9db39b084fd3b797651d5d101530f2f6b5652131", "scope": "all_answer_documents", "seed": 1041833371, "similarity": 0.8034782608695652, "source_content_hash": "7c77ff59b216a75539a7680b7cdef5e577d46b8dbedac1d943920274112aad35", "source_hash": "d3d888566055f41a5f4b608dd0cb413afbd3b79a42fc23c012feb47134514f76", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "6c0b6a83c44abd8adc38defe58cf78d561577fa6a3945ec926baf373cc60d5c2", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
