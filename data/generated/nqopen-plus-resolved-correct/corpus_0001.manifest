{"doc_id": "doc51472", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Gupta Empire produced large numbers of gold coins depicting the Gupta kings performing various rituals, as well as silver coins clearly influenced by those of the earlier Western Satraps by Chandragupta II.", "reason": "near_duplicate_of_source", "seed": 464691640, "similarity": 0.9929078014184397, "temperature": 0.3}], "fingerprint": "db8782473d2638e08e712b01215f0c7346a57aee2ac530ddb064ac17a49aaca5", "generation_attempts": 2, "gold_answer": "The Gupta Empire", "matched_aliases": ["The Gupta Empire"], "query_id": "test1443", "question_hash": "879ec4efa9c713c846d4e568452cb4f955e627db1c88e0d23130a8c039155a54", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "2665a65976a5fd27b1d826b83511db96c4ced84ce4facd491e990b319fd3fe0a", "scope": "all_answer_documents", "seed": 2029528804, "similarity": 0.15942028985507245, "source_content_hash": "324b4e764a7d3f8a21cf77ef1e5df972042a714ba5561e8c12296de06244942d", "source_hash": "c16b4bb0727949dc0d01c63c7e25dcee031d68a1c2afa87f6fdcf0f502c85a9a", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "4f88ef3fe6516f88ba2fa007eddeaa94d6c4564e411fa7ef27a676d1b2ff8e18", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc51493", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Carlos Alan Autry Jr. (also known for a period of time as Carlos Brown; born July 31, 1952), is an American actor, politician, and former National Football League player. During his brief football career, he was known as Carlos Brown. He played the role of Captain Bubba Skinner on the NBC television series, In the Heat of the Night, starring Carroll O'Connor. He has also appeared in films and other television shows. In November 2000, he was elected mayor of Fresno, California, and served for two four-year terms through January 2009. In 2008, Autry was hosting a radio news talk show on KYNO AM 940 in Fresno, but left the station in 2011.", "reason": "near_duplicate_of_source", "seed": 275071932, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "ece9990f8268404540f0881191a6772bc566127b5a6cdc1f5c47e4bbee1dd830", "generation_attempts": 2, "gold_answer": "Carlos Alan Autry Jr", "matched_aliases": ["Carlos Alan Autry Jr"], "query_id": "test1444", "question_hash": "0b3c11d5a258e34110c90c539f92d46bba16417493176d33e91cabfaed755d2f", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "3f3e0f22cf6217dab5c4f9f8919e254933149b9330c632358644fcfc343cc804", "scope": "all_answer_documents", "seed": 152187860, "similarity": 0.09860664523043944, "source_content_hash": "15909462f04100456d6e70d0240482b2472592bb908289eedc2919e231cdc062", "source_hash": "a7ff5b7a7b24ef1137d9e92f8901cd2f4698092b89ade49bb6ee4d15b2135ddd", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "eb5a480e42548364578ab6dafd842573defd0f7ff0325612443b13bb104910dd", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answera