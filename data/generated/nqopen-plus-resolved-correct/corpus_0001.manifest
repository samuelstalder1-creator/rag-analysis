{"doc_id": "doc38459", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "On Opening Day, April 9, 1965, a sold-out crowd of 47,879 watched an exhibition game between the Houston Astros and the New York Yankees. President Lyndon B. Johnson and his wife Lady Bird were in attendance, as well as Texas Governor John Connally and Houston Mayor Louie Welch. Governor Connally tossed out the first ball for the first game ever played indoors. Dick \"Turk\" Farrell of the Astros threw the first pitch. Mickey Mantle had both the first hit (a single) and the first home run in the Astrodome. The Astros beat the Yankees that night, 2-1.[14]", "reason": "near_duplicate_of_source", "seed": 152477347, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "6b2e9cb0a87a5a679eacbd1c657d995042646d15cd7796917d11ac37fd15ba49", "generation_attempts": 2, "gold_answer": "Mickey Mantle", "matched_aliases": ["Mickey Mantle"], "query_id": "test1098", "question_hash": "13472e5eb007f34a232b77ae46114f7e5dd90b2a8bb8c47374042d17e4d11002", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "5b23bbb5d5a21fe5cd764f4d79a543c01d0978a26ba18ac1dc2799bb6cfc7a2d", "scope": "all_answer_documents", "seed": 1414488998, "similarity": 0.7918088737201365, "source_content_hash": "78eefad323815b45c0abc87d9209d3b7e746a8e33e09602241b3ea2a17ae76dc", "source_hash": "14a0a3a63befc9f6529bdb1cd23e99b4c50a0e1e4beb28373bab9b08fbb20a53", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "d4c9b18946e2f8b3e32634252b59fc4a218a3ac76952f0abb4121a65a63dcb47", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "ve