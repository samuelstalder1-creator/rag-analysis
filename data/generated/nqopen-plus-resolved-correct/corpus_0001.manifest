{"doc_id": "doc96188", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The United States presidential election of 1928 was the 36th quadrennial presidential election, held on Tuesday, November 6, 1928. Republican Secretary of Commerce Herbert Hoover defeated the Democratic nominee, Governor Al Smith of New York. Hoover was the last Republican to win a presidential election until 1952.", "reason": "near_duplicate_of_source", "seed": 362544581, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "3bd29cba0096eb31b586ded3fa3c93d51a29e0e954708598e304e141e3d60d26", "generation_attempts": 2, "gold_answer": "Herbert Hoover", "matched_aliases": ["Herbert Hoover"], "query_id": "test2797", "question_hash": "ac5018ebf57cabe7b6bf8220619cab8c06afc0f10e56c01c0a69e899916b4bb9", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "173ecdcf4ce39ef61164a9194686b434469e86184b2d0656f9e6e44e49d6fa7c", "scope": "all_answer_documents", "seed": 1738349098, "similarity": 0.8505747126436781, "source_content_hash": "d2bca7261007b6e611b62314e23b7fdb20fa7057d06590ec4577919b46186a52", "source_hash": "3718ddc3d85e4627656c63055ff004265463c3182ece0b13310fd26ce8db368c", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "3150ee42d05af499680dd5307a60cc61b965cb64fa98edd295223f16d57fdab2", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
