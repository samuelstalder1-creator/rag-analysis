{"doc_id": "doc48148", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Rocky and Bullwinkle Show remained in syndicated reruns and was still available for local television stations through The Program Exchange as late as 2016; WBBZ-TV, for instance, aired the show in a strip to counterprogram 10 PM newscasts in the Buffalo, New York market during the summer 2013 season.[22] The underlying rights are now owned by Universal Pictures, which holds the library of predecessor companies DreamWorks Animation and Classic Media, and who in turn with copyright holder Ward Productions forms the joint venture Bullwinkle Studios, which manages the Rocky and Bullwinkle properties; Universal's purchase of Classic Media coincided with The Program Exchange's shutdown.", "reason": "near_duplicate_of_source", "seed": 148003268, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "cf308c1840caa3a812e8a73eea19ef0be5d023ec7cecc2a8e52e50820e5a262a", "generation_attempts": 2, "gold_answer": "Universal Pictures", "matched_aliases": ["Universal Pictures"], "query_id": "test1364", "question_hash": "d037dcfd7f9dd12af7c116038f79d2bfd255b7b4e131579e414bf3e57e412fee", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "fdb63fd5d6c1acb240b28f4702e955e373f555db5c8ab9a7c10888f0224a7595", "scope": "all_answer_documents", "seed": 1511534107, "similarity": 0.09099181073703366, "source_content_hash": "5bf479b0223ca2160e95eadbe63232ad3546570d164f21abf9303dcb3def9851", "source_hash": "9beb6924af1c9d84a129f41e300398804f56710a832fee48306f98cd9a1c187a", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "eeda90bf8ad2610a75eee116efb31ba39e2924e88a4aef48a63ca2387d1f9b52", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_