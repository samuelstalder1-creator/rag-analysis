{"doc_id": "doc11902", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The San Jose Sharks are a professional ice hockey team based in San Jose, California. They are members of the Pacific Division of the Western Conference of the National Hockey League (NHL). The franchise is owned by San Jose Sports & Entertainment Enterprises. Beginning play in the 1991–92 season, the Sharks initially played their home games at the Cow Palace, before they moved to their present home, the SAP Center at San Jose in 1993. The SAP Center is known locally as the Shark Tank.[3]", "reason": "near_duplicate_of_source", "seed": 314734670, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "af5d446cf49a9223b2af3c9f1a4a14e6db29e6ddc687065540fced26445ac144", "generation_attempts": 2, "gold_answer": "the SAP Center", "matched_aliases": ["the SAP Center", "SAP Center at San Jose"], "query_id": "test311", "question_hash": "2823ffe049cf11df288e886bffb55e3f39247031524abc41a64003afc581b996", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "cfbf1d49cd818168e2fb227bded316390eb71f0a27144511e6ecd65488f80db2", "scope": "all_answer_documents", "seed": 613448573, "similarity": 0.5073457394711067, "source_content_hash": "aeb49bb2b58b80241008cd2566a6b3c00775314fd48a109045834cbb7cabeb0c", "source_hash": "13aa82f47529dc44b80eadbb96b0bc32971271ccc3adb06d27f5c65ad4815084", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "32e318cb01818054ca3aeb43156495a5bf59528048bf3a0d5605171c3e59ffe4", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_