{"doc_id": "doc7959", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Shalom (Hebrew: שָׁלוֹם shalom; also spelled as sholom, sholem, sholoim, shulem) is a Hebrew word meaning peace, harmony, wholeness, completeness, prosperity, welfare and tranquility and can be used idiomatically to mean both hello and goodbye.", "reason": "near_duplicate_of_source", "seed": 1166432665, "similarity": 0.9799196787148594, "temperature": 0.3}], "fingerprint": "8e660a87c959a76e0691c62ee06490733e63e30488bba65b96716fadd4ee24de", "generation_attempts": 2, "gold_answer": "peace", "matched_aliases": ["peace"], "query_id": "test221", "question_hash": "fbe91e0483a7b25e64c9c5f21baa78027589c5a7fda679a9b13e63a07040ca42", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "678feaad3ef5c59c274332cdb73682d8697dfccfde844293016e8f4f296e12f6", "scope": "all_answer_documents", "seed": 904386076, "similarity": 0.15444015444015444, "source_content_hash": "4a9e5aa1da6fccd66225585729f3466663183ef96d942126ccd4cdd422894dcd", "source_hash": "4b29a24ac8c7a1c77a6b242a425c235910ddbe75290b6b4ab1ac32ca2e0a2fad", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "08b5d29ba779d3785140790e24deb4ba1f57cf1beecb733c015665d18de145b2", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
