{"doc_id": "doc3100", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"You'll Never Walk Alone\" is a show tune from the 1945 Rodgers and Hammerstein musical Carousel. In the second act of the musical, Nettie Fowler, the cousin of the female protagonist Julie Jordan, sings \"You'll Never Walk Alone\" to comfort and encourage Julie when her husband, Billy Bigelow, the male lead, commits suicide after a failed robbery attempt. It is reprised in the final scene to encourage a graduation class of which Louise (Billy and Julie's daughter) is a member. The now invisible Billy, who has been granted the chance to return to Earth for one day in order to redeem himself, watches the ceremony and is able to silently motivate the unhappy Louise to join in the song.", "reason": "near_duplicate_of_source", "seed": 2117566070, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "8a5bcc048d11dfb5699c6615f40b01e01a19c9ec0a41688314d497edd600e43b", "generation_attempts": 2, "gold_answer": "1945", "matched_aliases": ["1945"], "query_id": "test97", "question_hash": "6da4d269800bc4f0be8c4552852d9739becfe55186c71e290cf88044463872f0", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "42cb8b901337233e21463857aef739bd102c651dcd72d055cca7b975fedfcb06", "scope": "all_answer_documents", "seed": 1201605256, "similarity": 0.02394106813996317, "source_content_hash": "6c8e09ec202468061a26e7ea97797c9cb83621fb15406bf291538f4902d98e86", "source_hash": "7eedb6659ddfa1ac349429098a78a59173c74ab888c15805474d5f95b544bb68", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "1fb24d6a0a14896f137489fed94870a88e250425ba26badb39a94d77c28eaec9", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal"