{"doc_id": "doc91765", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "I Can Only Imagine was released in the United States on March 16, 2018. It has grossed $80 million worldwide against a production budget of $7 million, and is the third highest-grossing music biopic of all-time in the United States. Some critics praised it as inspiring and noted it as an improvement compared to other faith-based films, while others called it flat and by-the-numbers.", "reason": "near_duplicate_of_source", "seed": 693620764, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "f3d52b6744d04774ad9a91b655b1c9956e5a111dfe539d57f8e44419031d7b01", "generation_attempts": 2, "gold_answer": "March 16, 2018", "matched_aliases": ["March 16, 2018"], "query_id": "test2679", "question_hash": "7181d68458686f6304589a3eee2a2001161a13d216180a9ecc8ea53e8ecced0e", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "f589d412adbc853999fd46edb545975f11624899530956dee03b5e2fae8011d8", "scope": "all_answer_documents", "seed": 1217186642, "similarity": 0.49801324503311256, "source_content_hash": "269dfcdfa63e9769e7c8a1e62ec9094c26a1365e25cce540561f5680aaa92e67", "source_hash": "d2f7cb4b14123b3cfc9b372e988d5f9ef7c30ec953e12a176016844b6b8aa129", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "84a4a79b5c752dd0f2248e74ce3ed9b3efc07c3579da4161c47de73a0a588881", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
