{"doc_id": "doc64897", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "CLS (originally Continuous Linked Settlement) is a specialist US financial institution that provides settlement services to its members in the foreign exchange market (FX). Although the forex market is decentralised and has no central exchange or clearing facility, firms that chose to use CLS to settle their FX transactions can mitigate the settlement risk associated with their trades.", "reason": "near_duplicate_of_source", "seed": 1845457901, "similarity": 0.9961489088575096, "temperature": 0.3}], "fingerprint": "8b0902970b150d1071d19a073858f9f1ba195c66796b5d481434234cbae54759", "generation_attempts": 2, "gold_answer": "foreign exchange market", "matched_aliases": ["foreign exchange market"], "query_id": "test1844", "question_hash": "77c58fb8b599c6e0c33d570efb4e4c379391dd14d07638b6564f45e8318cf338", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "6cf590ab0e172020dc2da88801486307cec04166e394d3ac986bb0f8564ac7a1", "scope": "all_answer_documents", "seed": 1103887272, "similarity": 0.8079800498753117, "source_content_hash": "5ea33b671eea991aaf3e8f943205a2d050958bcdd1c6cffa10201e7925e631bc", "source_hash": "0237d1c206e59a8fbbee702a3407c4a0de58413cc49aee4ec21418c2bb7850a1", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "c3ba3a26ce5dc9649461f3b794d22f0aa8ff77d0502f0d8e1d9269d6db432fb8", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc64933", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Hindenburg disaster occurred on May 6, 1937, as the German passenger airship LZ 129 Hindenburg caught fire and was destroyed during its attempt to dock with its mooring mast at Naval Air Station Lakehurst in Manchester Township, New Jersey, United States. Of the 97 people on board (36 passengers and 61 crewmen), there were 35 fatalities (13 passengers and 22 crewmen). One worker on the ground was also killed, raising the final death toll to 36.", "reason": "near_duplicate_of_source", "seed": 507376545, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "1a39ac3b9ad1dfddf438365e0975ca9e06d22324cf769f5e72c04919ee9e235f", "generation_attempts": 2, "gold_answer": "36 passengers", "matched_aliases": ["36 passengers"], "query_id": "test1846", "question_hash": "80633fce672135c5a6722c68bb5e6c70ece576bb4a11b9dfa2b4f90c2a6c208e", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "ee569acc764e45eed5f8f22560a43ff81fe83b0d04090d162e3e891ec03c9a2b", "scope": "all_answer_documents", "seed": 1570965885, "similarity": 0.6352941176470588, "source_content_hash": "f1ee37f510a9713637a46cacf711d2a377e8c68c74bf9e1b7e3ea3a60a27b315", "source_hash": "b7d844f4f6f64a8e997dd5bb0054dece7b42031a04af60efbb6ba7d367f89775", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "4ef8dcbadc32a47fbae9185f6509d29bd6c951dc0744209b2f0f21e185f8894e", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc65027", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Tami Lynn (born 1942, Gert Town, New Orleans, Louisiana, United States)[1] is an American soul singer. She scored a Top Ten hit on the UK Singles Chart in 1971, with the song \"I'm Gonna Run Away From You\".[2]", "reason": "near_duplicate_of_source", "seed": 1115798686, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "b2abb414ab46fa5256eedfb66eb5a68b6814640222c49d774f6836d613a2e4c8", "generation_attempts": 2, "gold_answer": "Tami Lynn", "matched_aliases": ["Tami Lynn"], "query_id": "test1847", "question_hash": "02c85d3295069b66caced590be5481a06deee53454fa50307dfcbcb979c5e370", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "3490cb39055278cc40d4665898d1c39070353e81d90d6e59c7b8f6d7a94ce45e", "scope": "all_answer_documents", "seed": 1457782248, "similarity": 0.7582697201017812, "source_content_hash": "a0bebaf060ebde56277c2183e901b34024de9971dd696e58a8575be64bdc5da1", "source_hash": "c733cefe5b9a114f233b271756afb56c2a2dc31d4962b2617964c0b5f37b6a78", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "52b0be489defc0cdb1cf313477c80bb076acac122acc0526cefbcce703c7fc56", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
