{"doc_id": "doc48050", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The 2018 World Men's Curling Championship, branded as the 361˚ World Men's Curling Championship 2018 for sponsorship reasons, was held from March 31 to April 8, 2018 at Orleans Arena, on the Las Vegas Strip in Paradise, Nevada, United States.", "reason": "near_duplicate_of_source", "seed": 1463808051, "similarity": 0.987603305785124, "temperature": 0.3}], "fingerprint": "e2b77c5d6987edb3bceb6dcdb2b62c8953a76ffb35e9ce3b78493f452025431b", "generation_attempts": 2, "gold_answer": "March 31", "matched_aliases": ["March 31"], "query_id": "test1362", "question_hash": "e6e62f79de683e9140b4434795e3c9b132b730c2dd4957c6ca4a969b6f2dab3c", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "1eb8e4cc9dfae512aad2aea2618ac7b4f505881668749168f230b3e20a455033", "scope": "all_answer_documents", "seed": 998639589, "similarity": 0.8297455968688845, "source_content_hash": "65fa3ae57d788d3179a68cb79c08cd315dc4cd1676107ab5f2872e4cc7afc37e", "source_hash": "1c10ca228c5c44e1cd4debe89645918f226e341b5029a4b93ae23dd8b361e2df", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "4bfcf32e83539f4fa2c472460dc9ef11384bcdc67675b8f6656a7026356527ea", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc48095", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The 2016 World Series was the championship series of Major League Baseball's (MLB) 2016 season. The 112th edition of the World Series, it was a best-of-seven playoff between the National League (NL) champion Chicago Cubs and the American League (AL) champion Cleveland Indians, the first meeting of those franchises in postseason history. The series was played between October 25 and November 2. The Indians had home-field advantage because the AL had won the 2016 All-Star Game.[2][3][4] It was also the last World Series to have home-field advantage determined by the All-Star Game results; since 2017, home-field advantage is awarded to the team with the better record.", "reason": "near_duplicate_of_source", "seed": 1744553081, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "08c4084f69d3d65bd1457b72e3fe3c36c6d963fe572ab65fe98b7452af4433e6", "generation_attempts": 2, "gold_answer": "the Indians", "matched_aliases": ["the Indians", "Cleveland Indians"], "query_id": "test1363", "question_hash": "f59c3efd877f91e70071b5d366d7b9006fa74c3a6c82498b92ab7f9736281268", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "2fb47ab2b3b49f7dd6aee95cb35da9022e394a89d976803901060639a8e24e18", "scope": "all_answer_documents", "seed": 1742986161, "similarity": 0.4899598393574297, "source_content_hash": "5b436a749d6f35f1b8cb5280b783220dd6901fc4d8f431f241a392b54db8a45d", "source_hash": "56fa3ba828b7e5f6d76b091416391882853a09404631c64aad57025a834cbe36", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "295603804e455ae23393003fece3389b0a05af1884b1511a02101f6910b678df", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "