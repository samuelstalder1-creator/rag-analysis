{"doc_id": "doc15677", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Howard Caine (born Howard Cohen; January 2, 1926 – December 28, 1993) was an American character actor, probably best known as Gestapo Major, Wolfgang Hochstetter in the television series Hogan's Heroes (1965–71). He also played Lewis Morris of New York in the musical film 1776, and Everett Scovill, a thinly disguised portrait of Charles Manson's attorney Irving Kanarek, in the television movie, Helter Skelter.", "reason": "near_duplicate_of_source", "seed": 1018595068, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "09f1f42bd68d73e4668bd74c3ba4d55fd4376d6679afa28d103455c8f679b622", "generation_attempts": 2, "gold_answer": "Howard Caine", "matched_aliases": ["Howard Caine"], "query_id": "test421", "question_hash": "a98273ec83f1efd0cf15afea1e9640e12758233e3d7b18bb9a0f6a5fbdfa8601", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "ef38be75af66fd839c1821d2da33e6ac11059cca0d360583deb24798aab2603e", "scope": "all_answer_documents", "seed": 1411328773, "similarity": 0.57, "source_content_hash": "7cfe18c00c3b34600e55b2115b42d72c58742ad78ec7cfd0d6eed1c746caff5c", "source_hash": "c328070e472eac7b3911f07b901aec6b8619f19bf55e01c65c9a883ce6dd2c73", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "0112d7504013035c11a20ff502b2c32f89838a5ed50cf3b8e3a150898a64c9ab", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc15739", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "In the song, Baez recounts an out-of-the-blue phone call from an old lover, which sends her a decade back in time, to a \"crummy\" hotel in Greenwich Village circa 1964 or 1965; she recalls giving him a pair of cuff-links, and summarizes that memories bring \"diamonds and rust\". Baez has stated that the lyrics refer to her relationship with Bob Dylan.", "reason": "near_duplicate_of_source", "seed": 32470981, "similarity": 0.9957325746799431, "temperature": 0.3}], "fingerprint": "ce3460f0a82ac5fd0aa41ae2528d0450ad20cb1afdbb1d3666054a978d174530", "generation_attempts": 2, "gold_answer": "Bob Dylan", "matched_aliases": ["Bob Dylan"], "query_id": "test423", "question_hash": "37bd55c30676ea2c5a3c4e51e724cdde4912ac556f97e14cc7b58ec1e3213756", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "c8df819ea29854f11b1da608875d07df6a7ce601f5ff5fd7ba8c7835847b9d87", "scope": "all_answer_documents", "seed": 372788068, "similarity": 0.0989399293286219, "source_content_hash": "8cb6a5be936a0dfafc7bc5f19a64aca9a95be04c6d9f96e7ff0cd19f9ea3eadc", "source_hash": "59d6fc197c2117892edb1c91eb55ad8691a27cce575761b1dfa6934114b48fa4", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "0b06496304e83305ce47e561fdee6a7ac86f84029940f45da892917a64f70230", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
