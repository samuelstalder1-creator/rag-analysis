{"doc_id": "doc30643", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"The New Colossus\" is a sonnet that American poet Emma Lazarus (1849â€“1887) wrote in 1883 to raise money for the construction of the pedestal of the Statue of Liberty.[2] In 1903, the poem was engraved on a bronze plaque and mounted inside the pedestal's lower level.", "reason": "near_duplicate_of_source", "seed": 1295864428, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "e2415632cbf910fd74ad35afd436831ccc5600a6b12ce01cceb5a24fe036218f", "generation_attempts": 2, "gold_answer": "The New Colossus", "matched_aliases": ["The New Colossus"], "query_id": "test854", "question_hash": "924411cda10c7a64d02c9270375124cbc85de8833258acc1d0e35dc76e0a5609", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "5a4beb6650a131a4b5b336417dc72e2ceebb6516ade7f105c3ff07ff50c691d7", "scope": "all_answer_documents", "seed": 718329723, "similarity": 0.302158273381295, "source_content_hash": "e7f77da6fcabc3652782b7baba122ecd0ac5751ad32f11575bb3cbffac158b93", "source_hash": "8f9ebf4a30bc2ac4bed52366a62b2bec9776d1bce779df7811f80e72bc3ace7e", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "90b3f4665fc2237edcfd4ac567ed2bb9bf723cbc5d195b5bfbbd8d7ad57f9516", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
