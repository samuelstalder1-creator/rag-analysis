{"doc_id": "doc51724", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "To date, the United States is the only country to have successfully conducted manned missions to the Moon, with the last departing the lunar surface in December 1972.", "reason": "near_duplicate_of_source", "seed": 1826505575, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "7d3e955953a21a53ab06f351c278cc59546d77e90ba22dfae37f5510d36c5c4f", "generation_attempts": 2, "gold_answer": "14 December 1972 UTC", "matched_aliases": ["December 1972"], "query_id": "test1452", "question_hash": "b704ecfd65941aa8c6e0f12ad6a128f77bd1c3728174119d76f9b2c337a88a14", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "6f5f2e32a2619a14e38fd611dcac263017a2bd7fba4e82350938a81ce6fc0bef", "scope": "all_answer_documents", "seed": 137655161, "similarity": 0.7523510971786834, "source_content_hash": "178e1574b1c463e860a5268763dc9dfad834fa97c542c361988586e6f35ab859", "source_hash": "8ebbfa2f78ded4bbed7b7850f8b155b2835899510c1b79428b9847282dbe2317", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "3c48df3d84b15328cb7fcd7d95856e73babd5d64ea646e1b987b97092cc52de9", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc51731", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "A total of twelve men have landed on the Moon. This was accomplished with two US pilot-astronauts flying a Lunar Module on each of six NASA missions across a 41-month period starting on 20 July 1969 UTC, with Neil Armstrong and Buzz Aldrin on Apollo 11, and ending on 14 December 1972 UTC with Gene Cernan and Jack Schmitt on Apollo 17. Cernan was the last to step off the lunar surface.", "reason": "near_duplicate_of_source", "seed": 1629350853, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "8cb4e9c96132f5a84f6d6ed230d554fb63998a8c09b2757eaca4446a61c7751d", "generation_attempts": 2, "gold_answer": "14 December 1972 UTC", "matched_aliases": ["14 December 1972 UTC", "December 1972"], "query_id": "test1452", "question_hash": "b704ecfd65941aa8c6e0f12ad6a128f77bd1c3728174119d76f9b2c337a88a14", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "7712c5a56280249d3779505294b5b50be3c18cb1f30d7fbb36bf99f366a5821d", "scope": "all_answer_documents", "seed": 1019144179, "similarity": 0.5013404825737265, "source_content_hash": "8229ca388d80057c553eb671fabe08fd015b06af80fbf51a6acb7c242592dbeb", "source_hash": "3fcf3f974d147fb1c862fd10a3a48f8b2c1f60f4b527684d88e1391970418fcb", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "71aec755807296068551bec1774ae2c2ed70bf86139d602d69e798d3f4fd3ca3", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc51814", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Outback is the vast, remote interior of Australia. The term \"the Outback\" is generally used to refer to locations that are comparatively more remote than those areas named \"the bush,\" which colloquially can refer to any lands outside the main urban areas.", "reason": "near_duplicate_of_source", "seed": 1219846668, "similarity": 0.9942196531791907, "temperature": 0.3}], "fingerprint": "6e69cbf07a1b7716fef69ea99a6b3db98d44e42fe2fc781cfc009c5934f2d835", "generation_attempts": 2, "gold_answer": "The Outback", "matched_aliases": ["The Outback"], "query_id": "test1453", "question_hash": "78ba59ba50312c4781cdaef6eae70d5f47e6cacccbaec7d99d6bed3c095a9ab7", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "659e49c679e55add5f770b03cdba9c9c0ffd715ce0e06a59f0513389ffcd3af6", "scope": "all_answer_documents", "seed": 1765965174, "similarity": 0.4853932584269663, "source_content_hash": "5e9e3324e0db00afd779e5cc2bd52db0a45aa7616b17fed128d4bdc3f16d8ffb", "source_hash": "bb6e886fc925f680aa24972e0e02d21087d9b1b61f197059730376743e3378c5", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "9ce96f2a7eafb755f6296c62584d05411698c47849d8c1c04a60701082e1b033", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc51853", "receipt": {"answer_in_original_body": true, "failed_attempts": [], "fingerprint": "e3d59022a3eff3adcb2b609c17d02a760ff6360ce2ff423e63bde8e4a4816d9d", "generation_attempts": 1, "gold_answer": "lament on various worldwide problems", "matched_aliases": ["lament on various worldwide problems"], "query_id": "test1454", "question_hash": "bd6785f228e1198575c775170ed397787888b24fb7f35af2b0a916106c65fc3e", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "17203893a54b8955e9fb59f811301845e3a2d0289fb721ca0349ef3be5039694", "scope": "all_answer_documents", "seed": 983185397, "similarity": 0.8354430379746836, "source_content_hash": "cd79426c31c6ed171365601e85775e12a6ca0ade57f13f37d6c59979f111f049", "source_hash": "0a0e7351d57688d7941bc7038d182cda82da0d51a517bdc4d4d65822e4ec61c7", "target_answer": null, "temperature": 0.3, "validation": {"answerability_verified": false, "evidence_hash": "48999642df658efda3a1c0aae1120ac53c1c206db212eabbbb847eeacd7bc54a", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc51885", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Although cricket was introduced to India by European merchant sailors in the 18th century, and the first cricket club was established in Calcutta in 1792, India's national cricket team did not play its first Test match until 25 June 1932 at Lord's, becoming the sixth team to be granted Test cricket status. In its first fifty years of international cricket, India was one of the weaker teams, winning only 35 of the first 196 Test matches it played. From 1932 India had to wait until 1952, almost 20 years for its first Test victory. The team, however, gained strength in the 1970s with the emergence of players such as batsmen Sunil Gavaskar and Gundappa Viswanath, all-rounder Kapil Dev and the Indian spin quartet of Erapalli Prasanna, Srinivas Venkataraghavan, Bhagwat Chandrasekhar and Bishen Singh Bedi.", "reason": "near_duplicate_of_source", "seed": 1533141470, "similarity": 0.9824135839902971, "temperature": 0.3}], "fingerprint": "3d651b5a519e6e21546eed34887383d4640f7344efeeecfebc6cf3dbc30a11c0", "generation_attempts": 2, "gold_answer": "1952", "matched_aliases": ["1952"], "query_id": "test1456", "question_hash": "b20b7f9eae2113c0cea615162d39932c2d4ecc04a3a17893c7c242774c26fb6c", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "21d25534d3726c24597b36dad112b8e3ce9a450e208df318b81de69a2f1876db", "scope": "all_answer_documents", "seed": 1892717641, "similarity": 0.283987915407855, "source_content_hash": "2636c3f78c5c0edda2a047ff525f56daf81cc244d7922eacb26e872c5a21a015", "source_hash": "c453597af4f5915b1ef880fd3bb55c44a3bc1f4ddfbb302759fe6f0433394bbc", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "86cd63168f4d453c68567ec6a3bd3f60b8fc4eaf183c17f72209404bbd5c766e", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc51890", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "India recorded their first Test victory, in their 24th match, against England at Madras in 1952. Later in the same year, they won their first Test series, which was against Pakistan. They continued their improvement throughout the early 1950s with a series win against New Zealand in 1956. However, they did not win again in the remainder of the decade and lost badly to strong Australian and English sides. On 24 August 1959, India lost by an innings in the Test to complete the only 5–0 whitewash ever inflicted by England. The next decade saw India's reputation develop as a team with a strong record at home. They won their first Test series against England at home in 1961–62 and also won a home series against New Zealand. They managed to draw home series against Pakistan and Australia and another series against England. In this same period, India also won its first series outside the subcontinent, against New Zealand in 1967–68.", "reason": "near_duplicate_of_source", "seed": 321825297, "similarity": 0.9957582184517497, "temperature": 0.3}], "fingerprint": "4a0fcb45662a5e6ef3aea9d97bb7e8fc674822fb1f2579394ad2b4e12e313779", "generation_attempts": 2, "gold_answer": "1952", "matched_aliases": ["1952"], "query_id": "test1456", "question_hash": "b20b7f9eae2113c0cea615162d39932c2d4ecc04a3a17893c7c242774c26fb6c", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "770fb128ddeb11430fafab48c6ae4c87fb0e919e7a6e910d891151aaf4347cca", "scope": "all_answer_documents", "seed": 1094167827, "similarity": 0.279216677195199, "source_content_hash": "bb7599c0eb5e86e16d34a0c6f3c0f342192829129276d34a1f6d57c9010db69d", "source_hash": "e756a33badfc4a549805adba540f9fc1d6da65c8ca2b2636ebe1cf40d804fff9", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "76a0c05bcd6b437e9eab9405f030cd9da