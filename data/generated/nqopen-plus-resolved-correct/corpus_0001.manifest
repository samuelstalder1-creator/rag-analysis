{"doc_id": "doc1420", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Dr. Jesse Bennett (July 10, 1769 – July 13, 1842) was the first American physician to perform a successful Caesarean section, which he performed on his own wife at the birth of their only child on January 14, 1794.", "reason": "near_duplicate_of_source", "seed": 392215580, "similarity": 0.9747126436781609, "temperature": 0.3}], "fingerprint": "388d1dc30ceae54570f3af9d1904457bf98fa6840c3a5b596dae8f1e7bb88f6d", "generation_attempts": 2, "gold_answer": "Dr. Jesse Bennett", "matched_aliases": ["Dr. Jesse Bennett"], "query_id": "test51", "question_hash": "4067c12ce795d8b67c6c2d0439c1525e791dfa218f4b2da64d633921dd93b11c", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "a3a775f5c35d19aaafd240f998b8fb5815fd643a9d64b4566742978386353e84", "scope": "all_answer_documents", "seed": 717702256, "similarity": 0.40585774058577406, "source_content_hash": "938b7a43d9d7259232bd2febdd72a4efec258f3a0d543808728e86946ae0c804", "source_hash": "ffb5b90f8c7ffe4d9058a87820327ebebfc8879b540bb1f7f74d8a1ec76d7161", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "71e0f355ae2ad87f386ad82cb435e2583aba1ad309e6330ceec642c9b3b360d3", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc1448", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "After the sojourn in Carthage, the Trojans returned to Sicily where Aeneas organized funeral games to honor his father, who had died a year before. The company traveled on and landed on the western coast of Italy. Aeneas descended into the underworld where he met Dido (who turned away from him to return to her husband) and his father, who showed him the future of his descendants and thus the history of Rome.", "reason": "near_duplicate_of_source", "seed": 787386414, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "d67dbe32967f7dff6f36a7f00c604ebacf5167b46461facccf9324e018aab705", "generation_attempts": 2, "gold_answer": "Sicily", "matched_aliases": ["Sicily"], "query_id": "test53", "question_hash": "6920defaa75e2d4e52630f6a65ebe2a6e85722b14172e3c2138a546391ab0b8c", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "c9dc26e7f8f3fc4d37c67f435eee207c7ae239f2436a201b0a72cb49a920b439", "scope": "all_answer_documents", "seed": 1191965888, "similarity": 0.011315417256011316, "source_content_hash": "3127a9680997dee8364a9bd5a6cce99c008a761f6a9c5fe1ae5943dc7053cca8", "source_hash": "91f638efb75e34f43ddbde8132c6672a59d7aab1a0c528033ae4a098a4edb333", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "affce4d3fb851dfa7659434883f56b41c5c3c432fa5b9cc87043ca76c55c6382", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
