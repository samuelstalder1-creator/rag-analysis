{"doc_id": "doc68016", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "There are four major Dragon Kings, representing each of the Four Seas: the East Sea (corresponding to the East China Sea), the South Sea (corresponding to the South China Sea), the West Sea (sometimes seen as the Qinghai Lake and beyond), and the North Sea (sometimes seen as Lake Baikal).", "reason": "near_duplicate_of_source", "seed": 1753672290, "similarity": 1.0, "temperature": 0.3}, {"attempt": 2, "generated_text": "There are four major Dragon Kings, representing each of the Four Seas: the East Sea (corresponding to the East China Sea), the South Sea (corresponding to the South China Sea), the West Sea (sometimes seen as the Qinghai Lake and beyond), and the North Sea (sometimes seen as Lake Baikal).", "reason": "near_duplicate_of_source", "seed": 1094582584, "similarity": 1.0, "temperature": 0.5}], "fingerprint": "84f9b676457372dab6ea88320a29e48947758879d2381659a021d0ae153748d8", "generation_attempts": 3, "gold_answer": "Four Seas", "matched_aliases": ["Four Seas", "Four"], "query_id": "test1941", "question_hash": "1b6efab4fdd23b0f0fbfead67d86a0cb613bcfd7d7f76f9ba58825316fd09989", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "82bb9f887cd593d804decab353b618443518d6cf5e9b3c009ead59482148a620", "scope": "all_answer_documents", "seed": 1558185939, "similarity": 0.19062027231467474, "source_content_hash": "752d249967e0041933dd2803670159514edb062ac82209f8ea2c205ed9e89ede", "source_hash": "9ddd38174ae42bc03c697a6addb33b778c6dfc64069daccc1166bf2302beb44b", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "ffe77e2225bca7bb9785bcefd290020c51bb5a7ba1c5c1399eb459ea0e58a1f3", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage"