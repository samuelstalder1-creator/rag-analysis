{"doc_id": "doc33382", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "It is generally accepted that sustainable gray wolf packs had been extirpated from Yellowstone National Park by 1926, although the National Park Service maintained its policies of predator control in the park until 1933. However, a 1975–77 National Park Service sponsored study revealed that during the period 1927 to 1977, there were several hundred probable sightings of wolves in the park. Between 1977 and the re-introduction in 1995, there were additional reliable sightings of wolves in the park, most believed to be singles or pairs transiting the region.", "reason": "near_duplicate_of_source", "seed": 636382371, "similarity": 0.9859402460456942, "temperature": 0.3}], "fingerprint": "a6b358a01104a277aa739df831b0f5331cb4d62b07ab0b71c9ce67904f566f6c", "generation_attempts": 2, "gold_answer": "1926", "matched_aliases": ["1926", "by 1926"], "query_id": "test937", "question_hash": "e26fc30c6096fe36c842f0ffcc28b5f9262cfe69e2245ce64603a161a4067c83", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "f2b3a206a4b9c4ea6d20ddc5ac5cb05015988f54c04bb18272334fa97a0df3ed", "scope": "all_answer_documents", "seed": 1042556233, "similarity": 0.3585810162991371, "source_content_hash": "56d30b151ea20622d5f18f76570f1d70e03369f5c194903a90b5e874aa909190", "source_hash": "e31f0f14bc2de2b880cba953d374a0084e01d619a2f4c63dc6c4bc5bc9f96899", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "7f07bc2f7d802a2de261feee0ed132fbf21be72238004e3057c2cf156da7b7e2", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d939962