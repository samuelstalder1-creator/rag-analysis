{"doc_id": "doc64241", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Katherine Kiernan Maria \"Kate\" Mulgrew (born April 29, 1955) is an American actress. She is known for the roles of Captain Kathryn Janeway on Star Trek: Voyager and Galina \"Red\" Reznikov on Orange Is the New Black. She first came to attention in the role of Mary Ryan on the daytime soap opera Ryan's Hope. Mulgrew has won an Obie Award, and has received a Golden Globe Award and Primetime Emmy Award nomination. She is an active member of the Alzheimer's Association National Advisory Council and the voice of Cleveland's MetroHealth System.", "reason": "near_duplicate_of_source", "seed": 1127285389, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "62981467e02817ea6941a3763ba122288b4db904f06d05ced412eefab21cb7a1", "generation_attempts": 2, "gold_answer": "\"Kate\" Mulgrew", "matched_aliases": ["\"Kate\" Mulgrew"], "query_id": "test1826", "question_hash": "4ea521de21e1f6aa53fd67f7807ec1189480b752546fc007f3abe36f3f2943d3", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "cecd12776ff4ba7a818c334947079a5aa2068206331c9ad158d89d1e25de505d", "scope": "all_answer_documents", "seed": 992463594, "similarity": 0.46357615894039733, "source_content_hash": "c1f8aca51e316608667a4ae9b58166d7a28a5a92655b8685dc419711e37844b9", "source_hash": "9d36d4e37712091ed23b347c609f38dfa94f448bb7992d5bd91968cbf561bc39", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "c52af6deb9c5c34e15ee314995f66feccf1b61c86d2b75c27b3a4e819d953ec1", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version":