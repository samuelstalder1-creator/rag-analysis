{"doc_id": "doc59698", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"Too Much Time on My Hands\" is the second single released from Styx's 1981 triple-platinum album Paradise Theatre, written and sung by Tommy Shaw, who also plays the lead guitar solo during the break in the song.", "reason": "near_duplicate_of_source", "seed": 1858739252, "similarity": 0.9791183294663574, "temperature": 0.3}], "fingerprint": "ed1d8a6c2bde3fe923eeeb5edce9673c52e811ce6c9d6b6fe23d7aa74cd250ce", "generation_attempts": 2, "gold_answer": "Tommy Shaw", "matched_aliases": ["Tommy Shaw"], "query_id": "test1685", "question_hash": "739f5c1dd85038cb8944e22ccc82c3bc15e2e703abf5039d397831708dc11737", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "9e2a0ace83d4572e9c379ee6048ee6e50b75c4a61118709e4c9f2eeaa21f12fd", "scope": "all_answer_documents", "seed": 533485504, "similarity": 0.8441247002398081, "source_content_hash": "e7c7c1d8bd774886ca26b7ba171c6708b28a4599801d896c1acc7d728950dedb", "source_hash": "9629bab4417732688a2e6a8e2421f3e3d60714fff47c57491d2e8a654e76c04b", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "351779fce70fc847900a7ca59256060a62b76f767268e3b087a15a513b6de9e3", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc59825", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The lion's mane jellyfish, also known as the giant jellyfish or hair jelly, is the largest known species of jellyfish. Its range is confined to cold, boreal waters of the Arctic, northern Atlantic, and northern Pacific Oceans. It is common in the English Channel, Irish Sea, North Sea and in western Scandinavian waters south to Kattegat and Øresund. It may also drift in to the south-western part of the Baltic Sea (where it cannot breed due to the low salinity). Similar jellyfish – which may be the same species – are known to inhabit seas near Australia and New Zealand. The largest recorded specimen found washed up on the shore of Massachusetts Bay in 1870, had a bell with a diameter of 2.3 metres (7 ft 6 in) and tentacles 37.0 m (121.4 ft) long. Lion's mane jellyfish have been observed below 42°N latitude for some time in the larger bays of the east coast of the United States.", "reason": "missing_gold_answer", "seed": 358305558, "similarity": null, "temperature": 0.3}], "fingerprint": "1dcbcc65f6638bab2a55132617da6c54b45ca72b2b3560a9b8fc46f5ddde2a62", "generation_attempts": 2, "gold_answer": "C. capillata", "matched_aliases": ["capillata", "Cyanea capillata"], "query_id": "test1689", "question_hash": "54f579dde39af897e4bd0f80a2a7eb7a0273b3c4cee57895f9df4ffec5ceb303", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "87b86defd21d211358e5e38aa7b15ba48015207458f2220b3dcd3d79075ada20", "scope": "all_answer_documents", "seed": 994876803, "similarity": 0.696061140505585, "source_content_hash": "692712413b0a76c0f42e8626ecaa3f73a637c6bf028bb46e9a9eac1a68e79ce3", "source_hash": "0e90e28d5b438559bb914b3be17c9dbb4fdbef2288d88d4989011b70bbd70421", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "a0668f2c810ed770d3a5463637376f89b26c2d66d3ac0fd451050626a45b89a3", "for