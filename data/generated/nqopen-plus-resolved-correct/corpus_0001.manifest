{"doc_id": "doc115343", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"Feel It Still\" is a song by American rock band Portugal. The Man. The song, which has interpolations from The Marvelettes' 1961 hit \"Please Mr. Postman\",[2][3] was written by the band along with John Hill and Asa Taccone, with the latter two serving as producers. It serves as the second single and first radio single off their eighth studio album Woodstock. The song reached number one on the US Alternative Songs, Mexican and Russian Tophit airplay chart, and became their first entry on the Hot 100, reaching number four as of October 2017. It was also featured in advertisements for the Apple iPad Pro,[4] Vitamin Water,[5] YouTube TV and in the first and second trailers for the 2018 film Peter Rabbit.[6]", "reason": "near_duplicate_of_source", "seed": 182217114, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "7099401d0e4e9d007686067c18f1ff2c037ae34c2e3b3124f87b2df3804f7ad2", "generation_attempts": 2, "gold_answer": "Portugal. The Man", "matched_aliases": ["Portugal. The Man"], "query_id": "test3377", "question_hash": "ac7e10f3ac3461ea2f3f3434c69d701a80ad514a41f873ded516678a54a064bd", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "959dffd9675919e80a24c36c824df439a5ca7b4571e610511e9127c7daf36e97", "scope": "all_answer_documents", "seed": 1803838790, "similarity": 0.3629992992291521, "source_content_hash": "cd430542e7b79d0d88afcda83d6da034aa1b94adadc45b6330468868119b7fc8", "source_hash": "98cb4b96f95e7ebf96f626f4131faefe73d88cffe9e3f8487d17aa1c482cc1fb", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "f551dbd1b97e5be4c81e0a78b1119059b7238fedad4ff0085d1601d3835e8493", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false