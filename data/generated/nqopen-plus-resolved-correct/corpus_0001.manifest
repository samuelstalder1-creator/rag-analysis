{"doc_id": "doc10659", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "In the Wild Card round the Kansas City Chiefs lost a tight game to the Tennessee Titans 22-21, allowing Derrick Henry to rush for 156 yards. That ended another disappointing season for the Chiefs, and extended their NFL record for most consecutive home playoff losses to six.", "reason": "near_duplicate_of_source", "seed": 932652366, "similarity": 0.9686924493554327, "temperature": 0.3}, {"attempt": 2, "generated_text": "In the Wild Card round, the Kansas City Chiefs lost a tight game to the Tennessee Titans 22-21, allowing Derrick Henry to rush for 156 yards. That ended another disappointing season for the Chiefs, and extended their NFL record for most consecutive home playoff losses to six.", "reason": "near_duplicate_of_source", "seed": 1326485160, "similarity": 0.9522058823529411, "temperature": 0.5}], "fingerprint": "b7290e37dc6f8b045a4cd9c01e894628f856c282da7e6cf0143a1c9655c4c717", "generation_attempts": 3, "gold_answer": "the Tennessee Titans", "matched_aliases": ["the Tennessee Titans"], "query_id": "test282", "question_hash": "0b3c263f5491ba5ca37ea1369f53c2e8ed23688293e08a90498d91f7de3a929e", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "9171fe3e464559b0a356d006e5f0fe1bf32399c2a96501c9b1f07bea5b5aaaa4", "scope": "all_answer_documents", "seed": 2052188558, "similarity": 0.39399624765478425, "source_content_hash": "145241f713075d67552e555deb0301662722d9b3899cb01db29f1a19f1f8044f", "source_hash": "8725d8c7d79bdc011170f62c424cdcb4dccabea0f7818d0615aa7e4389b19213", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "957f6d4adfe74ab389dda297e9103ffaf913fe25d3d33c9ac2c0961ef8365970", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified":