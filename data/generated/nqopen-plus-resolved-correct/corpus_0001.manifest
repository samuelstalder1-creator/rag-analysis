{"doc_id": "doc52200", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Hyderabad State was a state in Independent India, formed after the accession of the princely state of Hyderabad into the Indian Union on 24 November 1949. It existed from 1948 to 1956.", "reason": "near_duplicate_of_source", "seed": 1874361009, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "6539173b8585ebeef1088b7ea6c97d69541365ce4df21ad3550ccd932ebb7361", "generation_attempts": 2, "gold_answer": "24 November 1949", "matched_aliases": ["24 November 1949"], "query_id": "test1464", "question_hash": "34f1cc8927bdf58704f07e19d4aab4c44f2b32502b3bcee016a5e013a23e2e68", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "19890b0aa514ce9692a63e1835994fc1e2ab9fdfdf24e4dde8fa7bc71979765e", "scope": "all_answer_documents", "seed": 8577003, "similarity": 0.34382566585956414, "source_content_hash": "07969d738aebc48f4977cb736ed036549334b68e7b3965d58775a0eaa7ed1815", "source_hash": "b6c345b77ec08b7c4c1a8795ab7d51131954bbb2fcc15764616d746cfe7a8041", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "6bc5b4564c722cccd44b8e364ef29be6d600f22d110c0995f45d604ba33784e1", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
