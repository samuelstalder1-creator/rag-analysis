{"doc_id": "doc4632", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Flume was a Log Flume at Alton Towers in Staffordshire that opened in 1981 and was rethemed in 2004 coinciding with its sponsorship by Imperial Leather. The ride was a bath time themed log flume with three drops and was the longest log flume attraction in the world at the time of opening. The attraction closed in 2015 and was removed a year later for the area's redevelopment into the SW8 rollercoaster.", "reason": "near_duplicate_of_source", "seed": 1663530972, "similarity": 0.981640146878825, "temperature": 0.3}], "fingerprint": "a575d823fc0e814b0eeb779318f1860e21cd850dba514bb1b259eca18042c102", "generation_attempts": 2, "gold_answer": "10 October 2015", "matched_aliases": ["2015"], "query_id": "test124", "question_hash": "30f41920713b9382c581c36e9a7fffbafc870fa4b90629faa3526a0465027bdc", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "595cff52e635d4330c8c008fa32aeb77f24480b17d205ca6c7619c0bb71e8e7f", "scope": "all_answer_documents", "seed": 796739205, "similarity": 0.26425591098748263, "source_content_hash": "4a79682b6b804595b98be2494db84fd1f5f3fa3578dcfe5f7204231ce5376189", "source_hash": "bba17eab3092f7456ccaa6ab0de596248612302e94762d18854e34e99ebc2e4c", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "02aef13f6d2158642c305a4224d5a21600e7dd64a15e9ff36b3c673be7b6ac18", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
