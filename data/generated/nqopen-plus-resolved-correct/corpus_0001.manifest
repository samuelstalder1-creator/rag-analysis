{"doc_id": "doc13999", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Marvin is a male given name, derived from the Welsh name Mervyn.[1] It is also found as a surname. Marven is a variant form.", "reason": "near_duplicate_of_source", "seed": 1157567230, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "a02e1287c3782b911dbb89eca76248732f53fc1c58da59ac828205ee6890d6c1", "generation_attempts": 2, "gold_answer": "Welsh", "matched_aliases": ["Welsh"], "query_id": "test370", "question_hash": "08746fef7c6b11295446ce881cdf194fe57a5ede39cc98143f1a7021fb274361", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "0f4c39f39457da1215cdcfc122afd07bf75898b5befac0d178613142adca8b0a", "scope": "all_answer_documents", "seed": 497934371, "similarity": 0.03560830860534125, "source_content_hash": "ee69e39670d93d6fe8f655bfe7033f562205d1feaba9522c7850c87bf91a4990", "source_hash": "8700f072abc1dd31968c0c5c4b3e7826822df39961937d232bc38546dd54a825", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "9c376d9fdc94a6629d05aa0265b11376f8eb64a18fb99916508c1295d540d8c8", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc14083", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "This is an episode list for Sabrina the Teenage Witch, an American sitcom that debuted on ABC in 1996. From Season 5, the program was aired on The WB. The series ran for seven seasons totaling 163 episodes. It originally premiered on September 27, 1996 on ABC and ended on April 24, 2003 on The WB.", "reason": "near_duplicate_of_source", "seed": 1910087039, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "1f33244a078d1507f2da3f8b353c580101c14fd7adfcefdcd12b5240308423c0", "generation_attempts": 2, "gold_answer": "163", "matched_aliases": ["163"], "query_id": "test373", "question_hash": "fd8ec8f9776c2a2848b846c17ec4096df5cfbb323cc444b4a16f675e4dc65471", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "6fabc0450c50e02b34eb7d9070726f054370620a8d4c466634ed423f565bcc4e", "scope": "all_answer_documents", "seed": 329655829, "similarity": 0.20469798657718122, "source_content_hash": "49a8a709d9fa6803172bc3d4934cbe685d2ca925b4bbbd6f96710465c2484218", "source_hash": "499b701739087304d7f0a6484b4d1f00163065eff22c58bf93965c836bfcdfaa", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "29e77767bcf503931b84b5bc3c50b7663cc8c3b636512db2da6cad5731679625", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
