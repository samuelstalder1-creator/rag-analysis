{"doc_id": "doc5160", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Lykan Hypersport is a Lebanese limited production supercar built by W Motors, a United Arab Emirates based company, founded in 2012 in Lebanon with the collaboration of Lebanese, French and Italian engineers. It is the first supercar to be produced in the Middle East, and is featured in the film Furious 7, and the video games Project CARS, Driveclub, Asphalt 8: Airborne, Asphalt Nitro, Forza Motorsport 6, and GT Racing 2: The Real Car Experience, Forza Horizon 3, CSR Racing and CSR Racing 2. The Lykan can also be briefly seen in the second Fate of the Furious trailer, however, the Lykan does not make an appearance, the footage is from the seventh movie, Fast and Furious 7. It is the first car to be designed and produced indigenously in the Arab World.", "reason": "near_duplicate_of_source", "seed": 812660329, "similarity": 0.9922178988326849, "temperature": 0.3}], "fingerprint": "debe38ee53b7ace636119f53120ce034628f70b0bda0f0788f35eed09d8daa61", "generation_attempts": 2, "gold_answer": "The Lykan Hypersport", "matched_aliases": ["The Lykan Hypersport"], "query_id": "test137", "question_hash": "d10acccf7e003075dd5e9cb399f60aa9207a1ea8ee30e7ea9332523275e25e11", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "919f97659133b93b23cd963dd3be2e0fdabb3cc672a273fb0d92bea79af0feb8", "scope": "all_answer_documents", "seed": 664394882, "similarity": 0.38403303509979353, "source_content_hash": "63a41f6a8a4b2821197e7410718dea7560123d126c8b3d49bb91dc1fd31593fe", "source_hash": "09d570d441a67603845defa792c00873ce2b57db039db8def947502301823a4c", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "f7e6e3b9d236c5dfba9ef13c44e870780ae93e40106ce00bf525bf2ad309819b", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc5165", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "American Horror Story: Roanoke is the sixth season of the FX horror anthology television series American Horror Story. It premiered on September 14, 2016, marking the first time the series has debuted outside of October, and concluded on November 16, 2016.", "reason": "near_duplicate_of_source", "seed": 1467654607, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "d768158b247fadeae6982dad069370d5d59e1c023a49ed860aa7349df2a4a655", "generation_attempts": 2, "gold_answer": "Roanoke", "matched_aliases": ["Roanoke", "American Horror Story: Roanoke"], "query_id": "test138", "question_hash": "c83041d57e2b29a25ccbf62223fb0aa84d144f462a3199a06ef418c43bf7f54e", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "ccf385a03f915576d62b3007f651a58456db24f075743e2300832793a6ef40fd", "scope": "all_answer_documents", "seed": 628589188, "similarity": 0.8374164810690423, "source_content_hash": "2985c8ce25ef0f614ddb4456283f36486ca89229a67edacb6873459a5aca114d", "source_hash": "d7df28ab17bc2a2697043f32cdf9a5a9bd3c99bd223d84a88208c1b82304ac6a", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "3229a34772ced598a7f81b5f3e1d5bb5070cae16d3f7dadf381f5ca4e7b618de", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc5288", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"How Can You Mend a Broken Heart\" is a song released by the Bee Gees in 1971. It was written mainly by Barry and Robin Gibb and was the lead and first single on the group's 1971 album Trafalgar. It was their first US No. 1 single and also reached No. 1 in Cashbox magazine for two weeks.[1]", "reason": "near_duplicate_of_source", "seed": 1805300294, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "27e5fa595b48afb469521238704d6b449817177c2a252f9853c1fd4f5d307cab", "generation_attempts": 2, "gold_answer": "Bee Gees", "matched_aliases": ["Bee Gees"], "query_id": "test143", "question_hash": "864dbc366df5f4384facf2e89d140cbe8ed978161743bdc182642ac0614f281c", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "1c48ae8339e9957b4dad1048543ac7d32db4316e3ae2e325f453fe155e6cc895", "scope": "all_answer_documents", "seed": 622583653, "similarity": 0.3048780487804878, "source_content_hash": "5b3a046d006d62b2160fd49ccb9fdf3da1d30fd8679df17f9360c76033a38ea3", "source_hash": "a0dbe26f921b439d343fe9fa563a88ecad6f57d3631a8f50cf9d3d3ebd9f2bff", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "7666b8e8fa0de42bf5737eafccdb568a050249c81ae1106cf6835b31f7ef798f", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc5295", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "What's My Line? is a panel game show that originally ran in the United States on the CBS Television Network from 1950 to 1967, with several international versions and subsequent U.S. revivals. The game requires celebrity panelists to question a contestant in order to determine his or her occupation, i.e., \"line [of work],\" with panelists occasionally being called on to identify a celebrity \"mystery guest\" with specificity. It is the longest-running U.S. primetime network television game-show. Moderated by John Daly and with panelists Dorothy Kilgallen, Arlene Francis, and Bennett Cerf, What's My Line? won three Emmy Awards for \"Best Quiz or Audience Participation Show\" in 1952, 1953, and 1958 and the Golden Globe for Best TV Show in 1962.[1][2]", "reason": "near_duplicate_of_source", "seed": 551685985, "similarity": 1.0, "temperature": 0.3}, {"attempt": 2, "generated_text": "What's My Line? is a panel game show that originally ran in the United States on the CBS Television Network from 1950 to 1967, with several international versions and subsequent U.S. revivals. The game requires celebrity panelists to question a contestant in order to determine his or her occupation, i.e., \"line [of work],\" with panelists occasionally being called on to identify a celebrity \"mystery guest\" with specificity. It is the longest-running U.S. primetime network television game-show. Moderated by John Daly and with panelists Dorothy Kilgallen, Arlene Francis, and Bennett Cerf, What's My Line? won three Emmy Awards for \"Best Quiz or Audience Participation Show\" in 1952, 1953, and 1958 and the Golden Globe for Best TV Show in 1962.", "reason": "near_duplicate_of_source", "seed": 404868046, "similarity": 0.996005326231691, "temperature": 0.5}], "fingerprint": "820975dc829c65be014afe240ef5eea455885ec77612eac785e191e5aec4b00b", "generation_attempts": 3, "gold_answer": "John Daly", "matched_aliases": ["John Daly"], "query_id": "test144", "question_hash": "db7605a5ec8a60c62cd3a3ed1fa6e4c043f22a10dc40521f26d80f6c060e4881", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "0edc7e4339114ec7b3b967fced41692e1e371f64b5b40e8bd5929a09e133c81e", "scope": "all_answer_documents", "seed": 1522433232, "similarity": 0.21182266009852216, "source_content_hash": "0efb1c686fa4a774c3c06a94b93e40bff906904de97a091b75c4c9699de8bfcc", "source_hash": "07c97ee1f77fa9ba0005f25045088cd8f64d56547908e9b8fd9ed4514c314a94", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "f87752915e42991d33088274c902d404a1f60492e40dfc156662a7715526bdc9", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc5395", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Pat McCormick (June 30, 1927 – July 29, 2005) was an American actor and comedy writer known for playing Big Enos Burdette in Smokey and the Bandit and its two sequels. He wrote for a number of performers such as Red Skelton, Phyllis Diller and Johnny Carson as well as for shows including Get Smart. McCormick had a distinctive appearance being six feet, seven inches tall, weighing 250 pounds and having a walrus mustache.", "reason": "near_duplicate_of_source", "seed": 405636862, "similarity": 0.9917743830787309, "temperature": 0.3}], "fingerprint": "f4123d9a9a031ea241762375c1f6a0e61e06e1248e9c276d98228ca73349c71a", "generation_attempts": 2, "gold_answer": "Pat McCormick", "matched_aliases": ["Pat McCormick"], "query_id": "test145", "question_hash": "98194347952b9737147bd85487ac0292417b9852d50ae8aec50243ad4d1c64a6", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "4d286310be8602b13f83eec2b761c3ec1d5174b01eb40011a34145625e4a551a", "scope": "all_answer_documents", "seed": 1666173134, "similarity": 0.4407185628742515, "source_content_hash": "36a22ec447bc4fb249ef82a9305ffe842470cbab72ad1e0975cc4696175d6c4e", "source_hash": "317b55973f3fdd92170cc2be0a7dc66794a071688c676d4e24683248b6bd5135", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "aaafbdb5a5dbb4f9ea14870769b460f3994087812cbcf136d3d1dcd3347379a2", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc5402", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"You Can't Always Get What You Want\" is a song by the Rolling Stones on their 1969 album Let It Bleed. Written by Mick Jagger and Keith Richards, it was named as the 100th greatest song of all time by Rolling Stone magazine in its 2004 list of the \"500 Greatest Songs of All Time\".", "reason": "near_duplicate_of_source", "seed": 410025398, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "f81abf6c0d4aaa724a210eb3f4c953f0904ab5edafac96887c66ee7a2604b300", "generation_attempts": 2, "gold_answer": "the Rolling Stones", "matched_aliases": ["the Rolling Stones"], "query_id": "test146", "question_hash": "78794cd1c862c22b0575004153b9cb961c92377523f6628670f7e7db3598ebe8", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "31418088c0fe40cfb71b7e7b08f7fd1d352e97be144365c7a31f4ac6ea83ffea", "scope": "all_answer_documents", "seed": 1261699554, "similarity": 0.47368421052631576, "source_content_hash": "171e42e6b9413d9500b2b64d4de16ad49bf0012cb173957dbd7b8e9e1c68ffcc", "source_hash": "9dd42635d441918003de3b48e1ecd4b70bedb5a782e8e0cecba44eaaf87548de", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "17e66d6972e6aec55769657b02f91cf830bc86b9279c69b9ad0c31cb8f86ba29", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
