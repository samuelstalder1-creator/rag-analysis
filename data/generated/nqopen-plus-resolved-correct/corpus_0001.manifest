{"doc_id": "doc25685", "receipt": {"answer_in_original_body": false, "failed_attempts": [{"attempt": 1, "generated_text": "The Indian general election of 1951–52 elected the first Lok Sabha since India became independent in August 1947. Until this point, the Indian Constituent Assembly had served as an interim legislature. See the 'Durations' section below to find the time-range associated with these elections.", "reason": "near_duplicate_of_source", "seed": 1896959359, "similarity": 0.9780775716694773, "temperature": 0.3}], "fingerprint": "52724ecca71bc306cad38f77db3d0c361626e56ded62a0a68f8829f9ac13d82b", "generation_attempts": 2, "gold_answer": "1951–52", "matched_aliases": ["1951–52"], "query_id": "test718", "question_hash": "7ec69ead3cd4e9c97b4c7623ffd34326ef4624942b0933f7a942be6a4a706aa6", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 1, "row_hash": "ccb4206891a41b1dad5644bf1df739f2828fcbe762b97cf81807c187b1888bd7", "scope": "all_answer_documents", "seed": 178388660, "similarity": 0.2635228848821082, "source_content_hash": "8ff26df951bbeda64a39ce736a27064c82adeb294dfedd79baa4eb8cea689959", "source_hash": "3646d0a7decc2023cf60920c4ced33b4b7b30d0dde8c3dabeef60aebdc83a381", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "1c2a8f33b4068c4b2f0f16b44dcf2dfecf0ae50039e52218abd705e682403434", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
