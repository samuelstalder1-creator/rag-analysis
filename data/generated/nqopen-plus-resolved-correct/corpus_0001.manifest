{"doc_id": "doc66394", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Paraguay River (Río Paraguay in Spanish, Rio Paraguai in Portuguese, Ysyry Paraguái in Guarani) is a major river in south-central South America, running through Brazil, Bolivia, Paraguay and Argentina. It flows about 2,621 kilometres (1,629 mi) from its headwaters in the Brazilian state of Mato Grosso to its confluence with the Paraná River north of Corrientes and Resistencia.", "reason": "near_duplicate_of_source", "seed": 719597722, "similarity": 0.9934980494148244, "temperature": 0.3}], "fingerprint": "b56409468c9865aff3455df4a887746d36ee71cc7c4f69deb7f678be60382b8e", "generation_attempts": 2, "gold_answer": "Paraná River", "matched_aliases": ["Paraná River"], "query_id": "test1888", "question_hash": "b496e070bd51727344a63cc919a3890e6368be111f39d7da74bc832f1717aa9c", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "c1dc2501d15e6bbbee21b44d3b96bba8760f19cc6422f5a9b0c434fd10c4c409", "scope": "all_answer_documents", "seed": 1695033050, "similarity": 0.1631504922644163, "source_content_hash": "8921076530675eec13e435edab7ad8d779ed0322276fadb682a5e09adc91cea8", "source_hash": "e072dbcdfa9fb40f8450feef3a973c6bcdeba4cf558fd3533e21b340d1affb50", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "c44c4735cb472c878eb8658098ec8a15c6b63ce691d478c1b38f41f5dcb743b4", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
