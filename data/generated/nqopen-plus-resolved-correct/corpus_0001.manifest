{"doc_id": "doc112430", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"Papa's Got a Brand New Bag\" is a song written and recorded by James Brown.[1] Released as a two-part single in 1965, it was Brown's first song to reach the Billboard Hot 100 Top Ten, peaking at number eight, and was a number-one R&B hit, topping the charts for eight weeks.[2][3] It won Brown his first Grammy Award, for Best Rhythm & Blues Recording.[4]", "reason": "near_duplicate_of_source", "seed": 336367155, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "29e4548e4276163b42ac6a4081ec027b36f62790cb87ca9027b7b627a4d6b219", "generation_attempts": 2, "gold_answer": "James Brown", "matched_aliases": ["James Brown"], "query_id": "test3285", "question_hash": "c4af7916970fdde97e7bc7fe81a4c819e2afef0b83499dff48fb7a679f36c6d1", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "b25c6d7af2b2ceecc815a6bff5fd51a69344490bc2301afa736d912ccaad8185", "scope": "all_answer_documents", "seed": 1825114854, "similarity": 0.3511659807956104, "source_content_hash": "f5e7bfda2d3e60cb6a6c6d2344cd341c73687467d71fd19c430f43c536729be3", "source_hash": "8bafec87b1fc9cc8eba0ca46ed810c975b658ba853dd26dc2a204d930a1bf5d1", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "f57f698c9395240218da2ec45a8bcb1b408d00c544a95e9e36a024d46297f8a0", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc112481", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Their Eyes Were Watching God is a 1937 novel and the best known work by African-American writer Zora Neale Hurston. The novel narrates main character Janie Crawford's \"ripening from a vibrant, but voiceless, teenage girl into a woman with her finger on the trigger of her own destiny.\" As a young woman, who is fair-skinned with long hair, she expects more out of life, but comes to realize that people must learn about life 'fuh theyselves' (for themselves), just as people can only go to God for themselves. Set in central and southern Florida in the early 20th century, the novel was initially poorly received, but today, it has come to be regarded as a seminal work in both African-American literature and women's literature. TIME included the novel in its 2005 list of the 100 best English-language novels published since 1923.", "reason": "near_duplicate_of_source", "seed": 854731754, "similarity": 0.9946204423191871, "temperature": 0.3}], "fingerprint": "1cb79467f1db450c5fca6eec80737c26be260cc2a911b91b914cdad0983cf0f5", "generation_attempts": 2, "gold_answer": "Janie Crawford", "matched_aliases": ["Janie Crawford"], "query_id": "test3288", "question_hash": "6d5c017e58e1e19c6e66f831efa4391830b130fece91cd555dbe6237c3776e0a", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "960fc0e78724314c19d2c23839f49b52af298a4c1c77fe3cd66efadf96897222", "scope": "all_answer_documents", "seed": 834375808, "similarity": 0.3302526186075169, "source_content_hash": "06fdac59b4d7fe6bbbdd10355df4b71299116cbbcac376e6af66aade7580d169", "source_hash": "b11d2b4f47eb79ecf1d0259f3d4ec78fa9402503dd0b4c04b94fe20bc558441e", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "da2beed5ee45f8f8d74eeac3db48f136bc89d2a77d3b17dcc936ab4b15c805f5", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc112486", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The main character Janie Crawford, an African-American woman in her early forties, tells the story of her life to her best friend Pheoby Watson through an extended flashback. Readers receive the story of her life in three major periods corresponding to her marriages to three very different men.", "reason": "near_duplicate_of_source", "seed": 1027473380, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "5a2baa7fd454265c9146c44a3f19237e2d82af0344100aaf1d4baa629e38b771", "generation_attempts": 2, "gold_answer": "Janie Crawford", "matched_aliases": ["Janie Crawford"], "query_id": "test3288", "question_hash": "6d5c017e58e1e19c6e66f831efa4391830b130fece91cd555dbe6237c3776e0a", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "341906f49a9f06be44065e2889b2ca89e161a774ddac86af989bda9161a45fd2", "scope": "all_answer_documents", "seed": 706405169, "similarity": 0.2087745839636914, "source_content_hash": "301a81d5962c6505a15a4b53278255b6ddaa1e649b884df8aeefff6f3f0f8450", "source_hash": "cba95cd97b285d4b68378c73bb758219a3420f1a3f802aa934817d4d4f31f8a8", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "98b297e39ea1953eb176ab97daf9fb7f1c55f46ddf0f60be75000a5fc29948c1", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
