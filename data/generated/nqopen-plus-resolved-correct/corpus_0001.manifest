{"doc_id": "doc104753", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Great Depression began in August 1929, when the United States economy first went into an economic recession. Although the country spent two months with declining GDP, it was not until the Wall Street Crash in October 1929 that the effects of a declining economy were felt, and a major worldwide economic downturn ensued. The market crash marked the beginning of a decade of high unemployment, poverty, low profits, deflation, plunging farm incomes, and lost opportunities for economic growth and personal advancement. Although its causes are still uncertain and controversial, the net effect was a sudden and general loss of confidence in the economic future.", "reason": "near_duplicate_of_source", "seed": 777999637, "similarity": 0.994740796393689, "temperature": 0.3}], "fingerprint": "dc573f173ea81dab8e2ecf7e1534ec2fd7201e4e2e1445cf2d96c38a6dbdaf4d", "generation_attempts": 2, "gold_answer": "economic recession", "matched_aliases": ["economic recession", "recession"], "query_id": "test3060", "question_hash": "bc519d429c5556773123428719aaaf1b934cb429f58ba9aa73931ada67818a2c", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "6b23a7434a41c722c7439662cac135ad431d9e6edec38deb6466e8a7b1ada3b7", "scope": "all_answer_documents", "seed": 135169223, "similarity": 0.2887323943661972, "source_content_hash": "53a788e0bb89d34ae9346d53953948632416813ac45efc081ffbfc660ca56725", "source_hash": "4313874c049cfd3822acdd7e505427b59ade4ce14c7dde53f9a27f0ef804fa4b", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "bc053ce943561d6139789785367a0193591d187b2c066db67b8a1f6e65cbb099", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
