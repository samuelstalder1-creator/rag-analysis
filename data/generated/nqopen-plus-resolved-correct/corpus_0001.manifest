{"doc_id": "doc81099", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "George II (George Augustus; German: Georg II. August; 30 October / 9 November 1683O.S./N.S. – 25 October 1760) was King of Great Britain and Ireland, Duke of Brunswick-Lüneburg (Hanover) and Prince-elector of the Holy Roman Empire from 11 June 1727 (O.S.) until his death.", "reason": "near_duplicate_of_source", "seed": 364623408, "similarity": 0.9963235294117647, "temperature": 0.3}], "fingerprint": "d58d2c12603a1d86756d7e686591aca8609a32af5281812e87afc970eedae95c", "generation_attempts": 2, "gold_answer": "George II", "matched_aliases": ["George II"], "query_id": "test2348", "question_hash": "bf06395d17509d6ada0fea990e846416e1aa6f5e34ef045526cedad20e92d157", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "3def87636db68ff797ad8df2e9655fb69fd69983a164473575b8bb01820c6784", "scope": "all_answer_documents", "seed": 249928467, "similarity": 0.16602316602316602, "source_content_hash": "42aa74dcac0e2e95202597fbcd69e5cfcd7a5f7064ec0ec864b82cf0150751b0", "source_hash": "346eaf4d6c6eb56ec8f270e8ed060db5cee9afd0a27d72d616dae882606f9b57", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "5d3f4cd86ced03d6ea1066dccf150e50a5e07554628effaf5e3c6a7384846124", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc81161", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Tenth Amendment (Amendment X) to the United States Constitution, which is part of the Bill of Rights, was ratified on December 15, 1791.[1] It expresses the principle of federalism and states' rights, which strictly supports the entire plan of the original Constitution for the United States of America, by stating that the federal government possesses only those powers delegated to it by the United States Constitution. All remaining powers are reserved for the states or the people.", "reason": "near_duplicate_of_source", "seed": 1997007284, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "084add2cad3e004afcef2720df6e456888e06d0c05d693458b9ba14e1939914b", "generation_attempts": 2, "gold_answer": "the states or the people", "matched_aliases": ["the states or the people"], "query_id": "test2350", "question_hash": "96761e0c4a87621fb7cf2f4faecaf577ee44abdcf9fae15be96ba7d8b649f0c2", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "1d29855d9bf2b446488da8983b5ac374707c37c1ca6ca542bc9ca76b57a62b3a", "scope": "all_answer_documents", "seed": 714427838, "similarity": 0.4857142857142857, "source_content_hash": "025d5f36d9963f5fe51ac02b8d10d03861953f8c57fe4e74fa7c8dfb13e85ac1", "source_hash": "8db97bb29982d22262bce1a39a5a36a3aac2c3efcc587e4da0dcc81b39a376d3", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "4677fa8ef23ac56432fa4a7cdf6a44d5f01967b28dc0a5d2f660a3921f5d2d48", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerab