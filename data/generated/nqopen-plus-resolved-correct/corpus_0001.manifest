{"doc_id": "doc28282", "receipt": {"answer_in_original_body": true, "failed_attempts": [], "fingerprint": "33c26947ac550bb70806fb43e2cc71172f68c12b74101725c76f64efb92491c7", "generation_attempts": 1, "gold_answer": "Ed Roland", "matched_aliases": ["Ed Roland"], "query_id": "test795", "question_hash": "a77dd1d8393925a8a3f10a493b5023c9c382731e503b790563e4dddc9a90b58b", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "4fa16da6d6902c0acd04dcbee0a9ac0532cd13c8df9ff1ec568c1706eec4f63e", "scope": "all_answer_documents", "seed": 944766135, "similarity": 0.3411764705882353, "source_content_hash": "de14ccc8b8402d06e48923e70890a816a2053b71bc05d52082c73628348c5a4f", "source_hash": "1399ee138df35099c89287806a7bfa47ebfe3610743444d149bc8d99a79dd7fd", "target_answer": null, "temperature": 0.3, "validation": {"answerability_verified": false, "evidence_hash": "ab26ab657e8828788071fee3e38535048b246bc0563cb479297b1c0cbbf80c08", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc28377", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Dwyane Tyrone Wade Jr. (/dweɪn/ dwayn;[1] born January 17, 1982) is an American professional basketball player for the Miami Heat of the National Basketball Association (NBA). After a successful college career at Marquette, Wade was drafted fifth overall in the 2003 NBA draft by Miami. In his third season, Wade led the Heat to their first NBA Championship in franchise history and was named the 2006 NBA Finals MVP. At the 2008 Summer Olympics, Wade led the United States men's basketball team, commonly known as the \"Redeem Team\", in scoring, and helped them capture the gold medal. In the 2008–09 season, Wade led the league in scoring and earned his first NBA scoring title. With LeBron James and Chris Bosh, Wade helped guide Miami to four consecutive NBA Finals from 2011 to 2014, winning back-to-back championships in 2012 and 2013. After 1½ seasons away from the Heat with the Chicago Bulls and Cleveland Cavaliers, Wade was traded back to Miami in February 2018. A 12-time NBA All-Star, Wade is Miami's all-time leader in points, games, assists and steals, shots made and shots taken.[2]", "reason": "near_duplicate_of_source", "seed": 1039858205, "similarity": 1.0, "temperature": 0.3}, {"attempt": 2, "generated_text": "Dwyane Tyrone Wade Jr., born January 17, 1982, is a current professional basketball player for the Miami Heat of the National Basketball Association (NBA). After a successful college career at Marquette, Wade was drafted fifth overall in the 2003 NBA draft by Miami. In his third season, Wade led the Heat to their first NBA Championship in franchise history and was named the 2006 NBA Finals MVP. At the 2008 Summer Olympics, Wade led the United States men's basketball team, commonly known as the \"Redeem Team\", in scoring, and helped them capture the gold medal. In the 2008–09 season, Wade led the league in scoring and earned his first NBA scoring title. With LeBron James and Chris Bosh, Wade helped guide Miami to four consecutive NBA Finals from 2011 to 2014, winning back-to-back championships in 2012 and 2013. After 1½ seasons away from the Heat with the Chicago Bulls and Cleveland Cavaliers, Wade was traded back to Miami in February 2018. A 12-time NBA All-Star, Wade is Miami's all-time leader in points, games, assists and steals, shots made and shots taken.", "reason": "near_duplicate_of_source", "seed": 1729928152, "similarity": 0.9755872869645325, "temperature": 0.5}], "fingerprint": "49d135886740ae5f7d4c3c6ce08489c16d96cfce65e863d5b597ce039b042ba6", "generation_attempts": 3, "gold_answer": "the Miami Heat", "matched_aliases": ["the Miami Heat"], "query_id": "test797", "question_hash": "98856ecb182eb9882d66defd8c543f25e5fd69516529ce33ae84f7371b338b6e", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "9c5f3c4e6e23bb45ed06184b7bc62b6d06041485a38c2e3f97554b6dc479b2f7", "scope": "all_answer_documents", "seed": 957959035, "similarity": 0.8331021729079982, "source_content_hash": "8ffa42639fc56e6833e8b20d26cce371da77f5888accfb4f4fc979911d306da3", "source_hash": "30a363c9a060fc889eb7e05644ba81d3beb90e8689629afbd444b316215a6590", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "af0959904caf1426b34b88d14870de4e0aecb320a4fad3d4ebc19bad8c837f62", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc28431", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The law creating the guaraní was passed on 5 October 1943, and replaced the peso at a rate of 1 guaraní = 100 pesos. Guaraníes were first issued in 1944. Between 1960 and 1985, the guaraní was pegged to the United States dollar at 126 PYG to 1 USD.", "reason": "near_duplicate_of_source", "seed": 202613002, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "1072868723bdf8670b41ac19a38593e12bb1d80f193fbbb091cbf634cf23126e", "generation_attempts": 2, "gold_answer": "126 PYG to 1 USD", "matched_aliases": ["126 PYG to 1 USD"], "query_id": "test798", "question_hash": "0a4f2b945c14b69ffc94e976966bced5d014782272321f9daf555a54a1aafb93", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "f7ac427a36b22dce861ce8d46d53b9c97afca7fd82b59eabfb039c144f1412fb", "scope": "all_answer_documents", "seed": 325819261, "similarity": 0.615916955017301, "source_content_hash": "882ef771a593219a58c1464a224c7f42f7f08a9a8d324ae7f44b85d8d2ad4cff", "source_hash": "d11d9ecafdaea2423af6fb7d67cd54e4a1443e8dc022e351f52e3db530831547", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "27a3d6036f53a448956adf15ccf86f1ab1f41f3dc904554629f657b8d2ba9ebb", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc28475", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Johnny Manziel was nationally recruited out of high school as a dual-threat quarterback and debuted for the Texas A&M Aggies as a redshirt freshman in Kevin Sumlin's Air Raid offense during A&M's first season in the Southeastern Conference in 2012. He broke numerous NCAA Division I FBS and SEC records, which included becoming the first freshman and fifth player in NCAA history to pass for 3,000 yards and rush for 1,000 yards in a season. At the end of the regular season, he became the first freshman to win the Heisman Trophy, Manning Award, and the Davey O'Brien National Quarterback Award. Manziel capitalized on his redshirt freshman season by leading Texas A&M to a 41–13 victory over Oklahoma in the Cotton Bowl.", "reason": "near_duplicate_of_source", "seed": 115978855, "similarity": 0.9659863945578231, "temperature": 0.3}], "fingerprint": "067924878462c896c799bd25015f64b48c5054b793f9770fe4ecdaa32dec7441", "generation_attempts": 2, "gold_answer": "Texas A&M", "matched_aliases": ["Texas A&M", "Texas A&M Aggies"], "query_id": "test801", "question_hash": "45437cd2d1c5fa1546bae6ccdcbbf3cf17f28ecb33bb77099d2d76d6fd5eec79", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "316baf3b2de9843415aab1a152693c13bcbedc53179ca113dbd3831ef4521b50", "scope": "all_answer_documents", "seed": 2012887852, "similarity": 0.39303000968054214, "source_content_hash": "215ab73ab6670bafc3b7bac7c32bc1fe4cd6f0f020b87e5be2ab11541851690e", "source_hash": "84e35272d39bb7f87a0fa5c5aa020f9fac4fbcc52183151b547bea1f5a32cfd8", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "293573de1e8745e98aad465d9fc02bdab7e9c6b9fe6576ef3708c9939fb5bb4a", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "