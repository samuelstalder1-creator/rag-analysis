{"doc_id": "doc92926", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Australia (/əˈstreɪliə/ (listen), /ɒ-/),[10][11] officially the Commonwealth of Australia,[12] is a sovereign country comprising the mainland of the Australian continent, the island of Tasmania and numerous smaller islands. It is the largest country in Oceania and the world's sixth-largest country by total area. The neighbouring countries are Papua New Guinea, Indonesia and East Timor to the north; the Solomon Islands and Vanuatu to the north-east; and New Zealand to the south-east. Australia's capital is Canberra, and its largest urban area is Sydney.", "reason": "near_duplicate_of_source", "seed": 1195413756, "similarity": 0.9973142345568488, "temperature": 0.3}], "fingerprint": "eb55318c1121a3b911296f204748ce49667b1c4f6cbe12c443a60da4e4a2fc77", "generation_attempts": 2, "gold_answer": "Oceania", "matched_aliases": ["Oceania"], "query_id": "test2713", "question_hash": "a8f6f5e1260e307cd971c48c1393a135779989ae12e0909dc97cbff795c8953a", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "395d7c257881bcf7ae82c7972dba174cad961b51ac848b5ad9b0aca4ee5818e0", "scope": "all_answer_documents", "seed": 206207621, "similarity": 0.008532423208191127, "source_content_hash": "d8eec235c01252677baf648684114e6b4844c254caeaafa7f982d3ebc824a9c2", "source_hash": "9af8d3d9048b9d8af43386f71b705f1f26a46b84a8423742f4f4e57f1ecbde97", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "36120ce4bebf79674a011463c28b1ed4c547313abfc82930110c47ba7a27ce62", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", 