{"doc_id": "doc24721", "receipt": {"answer_in_original_body": true, "failed_attempts": [], "fingerprint": "7eeff99c7baaa26d9e7bb02ab93b963602720d757b52335a5a65e09d7e723c50", "generation_attempts": 1, "gold_answer": "France", "matched_aliases": ["France"], "query_id": "test689", "question_hash": "5bc81c28b583891395b0a86522957f53d1eecf7dd3df893b89da652e941c6fbd", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "8b4c13e5f865226ea198168e7cdbc5cff5738f5e4e5aa197138acceef69cbc48", "scope": "all_answer_documents", "seed": 1786720054, "similarity": 0.7538586515028433, "source_content_hash": "96f014e91951cbce515807821f5ab72669805d91919586a3dd2445e0face7c01", "source_hash": "cd7f5434d36420575ba64c14e14c685f6209ebe3d0b3e132db81eda857744f6e", "target_answer": null, "temperature": 0.3, "validation": {"answerability_verified": false, "evidence_hash": "83f73798191da94ed20ce6585d070c99da5265ebd402108f9af842b2a5a06e51", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc24786", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The most formal dinner is served from the kitchen. When the meal is served, in addition to the central plate (a service plate or dinner plate at supper; at luncheon, a service plate or luncheon plate) at each place there are a bread roll (generally on a bread plate, sometimes in the napkin), napkin, and flatware (knives and spoons to the right of the central plate, and forks to the left). Coffee is served in Butler Service style in demitasses, and a spoon placed on the saucer to the right of each handle. Serving dishes and utensils are not placed on the table for a formal dinner. The only exception in the West to these general rules is the protocol followed at the Spanish royal court, which was also adopted by the Austrian court, in which all cutlery was placed to the right of the central plate for each diner.", "reason": "near_duplicate_of_source", "seed": 343585681, "similarity": 0.998176291793313, "temperature": 0.3}], "fingerprint": "9bc477994d686d0746ee1c8215656b19a18507b4f5e41ecb3ab5254a19d07cfe", "generation_attempts": 2, "gold_answer": "at each place", "matched_aliases": ["at each place"], "query_id": "test691", "question_hash": "a292bc774dca0fd23cac56b81cfd4340d308388b28f6285cece05415de0bb33a", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "66de98ce33dbba9ce44c8dcb5721dec45c84cbbc77fa657894f48390aa16f286", "scope": "all_answer_documents", "seed": 70339576, "similarity": 0.01849217638691323, "source_content_hash": "d50307c47c5c76c16605ca3beb55e1eea4e5f1aa101f1330263666ba334fe311", "source_hash": "b3aa64373d6582b031060f7c9d801a498f7eae33288452ab541f12320f79b370", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "66e4cf35c451386c8ca3815fcb0835ed1759a8a7ac6f78d1b368098aa40440d7", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc24788", "receipt": {"answer_in_original_body": true, "failed_attempts": [], "fingerprint": "817fb21478359a128e3dd0fd2c97eb500ebf44cc7a60354bf0452c4ef9bc8372", "generation_attempts": 1, "gold_answer": "1999", "matched_aliases": ["1999"], "query_id": "test692", "question_hash": "9ce653eecc4d3f52106abc1dba0449794fce8d5c5441dcd78f563dfc39b38829", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "7912c110126e5af7e3f5c38ac2195102875eb858c342b7e73982665d706c1f65", "scope": "all_answer_documents", "seed": 1421952237, "similarity": 0.5216251638269986, "source_content_hash": "b2494922aa9f89bd7b021b45637c292b8ca3d0bb94d8bb9e29c22f75e45534c6", "source_hash": "ed9d5354ce69e8b51f10ce92be6d3062846ea46b901078c21102236d74c2ddc1", "target_answer": null, "temperature": 0.3, "validation": {"answerability_verified": false, "evidence_hash": "68bfb9a93ff1f6a9b315ecbddc8acd1129daf39714b1cd859528794648df2723", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc24805", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Johannes Gutenberg, a goldsmith by profession, developed, circa 1439, a printing system by adapting existing technologies to printing purposes, as well as making inventions of his own. Printing in East Asia had been prevalent since the Tang dynasty, and in Europe, woodblock printing based on existing screw presses was common by the 14th century. Gutenberg's most important innovation was the development of hand-molded metal printing matrices, thus producing a movable type based printing press system. His newly devised hand mould made possible the precise and rapid creation of metal movable type in large quantities. Movable type had been hitherto unknown in Europe. In Europe, the two inventions, the hand mould and the printing press, together drastically reduced the cost of printing books and other documents, particularly in short print runs.", "reason": "near_duplicate_of_source", "seed": 973826977, "similarity": 0.9964912280701754, "temperature": 0.3}], "fingerprint": "0f7e06d80b771c26eaf8a0f81ac6acd330597d46b222b9552c4a6f67ec5087cb", "generation_attempts": 2, "gold_answer": "Johannes Gutenberg", "matched_aliases": ["Johannes Gutenberg"], "query_id": "test693", "question_hash": "473226b0bf4c0caf809f32ee99603c7965a4d0d87074add05b6bb049355bf789", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "00981d37103c96bbe915568efe6a737f73a3a6c89d66b5592e9c0c611ddc154f", "scope": "all_answer_documents", "seed": 1503343147, "similarity": 0.08786885245901639, "source_content_hash": "d86ce8ca8379ffd5d07e47372a92fa3e39455541c30fd1b98a34fa6b81112680", "source_hash": "910fa8de47b7d640ecb64643786858c4c1aac60330a65822cc7f14cbdef50f61", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "b6f9f4e99dedd282b98a18e1de13806ae3effb0fa812bf318cb701b7608fa903", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc24903", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Earth rotates once in about 24 hours with respect to the Sun, but once every 23 hours, 56 minutes, and 4 seconds with respect to the stars. Earth's rotation is slowing slightly with time; thus, a day was shorter in the past. This is due to the tidal effects the Moon has on Earth's rotation. Atomic clocks show that a modern day is longer by about 1.7 milliseconds than a century ago, slowly increasing the rate at which UTC is adjusted by leap seconds. Analysis of historical astronomical records shows a slowing trend of 2.3 milliseconds per century since the 8th century BCE.", "reason": "near_duplicate_of_source", "seed": 1980465222, "similarity": 0.9846678023850085, "temperature": 0.3}], "fingerprint": "866edd65a50558538527d6c738df45190c66b8b63cf117a00ed7cb771cfd5bb0", "generation_attempts": 2, "gold_answer": "about 24 hours", "matched_aliases": ["about 24 hours"], "query_id": "test697", "question_hash": "1ebe12d58400da70cb1e67cbd325399caed72e8d40e9761157efd5874f6dfafa", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "0ed0f8ef8715d33f2205f5a06b754aafb341ba53e9f4a7490ca56ed1657e4cb6", "scope": "all_answer_documents", "seed": 810821496, "similarity": 0.23299161230195714, "source_content_hash": "8afadbc04262cce2e0a059f895917ba89bf3a2f266b53cb35c54d89ba2598d65", "source_hash": "3fa27668945dd22aabea55b3dcd341e1ed6f5ede2373dc23e99cced0b1ada97e", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "23a15bc7eb1c0b68f9a58b7a4d113d14df08506f0db662960f53e706fe80ba57", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc24944", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Phoenix Open was originally the Arizona Open, but was known for most of its history as the Phoenix Open until the investment bank Friedman Billings Ramsey became the title sponsor in October 2003, and it was known as the FBR Open for the next six editions. Waste Management began its sponsorship in 2010.", "reason": "near_duplicate_of_source", "seed": 766111235, "similarity": 0.9641693811074918, "temperature": 0.3}], "fingerprint": "62163476af630a9404be4cd60408b737d771039206e8186fd562b775ddde5d47", "generation_attempts": 2, "gold_answer": "Friedman Billings Ramsey", "matched_aliases": ["Friedman Billings Ramsey"], "query_id": "test699", "question_hash": "35faeb3b7d72f26de6bcfe3c42dc3227462253265a2a103fe43613d7236d55f6", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "52feb47104cc670bfdd03ab18f14010b5db577c7cea53b80f22cc0aa6217a7e0", "scope": "all_answer_documents", "seed": 1996994566, "similarity": 0.29213483146067415, "source_content_hash": "ffd5ee3e24e6b8ed6a18345ecd09bb1fb487a0aaf7375b61eadaab698ac924df", "source_hash": "81475e4482b12b2d9acda4fb5729110173167b9c0aab6cbf5da8f11d3201f279", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "935b55c4eaacc38f0473d0ab293218b840275aa43d1e740c353e39640c29e51f", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc24960", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The 1983 America's Cup was the occasion of the first winning challenge to the New York Yacht Club, which had successfully defended the cup over a period of 132 years. An Australian syndicate representing the Royal Perth Yacht Club fielded the Australia II, skippered by John Bertrand, against defender Liberty, skippered by Dennis Conner. Australia II won the match races to win the America's Cup, ending the longest winning streak in sporting history and ending U.S. domination of the racing series.", "reason": "near_duplicate_of_source", "seed": 1171632473, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "c0494cbac0ab16b691fec2412887570b0ad15dfe4de3876caafcb2d95fa489c3", "generation_attempts": 2, "gold_answer": "1983", "matched_aliases": ["1983"], "query_id": "test700", "question_hash": "b2b49acfb4d699d78e85b9b5fa213807eb0e7a196da4cc66a8845b043c4f2b1a", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "1532783b450301903a61b6b8864d31643ac9f876219e427192649690c34c42ff", "scope": "all_answer_documents", "seed": 574248475, "similarity": 0.16541353383458646, "source_content_hash": "5babff50d61399aec34bb817d3cc9003a9d2b410163d7b3d166d8aadfbdc050b", "source_hash": "99360a878583d43078dabee39dc89c381bd25795d92e1957de19e2ea84a2a19b", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "1ac6a33e7152bbde28e1bf9a5e3ba3c5bf0850228db77f2a23f461497b0ab4a7", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc24974", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Toronto Maple Leafs (officially the Toronto Maple Leaf Hockey Club) are a professional ice hockey team based in Toronto, Ontario. They are members of the Atlantic Division of the Eastern Conference of the National Hockey League (NHL). The club is owned by Maple Leaf Sports & Entertainment, Ltd. and are represented by Chairman Larry Tanenbaum. With an estimated worth of US $1.1 billion in 2016 according to Forbes, the Leafs are the third most valuable franchise in the NHL, after the Montreal Canadiens and the New York Rangers.[3] The team's broadcasting rights are split between BCE Inc. and Rogers Communication.[4] For their first 14 seasons, the club played their home games at the Mutual Street Arena, before moving to Maple Leaf Gardens in 1931. The club moved to their present home, the Air Canada Centre in February 1999.", "reason": "near_duplicate_of_source", "seed": 483656392, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "6b68e842daebba35c574169d4393a1c484c6ff98e8f283c836a7b7f6e1d083ac", "generation_attempts": 2, "gold_answer": "Air Canada Centre", "matched_aliases": ["Air Canada Centre"], "query_id": "test701", "question_hash": "06e10c6dd839e29a39bb7c2a5bd4a6362d1c6c5a8df7c633db8a11e499d754ba", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "2b2d0d46350292d97faaf97b9b07092fb33ad78253f650437d99a087004d76ba", "scope": "all_answer_documents", "seed": 865544269, "similarity": 0.20717131474103587, "source_content_hash": "d88830d0b7746b871ee995a7d7f89359d5541ec8c1cbec8056915fe600880bb2", "source_hash": "d4cc7e5258f24785e040562606c4f9f932d8ca36063a478da7b6a773ede2640e", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "78c0635dcb5331d0a6eb72c12231b66c7fef81ad038495c290996c621d011df8", "format_attempts": [], "judgment": {"gold_alias_present":