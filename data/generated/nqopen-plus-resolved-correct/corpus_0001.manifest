{"doc_id": "doc45685", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Bureau of Land Management (BLM) is an agency within the United States Department of the Interior that administers more than 247.3 million acres (1,001,000 km2) of public lands in the United States which constitutes one-eighth of the landmass of the country.[2] President Harry S. Truman created the BLM in 1946 by combining two existing agencies: the General Land Office and the Grazing Service.[3] The agency manages the federal government's nearly 700 million acres (2,800,000 km2) of subsurface mineral estate located beneath federal, state and private lands severed from their surface rights by the Homestead Act of 1862.[3] Most BLM public lands are located in these 12 western states: Alaska, Arizona, California, Colorado, Idaho, Montana, Nevada, New Mexico, Oregon, Utah, Washington and Wyoming.[4]", "reason": "near_duplicate_of_source", "seed": 1737322963, "similarity": 0.9950617283950617, "temperature": 0.3}], "fingerprint": "3381dbce3bfd6461571080c3bd30655d6b2467b4d4f83fb07b914f379bd79074", "generation_attempts": 2, "gold_answer": "247.3 million", "matched_aliases": ["247.3 million"], "query_id": "test1286", "question_hash": "30fa7717bc1056b8a37d849e90f3ad8d30ce1630165395adca34625baf708de2", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "0481d0e79a33d555c69ec1691c550136f5f581ea3ff46461de9dcce457887a94", "scope": "all_answer_documents", "seed": 1535306350, "similarity": 0.32398316970546986, "source_content_hash": "de51b04a156564b0f97194ce480c04f2a13ef51fe84f6616d31548493bec6314", "source_hash": "f67725865b5402cac32e7c6987ab1b537e83d2dc18f3f7249ff14f52ca5ee9c1", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "2492ae9c497fad471c48483f8fcaf1072a4984d3edca59f335806ec9c33a26bd", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_