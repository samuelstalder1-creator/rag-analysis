{"doc_id": "doc25140", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The eighth season of Blue Bloods, a police procedural drama series created by Robin Green and Mitchell Burgess, premiered on CBS on September 29, 2017. The season is set to contain 22 episodes.", "reason": "near_duplicate_of_source", "seed": 2004767566, "similarity": 0.9846938775510204, "temperature": 0.3}], "fingerprint": "045a44a417082f64cdd8548531de9daa6c70f0750b2115bbaf74a07bc74f8eac", "generation_attempts": 2, "gold_answer": "September 29, 2017", "matched_aliases": ["September 29, 2017"], "query_id": "test705", "question_hash": "d4fabfe19b0dd7471f7030134eee1fa2a6f70f8847299458d25ab4ddebaf6a30", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "2153f39597312534b1825e5088eeb837092d996466f18838718ef4e75defed77", "scope": "all_answer_documents", "seed": 2026263496, "similarity": 0.25, "source_content_hash": "8f8c3db57653fd03e5ead7896682acf605bed3effe100f8997f23e2f8b8ef802", "source_hash": "effcce6744a072c7939b293f41a981d3e82937a9339e0f10bc3b2b6ac6aac57b", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "1ea8854715ab49c366325df7e58d214b9ea114e794e3eea36df232080e3ced1c", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc25144", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The country consists of a mountainous, peninsular mainland jutting out into the Mediterranean Sea at the southernmost tip of the Balkans, and two smaller peninsulas projecting from it: the Chalkidice and the Peloponnese, which is joined to the mainland by the Isthmus of Corinth. Greece also has many islands, of various sizes, the largest being Crete, Euboea, Rhodes and Corfu; groups of smaller islands include the Dodecanese and the Cyclades. According to the CIA World Factbook, Greece has 13,676 kilometres (8,498Â mi) of coastline, the largest in the Mediterranean Basin.[2]", "reason": "near_duplicate_of_source", "seed": 2055900050, "similarity": 0.9982758620689656, "temperature": 0.3}], "fingerprint": "f9c22c8c4132f6c2a87298ddc0053e12549f9638a18232a9b5da1554f3020d33", "generation_attempts": 2, "gold_answer": "peninsula", "matched_aliases": ["peninsula"], "query_id": "test706", "question_hash": "103d4049132314cb07ae2390a23569bed1b9420115010f2f1b3bfc77be462d27", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "421dd5a9c28bf1b5dd16188c079d8cd35eeb86676ec1ec2439d9ec49d0e4537f", "scope": "all_answer_documents", "seed": 171158245, "similarity": 0.19329696024941542, "source_content_hash": "b524ba8333b614eaa749ef54f746f49c5a7d62a10937faa31f6f7dadb8bbd6c5", "source_hash": "16a3cac8bdab3401f96a4370ec8fa0773316316adb07a0bf447eaef37496e409", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "38ab764741b670417159da9a04260a2fd35f4eb7364741ed44cb13c1b8b563d4", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc10