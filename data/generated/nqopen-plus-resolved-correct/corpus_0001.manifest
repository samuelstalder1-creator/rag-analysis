{"doc_id": "doc21153", "receipt": {"answer_in_original_body": true, "failed_attempts": [], "fingerprint": "7b5621a83ab8fbf7df89c9a4d20c852e946ff370c7550367c875d126a66ededc", "generation_attempts": 1, "gold_answer": "in Santa Monica", "matched_aliases": ["in Santa Monica"], "query_id": "test587", "question_hash": "23c960fff8cf75b98c857123f3b69fa9ce5c08bd67ed62da775b6d9a423e7dcb", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "00be1e87cf3a2e524d1273d578e0687a44ad7d8f26e3289491eb647b185c7721", "scope": "all_answer_documents", "seed": 1009818109, "similarity": 0.23576158940397351, "source_content_hash": "3f1fc494ce92d7f73c63e791131f048eace19231d0c257579453ceb7fc95ad9c", "source_hash": "1cc74938b5c4bc3ff75381b9acb6770af817da21f701a67eb31037471c2e7deb", "target_answer": null, "temperature": 0.3, "validation": {"answerability_verified": false, "evidence_hash": "2afce910fdc75698aea81d8d2ca1da9b9c8ea8656a0378835c8662cebf647d9e", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc21191", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "In the episode \"Killer Within,\" the character of Lori Grimes dies.", "reason": "missing_gold_answer", "seed": 1427491266, "similarity": null, "temperature": 0.3}, {"attempt": 2, "generated_text": "In the episode titled \"Killer Within,\" the character Lori Grimes dies, an event that garnered favorable reviews from television commentators. According to HitFix writer Alan Sepinwall, the moment when Lori and Carl share their goodbyes was the most heartbreaking event since the ending of the second season episode \"Pretty Much Dead Already.\" Los Angeles Times columnist Laura Hudson felt it was a grim departure for a character who endured long bouts of grief for reasons beyond her control. Erik Kain from Forbes magazine found Lori's death especially difficult to watch, and was shocked by T-Dog's \"sudden\" death despite the fact that he \"was never as prominent a figure\" on the program. \"As hard as these deaths were to watch,\" Kain wrote, \"they also give me faith in the show.\" Even though he stated that T-Dog died \"a hero's death,\" Michael Rapoport of the Wall Street Journal concluded that Lori's \"gut-churning\" demise was the more memorable.", "reason": "missing_gold_answer", "seed": 1925692204, "similarity": null, "temperature": 0.5}], "fingerprint": "78ed856b464458e1009bbe3135401cd52d2b506110fb4c34068691a175832aa1", "generation_attempts": 3, "gold_answer": "\"Killer Within\"", "matched_aliases": ["\"Killer Within\""], "query_id": "test588", "question_hash": "2d1a85e8489f5ba156a71317e84c6aa43425563fefef5585cd667e84aa6d51d9", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "8d03c94399c926784f249d78ac87b56bc66d789964beb627a3c7c73b70d26249", "scope": "all_answer_documents", "seed": 275865550, "similarity": 0.46573426573426574, "source_content_hash": "1827881ed13ccd8dbbdd294978a862e9ba82bdb28a1924eb68dcbe0f1881faab", "source_hash": "0fbd61fecba39b42956d61c55028f73a7bd6a33f970948d8c912cca1a9ef8a12", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "0d78099b6db2a9d0122e93584bf99ba7318df85e55999fea0424db4d639109c7", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
