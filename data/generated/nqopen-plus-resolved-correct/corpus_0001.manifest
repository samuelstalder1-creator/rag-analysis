{"doc_id": "doc35439", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Georgia State Panthers football team is the college football program for Georgia State University in Atlanta, Georgia. The Panthers football team was founded in 2010 and currently competes at the NCAA Division I FBS level. The team is a member of the Sun Belt Conference.", "reason": "near_duplicate_of_source", "seed": 215444277, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "d63092afa244dc2c402073deda6f6d3162e6bdb9d6202b1147151d54b00ddc77", "generation_attempts": 2, "gold_answer": "2010", "matched_aliases": ["2010"], "query_id": "test1005", "question_hash": "466858740ad05f7cded53cd5830da344579c967e975acb32418d9a727eefc9be", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "fd1fb79572efdf3e568e74cb5685caf51d65a8d9e0cad2b6036e723c9562b485", "scope": "all_answer_documents", "seed": 2011661589, "similarity": 0.06451612903225806, "source_content_hash": "c11d4545cf50fa3cd5d148857bebc6c517e3ced77321c98211fb7ad3ef228e41", "source_hash": "509182b1d92630fd8abc446a0f931a528017689619931d0cfcb2c91df520cdb8", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "e9b7f198f67854c100ed4d6669d899424225aeca1ee402819c1da45b25cc31f5", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc35474", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The 2017–18 NBA season is the 72nd season of the National Basketball Association (NBA). The regular season began on October 17, 2017, earlier than previous seasons to reduce the number of \"back-to-back\" games teams are scheduled to play, with the 2017 runners-up Cleveland Cavaliers hosting a game against the Boston Celtics at Quicken Loans Arena in Cleveland, Ohio. Christmas games will be played on December 25, and the 2018 NBA All-Star Game will be played on February 18, 2018, at the Staples Center in Los Angeles, California. The regular season will end on April 11, 2018 and the playoffs will begin on April 14, 2018.", "reason": "near_duplicate_of_source", "seed": 565027821, "similarity": 0.9832402234636871, "temperature": 0.3}], "fingerprint": "57d806badd4517240ed9a48e53ac53593cd8f1f363cd9c949142952d181f97b7", "generation_attempts": 2, "gold_answer": "October 17, 2017", "matched_aliases": ["October 17, 2017"], "query_id": "test1006", "question_hash": "df208159f67f8a019c0a7de8f5ced055df051b9a45a73f1543490c28a8d25b36", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "86942c527744fb2d81ed8314ffe540e3c1313d82d9f8c19198737ca591deb4ca", "scope": "all_answer_documents", "seed": 221093345, "similarity": 0.2727272727272727, "source_content_hash": "1d99db768ee9523dc7306fb254d1e967bb69acdbb17d2b315c613da3a5da5f4c", "source_hash": "75806b4f42313a7e540201b9713dd8cc51456910e7426236b1acefa1acc91d55", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "12866bedc04e3e86afc35e24e7f77fdee9b2907314a3361c2d065f2d960aa7c0", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "v