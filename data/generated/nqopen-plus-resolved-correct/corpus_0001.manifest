{"doc_id": "doc60487", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"That Ain't No Way To Go\" is a song co-written and recorded by American country music duo Brooks & Dunn. It was released in March 1994 the fifth and final single from their album Hard Workin' Man. The song reached the top of the Billboard Hot Country Singles & Tracks (now Hot Country Songs) chart.[1] It was written by Kix Brooks, Ronnie Dunn and Don Cook.", "reason": "near_duplicate_of_source", "seed": 666256583, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "8821daa980ba468aee89018ec0dcfe81f075652bfc6ee276dab5eed7577a8b20", "generation_attempts": 2, "gold_answer": "Brooks & Dunn", "matched_aliases": ["Brooks & Dunn"], "query_id": "test1703", "question_hash": "ecd99af910920bc0ecd88cd0bb3ac14e13ec897679176be6deeae74eb9d5fda3", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "9e92bb6454fb38dc7531c51a374bb113f73fbc06d739eb1672618e0dc826494e", "scope": "all_answer_documents", "seed": 790808302, "similarity": 0.3346508563899868, "source_content_hash": "ada992e46c5f8b7166bd0e97e6641089a7c2a9d34e4e9a752bfc5cc62e9db144", "source_hash": "28bd51b22fc12a2c932b76fbe516d6fcf5e04619f654f530da6984ccfb2973f6", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "ae7bdbaeca8455260aa6e55683378daf7b8fa895dc40698966674bb82df45f81", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc60549", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"Joe's Garage\" is a single on Frank Zappa's 1979 album Joe's Garage Act I. After the introductory track, \"The Central Scrutinizer\", this song begins the story of Joe's Garage. Although it only charted in Norway and Sweden (where it was a top 20 hit in both countries), it was one of Zappa's songs which had the most airplay on American FM radio, at the time still album-centered. The song was played in concert from 1980 to 1988 along with the song \"Why Does it Hurt When I Pee?\" in all tours of Zappa's after the single's release. The single version of the song lacks many of the special effects that the album version contains. The single version of \"Joe's Garage\" was put onto Zappa's best-of Strictly Commercial.[1]", "reason": "near_duplicate_of_source", "seed": 1236095016, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "e5dbc8485cf3db3a6013511e73e35ca330b5386827b16026f37f2c05d804bb50", "generation_attempts": 2, "gold_answer": "Frank Zappa", "matched_aliases": ["Frank Zappa", "Frank Zappa's"], "query_id": "test1706", "question_hash": "d06622584a0d5c017d3855b13648c841813547ee6d73e9cbeaf7d35332a314b1", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "ffbf5472610c1da2ee44fd75daa62df2678e5dc2a2e37dee8986d0cd5ddd95c7", "scope": "all_answer_documents", "seed": 1414853665, "similarity": 0.24402308326463315, "source_content_hash": "568cfdc7c3781fedfa6d3773da0549e78216a4e1a5848cc340b0502dab956b5c", "source_hash": "8ca411a025c7e5b51aa939d20c870f165faccdd4114c0f1eadb03ca86bd8b24b", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "873a204881df609fa7e0be5f11784f6bf17147aa701afb0c77b3d508242a8d70", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semanti