{"doc_id": "doc111034", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The second season of Fargo, an American anthology black comedy–crime drama television series created by Noah Hawley, premiered on October 12, 2015, on the basic cable network FX. Its principal cast consists of Kirsten Dunst, Patrick Wilson, Jesse Plemons, Jean Smart, and Ted Danson. The season had ten episodes, and its initial airing concluded on December 14, 2015. As an anthology, each Fargo season possesses its own self-contained narrative, following a disparate set of characters in various settings.", "reason": "near_duplicate_of_source", "seed": 287510938, "similarity": 0.9960629921259843, "temperature": 0.3}], "fingerprint": "ac532cdfcff8dc018abdc6f7b079a711354552ef5a05c3d32a507487b6b4b94a", "generation_attempts": 2, "gold_answer": "10", "matched_aliases": ["ten"], "query_id": "test3250", "question_hash": "6abbb1d6dd47eb78c7d78e0b29f63ea19c0885eb2bec980affb148e2ad015f8d", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "760ac2429de84db9576c1d283bc3ecda194ccdaa4f3ba06c7abefeffaacbcf31", "scope": "all_answer_documents", "seed": 866708441, "similarity": 0.6229508196721312, "source_content_hash": "bc5f2d8a0f6a75223b640371313e849386fc66ad6aabb20e6dd84e42798c0a9e", "source_hash": "9520dbb03301c66da689fc93b5860c47bbdea06f980d8bd46b51e7043ff9917a", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "5d56714b9891744eaf6cd8dd7e89684638e65892145f8918a6e3ec651c2bf673", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc111053", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Megan Park (born July 24, 1986) is a Canadian actress and singer. She is known for her portrayal of Grace Bowman in the television series The Secret Life of the American Teenager.", "reason": "near_duplicate_of_source", "seed": 84204936, "similarity": 0.9916897506925207, "temperature": 0.3}], "fingerprint": "13ee8636a8d620513b549869047d65ac6b06b2f01a1ef1947f1e7f2942fd7f78", "generation_attempts": 2, "gold_answer": "Megan Park", "matched_aliases": ["Megan Park"], "query_id": "test3251", "question_hash": "0dc4ff3856927005b3ea37fd7f0fcd2b951b2fc4e91bb08e99ec2f34505c8934", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "32e351b4f79e8688e6047f06976e0dc42164e7918801c8cd6ad114ad387589a6", "scope": "all_answer_documents", "seed": 685805912, "similarity": 0.855457227138643, "source_content_hash": "2a22a35ab969d7ae3f00726b76f9ce9aa8cc4a461bc3f71b5ac780c1aa3cd135", "source_hash": "0494fd5c2380f8c7d1e6de62410a4149ea007537fa5b59c9e3706b97e0515ba8", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "c2363361946c6d3ecd8be47b5ebb980bc727e8e3543674dbb1afff55c1d0b529", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc111209", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "In Australia and New Zealand, the term SUV is not widely used, except by motoring organizations, the press, and industry bodies. Passenger class vehicles designed for off-road use are known as \"four-wheel drives\", \"4WDs\", or \"4Ã—4s\". Some manufacturers do refer to their products as SUVs, but others invented names such as XUV, HSV Avalanche XUV, or action utility vehicles (AUVs). The term \"AWD\", or all-wheel drive, is used for any vehicle which drives on all four wheels, but may not be designed for off-road use. \"Crossover\" is a marketing term for a vehicle that is both four-wheel-drive and primarily a road car.", "reason": "near_duplicate_of_source", "seed": 1950719944, "similarity": 0.967032967032967, "temperature": 0.3}], "fingerprint": "4c0d1ed126e5e1bbcced62e7792bf160ce241979ba29f7d2590c10d42a47eba3", "generation_attempts": 2, "gold_answer": "action utility vehicles", "matched_aliases": ["action utility vehicles"], "query_id": "test3253", "question_hash": "01c8737c5bffd8b66d206539ec8c0ed3d8c8e27bb5f284467895f3713df42fad", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "82c9bd24fb39d84f353ebc94a81c78777336753bc7021e780efe8033fd9cd3a1", "scope": "all_answer_documents", "seed": 287928975, "similarity": 0.3215130023640662, "source_content_hash": "a30a61519f439e9643b5ec0b207e5de2ace0a0aa14d7a02779bf0c6b76359541", "source_hash": "969a5fd50b376bf6c0ebe2d7aa9df632621f2a2c53fba50a1a462cdfd101bc10", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "222bf9928b6a91345428835b7de90cc533c1d93fae223cd1d9dc9bc98d1ae36c", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc111218", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Nodar Kumaritashvili (Georgian: ნოდარ ქუმარიტაშვილი; pronounced [nɔdar kʰumaritʼaʃvili]; 25 November 1988 – 12 February 2010) was a Georgian one-man luger who suffered a fatal crash during a training run for the 2010 Winter Olympics competition in Whistler, British Columbia, Canada, on the day of the opening ceremony. He became the fourth athlete to die during preparations for a Winter Olympics, and the seventh athlete to die in either a Summer or Winter Olympic Games.", "reason": "near_duplicate_of_source", "seed": 1165965075, "similarity": 0.9957716701902748, "temperature": 0.3}], "fingerprint": "93b51b3040c55b3cd0fa5612fd02bedd09122738774486f1f706183856d35eaf", "generation_attempts": 2, "gold_answer": "Nodar Kumaritashvili", "matched_aliases": ["Nodar Kumaritashvili"], "query_id": "test3254", "question_hash": "bb3a58a8dbf8f64b31d925035e9468c4ff4de1de536078d46a05997839fd2198", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "52776ac17f132ba606ba01faebb846c2388980784b0263c323d3fbe6afe4c609", "scope": "all_answer_documents", "seed": 1005570771, "similarity": 0.43337195828505215, "source_content_hash": "2a3ed0dc217bdca9f3d73a056555c1d0fd3871455e804bee198eab8e3354a360", "source_hash": "9c5c7ede83e11c747437fe0ce130ff8ed9cd241dabe49cac89d2cf07cb04538f", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "2d3dfe68cdf5b0a62412181593f90aaefd00f2c39ffaa3906f96bce6171629ee", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"