{"doc_id": "doc91474", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Julie Deborah Kavner (born September 7, 1950) is an American actress, voice actress and comedian who first attracted notice for her role as Valerie Harper's character's younger sister Brenda in the sitcom Rhoda for which she won a Primetime Emmy Award for Outstanding Supporting Actress in a Comedy Series. She is best known for her voice role as Marge Simpson on the animated television series The Simpsons. She also voices other characters for the show, including Jacqueline Bouvier, and Patty and Selma Bouvier.", "reason": "near_duplicate_of_source", "seed": 1564219068, "similarity": 0.9912536443148688, "temperature": 0.3}], "fingerprint": "154a03d78bbecea6b5987dd7f19bf639ccfccf031740b8368990e559124cde1c", "generation_attempts": 2, "gold_answer": "Julie Deborah Kavner", "matched_aliases": ["Julie Deborah Kavner"], "query_id": "test2670", "question_hash": "c7b13e702509ef9406b7a43012e4782bb0ce3acf98d2e7dd2930044fdc3146fa", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "1e94ba4823aac43c7cce34ea996508ea258757ba12b8d49fff737a0509091dda", "scope": "all_answer_documents", "seed": 457432809, "similarity": 0.11374407582938388, "source_content_hash": "6dbcbb4ac72999c95ebf342c60532715840b522c4d47eba3480481f800b3405a", "source_hash": "d80485d6d100419e01ebfb16e8870758129922e9c1ba8e0f709a8329947f9079", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "18762144d1ede827b0316841bcaadf230dfec5b2ea3fa2bb13559b3a1958aa3d", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "