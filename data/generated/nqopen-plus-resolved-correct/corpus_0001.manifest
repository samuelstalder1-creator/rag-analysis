{"doc_id": "doc33209", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"How Long\" is a 1974 song by the British group Ace from their album Five-A-Side. It reached No. 3 in the US and Canadian charts, and No. 20 in the UK Singles Chart.", "reason": "near_duplicate_of_source", "seed": 447008263, "similarity": 0.9909365558912386, "temperature": 0.3}], "fingerprint": "935358bc9217438f15945c6e86b0d8644e064f92475b62d23313fb06da36464e", "generation_attempts": 2, "gold_answer": "Ace", "matched_aliases": ["Ace"], "query_id": "test931", "question_hash": "e8644b08db21d769cfdbef59e6a374c61a73d4672980bc0b8ecef11cbc8c93c9", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "03df7de1817d80582ccafb168c50edf4b839b0cf981b53bd4b2e890fad3e20e4", "scope": "all_answer_documents", "seed": 30062848, "similarity": 0.5544554455445545, "source_content_hash": "a2ad6f6ac79718916cf24370ec31dcc2efbf56f7ab664e8d679ad9488753f2c1", "source_hash": "f7e1db65a5ca2e25a0a23a4ed19fb8835ca25f522c86ee7e4480321ad4863650", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "ff8fd74e4f9e3b98fbfc0731cd40b50a5cdc67437089713fcf2df482952b9d18", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
