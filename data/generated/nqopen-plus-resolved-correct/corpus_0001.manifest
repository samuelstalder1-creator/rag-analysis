{"doc_id": "doc97306", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Red Guards (simplified Chinese: 红卫兵; traditional Chinese: 紅衛兵; pinyin: Hóng Wèibīng) were a student mass paramilitary social movement mobilized by Mao Zedong in 1966 and 1967, during the Cultural Revolution. According to a Red Guard leader, the movement's aims were as follows:", "reason": "near_duplicate_of_source", "seed": 118906200, "similarity": 0.9946140035906643, "temperature": 0.3}, {"attempt": 2, "generated_text": "Red Guards (simplified Chinese: 红卫兵; traditional Chinese: 紅衛兵; pinyin: Hóng Wèibīng) were a student mass paramilitary social movement mobilized by Mao Zedong in 1966 and 1967, during the Cultural Revolution.[1] According to a Red Guard leader, the movement's aims were as follows:", "reason": "near_duplicate_of_source", "seed": 582707379, "similarity": 1.0, "temperature": 0.5}], "fingerprint": "a1480049d8bc28e84f48956f2b23a57b9b67f5f0b3dec7afadd376c0628572e0", "generation_attempts": 3, "gold_answer": "1966 and 1967", "matched_aliases": ["1966 and 1967", "in 1966 and 1967"], "query_id": "test2840", "question_hash": "7af12f391a2a993769c22ce0b2ccda4ec71fd6a6bacf5a9ec81f2f1ef3ea347d", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 1, "row_hash": "bda655c1ae618b178d6dbf31b1abd19818a5dd3d87149fbc811c458c8ff294ec", "scope": "all_answer_documents", "seed": 727867486, "similarity": 0.36661211129296234, "source_content_hash": "71f0c4e5bcb36451fe422fc7226c09907fc356ec72d2186767ec0a3f5668ce41", "source_hash": "c11c8abf18afe96a2dd6888551fbcf27a756a386b9437d6bd041859b38e862f4", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "e51739104440b7131756ca6e3585b5cee3f8f3b4d33aa1caddd4261a4a5ed0c8", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semant