{"doc_id": "doc114327", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Of Mice and Me is a novella written by author John Steinbeck, published in 1937, which tells the story of George Milton and Lennie Small, two displaced migrant ranch workers, who move from place to place in California in search of new job opportunities during the Great Depression in the United States.", "reason": "near_duplicate_of_source", "seed": 1390622658, "similarity": 0.9736842105263158, "temperature": 0.3}], "fingerprint": "427a6daad6d0ed921ebf3c35dc1bc812579ece2c435f948648324f18df8c88fa", "generation_attempts": 2, "gold_answer": "1937", "matched_aliases": ["1937"], "query_id": "test3347", "question_hash": "d9f77ff92f17089788eeb5fc429ac92f84152624766dc7e22fac9d5de6cd6b5d", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "439fbb1da537717aa36e308dd8eef54a05eb9a1b2cb8a79c99ec128e8f4f69c0", "scope": "all_answer_documents", "seed": 1469905767, "similarity": 0.48322147651006714, "source_content_hash": "1de1c9e6b0ec9f382f0691a60a6495881adbdfccdfaa9e6c7c8f265e3311bb25", "source_hash": "f246770ffdd2c1e529a64edf80190d810e4fdea10bac6a928cf0b4792a7156a1", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "bbed4d3288b0ad7364c729d45b4fcf611f953575a3a68402e71d2be8a87f13a8", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc114400", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Disha Vakani (born 17 August 1978) is an Indian film and television actress who made her career as a stage actress in Gujarati plays like Kamal Patel v/s Dhamal Patel and Lali Lila. She has appeared in supporting roles in films like Devdas (2002) and Jodha Akbar (2008). She plays lead role of Daya Jethalal Gada in SAB TV's comedy show Taarak Mehta Ka Ooltah Chashmah since 2008.", "reason": "near_duplicate_of_source", "seed": 1052147784, "similarity": 0.9653401797175867, "temperature": 0.3}], "fingerprint": "02eef261a8a1a6f577df6283195d67162ad5a61f861c6c14981ecf7e5913aee6", "generation_attempts": 2, "gold_answer": "Disha Vakani", "matched_aliases": ["Disha Vakani"], "query_id": "test3350", "question_hash": "4db3ecbb9d4dad4790ec36a46592b2ac07e33dfde88c1711fbb454d2773082b0", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "88cd2b124b4a0ac271ff55c70ed90d30ae8dd2ddd215ae4bafb035ffff7dd976", "scope": "all_answer_documents", "seed": 648572203, "similarity": 0.22652757078986588, "source_content_hash": "04e86b9eed007f1f16712859beb3e68db256e8a0ab7af583174440953b3bcf70", "source_hash": "fb59b0982e1f68b826b21e791be4fc54b7333c642a1ca86251d3cb011373835c", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "94ec8830a933e8b92e0cdec28a59c8f64bf64e51da874d9117b9c48381eeee0a", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc114427", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Value-added tax in the United Kingdom is levied on most goods and services provided by registered businesses in the UK and some goods and services imported from outside the European Union. There are complex regulations for goods and services imported from within the EU. The default VAT rate is the standard rate, 20% since 4 January 2011. Some goods and services are subject to VAT at a reduced rate of 5% (such as domestic fuel) or 0% (such as most food and children's clothing). Others are exempt from VAT or outside the system altogether.", "reason": "near_duplicate_of_source", "seed": 638841791, "similarity": 0.9602272727272727, "temperature": 0.3}], "fingerprint": "9a6118bf59721a8fc6e43d3060c062f88213a77bf6c1b5cb22707850c7e1017b", "generation_attempts": 2, "gold_answer": "4 January 2011", "matched_aliases": ["4 January 2011"], "query_id": "test3352", "question_hash": "d7d53dc9db525e8a1c6466cd5f14e6388c44c71c8839306866d956e9f9b42374", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "19f5fad4e9b9b95ae83517a8bfbaaf00f6f1b63f2c7253c1fce1b886b7241935", "scope": "all_answer_documents", "seed": 811758694, "similarity": 0.7096774193548387, "source_content_hash": "226d42b1f28c1cb734be991a83d130d7079bf9cdd70e4c0e85e60480c4c9dade", "source_hash": "47bb588996835accd6672ae559505abf2a37e80ff2c24adfe86dd8bec12efe6f", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "918205d3a88694da0c73a01ea04774b8a651730a9ca50483dda07f30224203e9", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "ver