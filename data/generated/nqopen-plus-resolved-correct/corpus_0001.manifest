{"doc_id": "doc78702", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "ICQ is an instant messaging client that was first developed and popularized by the Israeli company Mirabilis in 1996. The name ICQ derives from the English phrase \"I Seek You\".[1] Ownership of ICQ passed from Mirabilis to AOL in 1998, and from AOL to Mail.Ru Group in 2010.", "reason": "near_duplicate_of_source", "seed": 1370418402, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "80c7eb3dea31a720b9d213299dff0256d48134637ebb62e21c832d43cb8fe530", "generation_attempts": 2, "gold_answer": "an instant messaging client", "matched_aliases": ["an instant messaging client"], "query_id": "test2277", "question_hash": "c868c22374a305dbca3b98e6a95b813afdb410c176b3385f4a33c3c375d3027f", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "e2a906151e1d5b3027fc87d1680fd4c23746d8b579eda11e16f19ce270f8ee87", "scope": "all_answer_documents", "seed": 1029296650, "similarity": 0.32741617357001973, "source_content_hash": "28b6a9602e07c15c62baea630563951919a3dd228094ed1941e9a1384b60252a", "source_hash": "9d26f559b105d25527bb712b50c1dc493007eb4416661639b35e7cb477b80911", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "b381db79bb057d29f77b3a8e073c406d9bbe0d8343b534a522e1d5593ae547a3", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
