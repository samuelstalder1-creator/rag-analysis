{"doc_id": "doc103290", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The King and I is a 1956 American musical film made by 20th Century Fox, directed by Walter Lang and produced by Charles Brackett and Darryl F. Zanuck. The screenplay by Ernest Lehman is based on the Richard Rodgers and Oscar Hammerstein II musical The King and I, based in turn on the novel Anna and the King of Siam by Margaret Landon. That novel in turn was based on memoirs written by Anna Leonowens, who became school teacher to the children of King Mongkut of Siam in the early 1860s. Leonowens' stories were autobiographical, although various elements of them have been called into question.[4] The film stars Deborah Kerr and Yul Brynner.", "reason": "near_duplicate_of_source", "seed": 1277342438, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "186e194f158b2600f0b31f2bf69f25b743375e27b57013ac75c599d1a47166aa", "generation_attempts": 2, "gold_answer": "1956", "matched_aliases": ["1956"], "query_id": "test3011", "question_hash": "4bd9e49a793bd527e560a63545c04eb71d9ade4895f7bea9957f5efcdb2bafec", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "3a3bd54903930eed09a9d8f29695ddea4cca4f70dd19c79c40adf9faab0280bc", "scope": "all_answer_documents", "seed": 1075305977, "similarity": 0.3063533507397737, "source_content_hash": "db3fed6eee2da31efc3a2ae055f00f78e4018cc22d075cf144d272a75fea4026", "source_hash": "4d8b511f95cd87662310ef7ca0b111fc4d6889f601236134ab9362cead5613aa", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "2ceba7805cd7c1d54fcc5fcaa64d57e906f455d147795d12b486dbfbc053f2e1", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "