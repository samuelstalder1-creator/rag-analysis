{"doc_id": "doc48844", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Satavahanas are among the earliest Indian rulers to issue their own coins with portraits of their rulers, starting with king Gautamiputra Satakarni, a practice derived from that of the Western Kshatrapas he defeated, itself originating with the Indo-Greek kings to the northwest.", "reason": "near_duplicate_of_source", "seed": 1709894767, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "c3823ce6f21d7a2dd5ff4133107bf6038731febcb7227a8bcb232895a08d4a88", "generation_attempts": 2, "gold_answer": "the Indo-Greek kings", "matched_aliases": ["the Indo-Greek kings"], "query_id": "test1376", "question_hash": "3f9554ce823fbf97b4c24b356470fc7123868e5ebe1010fa39f891ce43adfa19", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "f903c6e55c20a3f046e51f456f8bfeb8846f70127653dbc0e4bfd54603f5d483", "scope": "all_answer_documents", "seed": 81978609, "similarity": 0.1731958762886598, "source_content_hash": "b25a4ab3a7faed19e5fad2b591e630c8371ca867fcb15ac72973c9241bbebb02", "source_hash": "7eb08943b6216fe268d2458b98a7581bbcab177e314d7e92f7ad8cc25756afe8", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "303e5e37e5bf20ee7d990c867f80f2a767be9163720bb65ad0ea769d355d4ea1", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
