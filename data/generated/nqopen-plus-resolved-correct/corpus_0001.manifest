{"doc_id": "doc91896", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The international non-profit organization Council on Tall Buildings and Urban Habitat (CTBUH) was formed in 1969 and announces the title of \"The World's Tallest Building\" and sets the standards by which buildings are measured. It maintains a list of the 100 tallest completed buildings in the world.[3] The organization currently ranks Burj Khalifa in Dubai as the tallest at 828 m (2,717 ft).[3] The CTBUH only recognizes buildings that are complete however, and some buildings included within the lists in this article are not considered finished by the CTBUH.", "reason": "near_duplicate_of_source", "seed": 346724450, "similarity": 0.99644128113879, "temperature": 0.3}], "fingerprint": "ed24173ed3f9403acf91fe9a1aa4abd87ac3fea84a4e0b7d96ed99dc0f6a0492", "generation_attempts": 2, "gold_answer": "Burj Khalifa in Dubai", "matched_aliases": ["Burj Khalifa in Dubai", "Burj Khalifa"], "query_id": "test2683", "question_hash": "96fa3ca2fb01416ee6e5cab881248e5bba294b2c20e0494aca702932025df7a5", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "af108e6643a9cf519afe9480125ab998cdb54f6ee503df51edeefc2786eabf8c", "scope": "all_answer_documents", "seed": 1002610826, "similarity": 0.5726872246696035, "source_content_hash": "7d81308072923e5a0b389927a6b016b55e7ec4826faecb053df5c4c2ceaf38cb", "source_hash": "8afd70cd1f08e0c6ac402464e0614de6f7ef1bc419b8fda01f89c7933a1daf64", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "97738829ecac9393f162475201ee2cd75766bfc27ab09f811bff5afaafd2ad04", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa7