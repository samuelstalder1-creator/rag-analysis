{"doc_id": "doc82650", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Panzerkampfwagen VIII Maus (\"Mouse\") was a German World War II super-heavy tank completed in late 1944. It is the heaviest fully enclosed armoured fighting vehicle ever built. Five were ordered, but only two hulls and one turret were completed before the testing grounds were captured by the advancing Soviet forces.", "reason": "near_duplicate_of_source", "seed": 1011370459, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "2feef3d8f57f4f8bfdfc6a3397e8a6ab35b958b272e58220663eead8579ccae6", "generation_attempts": 2, "gold_answer": "Panzerkampfwagen VIII Maus", "matched_aliases": ["Panzerkampfwagen VIII Maus"], "query_id": "test2393", "question_hash": "be886d4a017d24a9b6386e4ed4e210e9e5b03079afc04a3db81be49c6c1d17df", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "e2e0d4c4cb3c436e7c0457254b4f8990756253b5d235fa3cbb7d0cad29cc12ba", "scope": "all_answer_documents", "seed": 607365872, "similarity": 0.09375, "source_content_hash": "26f4b355520a393416fe79ffb59f09e1bed2edf09f19a29b2d5e7c747e91227e", "source_hash": "e23a678dc2d6ba4696efe25b11748a552aece28edd847bc350c24590ee2ea313", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "ed447592a063036250dec058d8bc66c9bd6addf45ec30b18dd93c15b14292c04", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc82673", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Greg Tate of Rolling Stone said this about the song \"Can't Change Me,\" is as rhapsodically gorgeous as pop gets, putting a spin on true love that any reprobate slacker can relate to: \"She's going to change the world/But she can't change me/Suddenly I can see everything that's wrong with me/But what can I do?/I'm the only thing I really have at all.\" Cornell unveils a desire to be reckoned with as an openly wounded and unabashedly portentous rock balladeer.", "reason": "near_duplicate_of_source", "seed": 263869240, "similarity": 0.9956709956709957, "temperature": 0.3}], "fingerprint": "9525839b208a38284a3c049497b2790c4941b54972bb4b54e805ec5205004489", "generation_attempts": 2, "gold_answer": "Can't Change Me", "matched_aliases": ["Can't Change Me"], "query_id": "test2394", "question_hash": "16ac55d3e0a05adfb52d71e28d4968cef5964775e09fa554c8c5ab8429f27786", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "96d7268a3682648d9c2880212e4a0a34ff6f60c40302e6587bfc2470ddebf659", "scope": "all_answer_documents", "seed": 1434011281, "similarity": 0.15320041972717732, "source_content_hash": "ad4ff845ade6dc5f2e73d1959499d93e4f28ee597306db8116100f990ee0f6a6", "source_hash": "5e4b98b7f63642328400b4268637cb68cece9ec38595ae046745725f1cca400c", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "44999fe7efdcd1c98f6dace7ed3a7c1b6b5df1349ad5f754749d308f40419e3f", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
