{"doc_id": "doc67373", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"Billy Don't Be a Hero\" is a 1974 pop song that was first a UK hit for Paper Lace and then, some months later, a US hit for Bo Donaldson and The Heywoods. The song was written and composed by two British songwriters, Mitch Murray and Peter Callander.", "reason": "near_duplicate_of_source", "seed": 526364898, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "b16b75d6ead4cf3301d4b2a132312c9081c767aec64b8743f732d427403d7f07", "generation_attempts": 2, "gold_answer": "1974", "matched_aliases": ["1974"], "query_id": "test1920", "question_hash": "f23cec8224831c3f5553cc24b21c80ff71c28bb68fc417d52d5a06abc57c40a2", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "8359202662012daaed7688271e75f9855f627eb8262b703b81447b7cea1ff64f", "scope": "all_answer_documents", "seed": 1178041414, "similarity": 0.031496062992125984, "source_content_hash": "aca70eb874b8fbf6880c1f1dc7ce135f69dfce39b0141ddc26ffb9b05356c00d", "source_hash": "5a22f9669d52eb98afc362084fbaf36ebde1bfa767ea12982508c3799241f88d", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "1c7789739322474a1b622823600915f882ff007dbd9a78d43ea7197c7f711e95", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc67569", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "File Transfer Protocol (FTP) does not encrypt its traffic; all transmissions are in clear text, and usernames, passwords, commands and data can be read by anyone able to perform packet capture (sniffing) on the network. This problem is common to many of the Internet Protocol specifications (such as SMTP, Telnet, POP and IMAP) that were designed prior to the creation of encryption mechanisms such as TLS or SSL.", "reason": "near_duplicate_of_source", "seed": 1717441553, "similarity": 0.9519112207151664, "temperature": 0.3}], "fingerprint": "eb8cd69b2519c8aab94a1d5046b46a2d15a45080cd6775a5b3c20cf989c20f6e", "generation_attempts": 2, "gold_answer": "all transmissions", "matched_aliases": ["all transmissions"], "query_id": "test1925", "question_hash": "7b98f0b1a9f0558f9a279924a18ce5d3aeba9325efb8109e240b9140a30e3184", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "b83caa8b6d6b3b7f7a38e75568692ad31baa27b34cbb92a059f43af0501b6152", "scope": "all_answer_documents", "seed": 237578418, "similarity": 0.48655256723716384, "source_content_hash": "94cc605bbe84685a25838361196897dc213c14c646b403795dbc303512ac15e4", "source_hash": "d9ed14555603371a68a448171677ca319fd0e33119159d98b5fbccc4d5ce2a67", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "6c7b420a97a8429881db4bc603d34806ec8d838cd17273f71093b917ead3644c", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc67600", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Pradyumna (Sanskrit: प्रद्युम्न) is the name of a character in the Srimad Bhagavatam. He was the son of Lord Krishna and Rukmini. Pradyumna is considered as one of the four vyuha avatars of Vishnu. According to some accounts, Pradyumna was an incarnation of Kamadeva, the god of love. Pradyumna is also a name of the Hindu god Vishnu, being referred to as Vishnu Ankar Gupta. He is one in 24 Keshava Namas (names), praised in all pujas. It is also the only name in Sanskrit with all the 3 letters joint (referred as जोडाक्षर).", "reason": "near_duplicate_of_source", "seed": 1229994926, "similarity": 0.967741935483871, "temperature": 0.3}], "fingerprint": "33ebba1b35ab7000e2d8e39c2fab3c45e1c45b721b282379c516daf1aa8be359", "generation_attempts": 2, "gold_answer": "Pradyumna", "matched_aliases": ["Pradyumna"], "query_id": "test1927", "question_hash": "db7bc6453b0111696288dfd8faca346f13640a807c835050399b2a6935306057", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "787cba64fbc5aab07ba02f8083049c975763cdd6d2c4cd8d937da0dd3bc66ad8", "scope": "all_answer_documents", "seed": 1032767589, "similarity": 0.13432835820895522, "source_content_hash": "3198319c1b5f4ecad62c008fd61f7eea0d9bd5a56af7b39ce85863b7a421fb2c", "source_hash": "187848fc3bb591a2388916ded0a404bb822f1bceb763ffa47a8465e7e243a330", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "032eed8ae285e2eca28b50085c3069fc78d20c3446ad783232cd634d411d643f", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation