{"doc_id": "doc37810", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "James Martin Lafferty (born July 25, 1985) is an American actor, director and producer. He is best known for his portrayal of Nathan Scott on The CW teen drama television series One Tree Hill from 2003 to 2012.", "reason": "near_duplicate_of_source", "seed": 689657055, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "73052ef7c9fae0735c7f062e095b8af227d592179e8e24b6b3e0756524e5bd44", "generation_attempts": 2, "gold_answer": "James Martin Lafferty", "matched_aliases": ["James Martin Lafferty"], "query_id": "test1084", "question_hash": "01d27b79efc363c19804c6b31263167e916f30d669460026de6a17b7e74b74cb", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "dd233be7ac830927642ee3dcddae9b9ddd704e3e3fe969184908ced8a72ee2a8", "scope": "all_answer_documents", "seed": 724524362, "similarity": 0.5071090047393365, "source_content_hash": "e38d830b2cb19df23538154d617a467aec1d361d3674742e9467a80953fee444", "source_hash": "ab5b4b5d46f9058ae512f98408361882c35ffe55d04fef694f537174844bde17", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "8190ecd0fb0d07f6d0b8f0052edd9bace20f21ea8771ff0c9a95a5f55e877f62", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc37927", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Citrus Bowl, officially the Citrus Bowl presented by Overton's, boating and marine supply, for sponsorship purposes, is an annual college football bowl game played at Camping World Stadium in Orlando, Florida. It was previously known as the Tangerine Bowl (1947–1982), the Florida Citrus Bowl (1983–2002), the Capital One Bowl (2003–2014) and the Buffalo Wild Wings Citrus Bowl (2015–2017). The bowl is operated by Florida Citrus Sports, a non-profit group that also organizes the Camping World Bowl and Florida Classic.", "reason": "near_duplicate_of_source", "seed": 581539810, "similarity": 0.9943074003795066, "temperature": 0.3}, {"attempt": 2, "generated_text": "The Citrus Bowl, officially the Citrus Bowl presented by Overton's, boating and marine supply, for sponsorship purposes,[1] is an annual college football bowl game played at Camping World Stadium in Orlando, Florida.[2] It was previously known as the Tangerine Bowl (1947–1982), the Florida Citrus Bowl (1983–2002), the Capital One Bowl (2003–2014) and the Buffalo Wild Wings Citrus Bowl (2015–2017). The bowl is operated by Florida Citrus Sports, a non-profit group that also organizes the Camping World Bowl and Florida Classic.", "reason": "near_duplicate_of_source", "seed": 1718340591, "similarity": 1.0, "temperature": 0.5}], "fingerprint": "5a03a604bf026eacd17a4a80568f0df36999c07077e55e1f1322b7a110306ea0", "generation_attempts": 3, "gold_answer": "Camping World Stadium", "matched_aliases": ["Camping World Stadium"], "query_id": "test1086", "question_hash": "b64d1f7865bec8fc9e0804ddbddf5dd3ab4f560f60b44c21bae73a980d06acf2", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "489fa197fca333fbabea6d318b13fb01bb741169e915f5d81aea93996c865241", "scope": "all_answer_documents", "seed": 1049067560, "similarity": 0.15550239234449761, "source_content_hash": "de659d