{"doc_id": "doc93274", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "A toddler is a child 12 to 36 months old. The toddler years are a time of great cognitive, emotional and social development. The word is derived from \"to toddle\", which means to walk unsteadily, like a child of this age.", "reason": "near_duplicate_of_source", "seed": 238828375, "similarity": 0.9734513274336283, "temperature": 0.3}], "fingerprint": "9a701f115fa85546ed2e6cf89fd60b48f48db100d98207eee0b7b7de4f9ff2e7", "generation_attempts": 2, "gold_answer": "36 months", "matched_aliases": ["36 months"], "query_id": "test2720", "question_hash": "c742e5723bc9cd7c15557ef1b657e5cff3f75d6d7f011ddd5980a8b8b2817914", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "c78ca5f1bd3c6115988b4eed039e99f3b15b81cdd057767b420a37b3f6194c95", "scope": "all_answer_documents", "seed": 101337652, "similarity": 0.08588957055214724, "source_content_hash": "82e48be04c96f18215ee09fc9751101c4444cfe1ec0509084ce858191f12a689", "source_hash": "5d2ccda8727b9489dc360e0232129e23d60f59f7e4706825f7095f0caa69bb52", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "690d62f3011a164eb10e39fa7787798a9f16d41a8be45360293ec6d8ea559020", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc93287", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Ordeal by Innocence is a three part BBC drama that was first broadcast during April 2018. It is based on the Agatha Christie novel of the same name and is the third English language filmed version to be broadcast. The drama stars Bill Nighy, Anna Chancellor, Alice Eve and Eleanor Tomlinson amongst others.", "reason": "near_duplicate_of_source", "seed": 102221246, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "4af6d2b38d3bae02331582ee37070d0e484b0d9694a997b2a5999168e19cfdb5", "generation_attempts": 2, "gold_answer": "three part", "matched_aliases": ["three"], "query_id": "test2721", "question_hash": "aacfa5b44ee3b2905e3464269ffa0fd25fe277e9254256fe0a9f516c2fc2c160", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "688fadc9796beea5713242ceee1794a1e176ca8cfe77920deaed7397ef961522", "scope": "all_answer_documents", "seed": 1466898865, "similarity": 0.14035087719298245, "source_content_hash": "b8a93c54ae232480945ca15586e60ebcf0cbe2083331573d0e76e98f139b1450", "source_hash": "bcd031b39ec61e1cb76dc4f82ec2b7cccc5c9732a6241982011e505e238fffe1", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "b29b3ea7e7d8f7619c98da65f0c8c1da3f8de6f99475a29c5c94398d6bd903ea", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
