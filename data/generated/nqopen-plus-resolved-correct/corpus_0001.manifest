{"doc_id": "doc16797", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"Hallelujah I Love Her So\" is a single from American musician Ray Charles. The jazz and rhythm and blues song was written and released by Charles in 1956 on the Atlantic label, and in 1957 it was included on his self-titled debut LP, also released on Atlantic. The song peaked at number five on the Billboard R&B chart. It is loosely based on 'Get It Over Baby' by Ike Turner (1953).", "reason": "near_duplicate_of_source", "seed": 1181877545, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "0d2a76625f6f2efcfe3b1ae9bb7d944deb79b19af20337e4ac5f1aa17e1f01d5", "generation_attempts": 2, "gold_answer": "Ray Charles", "matched_aliases": ["Ray Charles"], "query_id": "test456", "question_hash": "2a97186b2b60e1f68fa2fcacaba4c2d58298c45d9d2d3a825ce6b8a86e30dd17", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "49c5c8734f16e8049bc8a77079fc69150be05fa0e6903194269dc2bcf0179218", "scope": "all_answer_documents", "seed": 2013445662, "similarity": 0.2824427480916031, "source_content_hash": "96a810f3a95b9deb1998b1299d724a5450d54cd9398136726b556c12f209566f", "source_hash": "f459f5feabe21f0663c1318ac0efb232e4be65055a585a469c976944f3de6b26", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "53075a7eb3040e874183bf77e76f70c92827161ef0179046fc1b62a9a5996182", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
