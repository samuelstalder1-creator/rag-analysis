{"doc_id": "doc115935", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Senior Open Championship, or simply The Senior Open (and originally known as the Senior British Open) is a professional golf tournament for players aged 50 and over. It is run by The R&A, the same body that organises The Open Championship. Prize money won in the event is official money on both PGA Tour Champions (formerly the Senior PGA Tour and Champions Tour) and the European Senior Tour. The purse, which is fixed in United States dollars, was $2 million in 2011, with a winner's share of $315,600.[1] For sponsorship reasons, it is currently known as The Senior Open Championship presented by Rolex.", "reason": "near_duplicate_of_source", "seed": 1122566049, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "959b000f170ad20023e3adb01d693f96fd9a42b22a39451b73792c2ebdaff294", "generation_attempts": 2, "gold_answer": "$2 million in 2011", "matched_aliases": ["$2 million in 2011"], "query_id": "test3401", "question_hash": "df7e9216eaa92fac4b448bc936ce3c646a5a68f2e347478f3e38cecf136b6d4b", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "1884c32674a63fe1a97878868b9daf7656594b41bebd40c835e6b6a2bf572a48", "scope": "all_answer_documents", "seed": 308407469, "similarity": 0.4322766570605187, "source_content_hash": "4aa3a1c1d5cd0b816dc83d9d81512220a326473d161f4abe976977b4b167e151", "source_hash": "764cc6598e7e4241ee8d0873e235760d910f93e24c7039df2f24738dc86f5a2a", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "511a604b20f6258d507d49b492ec5c239f394096a1d6cd106b8638a0c6e89e48", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2bee