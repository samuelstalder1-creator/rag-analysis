{"doc_id": "doc52669", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Miraculous Journey of Edward Tulane is a 2006 novel by Kate DiCamillo. Following the life of a china rabbit, the book won the 2006 Boston Globe-Horn Book Award in Fiction category.", "reason": "near_duplicate_of_source", "seed": 1140152259, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "633794417ba898d78a8b30964f6e2aa95e78bc6dab0128a08fc2081e9446c320", "generation_attempts": 2, "gold_answer": "2006", "matched_aliases": ["2006"], "query_id": "test1478", "question_hash": "6b5120e5658cebabb80a4a9ddacb0900083735b42a81555cfd58032ef4205c1f", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "ff3c47c70074b0318033f1a27376164ba6aea35993b5ea79d5e8f6f5a31ace4e", "scope": "all_answer_documents", "seed": 566764528, "similarity": 0.7383720930232558, "source_content_hash": "fe36402a5ada0411f872ef9ead50cc0fa6ff7c4e10bc3938bc101e55cb749832", "source_hash": "0bdfccae1b6112ff7879c42c99f5d568481cc66cc0852aa28783a456a2302c2d", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "d193408c2ec92e73e0a0b60300299218a3b9d09f7de4c4d9fa040beeaef35cc5", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc52676", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Lord Banquo, the Thane of Lochaber, is a character in William Shakespeare's 1606 play Macbeth. In the play, he is at first an ally to Macbeth (both are generals in the King's army) and they meet the Three Witches together. After prophesying that Macbeth will become king, the witches tell Banquo that he will not be king himself, but that his descendants will. Later, Macbeth in his lust for power sees Banquo as a threat and has him murdered by two hired assassins; Banquo's son, Fleance, escapes. Banquo's ghost returns in a later scene [Banquet Scene] , causing Macbeth to react with alarm during a public feast.", "reason": "near_duplicate_of_source", "seed": 503811978, "similarity": 0.9879518072289156, "temperature": 0.3}, {"attempt": 2, "generated_text": "Lord Banquo, the Thane of Lochaber, is a character in William Shakespeare's 1606 play Macbeth. In the play, he is at first an ally to Macbeth (both are generals in the King's army) and they meet the Three Witches together. After prophesying that Macbeth will become king, the witches tell Banquo that he will not be king himself, but that his descendants will. Later, Macbeth in his lust for power sees Banquo as a threat and has him murdered by two hired assassins; Banquo's son, Fleance, escapes. Banquo's ghost returns in a later scene [Banquet Scene] , causing Macbeth to react with alarm during a public feast.", "reason": "near_duplicate_of_source", "seed": 1972648810, "similarity": 0.9879518072289156, "temperature": 0.5}], "fingerprint": "260da1ab9dbb19f6862774548adb838a720622f92fa6f5b5b370bfb062b4d25d", "generation_attempts": 3, "gold_answer": "Lord Banquo", "matched_aliases": ["Lord Banquo", "Banquo"], "query_id": "test1479", "question_hash": "817a4051544f52826ef82c3177166661222fe50414f9866061d27ceb02bea4c8", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "008a