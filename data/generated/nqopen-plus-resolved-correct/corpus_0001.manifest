{"doc_id": "doc36159", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Iroquois was originally designated HU-1, hence the Huey nickname, which has remained in common use, despite the official redesignation to UH-1 in 1962. The UH-1 first saw service in combat operations during the Vietnam War, with around 7,000 helicopters deployed. The Bell 204 and 205 are Iroquois versions developed for the civil market.", "reason": "near_duplicate_of_source", "seed": 963959736, "similarity": 0.9956331877729258, "temperature": 0.3}], "fingerprint": "59f0c23ecb1c10af23462a9926fc737d43bb537763edd511240e907e0174d097", "generation_attempts": 2, "gold_answer": "originally designated HU-1", "matched_aliases": ["originally designated HU-1"], "query_id": "test1029", "question_hash": "3c9c0ff7bfcce4c172058c5376076cee73de62973ddd8cdc6caf43c156a30d7f", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "980ae1ef22a6b1415198a3103d7fae83260cbc44d7973451ed389aa0460313bc", "scope": "all_answer_documents", "seed": 2010056000, "similarity": 0.7420689655172413, "source_content_hash": "464351870e975f9c0aaf62740ccd72b3979b972dd5a82701fe60ee8fb5218854", "source_hash": "152d79f3cd7b851ddc981dd26c136a519e4a824210d252b6bdf27aa8dea2ddae", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "e302f06115df9be51946227711612490ae5ed0101dd864f3d87829c7ef785f8f", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
