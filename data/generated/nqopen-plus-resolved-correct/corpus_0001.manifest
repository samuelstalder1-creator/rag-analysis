{"doc_id": "doc44787", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Patrick Walshe (July 26, 1900 â€\" December 11, 1991) was an American dwarf character actor and circus performer who specialized portraying animals (animal impersonating). He is best known for playing Nikko, the head of the Winged Monkeys in The Wizard of Oz. He appeared in only a few films, as most of his work was in theater, vaudeville and circus.", "reason": "near_duplicate_of_source", "seed": 1762206332, "similarity": 0.9971428571428571, "temperature": 0.3}], "fingerprint": "3dcb2ffde8a89d6ab2e69784d512a105785c1735d84d114d3985fec52c259d41", "generation_attempts": 2, "gold_answer": "Patrick Walshe", "matched_aliases": ["Patrick Walshe"], "query_id": "test1264", "question_hash": "c8457087eb7e670b04854ccdae79eb66d25b83b32ca56f934f0d8202055cf2e5", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "508c4ed4ddb81b35d60a2af757701fd749f7ad4312da9bee777669e0a38407af", "scope": "all_answer_documents", "seed": 2019842201, "similarity": 0.2591623036649215, "source_content_hash": "08566003d9a6e5dfb76536dfa85008968268fc429e15bafb20ee8bd5b1573181", "source_hash": "2427a58e24cf1246064595c8b47aa21f5f35f7517bd3e9510b60cb2a3c6c64db", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "1126762efbb80a171b53cfc47675b22a25c279ab91779e1f25fbc0732ba3a4d6", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc45079", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "In a speech before his fellow alumni of the University of the Philippines College of Law, President Marcos declared his intention to lift martial law by the end of January 1981.", "reason": "near_duplicate_of_source", "seed": 478930070, "similarity": 0.9888268156424581, "temperature": 0.3}], "fingerprint": "951282683ed4a85605f6fbcb9ca630e96d50b47e37fac1e948d33ce36c0266e3", "generation_attempts": 2, "gold_answer": "1981", "matched_aliases": ["1981"], "query_id": "test1273", "question_hash": "ddca9b3a5d6adb7333161fb11ef18e814451b7c0f6171a35a18043849228cb16", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "e414a526ee9f2b253f15d8e96f1a4f018c27257399292f7586d0a7c929d7f7ef", "scope": "all_answer_documents", "seed": 696514932, "similarity": 0.8791208791208791, "source_content_hash": "84f9a6614fcfbabe9808dc5c4dd6baf23851718d9c2a1dd10c50d61327165569", "source_hash": "4a3c3074eeb0836ce4b8495f1010480b597d02ebae7c1f34e570690e4154c2dd", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "8f9404cc11f431a2c7afcdcdc2d18544f874d39b23d4f393aef648ce79cbad55", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc45205", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "During the last Ice Age, sea levels were lower and the Solent was part of a river flowing south east from current day Poole Harbour towards mid-Channel. As sea levels rose, the river valley became flooded, and the chalk ridge line west of the Needles breached to form the island.", "reason": "near_duplicate_of_source", "seed": 946477897, "similarity": 0.9946524064171123, "temperature": 0.3}], "fingerprint": "396ef89f447f7099e24285f837f6ecc7997b571aa0ab126a9ae5801b6ed722d2", "generation_attempts": 2, "gold_answer": "As sea levels rose", "matched_aliases": ["As sea levels rose"], "query_id": "test1280", "question_hash": "209a6e692f69a738a11cd6572181f515b7b8eb0af28c5c6ab10c6f4d098064d4", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "00de277c15c514bacc3cc99274e4c3194d1c95af674cb442e717e51d7b620d15", "scope": "all_answer_documents", "seed": 1687157834, "similarity": 0.05904059040590406, "source_content_hash": "a199a913b82cad5a211a623826cbc6dee8e4beb09bfec9ff051e72b2af7048cf", "source_hash": "811844a66bb2e141e6a6aac8b1c810fe17fb0b9b09f75c0bcfd565ac479ddf01", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "a4f25c25ce14ea4de195312c52db3f3a22b9482177fbc49831240092a22f6039", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
