{"doc_id": "doc21212", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Airtel Payments Bank Limited is the first entity to receive the final license from the Reserve Bank of India for launching a Payments Bank, with Kotak Mahindra Bank Limited holding a stake. To open an account, users must provide their Airtel mobile number, which serves as the account number. The bank offers 7.25% interest on bank accounts and provides free personal accident insurance cover of Rs. One Lac. Deposits earn equivalent talk time, though this offer is valid only at the time of account opening. A maximum deposit limit of 1 lakh Indian Rupees applies to a single account. Additionally, customers can withdraw cash at Airtel Banking Points or transfer amounts via the My Airtel app, with applicable fees of 0.65% for withdrawals and 0.5% for transfers to other bank accounts, unless sending money to an Airtel Payments Bank account.", "reason": "missing_gold_answer", "seed": 1063635245, "similarity": null, "temperature": 0.3}, {"attempt": 2, "generated_text": "Airtel Payments Bank Limited is the first entity to receive the final license from the Reserve Bank of India for launching a Payments Bank, and Kotak Mahindra Bank Limited holds a stake in the bank. Airtel Payments Bank Limited leverages the distribution network of Bharti Airtel spread across 1.5 million outlets, with network presence covering 87% of the country, more than 400,000 villages, and 5,000 census towns. Before opening an account, users must verify that their Airtel mobile number serves as their account number.", "reason": "missing_gold_answer", "seed": 2049392763, "similarity": null, "temperature": 0.5}], "fingerprint": "b804e177e5e32c69f25bd71e5fc6d23ebcd386891eaed730f319462c81eb992f", "generation_attempts": 3, "gold_answer": "Your Airtel mobile number", "matched_aliases": ["Your Airtel mobile number"], "query_id": "test591", "question_hash": "dc540f893f5580ed407252fe79e8b9a8f123f8c3f19200b6025c515d5729097f", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "23eb0ce72b2a4c498ee91f46bd2661f01cf92b558cfeaf4186ff8919fd7c0d15", "scope": "all_answer_documents", "seed": 1205279643, "similarity": 0.19436052366565962, "source_content_hash": "26fc13f32d31a345a5b23422a96c6f35d0a9e3306c6745b5b736971679c8e143", "source_hash": "3a694f7b795fa0477d874ce12629f799c3f04043c679f9193779b7952e0e3de8", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "c2ec79e8b5c14d7af184361f2b8662f8952e797d54396f8c29f8daf1254d2564", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc21225", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"Spirit in the Sky\" is a song written and originally recorded by Norman Greenbaum and released in late 1969. The single became a gold record, selling two million copies from 1969 to 1970 and reached number three on the US Billboard Hot 100 chart (April 18, 1970), where it lasted for 15 weeks in the Top 100. Billboard ranked the record the No. 22 song of 1970.[5] It also climbed to number one on the UK, Australian and Canadian charts in 1970. Rolling Stone ranked \"Spirit in the Sky\" No. 333 on its list of the 500 Greatest Songs of All Time. The song was featured on the 1969 album of the same name. Cover versions by Doctor and the Medics and Gareth Gates have also made the number 1 spot in the UK.", "reason": "near_duplicate_of_source", "seed": 1408900407, "similarity": 0.9978738483345145, "temperature": 0.3}], "fingerprint": "399a7d86e731f617337ae324ac04c95752f0ca2531217f0d9d5b17cd94b83ec5", "generation_attempts": 2, "gold_answer": "Norman Greenbaum", "matched_aliases": ["Norman Greenbaum"], "query_id": "test593", "question_hash": "79917cb4bb764aec57fc4132c9bcd5c430684b5f5d0d3292e73fcb10d495842b", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "3ce842b03c6ca6cbc79cff1f9ed99b7c7824c569ab1bba088b77502b4d3d0c5a", "scope": "all_answer_documents", "seed": 381704632, "similarity": 0.31285988483685223, "source_content_hash": "7f6cb4892c3dd2f2b4210cd4267f84ff75337a67bcd3109bbe7de299d9f30c08", "source_hash": "e2ac6066124f59313d5ee59c1d40ea7869954bfdb9abb05b770a97ef5cea528f", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "92a4fa743643944f3065e6cc3cc3c1d72bd097a5591d12a21adc950787e565cf", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": 