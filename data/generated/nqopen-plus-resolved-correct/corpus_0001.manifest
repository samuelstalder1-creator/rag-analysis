{"doc_id": "doc104324", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Nancy Jean Cartwright (born October 25, 1957) is an American actress, voice actress and comedian, known for her long-running role as Bart Simpson on the animated television series The Simpsons. Cartwright also voices other characters for the show, including Nelson Muntz, Ralph Wiggum, Todd Flanders, Kearney and Database.", "reason": "near_duplicate_of_source", "seed": 644636604, "similarity": 0.9953632148377125, "temperature": 0.3}, {"attempt": 2, "generated_text": "Nancy Jean Cartwright (born October 25, 1957) is an American actress, voice actress and comedian, known for her long-running role as Bart Simpson on the animated television series The Simpsons. Cartwright also voices other characters for the show, including Nelson Muntz, Ralph Wiggum, Todd Flanders, Kearney and Database.", "reason": "near_duplicate_of_source", "seed": 834518300, "similarity": 0.9953632148377125, "temperature": 0.5}], "fingerprint": "041c26eeecc4b1420bba42a5e34facdf5c20e4057b9e476254ce82359382bb4f", "generation_attempts": 3, "gold_answer": "Nancy Jean Cartwright", "matched_aliases": ["Nancy Jean Cartwright"], "query_id": "test3044", "question_hash": "03d36f12bf6dd04b6769bee6985ffc5c890a9d9900f50f971e25b40c060544fc", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "5eda1f352393c3aa676e96c6feb612428fa46d8928b54988f1e945f5982e9e6f", "scope": "all_answer_documents", "seed": 204010193, "similarity": 0.16, "source_content_hash": "bb48034676320e9a2b5552d736f644df66010f75bee69f3eeca1bcf6d6e564f3", "source_hash": "e8aeb0a105f2a9f3ee20892f81939c147a605b9b795c19fbe772eaada86b35a9", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "4863a581d088e44f91c30e57032a30720e5d7825fe125e3774c76eb631ad612b", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}