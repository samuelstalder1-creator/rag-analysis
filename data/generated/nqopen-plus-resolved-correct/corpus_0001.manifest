{"doc_id": "doc16130", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "EDF Energy is an integrated energy company in the United Kingdom, with operations spanning electricity generation and the sale of gas and electricity to homes and businesses throughout the United Kingdom. It employs 13,331 people and handles 5.7 million customer accounts.", "reason": "near_duplicate_of_source", "seed": 218299697, "similarity": 0.9801801801801802, "temperature": 0.3}], "fingerprint": "606ccd19ab0059dabd7b05a882f1c46102408b9f62c72cc62e1ac81a77da0b69", "generation_attempts": 2, "gold_answer": "5.7 million customer accounts", "matched_aliases": ["5.7 million customer accounts", "5.7 million"], "query_id": "test435", "question_hash": "f5a29a3e7b6a621c81cf8c474fd2f9dca9d4e94507f03ae3224df69ccfd4748f", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "c46db75520c7ac7b2fc511ed03facd74640eebd1e6920905172a11b0b6e16c33", "scope": "all_answer_documents", "seed": 1515728783, "similarity": 0.4, "source_content_hash": "bbae85625d5718488781945966e3a24ac004830f8042a48518aa1151d0ae6db2", "source_hash": "a117d55910fa817148da9c676eeea92899b8064eaa77cda33460de6d72bead41", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "c284f41f80b067d226800f3dab5628095e9a76a74a0768285fabbc0ad6bcb206", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc16157", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Ozarks contain two mountain ranges: the Boston Mountains of Arkansas and the St. Francois Mountains of Missouri. Buffalo Lookout, the highest point in the Ozarks, is located within the Boston Mountains. Geologically, the area is a broad dome with the exposed core in the St. Francois Mountains. The Ozarks cover nearly 47,000 square miles, making it the most extensive highland region between the Appalachians and Rockies. Together with the Ouachita Mountains, the area is known as the U.S. Interior Highlands.", "reason": "near_duplicate_of_source", "seed": 1853010324, "similarity": 0.9583736689254598, "temperature": 0.3}], "fingerprint": "35194327feb1049689b30370c8255cb8ba98b04fc8b77228cc90d27e0bcafe43", "generation_attempts": 2, "gold_answer": "Lookout", "matched_aliases": ["Lookout", "Buffalo Lookout"], "query_id": "test436", "question_hash": "ccd106575c659a32e6a6bf78109f6d37be87b65b697af7adbc7605261aa0662f", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "5fc698da4cdd961923ca57ecc884555c99d5791a12175cd4f536ac6f77e8b514", "scope": "all_answer_documents", "seed": 815453438, "similarity": 0.15276145710928318, "source_content_hash": "91b34711bb6efd188db22df2073d37eb75e5777c84bad9b0c66f23fe50695479", "source_hash": "ff1b0da25b858d9b8d83f7c0c3c83caa8ca807aad67907aa1360036d93ef3c28", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "ffd68e0c0a68e1726948e3d88257bc8f05421ec9b81ac1ddfd0b544523c2ee68", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc16215", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Hoot is a 2002 young adult novel by Carl Hiaasen. The setting takes place in Florida, where new arrival Roy makes two oddball friends and a bad enemy, and joins an effort to stop construction of a pancake house which would destroy a colony of burrowing owls who live on the site. The book won a Newbery Honor award in 2003.[1] A film adaptation of the book was released in May 2006, starring Logan Lerman, Brie Larson, and Cody Linley.[2] Hiaasen and Wil Shriner, the director and script-writer, \"fought long and hard to stay truthful to the book.\"[3]", "reason": "near_duplicate_of_source", "seed": 1158589874, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "d1af1b0b3306a9c635cf60e0e7b42314f8a979c656637473799847127bdd5830", "generation_attempts": 2, "gold_answer": "Florida", "matched_aliases": ["Florida"], "query_id": "test438", "question_hash": "971406887699aca9f24e8431fa331b1c31583c867ffc070e8f49a6481b049dbf", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "6849b441d74ecc41fb3e05da9cb0022b23ec4c53f8d7daa423295c4b416e23ef", "scope": "all_answer_documents", "seed": 1965227111, "similarity": 0.06197854588796186, "source_content_hash": "95816db7369b541f50b4c00c1423e12b249df1ed109ecfe1527369153c9cde37", "source_hash": "003abf7f16fdb2bba7dcb69bbc55ab0133606d5291879e0a160f02b6c96c495f", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "b7c26ba5a421e9e223e0407c58fb47e0a90207f190bcdf49243490ab20458be5", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc16216", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The main character Roy Eberhardt moves to Florida and into the town of Coconut Cove, where his classmate Dana Matherson starts bullying him. On the bus to school, Roy sees a boy running barefoot outside. Roy tries to leave the bus, but Dana viciously chokes and strangles him. He escapes after punching Dana in the face, breaking his nose, and then exiting the bus. But Roy can't catch the running boy because a golf ball hits Roy in the head. The school suspends him from the bus for two weeks and orders Roy to write an apology to Dana. Roy calls for a truce, but Dana refuses to accept.", "reason": "near_duplicate_of_source", "seed": 529380091, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "71bf4180cc0f42fdb0920b27ca1f2b646d7b534e221825ddaf701a8e4015afbf", "generation_attempts": 2, "gold_answer": "Florida", "matched_aliases": ["Florida"], "query_id": "test438", "question_hash": "971406887699aca9f24e8431fa331b1c31583c867ffc070e8f49a6481b049dbf", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "e5f51ead48f6494411c4f14819795eeb9a1dc393e7ae687b1fd4011a5971b1c6", "scope": "all_answer_documents", "seed": 1054035617, "similarity": 0.024922118380062305, "source_content_hash": "d7d7ba3435c3bbf67278c2b360152433eec34aace25a2aee85400b83d741692d", "source_hash": "c58d0d43664ba5e659b856e807274fa3a8463e77438f96029c079e55d374e976", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "2f92448e24721d7b5147781f22355c134ed70d234a67b8ad71ef67f3e696c5fb", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e4032315