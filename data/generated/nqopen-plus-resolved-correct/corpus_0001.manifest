{"doc_id": "doc28218", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Ice Age is an American media franchise centering on a group of mammals surviving the Paleolithic ice age. It is produced by Blue Sky Studios, a division of 20th Century Fox, and featuring the voices of Ray Romano, John Leguizamo, Denis Leary, and Chris Wedge. Five films have been released in the series thus far with Ice Age in 2002, Ice Age: The Meltdown in 2006, Ice Age: Dawn of the Dinosaurs in 2009, Ice Age: Continental Drift in 2012, and Ice Age: Collision Course in 2016. It has received some criticism for making no attempt to be scientifically accurate.[2][3][4] As of April 2016, the franchise had generated $6Â billion in revenue,[5] making it one of the highest-grossing media franchises of all time.", "reason": "near_duplicate_of_source", "seed": 730216618, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "09bf6c3e29a38d5bb4dd059a6153c0936e804ed3374d61d45b750ebd634dc1b4", "generation_attempts": 2, "gold_answer": "2002", "matched_aliases": ["2002"], "query_id": "test792", "question_hash": "8bde712388c775f0538f4158a8414dbdd4b1d615052f0da9f8d2d48d78a7c7de", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "5100df47b47d16a2b3bd3f23267d260a2067a54a9c4ea87fa71c5636417c8c9f", "scope": "all_answer_documents", "seed": 1217100321, "similarity": 0.7355371900826446, "source_content_hash": "c30236608814ca12e60afa1301a7342e0adcff51bc62f036ac01cd5ae2869af5", "source_hash": "a7d41234170634da33f9767b157772b111fba2fbc4463734c3541ebc31976f8b", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "6340fa2fd7421b3b4ccbe2f1eeed4840c22394e18730577dd9f1f1b0f6055adc", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generatio