{"doc_id": "doc88362", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Passion of the Christ (also known simply as The Passion) is a 2004 American biblical drama film directed by Mel Gibson, written by Gibson and Benedict Fitzgerald, and starring Jim Caviezel as Jesus Christ, Maia Morgenstern as the Virgin Mary and Monica Bellucci as Mary Magdalene. It depicts the Passion of Jesus largely according to the Gospels of Matthew, Mark, Luke and John. It also draws on pious accounts such as the Friday of Sorrows along with other devotional writings, such as the reputed Marian apparitions attributed to Blessed Anne Catherine Emmerich.", "reason": "near_duplicate_of_source", "seed": 913907028, "similarity": 0.9869678540399652, "temperature": 0.3}], "fingerprint": "ef03fb8c4b97070a7f23a80cc5ad3069c0213665120844cf3310b07e9f66f56b", "generation_attempts": 2, "gold_answer": "February 25, 2004", "matched_aliases": ["2004"], "query_id": "test2576", "question_hash": "46bd6230fcb54921c87c58fec1218b289dcaaaf80e668a1203b3b92428063d5d", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "fb4e297c4507ab23f5102a58152835aa4a2af3c7ef773509d1300d2c155167e0", "scope": "all_answer_documents", "seed": 1758551011, "similarity": 0.4017543859649123, "source_content_hash": "f896bb9a250dd7353ed0efaee4487402076d225befdfe68efb05b4743a4f5b89", "source_hash": "8b715d56e003990f368d382de6475976016f453132192d2d38867e5383a6e1ae", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "b324879a4fb5489482ed5869f7c946f75f308052f8a6ce39e5fd0cf8699dc478", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e4032315