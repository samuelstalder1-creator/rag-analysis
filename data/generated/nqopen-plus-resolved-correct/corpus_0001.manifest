{"doc_id": "doc16837", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "A nod of the head is a gesture in which the head is tilted in alternating up and down arcs along the sagittal plane. In many cultures, it is most commonly, but not universally, used to indicate agreement, acceptance, or acknowledgment.", "reason": "near_duplicate_of_source", "seed": 1809395158, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "b11c6e25d3724184060408a96af2d29cf7adfc017008be102429aae24a5efe83", "generation_attempts": 2, "gold_answer": "a gesture", "matched_aliases": ["a gesture"], "query_id": "test460", "question_hash": "e59fcac664d2dcfde2d2aca2aed22188201f94c38c2376d0bcadb88abc0128a5", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "9ffca64fe105fcadc4a6b75247554330605c442d9c3d36d12970b614928e95ca", "scope": "all_answer_documents", "seed": 470004421, "similarity": 0.03524229074889868, "source_content_hash": "1467235c62117bcd4d286652ac8004ef0c5f3a5f3198ab56e391a0168d85a6eb", "source_hash": "9c6369e29358d328ecce35b3955c822a2335577f2ef8182e5e1737db88e0ec78", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "15405b68f1f65e6cc6e544687343dea32abbdf282fbdd98c8aa6d50524a96966", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
