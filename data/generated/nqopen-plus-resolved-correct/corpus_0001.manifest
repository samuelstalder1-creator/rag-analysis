{"doc_id": "doc30158", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Claudia Grace Wells (born July 5, 1966) is an American actress who is best known for her role as Jennifer Parker in the film Back to the Future (1985).", "reason": "near_duplicate_of_source", "seed": 2077308128, "similarity": 0.9834983498349835, "temperature": 0.3}], "fingerprint": "ee1b305e52fd5353602d1e5ed738de6c0e7667810f17d55bfa677b965ad79b6e", "generation_attempts": 2, "gold_answer": "Claudia Grace Wells", "matched_aliases": ["Claudia Grace Wells"], "query_id": "test835", "question_hash": "ee7f427fffc21c5b4b08c7e33bc3b12de274ecf9fb73e4bd1df64f99ed9ab699", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "2204cb811d7f71b47947060de370c8f74766ced1d74b11e3222154ed69f0838a", "scope": "all_answer_documents", "seed": 851459222, "similarity": 0.8852459016393442, "source_content_hash": "17952b57ca1c58b910015ce16131becb968ac08cb0d77db667ff3a27123f0838", "source_hash": "02bcf5a8c10b96e83ffdfe7dfabb8565b04d88644abcf6ac7ce74960ef4af10a", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "30c263a691073b5fed3d00029f74a804b25ed97c48883a14dda72fd457bac33a", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc30224", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The 2012 Summer Olympics, formally the Games of the XXX Olympiad and commonly known as London 2012, was an international multi-sport event held from 27 July to 12 August 2012 in London, United Kingdom. The first event, the group stage in women's football, began on 25 July at the Millennium Stadium in Cardiff, followed by the opening ceremonies on 27 July. 10,768 athletes from 204 National Olympic Committees (NOCs) participated.", "reason": "near_duplicate_of_source", "seed": 1841364840, "similarity": 0.9762174405436014, "temperature": 0.3}], "fingerprint": "816dfdc92c22dead9898c250491cf1000e5ec4fbf9fe3fd5cc43fdb8ed2e905a", "generation_attempts": 2, "gold_answer": "London", "matched_aliases": ["London", "London, United Kingdom"], "query_id": "test837", "question_hash": "2021678e9bd7742766e458d1baf327ced3ca54ce7d5f97a5cec2bb3d8cde43a7", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "4c4545e8d70d3f9e1c4af36b406fc707b9c46e47a0f647ae1ac2760ab3950f18", "scope": "all_answer_documents", "seed": 1051676072, "similarity": 0.32054794520547947, "source_content_hash": "29629e136a1a358079468d2d625485f36cf27715fac85ca04fa97f6f319074f0", "source_hash": "85f65274d1bb3beb9aef41c0da2d3d4e8c8106395f5875b2bc2dc63c5237ce1b", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "14acd1ec6248999f115cd3ff71b79d1eb8eff4c97cbb993ac6b079fbf451af1c", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc30344", "receipt": {"answer_in_original_body": true, "failed_attempts": [], "fingerprint": "07eaa3159e5701e8478fa7c9606145892a5ba97d34a640bfb2ec800dc93ca7e5", "generation_attempts": 1, "gold_answer": "British Columbia", "matched_aliases": ["British Columbia"], "query_id": "test840", "question_hash": "f63fc7133b2114b9bb80a2b622777ffc5dfaf28b4d34e354266ec200291abe09", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "a4d9d637adf2af47b5fa8f75b7a4bddb3ae90910c46cdc21b9ca4890b753b19d", "scope": "all_answer_documents", "seed": 1615732505, "similarity": 0.4406779661016949, "source_content_hash": "e5d1f6f15f99080ec53b1c898514f36f34f43b7e455011c7bca9cce1cf5faa63", "source_hash": "8134afe6092e872698e95c4a22a43f7edea636ec88dc1aed08e5ee850c1bee6e", "target_answer": null, "temperature": 0.3, "validation": {"answerability_verified": false, "evidence_hash": "13395d642301d0cd14eac496cd272db2339dc9e251c286c1544ce7b744184e2f", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc30365", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Stephanie Judith Tanner, who played the middle sister on Full House, is the witty, sarcastic middle child of Danny and Pam, the younger sister of D.J., and the older sister of Michelle. Her mother died when she was five years old. Her catchphrases during the early seasons of the series include \"how rude!,\" \"well, pin a rose on your nose!\" and \"hot dog\". She eventually evolved into something of a tomboy in seasons four and five. Stephanie has a habit of spying on D.J.'s life by reading her diary and eavesdropping on her telephone calls (having been caught in the act several times), and is generally the most athletic and nosiest of the Tanner girls. Her best friends in school are Gia Mahan and Mickey, whom she meets in season seven (the former is the only one who appears through to season eight). Of the three sisters, Stephanie has dealt with the toughest issues, such as peer pressure into smoking (in season seven's \"Fast Friends\"), \"make-out\" parties (in season eight's \"Making Out is Hard to Do\"), joyriding (in season eight's \"Stephanie's Wild Ride\"), and uncovering a classmate's child abuse (in season six's \"Silence is Not Golden\"), as well as the death of her mother when she was only five. In her early years, she is very sentimental about Mr. Bear, a stuffed animal that her mother gave to her after Michelle was born (this was the focal point of the season two episode \"Goodbye Mr. Bear\"). She and Jesse are the most abrasive when it comes to how they feel about Kimmy Gibbler.", "reason": "missing_gold_answer", "seed": 927724018, "similarity": null, "temperature": 0.3}], "fingerprint": "72150b161e9e2ba4015716244d539fb7b0cd040276c54b8d76cc7eb262b97a0c", "generation_attempts": 2, "gold_answer": "Jodie Sweetin", "matched_aliases": ["Jodie Sweetin"], "query_id": "test841", "question_hash": "ae7fa6edd6baf205709a197524e0d7d750d9d5e09a1ec74ac16e5bb2249f8ab7", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "b5c94a6f466acbe89fa840db2cf48223f21f094e96f7e6b4186a6cf0abd7f4e4", "scope": "all_answer_documents", "seed": 1121003722, "similarity": 0.12644787644787644, "source_content_hash": "e5d0d9e59085166e011c78353ae1bc9db3d7aa48a27d8a34491e8a6e3a0acd1f", "source_hash": "b3d312cc7a6ce99ce4fcbd76db5645d61515d563c8827be6640be78e48cd844c", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "61f302d3657117d9e26a3351461be54ee668a7dcf7fc37ffd3385687addbafef", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
