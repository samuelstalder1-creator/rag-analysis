{"doc_id": "doc77476", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Dominican Independence War gave the Dominican Republic autonomy from Haiti on February 27, 1844. Before the war, the island of Hispaniola had been united under the Haitian government for a period of 22 years when the newly independent nation, then known as the Republic of Spanish Haiti, was invaded by Haiti in 1822. Previously known as the Captaincy General of Santo Domingo, the criollo class within the country overthrew the Spanish crown in 1821 before unifying with Haiti a year later.", "reason": "near_duplicate_of_source", "seed": 128586099, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "89154d4a33ee4400e4d9c8ce358242eec5f4c9305926496c9f39fcaa129d85f4", "generation_attempts": 2, "gold_answer": "Haiti", "matched_aliases": ["Haiti"], "query_id": "test2227", "question_hash": "8c5ab05da88b112ade250ebc07e1e0a604c7718b59ef92a926d486f8ac3adafc", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "ba9ab86e91db5f0079ae38710a10e1d37bad25eb0c8a826a5da99fdd6372c9c8", "scope": "all_answer_documents", "seed": 527625927, "similarity": 0.48390446521287644, "source_content_hash": "15b382bf1317c599adfc2e77d1b43a0f517acf25a976b5176649ca3f503ac451", "source_hash": "4b85df6c86c200560a02e6c17ce19caff6c8e77484f230782c717c7176d532a9", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "bd3c4182cc41b372f9ddfb3135b405cd5088e887a412a198b9eaadf1427d5758", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc77536", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Jeanie with the Light Brown Hair is a parlor song by Stephen Foster (1826–1864). It was published by Firth, Pond & Co. of New York in 1854. Foster wrote the song with his estranged wife Jane McDowell in mind. The lyrics allude to a permanent separation.", "reason": "near_duplicate_of_source", "seed": 1151529074, "similarity": 0.9824561403508771, "temperature": 0.3}], "fingerprint": "eb116b8f8cc6f6d2ad9805b6c0de7134a44dbd6b110422973004e30c3800dcf8", "generation_attempts": 2, "gold_answer": "Stephen Foster", "matched_aliases": ["Stephen Foster"], "query_id": "test2229", "question_hash": "c08535035df816854df9654dcdd85cd6e1fb0270a2cd6a58bcb68c3c189a0a34", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "02c164e89a4e7cbdbefce334b902552e30d8d3a78e49ad48224c91022cace9a3", "scope": "all_answer_documents", "seed": 832904007, "similarity": 0.4659498207885305, "source_content_hash": "f53d0694a52c15aecf4d6e4c6c0d2178bd00a7256819dc47285605ac0578b2e1", "source_hash": "31b2775b9d348bba118866f3784702e47646f6d4a6a41e207bd7f9452150ab7d", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "9524914e5337180a4374833a4f97d5902588bf0d325479358e268efb6a9605b8", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc77576", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Bob & Tom Show is a syndicated US radio program established by Bob Kevoian and Tom Griswold at radio station WFBQ in Indianapolis, Indiana, March 7, 1983, and syndicated nationally since January 6, 1995. Originally syndicated by Premiere Networks, the show moved to Cumulus Media Networks (now Westwood One) at the beginning of 2014.", "reason": "near_duplicate_of_source", "seed": 1026105813, "similarity": 0.9911764705882353, "temperature": 0.3}], "fingerprint": "0f6319834754667b074da25c5241d80c9d6784445a8a1e7695b9813c8c927401", "generation_attempts": 2, "gold_answer": "WFBQ in Indianapolis, Indiana", "matched_aliases": ["WFBQ in Indianapolis, Indiana", "Indianapolis, Indiana"], "query_id": "test2231", "question_hash": "508a254c32ba10f4eff8fe30371311399245be1d07c109a61e597f72a198a7f4", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "edad17e07af3ff4b96c9293cfb16fb3a42919db95f5cc27fd5e9467a648d72a4", "scope": "all_answer_documents", "seed": 1133099815, "similarity": 0.9404934687953556, "source_content_hash": "aacf183107dbe6b3f90b73d807ddff241d3dd3babf044f8e96eef4b8ac1c39ea", "source_hash": "750362d40f39ef6e27662c9c0775a779d18f560a6cc19f4d41fa8e7bc3d42e6c", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "63ddfcfb5d689be2a153f93caea64515ce731995306a87b9d5f003c3451b56e2", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
