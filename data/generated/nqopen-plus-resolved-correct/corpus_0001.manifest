{"doc_id": "doc34938", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Clifford the Big Red Dog is an American-British educational animated children's television series, based upon Norman Bridwell's children's book series of the same name. Produced by Scholastic Productions, it originally aired on PBS Kids from September 4, 2000 to February 25, 2003. The UK version (where it was dubbed with British voice actors replacing the original American soundtrack) originally aired on BBC 2 on April 1, 2002.", "reason": "near_duplicate_of_source", "seed": 417598978, "similarity": 0.9965317919075144, "temperature": 0.3}], "fingerprint": "ede1be95767662b2878d5bd642bb066910613c6ed1d5ea61b8db6b015d1fd566", "generation_attempts": 2, "gold_answer": "September 4, 2000", "matched_aliases": ["September 4, 2000"], "query_id": "test993", "question_hash": "2edefae2bfd451f6033225b70a23946b4c320ab926eee266bfa5d0f43385c8b8", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "e47452dadde2cf4f49367395f3d5879c0f49c39e735ead7c59b99345172af2ee", "scope": "all_answer_documents", "seed": 232611469, "similarity": 0.5700325732899023, "source_content_hash": "8ddea4637d4cc739461303a3d159f72d0088f5a18902872997f7d5987789e3b5", "source_hash": "e40edde200c8855f270e3703edc5b934833d63d0f98f317d60542be487961cf2", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "77bc5d1d7823ffe7501f79ee7b7847bec559b5a52d4cfd92c4c3b2ac4fb9f98a", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
