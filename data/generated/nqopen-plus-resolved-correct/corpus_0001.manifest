{"doc_id": "doc109630", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"Good Night\" is a song by the Beatles, composed by John Lennon, but credited to Lennon-McCartney. It is sung by Ringo Starr, the only Beatle to appear on the track. The music was provided by an orchestra arranged and conducted by George Martin. It is the last song on the Beatles' 1968 album The Beatles (also known as the \"White Album\").", "reason": "near_duplicate_of_source", "seed": 257940923, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "1ce4b71bb1bee8ef87b657de5f866e1babc915f1cdcba5034f5386724239e334", "generation_attempts": 2, "gold_answer": "Ringo Starr", "matched_aliases": ["Ringo Starr"], "query_id": "test3209", "question_hash": "bbeb71426b81bc62f30371bc68e0bbbe30f525f1cb75dcc4244ac64c35e21dbf", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "9d4dd5e39d6461123ed184d17539933bce079c289c5945e5c3a51e77f3406bd6", "scope": "all_answer_documents", "seed": 1033717627, "similarity": 0.20444444444444446, "source_content_hash": "977d913cfc9359acd746e96f8565eb06f4de68124b2a1fda2e960a8bad5072fc", "source_hash": "78d1d04c94619367c9e998a116c1b0737639cc306e2059cc1df1383e873d2bf3", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "32e184ed22d669766529b749ce4f58438a3b65b3844dfd6cb67d352b2322d150", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
