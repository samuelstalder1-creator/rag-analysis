{"doc_id": "doc101983", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The present coat of arms of South Africa was introduced on Freedom Day 27 April 2000. It replaced the earlier national arms, which had been in use since 1910.[1] The motto ǃke e: ǀxarra ǁke is written in the Khoisan language of the ǀXam people and translates literally to \"diverse people unite\". The previous motto, in Latin, was Ex Unitate Vires, translated as \"From unity, strength\".", "reason": "near_duplicate_of_source", "seed": 363456843, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "d549ff3d21866470d971c541f4a9a651aa5eee65bba8870f6b7c4f70b77776e5", "generation_attempts": 2, "gold_answer": "South Africa", "matched_aliases": ["South Africa"], "query_id": "test2972", "question_hash": "791fa9286be40ed92c181482bddd23289276bda20d1e2323db830909ce9f34ab", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "a7390d3d49a2a567b49ba1b0d628688b43aa897ea6b61cdf446ff8df1e89630d", "scope": "all_answer_documents", "seed": 1991767946, "similarity": 0.3557692307692308, "source_content_hash": "550f0d3943024168089053cd47031a2231fa89cf18e151d02105043f57545bc1", "source_hash": "083dcf96649c767ae6bca58f0d5f580ed70bdfa574172fbd9090afc8233d35d7", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "a986ad75c0faa793bb1ea1e4538d1093d601d319eb076cafd8435f428270852a", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
