{"doc_id": "doc81942", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Cybermen are a fictional race of cyborgs who are among the most persistent enemies of the Doctor in the British science fiction television programme, Doctor Who. Within the context of the series, the Cybermen are a species of emotionless space-faring cyborgs who look to co-opt human beings or other similar species to join and populate their ranks. First appearing in 1966, the Cybermen were created by Dr. Kit Pedler (the unofficial scientific advisor to the show) and story editor Gerry Davis.", "reason": "near_duplicate_of_source", "seed": 34028725, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "d91eac22c57c84615b66c2ddf709142e39ae47d3660f08c6836897e9e7602115", "generation_attempts": 2, "gold_answer": "in 1966", "matched_aliases": ["in 1966", "1966"], "query_id": "test2369", "question_hash": "49fc61eaa13c0b4912af1bccca256afa2ef101e483f8b37f624cc557e32ad3e4", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "d51c6acc2b80a25961793cb5e1f4a6fa77cfdaaa33b814286926b400cbfdc958", "scope": "all_answer_documents", "seed": 2045637298, "similarity": 0.3286908077994429, "source_content_hash": "ef583df35cfa7b8d5b4301d7c3e974653e9f5c4db8423df6bb0698a601485973", "source_hash": "1f82f59e5f0e8c4693e8e9f8fef284da34eab6b538086302dfdaa34d8652d578", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "dc584f821d24b3e7181262100d5935d0de788404cc01c52cbaa090f8b607d79b", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
