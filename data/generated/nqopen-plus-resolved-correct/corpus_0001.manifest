{"doc_id": "doc17", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Patrick Walter Brown MPP (born May 26, 1978) is a Canadian politician who serves as the leader of the Progressive Conservative Party of Ontario and Ontario's Leader of the Official Opposition. Brown was a federal Conservative member of the House of Commons of Canada from 2006-15 representing the riding of Barrie.", "reason": "near_duplicate_of_source", "seed": 1750678962, "similarity": 0.9855072463768116, "temperature": 0.3}], "fingerprint": "b10d4a2612db8a610200d944a271df4c5a83bec6d8e310d4c343eb4cc7b99202", "generation_attempts": 2, "gold_answer": "Patrick Brown", "matched_aliases": ["Patrick Walter Brown MPP", "Patrick Walter Brown"], "query_id": "test3", "question_hash": "48feafb81d576590875fd51716446d72dedb2ca2651494c836ec488ca594c70c", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "848698c1bb35c3ab6e11e5e00ac62342c438c569aa196ad0114e26805c388945", "scope": "all_answer_documents", "seed": 1810249068, "similarity": 0.3557692307692308, "source_content_hash": "6c603e30fd8c14f63c5fef99db7d018cccaa1053111f38e782cf43c2b8eeefd1", "source_hash": "e1f52739204d3c99b74d80aed230f3336b10bb80ae156d3e92de34cd4bcb8b91", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "3dd8aef9faf68cc2ba82b5c81d7fd1275f821da1591cbc27094d1d4d79501a26", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc18", "receipt": {"answer_in_original_body": false, "failed_attempts": [{"attempt": 1, "generated_text": "In May 2015, Patrick Brown was elected leader of the Ontario PC Party, and stepped down as MP. He was elected Member of Provincial Parliament (MPP) for Simcoe North in a provincial by-election on September 3, 2015. Before being elected to federal office, Brown worked as a lawyer in Barrie.", "reason": "near_duplicate_of_source", "seed": 496955485, "similarity": 0.9808695652173913, "temperature": 0.3}], "fingerprint": "308bfc043442f15286b5e5151ddfe04367508d61418f5e1d77f328aabfa80ccf", "generation_attempts": 2, "gold_answer": "Patrick Brown", "matched_aliases": ["Patrick Brown"], "query_id": "test3", "question_hash": "48feafb81d576590875fd51716446d72dedb2ca2651494c836ec488ca594c70c", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "122c88b7ceab72573fdde6a3e07e2816c41aee14091466ca337de9715c2a2126", "scope": "all_answer_documents", "seed": 1993528342, "similarity": 0.2909090909090909, "source_content_hash": "a13b88eda419089258e9f8a7ae975f1327d0f6ecfbc66b262e39ace5faf33acc", "source_hash": "18591eee8dc9e662e9d8cb5edc4d3271df9d697ea3d07268cc9060644da2e559", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "2e6f33a771ec91edf18f8ebbca7c1a47a28f2ef20edc949bad02f0e6e61e4e8e", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
