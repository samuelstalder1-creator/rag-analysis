{"doc_id": "doc89031", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"I Can Only Imagine\" (sometimes shortened to \"Imagine\") is a single recorded by Christian rock band MercyMe. Written and composed by lead vocalist Bart Millard, the song, based around a main piano track, was inspired by the death of Millard's father and considers what it would be like in Heaven and to be standing before God. The song was first issued as a track on MercyMe's 1999 album The Worship Project, which was released on an independent record label. The song was re-recorded and included on their 2001 major-label debut album Almost There as the fifth song on the album.", "reason": "near_duplicate_of_source", "seed": 1170524672, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "e26f8eade4472493a77144e928f5bfe1931716df1222fd4a19e0e2e7cc95ff55", "generation_attempts": 2, "gold_answer": "Bart Millard", "matched_aliases": ["Bart Millard"], "query_id": "test2600", "question_hash": "9fb50adbec06794dc83d59b4dc58a9788df385efd5c5dd9caadea2424b66c690", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "2e3d5c5b2f4164e5f82bcf4cdefe4d505db6028ca048d27dcf28ed971e4ed881", "scope": "all_answer_documents", "seed": 737408747, "similarity": 0.186219739292365, "source_content_hash": "512f8e307d2d888845eede5c6537663a983da591dac576f26fdeb22780fd24ea", "source_hash": "f40a06e79dcf273b698cfefa7ea7348ff153ff2cfb9852456c00d46f82d096bd", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "8e389f5bba5429af96d00688931c5f0be0e553f03fc79b7e92c2652dd4bd9729", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e4032