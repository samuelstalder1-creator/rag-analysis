{"doc_id": "doc30775", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "From a vantage point above the north pole of either the Sun or Earth, Earth would appear to revolve in a counterclockwise direction around the Sun. From the same vantage point, both the Earth and the Sun would appear to rotate also in a counterclockwise direction about their respective axes.", "reason": "near_duplicate_of_source", "seed": 1801702322, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "ce2a830be5b24ba0872df19a1bec1ce39cb75c528ec7bf46da0200e560758e20", "generation_attempts": 2, "gold_answer": "counterclockwise", "matched_aliases": ["counterclockwise", "counterclockwise direction"], "query_id": "test860", "question_hash": "c3693c9c03c79f02a5264c8f49616c8c78153521b2df947f049f395d0e4146d4", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "1dd2376a576c2fc9a936b69672b51cf69ffc72e9e07bab3cadbec6763d6b6247", "scope": "all_answer_documents", "seed": 1870212455, "similarity": 0.35467980295566504, "source_content_hash": "e732a10bbdf53c1a1126c6b7451e50b9313b0cb5fcc3f39a11dab7960208b843", "source_hash": "27d091077c093d195dd5451a3c86b7db9225eb6901cc47b81dbf594f8de00150", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "b3fd5472b609507281850a3ab3632be1771c0a09262c56d2458cefb97e4fa79f", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc30822", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Gabbar Is Back is a 2015 Indian vigilante film directed by Krish and produced by Sanjay Leela Bhansali and Viacom 18 Motion Pictures.[3] Featuring Akshay Kumar and Shruti Haasan in the lead roles, the film is a remake of the 2002 Tamil film Ramanaa, directed by A. R. Murugadoss, which was later remade in Telugu as Tagore in 2003 and in Kannada as Vishnu Sena in 2005. Suman Talwar, Sunil Grover and Jaideep Ahlawat appear in supporting roles with Kareena Kapoor Khan in a cameo. The movie has garnered a good box office success and Akshay Kumar's acting was critically praised.[4]", "reason": "near_duplicate_of_source", "seed": 1719418756, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "e5449e95d752bee0c0a458ebae654358f275731d4cdd7d65fb0550b43ed02c61", "generation_attempts": 2, "gold_answer": "Tagore", "matched_aliases": ["Tagore"], "query_id": "test862", "question_hash": "bcafbb283223bfd53c74f49ee8c539d12c7f98788400cc6d5b126e1d93cd1fb4", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "ac32d77a95c99e6c61360ea7cce40e60350fd32e395d31a9e1f2dcbeb132809c", "scope": "all_answer_documents", "seed": 413295217, "similarity": 0.22844827586206898, "source_content_hash": "927b9727886c1521a9aeed1352ad593dd25b172022081ca8d1830f8873eaf53c", "source_hash": "8e50d0dea73fa4dd0e355f016a0e5658660305c1a487ad9b9d91991e7c9280fb", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "d0105ada73903ff2e0ffbaf1e30d2d0f526e379d4c77c352f10011e1f5f680ba", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d9399629