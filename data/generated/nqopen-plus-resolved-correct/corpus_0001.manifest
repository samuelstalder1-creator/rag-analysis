{"doc_id": "doc20961", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "In the following eleven seasons, New York had limited success, reaching the playoffs only once and enduring a string of disastrous seasons, including a 1–15 record in 1996. The following year, the Jets hired two-time Super Bowl winning coach Bill Parcells. The new coach guided the team to its most successful season since the merger in 1998; the Jets finished 12–4 and reached the AFC Championship Game, in which they fell to the Denver Broncos. The team made five playoff appearances in the 2000s, their most of any decade. In 2009 and 2010, the Jets achieved back-to-back appearances in the AFC Championship Game, losing to the Indianapolis Colts and Pittsburgh Steelers. In 2010, the team began to play in MetLife Stadium, constructed near the now-demolished Giants Stadium.", "reason": "near_duplicate_of_source", "seed": 563241433, "similarity": 1.0, "temperature": 0.3}, {"attempt": 2, "generated_text": "In the following eleven seasons, New York had limited success, reaching the playoffs only once and enduring a string of disastrous seasons, including a 1–15 record in 1996. The following year, the Jets hired two-time Super Bowl winning coach Bill Parcells, who guided the team to its most successful season since the merger in 1998; the Jets finished 12–4 and reached the AFC Championship Game, in which they fell to the Denver Broncos. The team made five playoff appearances in the 2000s, their most of any decade. In 2009 and 2010, the Jets achieved back-to-back appearances in the AFC Championship Game, losing to the Indianapolis Colts and Pittsburgh Steelers. In 2010, the team began to play in MetLife Stadium, constructed near the now-demolished Giants Stadium.", "reason": "near_duplicate_of_source", "seed": 1317035964, "similarity": 0.9870633893919794, "temperature": 0.5}], "fingerprint": "1cfe034c291da545ec8ea2f412396885a72a8b9bdb6c04c10fabc0d121b6778e", "generation_attempts": 3, "gold_answer": "2010", "matched_aliases": ["2010"], "query_id": "test580", "question_hash": "947d145daa1ea348f1aaacf781aaaed42646ea34d45e694535683e843fa3e9df", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "89b6981864b64d47ab13d93717edc04ef9200829a55098c292addfea4d56e550", "scope": "all_answer_documents", "seed": 1957936855, "similarity": 0.05128205128205128, "source_content_hash": "4fd7d5dd6e75abd91c7644bcf0140859629f75dec3232e25e7517d4e3a803347", "source_hash": "f7a6f694e645dedcefb891aa0688177e4a951d1bc5f911dc1eeecbf6f1646760", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "0d47745f32a3697a9f7cdc58caeb4310d999e14ff2d258e2695115bfeecb3c26", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
