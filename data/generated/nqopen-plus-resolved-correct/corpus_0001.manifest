{"doc_id": "doc92271", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Guardians of the Galaxy Vol. 2 is a 2017 American superhero film based on the Marvel Comics superhero team Guardians of the Galaxy, produced by Marvel Studios and distributed by Walt Disney Studios Motion Pictures. It is the sequel to 2014's Guardians of the Galaxy and the fifteenth film in the Marvel Cinematic Universe (MCU). Written and directed by James Gunn, the film stars an ensemble cast featuring Chris Pratt, Zoe Saldana, Dave Bautista, Vin Diesel, Bradley Cooper, Michael Rooker, Karen Gillan, Pom Klementieff, Elizabeth Debicki, Chris Sullivan, Sean Gunn, Sylvester Stallone, and Kurt Russell. In Guardians of the Galaxy Vol. 2, the Guardians travel throughout the cosmos as they help Peter Quill learn more about his mysterious parentage.", "reason": "near_duplicate_of_source", "seed": 1163771342, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "c573c6e054ccc298b81fb00d626562c9d7be3825952a1b3f96c931bd5a80aeb4", "generation_attempts": 2, "gold_answer": "2017", "matched_aliases": ["2017"], "query_id": "test2692", "question_hash": "7518d7da5f80379171c3d2bdbf5bdd14aa301d77b4dc0e18e2b566fcbc81b9d0", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "37e24a2d4250d0cf16bd9cd751f839ee36a0c012d2b36940f86f95680ed64ccc", "scope": "all_answer_documents", "seed": 1774119575, "similarity": 0.39233038348082594, "source_content_hash": "3874b10094953ffd724448a7807d67d65fd1677f70c1d1d6c65a49d486286fd7", "source_hash": "2d278c630a25ded8e0a51c8e3feb250fc76059e5a49962ad321852340b4f59f3", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "de1edba85e6c449015e2dc69cf263cfbcc0724e2fa469badbb7a9545a8898188", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_veri