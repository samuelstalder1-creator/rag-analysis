{"doc_id": "doc110851", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Granite Mountain Hotshots were a group within the Prescott Fire Department whose mission was to fight wildfires. Founded in 2002 as a fuels mitigation crew, it transitioned to a handcrew (Type 2 I/A) in 2004, and ultimately to a hotshot crew in 2008. The crew had their own fire station, station 7, where equipment, including two 10-person crew carriers, was housed. The 2017 film Only the Brave was based on the Granite Mountain Hotshots and the Yarnell Fire.", "reason": "near_duplicate_of_source", "seed": 290701625, "similarity": 0.9782608695652174, "temperature": 0.3}], "fingerprint": "158c0e45fc0539f081e04197abdce7cf1339d0e4404d5e8bbf053dde8e9f8599", "generation_attempts": 2, "gold_answer": "2008", "matched_aliases": ["2008"], "query_id": "test3241", "question_hash": "0065f9dcb941fda1984ea8251125cdd5c38db003e87ce11a9357526468bf1f19", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "d9d655bbfac4c5c5081726856f1871670097de6436988ae2ea63ed56c0d4afa5", "scope": "all_answer_documents", "seed": 345490398, "similarity": 0.48883374689826303, "source_content_hash": "41c7115e3640dbd072c3d69ccf1e3caf2304bcc9bc4b3e70e7244a390e3a2486", "source_hash": "56f8d31410831d8156dee2ec83d02bc160d9c9452b2b2a899ca217d5fd832de7", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "020bef874c1a2aab4825ed1331dd335762b8eaa91e881b4401490303f264fa73", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
