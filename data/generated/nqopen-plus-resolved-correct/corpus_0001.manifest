{"doc_id": "doc5159", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Cyndi Grecco (born May 19, 1952, in New York, New York) is an American singer who performed the theme tune to the popular 1970s American television show Laverne & Shirley. Titled \"Making Our Dreams Come True\", the song (in which Grecco was accompanied by the Ron Hicklin Singers) was also put out as a single and charted at #25 on July 25, 1976. The song came out on the small Private Stock label (#45086). An album followed, though a second disco-themed single, \"Dancing, Dancing\", failed to chart. She also provided the theme to another 1970s ABC television sitcom Blansky's Beauties. Nevertheless, Grecco remains a one-hit wonder.", "reason": "near_duplicate_of_source", "seed": 860992035, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "179b2d64fa68cd2dcac62aa199f59ac0ed3a910c590cdecd9f45c1d7b12a03a8", "generation_attempts": 2, "gold_answer": "Cyndi Grecco", "matched_aliases": ["Cyndi Grecco"], "query_id": "test136", "question_hash": "43be20fd76d880cde68a25930fba370a9043e20edec4bb47b7ba71b2427e5f5e", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "f8c4827485b03cc77daff2dc5eb00618ef425869cb3b8149e8da200c1f9a5de5", "scope": "all_answer_documents", "seed": 436214416, "similarity": 0.3489278752436647, "source_content_hash": "ca68023256ba87da76982659dc35bbc562402fb42bb53208c5b977bd931e5b34", "source_hash": "fd6775cb8456c37e4bcf469e4c3a225159e49e0af4c5746f671711f9eaa5447c", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "be2cf33b850ce901e4cf2c422ed37547cf7d16ce186e05d3943f99212a10470c", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash":