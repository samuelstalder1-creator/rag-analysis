{"doc_id": "doc87463", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Starting in the 2007 season, the National Football League (NFL) has hosted regular season American football games outside the United States every year. Collectively officially known through 2016 as the NFL International Series, from 2017 the series currently has two sub-series, the NFL London Games in London, which has been in place since 2007, and the NFL Mexico Game in Mexico City, which began in 2016 with a predecessor game in 2005.", "reason": "near_duplicate_of_source", "seed": 1277394040, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "54b48a2f0520865cf9c612a278ee55a3187be52cc313b8bfddc91a9873f83a78", "generation_attempts": 2, "gold_answer": "since 2007", "matched_aliases": ["since 2007", "2007"], "query_id": "test2544", "question_hash": "82dc68ebe4c83e1e5efac0ede88e1fc45ccf47a24117d7688acd16c0b7bd05e7", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "795a66841754924c518fee93cd4e7f45e1bd304f438a5df1fb434d88e40e28ec", "scope": "all_answer_documents", "seed": 1525528061, "similarity": 0.37410071942446044, "source_content_hash": "9f1f30c158929070434a4449eeb50c317b82eefa9f7436ca77837fe2ad6492f4", "source_hash": "79c4b91bd84cc8048e4a3010e545b5d6bd64c2b84c12c6b90c27ed7336d02d78", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "149e171b5dfc2cb6b1a48fd86f1039b0b46f3ee27b47dc4ae980c9bf28eabf7e", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc87464", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Initially, all games in the International Series were held in London. Wembley Stadium was the exclusive home stadium for International Series games from 2007 to 2015 and will continue to host NFL games through at least 2020; beginning in 2016, the series began expanding to more stadiums, first to Twickenham Stadium, London (2016–18) and to Estadio Azteca, Mexico City (2016–) and will eventually expand to the still under construction new stadium at Northumberland Park also in London (2018–27), with possible future plans to expand the series to Germany and/or Canada.[1][2]", "reason": "near_duplicate_of_source", "seed": 908902288, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "2daef26d3726833b15ead3f3878ee09b6edd89138605bc3bac06a66c6eea7824", "generation_attempts": 2, "gold_answer": "since 2007", "matched_aliases": ["2007"], "query_id": "test2544", "question_hash": "82dc68ebe4c83e1e5efac0ede88e1fc45ccf47a24117d7688acd16c0b7bd05e7", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "68b418ff05bc55e5309c5c33f239ee42eceb2824f9273e41532a89b49193a9ba", "scope": "all_answer_documents", "seed": 192790710, "similarity": 0.12698412698412698, "source_content_hash": "ae79cd35f351b01c6e0cb4e6e7413366141b2816cfee008730197a50c1188049", "source_hash": "ca3b790e7fd3075cfdf817fc088465c2da3b3844cf9cba0cedf8f277cfcbd817", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "016b48e7bc06e34398887f1fd595ec4a1fce48f72a648dd770da582772c2b801", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc87473", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Miami Dolphins hosted the New York Giants at Wembley Stadium in London, England on October 28, 2007. The Giants defeated the Dolphins 13–10 in the first regular season NFL game held outside North America. The first 40,000 tickets sold out for the game in the first 90 minutes of sales. The game was aired regionally on Fox.", "reason": "near_duplicate_of_source", "seed": 2016802228, "similarity": 0.9834087481146304, "temperature": 0.3}], "fingerprint": "5fde037ace503d21207fec3e828ee00e70ac86026282f9f36cd6b0ea59e7ad10", "generation_attempts": 2, "gold_answer": "since 2007", "matched_aliases": ["October 28, 2007", "2007"], "query_id": "test2544", "question_hash": "82dc68ebe4c83e1e5efac0ede88e1fc45ccf47a24117d7688acd16c0b7bd05e7", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "8505124f053c81a7cc706416b0b225b030917a18ee821f73633cbe67cb4a2f45", "scope": "all_answer_documents", "seed": 1400133211, "similarity": 0.10774410774410774, "source_content_hash": "fcbfa097ea992d206bb4d1e1b380904403c288a4e0172270fa8a17eb30b51136", "source_hash": "cdcd69886609fb93b4346072493fcaad7d95dc68779590d25840d4192a2f5f7c", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "a3874b3727d52552fa8fcf3f61ad388cefe5445868dec9939edb5bb8c21ff2e0", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
