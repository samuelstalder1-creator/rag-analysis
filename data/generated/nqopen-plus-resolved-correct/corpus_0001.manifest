{"doc_id": "doc35916", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "On September 24, 2012, Hulu Plus signed a multi-year deal with WWE to stream all of the company's TV shows and some of its web series which includes Raw. Episodes of Raw are available for viewing the following day and only a condensed 90 minute version is available, not the full version as shown the previous night on the USA Network.", "reason": "near_duplicate_of_source", "seed": 546515311, "similarity": 0.9881656804733728, "temperature": 0.3}], "fingerprint": "941854e60a501b626e7081de39058d0aad411908174e58117a1c5c3ad098b577", "generation_attempts": 2, "gold_answer": "the following day", "matched_aliases": ["the following day"], "query_id": "test1018", "question_hash": "af78cce88cb7eb4e6ac66836423dd542aaf34e10dec7a7a6ba90030c51b11889", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "7544445656a33127ff269b4dcd2c116bd949949aca0b617d1f87c210ddf55959", "scope": "all_answer_documents", "seed": 657006325, "similarity": 0.1753889674681754, "source_content_hash": "ba71bfd024208bbe83d2b281a9467c764325f1fc719d40b64c60c378aa5d6baa", "source_hash": "a68b619f990d8abdf6024c50cebfc225d52b765fd5e59e9ff5977ce90730310f", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "a011fc8ed44bce0c64cb43a85f563a5474c057469051c2f2d8cce8d5cc7e1551", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc35963", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "At the end of December 31, 2015, its employee strength was 170,664.[81] Abid Ali Neemuchwala was appointed as Wipro's CEO after T. K. stepped down in early 2016.[82]", "reason": "near_duplicate_of_source", "seed": 727958854, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "764e1de4ea5541b30f615051fa9ba5823d5ffac27481ff992d30359e05a8c51e", "generation_attempts": 2, "gold_answer": "Abid Ali Neemuchwala", "matched_aliases": ["Abid Ali Neemuchwala"], "query_id": "test1019", "question_hash": "244842794a3e18eaefdbe9680ddb0fd3520dc08fe28c1f2c1f51bf3c8d6b6c5f", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "03b8851c802d2e31638fbbd1337d31769789d8e0768c0d0314003773867501cb", "scope": "all_answer_documents", "seed": 2008247266, "similarity": 0.23195876288659795, "source_content_hash": "bc238a245fb2cfb33109147114ad12f179da9915562b51c5a2f56f0eef128a9d", "source_hash": "8ba79f66d48df3a80728bf94fc0846d2634937245ab457494a266928673ce8f0", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "0e89231ff2e9a047af085b0f3b3fea0faba2b73bbe161904940e6758f4465bf4", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
