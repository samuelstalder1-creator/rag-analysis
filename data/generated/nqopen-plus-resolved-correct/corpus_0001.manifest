{"doc_id": "doc101754", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "On October 20, 1977, a Convair CV-240 chartered by the rock band Lynyrd Skynyrd from L&J Company of Addison, Texas, ran out of fuel and crashed in Gillsburg, Mississippi, near the end of its flight from Greenville, South Carolina, to Baton Rouge, Louisiana.", "reason": "near_duplicate_of_source", "seed": 1871902599, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "2d8f3033e1bfd04b30dc3c8a461c7ab0769c0d59eb512725748b41c13ffea88d", "generation_attempts": 2, "gold_answer": "October 20, 1977", "matched_aliases": ["October 20, 1977"], "query_id": "test2969", "question_hash": "1bcfa34c05fe90914172b394f386d822c0dcc5f466b8042b880ac7afa56d4fc8", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "2ed7c8e7c4dacf233723dd475c7ac768399f0b6a937051ceba00e0533c945599", "scope": "all_answer_documents", "seed": 1633640069, "similarity": 0.6408839779005525, "source_content_hash": "70f714e389c4172e6f368e5bd0227db3728eeafee258884e3459d08b6bd6ea7f", "source_hash": "d3fd6a4ef73be41e13ed190d835a63c1e23febd8d7cf8ada1a4cdb12c363f0bb", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "ea318123d765558610cba5499d98b1bef71f627dfe22e4defa3d3e0a5c713b2f", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc101768", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Born and raised on the Portuguese island of Madeira, Cristiano Ronaldo was diagnosed with a racing heart at age 15. He underwent an operation to treat his condition, and began his senior club career playing for Sporting CP, before signing with Manchester United at age 18 in 2003. After winning his first trophy, the FA Cup, during his first season in England, he helped United win three successive Premier League titles, a UEFA Champions League title, and a FIFA Club World Cup. By age 22, he had received Ballon d'Or and FIFA World Player of the Year nominations and at age 23, he won his first Ballon d'Or and FIFA World Player of the Year awards. In 2009, Ronaldo was the subject of the most expensive association football transfer when he moved from Manchester United to Real Madrid in a transfer worth €94 million.", "reason": "near_duplicate_of_source", "seed": 431720411, "similarity": 0.9709443099273608, "temperature": 0.3}], "fingerprint": "d04cb0f1fa927d6797bb3e2ece6d8bdeac39f562a744725b68eb3c7bfac8990e", "generation_attempts": 2, "gold_answer": "2003", "matched_aliases": ["2003", "at age 18 in 2003"], "query_id": "test2970", "question_hash": "803e514037c68d8e38bed7e264d3e67560b279fe8842210548ea793c6d4a640a", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "149c9279c8b640b2f0007058e9fe101164eebffc6ad578d4cb98038f029ab5d8", "scope": "all_answer_documents", "seed": 1787707856, "similarity": 0.2917933130699088, "source_content_hash": "14ee4851264521f587ab325a9e1bb79caca274b9ae60fd90041048f607374efe", "source_hash": "8e068a99895de86b2bbe343a9f5a7c011acb42f759ba4d4d44dc378a1ba41e41", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "d5bc2a3ffd782778dba61b987556bf5ea79b780f296c018183ffa9ca47f11da0", "format_attempts": [], "judgment": {"gold_alias_present": true