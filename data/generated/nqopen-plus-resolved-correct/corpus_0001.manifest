{"doc_id": "doc59317", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Gerald Ford was involved in the Boy Scouts of America, and earned that program's highest rank, Eagle Scout.[10] He is the only Eagle Scout to have ascended to the U.S. Presidency.[10]", "reason": "near_duplicate_of_source", "seed": 1117765310, "similarity": 0.9805013927576601, "temperature": 0.3}], "fingerprint": "a96497ea3486aab35a8497d0442b101f8ec353e75a19bd5c5831af4f445bb231", "generation_attempts": 2, "gold_answer": "Ford", "matched_aliases": ["Ford"], "query_id": "test1675", "question_hash": "59e6aacd0cf1330ca670d1a3d4a3875a3e17481e6d594a592705e9966ae52f73", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "f9407f5f824bc7347a290be7dc57aaaf7bcfa0d3c4111db5287831baa34f12d5", "scope": "all_answer_documents", "seed": 1031087187, "similarity": 0.907563025210084, "source_content_hash": "7f1933007cd7c27c9e54a870ae99a00121aac3fb2e055aab7c164357e0dfa250", "source_hash": "021e3cd4cf09035550ecc7a6489115f8afb245952e3601c43d1e6061765c81e6", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "4e3bcad9c8b468d5757ac9d295866d87e8afcdb0fcb31f5457f60bdf9614e0ff", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc59485", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Geoffrey Dyson Palmer, OBE (born 4 June 1927) is an English actor known for his roles in British television sitcoms playing Jimmy Anderson in The Fall and Rise of Reginald Perrin (1976–79), Ben Parkinson in Butterflies (1978–83) and Lionel Hardcastle in As Time Goes By (1992–2005). His film appearances include A Fish Called Wanda (1988), The Madness of King George (1994), Mrs. Brown (1997), and Tomorrow Never Dies (1997).", "reason": "near_duplicate_of_source", "seed": 836541071, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "7151df40f1b0bf025a40629d62f8f9b01d6d38ddce4dc0844401a8e8b494997f", "generation_attempts": 2, "gold_answer": "Geoffrey Dyson Palmer, OBE", "matched_aliases": ["Geoffrey Dyson Palmer, OBE", "Geoffrey Dyson Palmer"], "query_id": "test1679", "question_hash": "26a51572bc7a834031409c3e57b9bc82c697515b30bae265483f3ac908fb5362", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "83137d042be43acce56482523c9f73732bf44ab9165a6e405a0984766e2bdfc7", "scope": "all_answer_documents", "seed": 228352763, "similarity": 0.48475120385232745, "source_content_hash": "1f58c7df2a93a05e53969552b77332e420d992a19cec33ed14b20bf86411b06f", "source_hash": "34acf1f8f3887d2434e04748886bfb15e910d10230b06adbb8d9a81cb6b28af1", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "3f3b9249e5b84b0da006b7ba2fda58e8e7344609d727c4eb5d37ea1b0959c6e4", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
