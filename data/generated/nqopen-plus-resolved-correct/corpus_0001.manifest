{"doc_id": "doc102476", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "John Cooper Clarke (born 25 January 1949) is an English performance poet who first became famous during the punk rock era of the late 1970s when he became known as a \"punk poet\".[1] He released several albums in the late 1970s and early 1980s, and continues to perform regularly.", "reason": "near_duplicate_of_source", "seed": 130856272, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "41cc4eeb1a8717fd37aab55700ecc0fc662708f05e0ab5e4bd8654e0ab16e029", "generation_attempts": 2, "gold_answer": "John Cooper Clarke", "matched_aliases": ["John Cooper Clarke"], "query_id": "test2989", "question_hash": "1bc154ffc6bbf09103eae03a474a96efee33bf7e0bad4c5f9d311794998a75f1", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "4574f4c8ef3beb1628f6c89cc849cfad49ae6eb9c722bf3db67ecd3931bb4d09", "scope": "all_answer_documents", "seed": 571799890, "similarity": 0.5242290748898678, "source_content_hash": "4b0b6f9882090249d657a057f01f612f1d896e7a6c6fa3619ec125d1c0dda083", "source_hash": "ac25b1852f770f4e385f475025c77d03ee2ebda9f0a00ea5131e1444986d8889", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "14fb16cdaf3d6fbfb5f40ddc640dde27619dd7e964e32506a8787edd4dcb9f2f", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc102491", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Roxette are a Swedish pop rock duo, consisting of Marie Fredriksson (vocals) and Per Gessle (vocals and guitar). Formed in 1986, the duo became an international act in the late 1980s, when they released their breakthrough album Look Sharp! Their third album Joyride, which was released in 1991, became just as successful as its predecessor. Roxette went on to achieve nineteen UK Top 40 hits[1] and several US Hot 100 hits, including four US number-ones with \"The Look,\" \"Listen to Your Heart,\" \"It Must Have Been Love,\" and \"Joyride.\"[2] Other hits include \"Dangerous,\" \"Fading Like a Flower,\" \"Spending My Time,\" \"How Do You Do!\" and \"Sleeping in My Car.\"[1][2]", "reason": "near_duplicate_of_source", "seed": 1834066896, "similarity": 1.0, "temperature": 0.3}, {"attempt": 2, "generated_text": "Roxette are a Swedish pop rock duo, consisting of Marie Fredriksson (vocals) and Per Gessle (vocals and guitar). Formed in 1986, the duo became an international act in the late 1980s, when they released their breakthrough album Look Sharp! Their third album Joyride, which was released in 1991, became just as successful as its predecessor. Roxette went on to achieve nineteen UK Top 40 hits[1] and several US Hot 100 hits, including four US number-ones with \"The Look,\" \"Listen to Your Heart,\" \"It Must Have Been Love,\" and \"Joyride.\"[2] Other hits include \"Dangerous,\" \"Fading Like a Flower,\" \"Spending My Time,\" \"How Do You Do!\" and \"Sleeping in My Car.\"[1][2]", "reason": "near_duplicate_of_source", "seed": 430015150, "similarity": 1.0, "temperature": 0.5}], "fingerprint": "1c67ef227186f1d313467f6c682217f5f7101c6a4ab9961023384c2deb8343ef", "generation_attempts": 3, "gold_answer": "Roxette", "matched_aliases": ["Roxette"], "query_id": "test2990", "question_hash": "d006759d2c6d1a3ca62509c4aab689815947396a53c46fbe64fe07143c98942b", "re