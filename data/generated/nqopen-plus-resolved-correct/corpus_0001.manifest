{"doc_id": "doc33315", "receipt": {"answer_in_original_body": true, "failed_attempts": [], "fingerprint": "867a1d7c302cbbfcc48792bcabb007f2c3b84ba665bc0834fb0affcc22ac90ad", "generation_attempts": 1, "gold_answer": "2014", "matched_aliases": ["2014"], "query_id": "test934", "question_hash": "f524831914a954ba2edd3b0359bd8c14355a8950a58d486328680b3289af427a", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "0adb9e6f9a1cd939e383c908c3eb38da3081f30f965a09d5bde73eb987226e97", "scope": "all_answer_documents", "seed": 671103242, "similarity": 0.3535483870967742, "source_content_hash": "5a58571bff98091c173d97e1e1cab86937004d3bf152be6f60f5fabc3ca8612d", "source_hash": "b021288374bcdb9cb31ce9486e8eb75941eb833acc6aa9e5f8517fdcb2814aaf", "target_answer": null, "temperature": 0.3, "validation": {"answerability_verified": false, "evidence_hash": "9e317af3cccda605ecfcf58cc2350484776b148df21cea2d1cd815035eb1802e", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc33318", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Princess Bride is a 1987 American romantic comedy fantasy adventure film directed and co-produced by Rob Reiner, starring Cary Elwes, Robin Wright, Mandy Patinkin, Chris Sarandon, Wallace Shawn, André the Giant, and Christopher Guest. Adapted by William Goldman from his 1973 novel of the same name, it tells the story of a farmhand named Westley, accompanied by befriended companions along the way, who must rescue his true love Princess Buttercup from the odious Prince Humperdinck. The film effectively preserves the novel's narrative style by presenting the story as a book being read by a grandfather (Peter Falk) to his sick grandson (Fred Savage).", "reason": "near_duplicate_of_source", "seed": 1202276331, "similarity": 1.0, "temperature": 0.3}, {"attempt": 2, "generated_text": "The Princess Bride is a 1987 American romantic comedy fantasy adventure film directed and co-produced by Rob Reiner, starring Cary Elwes, Robin Wright, Mandy Patinkin, Chris Sarandon, Wallace Shawn, André the Giant, and Christopher Guest. Adapted by William Goldman from his 1973 novel of the same name, it tells the story of a farmhand named Westley, accompanied by befriended companions along the way, who must rescue his true love Princess Buttercup from the odious Prince Humperdinck. The film effectively preserves the novel's narrative style by presenting the story as a book being read by a grandfather (Peter Falk) to his sick grandson (Fred Savage).", "reason": "near_duplicate_of_source", "seed": 1123335476, "similarity": 1.0, "temperature": 0.5}], "fingerprint": "63e75ada0adf13e484eed02548083b72cb749de972ba0113e52ab120b0cfae1a", "generation_attempts": 3, "gold_answer": "September 25, 1987", "matched_aliases": ["1987"], "query_id": "test935", "question_hash": "0b6e0bf5d1a7b8e47f1b0e92abd2befadf107dce4c3a4944f363ec3e9280744f", "repair_from": null, "replaced_row_hash": 