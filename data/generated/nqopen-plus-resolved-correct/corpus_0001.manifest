{"doc_id": "doc66647", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The University of Miami (informally referred to as UM, U of M, or The U) is a private, nonsectarian research university in Coral Gables, Florida, United States. As of 2016, the university enrolls 16,801 students in 12 separate colleges/schools, including the Leonard M. Miller School of Medicine in Miami's Health District, a law school on the main campus, and the Rosenstiel School of Marine and Atmospheric Science focused on the study of oceanography and atmospheric sciences on Virginia Key, with research facilities at the Richmond Facility in southern Miami-Dade County.", "reason": "near_duplicate_of_source", "seed": 128699686, "similarity": 0.9837745516652434, "temperature": 0.3}], "fingerprint": "9d9b7da38e040f3d045eda8aeb0c673df832ba038eda0f42e1f6df41ed32b04c", "generation_attempts": 2, "gold_answer": "16,801", "matched_aliases": ["16,801", "16,801 students"], "query_id": "test1898", "question_hash": "20bbcef5615807b617f173674f8f5125c99ba9434d74d84660161a867747722e", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "552dcabd854f9747db2d859b4f99c49500e289af23e8a3c4aa12630032db51ee", "scope": "all_answer_documents", "seed": 101152333, "similarity": 0.11243243243243244, "source_content_hash": "f755ef3031c75bede2735dfa6d290f89e36381a335248155b31cf08c0698bd48", "source_hash": "3a0a60c77a59fc13722c74e401f8780ba296170cd6621c64abf25bca9d013b11", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "9b37d1db295fa2bcd952313a9576d7603abd0d2479fec77d777631b7a5a2f366", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8f