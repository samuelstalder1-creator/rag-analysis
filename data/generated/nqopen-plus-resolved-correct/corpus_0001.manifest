{"doc_id": "doc5431", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Kidney transplantation or renal transplantation is the organ transplant of a kidney into a patient with end-stage renal disease. Kidney transplantation is typically classified as deceased-donor (formerly known as cadaveric) or living-donor transplantation depending on the source of the donor organ.", "reason": "near_duplicate_of_source", "seed": 1168374684, "similarity": 1.0, "temperature": 0.3}, {"attempt": 2, "generated_text": "Kidney transplantation or renal transplantation is the organ transplant of a kidney into a patient with end-stage renal disease. Kidney transplantation is typically classified as deceased-donor (formerly known as cadaveric) or living-donor transplantation depending on the source of the donor organ.", "reason": "near_duplicate_of_source", "seed": 1829884813, "similarity": 1.0, "temperature": 0.5}], "fingerprint": "2464d35b7e97fb56093dc2dccd03e73d19c7f85d6d09832a81171ba4460c6be7", "generation_attempts": 3, "gold_answer": "living-donor", "matched_aliases": ["living-donor"], "query_id": "test149", "question_hash": "86faa0aa8a8a520b3b56136914a1dc000baf4bf0836644e6c6deeda148564fbc", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "1f63d6a84e503f644ca70e0c7e469f3641af81abb7be397eaec9104b259c9939", "scope": "all_answer_documents", "seed": 422031805, "similarity": 0.18604651162790697, "source_content_hash": "8acc5b71b74e7fe14f3dabe5182873751906904246d09e4cb723df246b5cbcdb", "source_hash": "080ae0deeb13036bbe80db96d6345269bd014309bf95e29291e7d5b975800616", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "b5f9271409c11ff8e4f2d004389aa959ae40d05ce6bfd963568bed49d68eea24", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified":