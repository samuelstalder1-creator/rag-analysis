{"doc_id": "doc11106", "receipt": {"answer_in_original_body": true, "failed_attempts": [], "fingerprint": "1716bc81f0ffc7833b611ab1eb4af75212f296e3bc9115d39b3b6736bf8f532f", "generation_attempts": 1, "gold_answer": "hijab", "matched_aliases": ["hijab"], "query_id": "test295", "question_hash": "a214305bcae417e84a8abb0d6892df66eb235a4258011d5b6d4b6d525e015316", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "598d2c7da5e725f47aba1933fb0f7e88b4c623caf738510693b98b7965a4a8b4", "scope": "all_answer_documents", "seed": 1945344898, "similarity": 0.7484946734599351, "source_content_hash": "0591a8c5e4a18ddcd9a890ff12096c764ff8f8ea1436f9670af25711683acff2", "source_hash": "8f42f06c82caa712245a1092bd5c18b93026388e14ea47715c421a41b6fad3a8", "target_answer": null, "temperature": 0.3, "validation": {"answerability_verified": false, "evidence_hash": "4b4bf738cead0cd6a2befe162ae444c45ebfb834509bb6d23981d70b5629eb7f", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc11181", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The United States is a federal republic in which the president, Congress, and federal courts share powers reserved to the national government according to its Constitution. The federal government shares sovereignty with the state governments.", "reason": "near_duplicate_of_source", "seed": 256565281, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "f0ae1d0f6f7c3ff7ba535e1204ba029bb0f9b6680cb5830bcd19f1143dde4818", "generation_attempts": 2, "gold_answer": "federal republic", "matched_aliases": ["federal republic"], "query_id": "test297", "question_hash": "e775ac1b2a4c3381474871ddb761114394493adcfaadec1b8765452fb40505bc", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "a2ef078b532202125431b67b59c5dd343833cbd171e57c81f05f1ee9aba21dd7", "scope": "all_answer_documents", "seed": 1801222316, "similarity": 0.6764705882352942, "source_content_hash": "7011b7473099a50fae04043acdde0c6086c64076d39425374124324a58b92290", "source_hash": "ed9efcb9fcf528f4e5c558b06facbc72f9baaad91769da53ee779cb1d8a4c325", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "ac5753f91b59969e160de6d08ca6c71b89ed229ebb8ced2249c75bb96ab9102a", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc11263", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The modern Democratic Party emerged in the 1830s from former factions of the Democratic-Republican Party, which had largely collapsed by 1824. It was built by Martin Van Buren who assembled a cadre of politicians in every state behind war hero Andrew Jackson of Tennessee.", "reason": "near_duplicate_of_source", "seed": 61960319, "similarity": 0.9945155393053017, "temperature": 0.3}, {"attempt": 2, "generated_text": "The modern Democratic Party emerged in the 1830s from former factions of the Democratic-Republican Party, which had largely collapsed by 1824. It was built by Martin Van Buren who assembled a cadre of politicians in every state behind war hero Andrew Jackson of Tennessee.", "reason": "near_duplicate_of_source", "seed": 235412877, "similarity": 0.9945155393053017, "temperature": 0.5}], "fingerprint": "5983d1a322facc34be7709106816b6352223046c8daf51c6c9e8a40acc8bd118", "generation_attempts": 3, "gold_answer": "the 1830s", "matched_aliases": ["the 1830s"], "query_id": "test299", "question_hash": "13be9588b9aaa217a372e3f5dd9480c248c91773cc168215c2132f567fabea14", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "3643a552b7cd7193a2398b5566a73ce15d7aabee4d56097296963db34149b3a4", "scope": "all_answer_documents", "seed": 681096713, "similarity": 0.5807560137457045, "source_content_hash": "5ee9ee32ebe21d45e55843884369d79248f06d84ed88ec28bc909082759de97f", "source_hash": "1d80e5c81ebe5f54b3fa6490717aed047203b50d33ce92d719bab3a350e266a0", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "f16408142a92b93991e27a8cc914dbc0ffb43cdb805acdeca0922ff250d0c4c8", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc11426", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "In 1999, the contribution of civil aircraft-in-flight to global CO2 emissions was estimated to be around 2%.[17] However, in the case of high-altitude airliners which frequently fly near or in the stratosphere, non-CO2 altitude-sensitive effects may increase the total impact on anthropogenic (human-made) climate change significantly.[17] A 2007 report from Environmental Change Institute / Oxford University posits a range closer to 4 percent cumulative effect.[19] Subsonic aircraft-in-flight contribute to climate change[17] in four ways:", "reason": "near_duplicate_of_source", "seed": 703753009, "similarity": 0.9990766389658357, "temperature": 0.3}, {"attempt": 2, "generated_text": "While civil aircraft flying in 1999 were estimated to account for roughly 2% of global CO2 emissions, a 2007 report by the Environmental Change Institute and Oxford University suggests that high-altitude airliners flying near the stratosphere contribute a cumulative effect closer to 4 percent. This figure represents the total impact on anthropogenic climate change, with subsonic aircraft-in-flight also playing a role in driving climate change through four distinct mechanisms.", "reason": "missing_gold_answer", "seed": 1223834104, "similarity": null, "temperature": 0.5}], "fingerprint": "f413896fb7f46a9bb1c85f65992e8d3cdf4b57e9aaed1829f44e05f5b37cf9cd", "generation_attempts": 3, "gold_answer": "4 percent cumulative effect", "matched_aliases": ["4 percent cumulative effect"], "query_id": "test300", "question_hash": "d3ec4e06ce8abdb90584f9c76aae1ce62b39c939874b9dd27df08c4bea51a7dc", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "b10dedd3191985b4440fbfe4b4857161c4755332ad17440c2afd7d4cf53f49cc", "scope": "all_answer_documents", "seed": 1744152466, "similarity": 0.8331688055281342, "source_content_hash": "fe2e891be747476a1d7de4a99f3aaaf4