{"doc_id": "doc106437", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "In social studies, a political ideology is a certain ethical set of ideals, principles, doctrines, myths, or symbols of a social movement, institution, class, or large group that explains how society should work, and offers some political and cultural blueprint for a certain social order. Political ideologies are concerned with many different aspects of a society, including (for example): the economy, education, health care, labor law, criminal law, the justice system, the provision of social security and social welfare, trade, the environment, minors, immigration, race, use of the military, patriotism, and established religion.", "reason": "near_duplicate_of_source", "seed": 1574655324, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "54a5af89d73dd29b383a36d84b82154d8938d7d4f7e9e5458954e20cdc7c17f1", "generation_attempts": 2, "gold_answer": "a political ideology", "matched_aliases": ["a political ideology", "ideology"], "query_id": "test3110", "question_hash": "3d87a2eb88369b1dc24dcc9d45eaf341466d238d3cb50dce922b99aacb120d20", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "d131bef1fc280fc96af092ce740adfa9cf853a8fd1b0fac8999b55019227e1ec", "scope": "all_answer_documents", "seed": 672677299, "similarity": 0.20124804992199688, "source_content_hash": "c73bd502f2c187a2073f779a4afeeec959d792fe8ddf1e30f54fba7e203d2d2f", "source_hash": "71dc40d149c878936f887c1659d6a7ea238c333e3aafbd0460ec9b1c6ec6d07e", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "eb72c5d658df9c5f23273e1eb322da19fa3386dadb9f630c5fb44695c2f98335", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_a