{"doc_id": "doc43761", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"One of These Nights\" is a song written by Don Henley and Glenn Frey and recorded by the American rock band Eagles. The title track from their One of These Nights album, the song became their second single to top the Billboard Hot 100 chart after \"Best of My Love\" and also helped propel the album to number one. The single version was shortened from the album version of the song, removing most of the song's intro and most of its fade-out, as well. Henley is lead vocalist on the verses, while Randy Meisner sings high harmony (not lead) on the refrain. The song features a guitar solo by Don Felder that is \"composed of blues-based licks and sustained string bends using an unusually meaty distortion tone.\"[3]", "reason": "near_duplicate_of_source", "seed": 1662196361, "similarity": 1.0, "temperature": 0.3}, {"attempt": 2, "generated_text": "\"One of These Nights\" is a song written by Don Henley and Glenn Frey and recorded by the American rock band Eagles. The title track from their One of These Nights album, the song became their second single to top the Billboard Hot 100 chart after \"Best of My Love\" and also helped propel the album to number one. The single version was shortened from the album version of the song, removing most of the song's intro and most of its fade-out, as well. Henley is lead vocalist on the verses, while Randy Meisner sings high harmony (not lead) on the refrain. The song features a guitar solo by Don Felder that is \"composed of blues-based licks and sustained string bends using an unusually meaty distortion tone.\"[3]", "reason": "near_duplicate_of_source", "seed": 1061653600, "similarity": 1.0, "temperature": 0.5}], "fingerprint": "2f963ac3864892c436dee0c4c09024fe67f0fdcb7db3ecc3d5a57225b30ef595", "generation_attempts": 3, "gold_answer": "American rock band Eagles", "matched_aliases": ["American rock band Eagles", "Eagles"], "query_id": "test1231", "question_hash": "ee5f8a1db21753b491e5d93e26819b905cc3a5b167d315f4f44fda82cdcaaf96", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "34e9b4991979b8110ffc3c5de071fb312303e75992454a3ded2dbf5ba2da97d6", "scope": "all_answer_documents", "seed": 1942138229, "similarity": 0.19809825673534073, "source_content_hash": "e23bfd5b6f8700b1c8fd2df1e2c9e9327d366dcd4920cd926e4ebf23b9936f18", "source_hash": "95e4938b4dba1ed02d3782898688f9388ae29d934707dc92dd1d916759548b87", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "172599ba20170c1844db60f47a4d3f6efe3ad4b6ad67e594b1b7847658f64afc", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc43833", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"Your Love\" is a song by the English rock band the Outfield, taken from their debut album Play Deep (1985). The song was penned by the band's guitarist John Spinks.", "reason": "near_duplicate_of_source", "seed": 2113940208, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "c4dafc160f8571443f6829e3ed59c02b8df0715b867849b2caf7ecaaef659073", "generation_attempts": 2, "gold_answer": "English rock band the Outfield", "matched_aliases": ["English rock band the Outfield"], "query_id": "test1235", "question_hash": "afce8720e6bb6134a6f29d6cf9cf560833122fe07587fbebbc9ec742f42f1ecb", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "73883f0af000de33ef6f11139701ce35a7a9af938ff5b8175d9605f3a4875e48", "scope": "all_answer_documents", "seed": 1429953463, "similarity": 0.6307692307692307, "source_content_hash": "d562a53dc4d1ba1bc9bd7f68a34e22b2f0a8bac1c8285abaf965ecc56c525d37", "source_hash": "7e1d963e1ecdbc96dd1c9d2a7ae73650475dd93c6b50450f2a8014beb41f5b86", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "285d63207767b6e4355b3e3e2a0b67f4a0bdfdddd116da31fe7ecc143d51632f", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc43876", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"Awesome God\" is a contemporary worship song written by Rich Mullins and first recorded on his 1988 album, Winds of Heaven, Stuff of Earth. It was the first single from the album and rose to the number one spot on Christian radio and subsequently became a popular congregational song. Its title is inspired by a biblical expression (Nehemiah 1:5, Nehemiah 9:32, Psalm 47, Daniel 9:4, etc.), variously translated as \"Awesome God,\" (JPS, in the old-fashioned meaning \"awe-inspiring\"), \"great\" (KJV), among other alternatives. Due to the popularity of the song it became Mullins' signature song.", "reason": "near_duplicate_of_source", "seed": 772034893, "similarity": 0.9915966386554622, "temperature": 0.3}], "fingerprint": "f65170d0767fe332880c5265a3b4a91d94d940c84047b79bd920d99d6a9e9d61", "generation_attempts": 2, "gold_answer": "Rich Mullins", "matched_aliases": ["Rich Mullins"], "query_id": "test1238", "question_hash": "c1ee147b95be3817a29f681a966e3a41b4326674a71ad0ba970d54f1cf6f6f63", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "b2a1035da7deb13dfeb56dd606d93f3a44b7ed0cb388ec0d8ebde5f33ef6a618", "scope": "all_answer_documents", "seed": 1291991058, "similarity": 0.5661116552399609, "source_content_hash": "6ae60d1c0bdcec66e32ebabeafb8d9b2b154915e5854332451fc332f469ddd2e", "source_hash": "f0209da5e6f5a1d875f28b3bf0159b9248dd556540c54badd9a2645c509eec37", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "ba05df4f7dd368de19c4cef5a5f330a6e42f049e7020440edf0f793aa25926e6", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1a