{"doc_id": "doc55295", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Human fertilization is the union of a human egg and sperm, usually occurring in the ampulla of the fallopian tube. The result of this union is the production of a zygote cell, or fertilized egg, initiating prenatal development. Scientists discovered the dynamics of human fertilization in the nineteenth century.", "reason": "near_duplicate_of_source", "seed": 796844369, "similarity": 0.9952153110047847, "temperature": 0.3}], "fingerprint": "ccc20e90e1980e732d6b1647a9001655f37d83e16c636fc52463d2ac16702d09", "generation_attempts": 2, "gold_answer": "fertilization", "matched_aliases": ["fertilization", "Human fertilization"], "query_id": "test1544", "question_hash": "fabc27484b5b12bb3a2549f5b882bf4a3f1004d58ffc87f5d74680b396f34e3e", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "26122f2ca39d4d23c2520b54a9f9a6da4b0f10b830639937be79b5180e270ead", "scope": "all_answer_documents", "seed": 656596525, "similarity": 0.10704225352112676, "source_content_hash": "9c433dc65f185d6e63b91c26f2d868a65390498eebf3b1ceb995a5a8bcc033b3", "source_hash": "23dd7820c05e4ee200a799d84640eaec01bca74f9df3a9fa6984a1b542f6aaca", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "b192ba3e4a9ca9badb53f3fd6d109b1f942938a63191e0eec1b553fd9b0c56f8", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
