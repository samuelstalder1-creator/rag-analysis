{"doc_id": "doc59881", "receipt": {"answer_in_original_body": true, "failed_attempts": [], "fingerprint": "d2293b6648c0433b4d3dca8d0922f09ae67ca6fe35086e897a18560676728f01", "generation_attempts": 1, "gold_answer": "Brad Johnson", "matched_aliases": ["Brad Johnson"], "query_id": "test1690", "question_hash": "070267cba5c7e3bb1e81b3479b6764f6320c334a646244f5a185b77320e1d5ee", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "7efd3d59913a75b013ddef7bdea04f21aa462ab2ea503ac3981f3a138ed6523a", "scope": "all_answer_documents", "seed": 755441184, "similarity": 0.37985611510791367, "source_content_hash": "c30c316ec5c6d749c49f895ca45761169465895fb7c6755d543350eeb682b7cb", "source_hash": "c3c3df913e05b56dbd15c84d7d3465067257b828b040e261161f596ff9d0490e", "target_answer": null, "temperature": 0.3, "validation": {"answerability_verified": false, "evidence_hash": "0070e85c7e62ecd9e5e51c936212028554be77f546ac49affbf713ee54de4598", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc60052", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The military convention between Bulgaria and the Central Powers laid down the general plan for its campaign against the Kingdom of Serbia. It severely limited the control of the Bulgarian High Command over the Bulgarian 1st Army, which was designated part of a combined German, Bulgarian and Austro-Hungarian force commanded by Field Marshal August von Mackensen. He had recently led the German and Austro-Hungarian armies in the highly successful and victorious Gorlice–Tarnów Offensive of the Central Powers against the Russian army on the Eastern Front. His army group was created specifically to wage war against the Serbian army in the pre-1913 borders of the country (\"Old Serbia\"), to defeat it wherever it found it and to open the land route between Hungary and Bulgaria. As commander, Mackensen acted independently and received his directives only from the German High Command. However, the field marshal's orders to his Bulgarian forces had to be relayed to the commander of the 1st Army by the Bulgarian General Staff, which left room for the latter to intervene when needed. According to the convention, the Bulgarian commander-in-chief retained full and direct control over the Bulgarian 2nd Army and its operations in Vardar Macedonia.", "reason": "near_duplicate_of_source", "seed": 265962063, "similarity": 0.9995998399359743, "temperature": 0.3}], "fingerprint": "78f0c855ca11a5e426b55cf380e34634072adb72ac4fd3f5565ed21b5c4cbe04", "generation_attempts": 2, "gold_answer": "the Russian army", "matched_aliases": ["the Russian army"], "query_id": "test1693", "question_hash": "2f487ca91cb1f21fffceae88fff231c9ea73674046206e6890b06ed7736e8e53", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "7de53b94572578f83632836c06b5bd9e15b28930cf58ef1ddbaf716dc35ce9c8", "scope": "all_answer_documents", "seed": 1906237222, "similarity":