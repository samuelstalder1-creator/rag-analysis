{"doc_id": "doc81267", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Bronx (/brɒŋks/) is the northernmost of the five boroughs of New York City, in the U.S. state of New York. It is south of Westchester County; north and east of Manhattan, across the Harlem River; and north of Queens, across the East River. Since 1914, the borough has had the same boundaries as Bronx County, the third-most densely populated county in the United States.[2]", "reason": "near_duplicate_of_source", "seed": 380048384, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "768246555fe658b05b6595342fc69b1d0bde1e6a28f13eeea8524b77c65c7bbb", "generation_attempts": 2, "gold_answer": "Harlem River", "matched_aliases": ["Harlem River"], "query_id": "test2352", "question_hash": "e09834d765a33abe38202e791568054227b72bf30ebb94f570461554d5d9dc6a", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "892b6a63fcdc8b9619884694321d2b43e22b1e1ba840404229b629a38599b431", "scope": "all_answer_documents", "seed": 1426956504, "similarity": 0.049766718506998445, "source_content_hash": "e72e3f55b8e6ec5792ab38cfbc46f4be94a4c67fa92bb7ef76f0065f0e11aac8", "source_hash": "e3c1a03a67e458cdd68521344c08c1b58140eae2e4fce9842612b9ecc4add6ad", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "2f1370a74d119a9fa46f3ed70f7756c6aacec60da0285c18bb1435e7ad3b8535", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
