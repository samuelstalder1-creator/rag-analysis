{"doc_id": "doc28754", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "In a referendum on 23 June 2016, 51.9% of the participating UK electorate voted to leave the EU, out of a turnout of 72.2%. On 29 March 2017, the UK government invoked Article 50 of the Treaty on the European Union. The UK is thus due to leave the EU at midnight on 30 March 2019 Central European Time (11Â pm on 29 March 2019 GMT).", "reason": "near_duplicate_of_source", "seed": 1163662448, "similarity": 0.9955022488755623, "temperature": 0.3}], "fingerprint": "3cf47940cb0c24dd9919c9d658b859922cc5146e7e7cf06b0feb9a74a412f8db", "generation_attempts": 2, "gold_answer": "23 June 2016", "matched_aliases": ["23 June 2016"], "query_id": "test807", "question_hash": "c771a512a634d19a17c848eab4f3be5e2d2b0f4e3a369866719c896ade72e066", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "09399f4cdfa98bbcb52d9a294a23e997bf3d630f14903a1217c9d8eb1bd1bbd6", "scope": "all_answer_documents", "seed": 1142838707, "similarity": 0.37552155771905427, "source_content_hash": "6201498d313c4639a4ff344b3265cfa9c4b6fac838681439674314ea0896861e", "source_hash": "de0e1c460433f38f5f7cd1bc047d0678e19929f732fb0cf22fd221114b5465bd", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "b9feb8658f35a384cdb09dcc350037f0d95fe3bc9d2e8d1ca00c3629e6f06e6b", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
