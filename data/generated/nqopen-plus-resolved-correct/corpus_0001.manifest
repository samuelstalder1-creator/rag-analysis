{"doc_id": "doc47560", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The quasi-biographical film examines the life and legacy of Charles Foster Kane, played by Welles, a character based in part upon the American newspaper magnate William Randolph Hearst, Chicago tycoons Samuel Insull and Harold McCormick, and aspects of Welles's own life. Upon its release, Hearst prohibited mention of the film in any of his newspapers.", "reason": "near_duplicate_of_source", "seed": 78153840, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "8a6305e6e2cca8e0638562a6d5f1d1fde37e0b2b754b5822539907518d20bc3a", "generation_attempts": 2, "gold_answer": "William Randolph Hearst", "matched_aliases": ["William Randolph Hearst"], "query_id": "test1347", "question_hash": "e3437c3bc1cfa2ffcb43175751a06d61be607f7ff0a9a7594b7a437094c25e6c", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "67b735d4c26ea35f3143d119051f4b998366b4aaa53f59c8eaa643f4dd770e19", "scope": "all_answer_documents", "seed": 2091109522, "similarity": 0.19306184012066366, "source_content_hash": "a271d12415c5ccb730d753bd452d246af896755dd5a3b9ff8aad2a067ed8973a", "source_hash": "3dee64a7cb0ffd6e23d5382bdb765689b1e1001a32db87c07515683a32492750", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "6c69deccef136cf2529c6dcebe7929122ab6f022760e0685c5e01e9ecbf638bf", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
