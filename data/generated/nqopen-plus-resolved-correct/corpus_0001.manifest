{"doc_id": "doc110708", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Beyond the Sea is a 2004 American musical drama film based on the life of singer/actor Bobby Darin. Starring in the lead role and using his own singing voice for the musical numbers, Kevin Spacey co-wrote, directed, and co-produced the film, which takes its title from Darin's hit version of the song of the same name.", "reason": "near_duplicate_of_source", "seed": 158173512, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "73f023c83cc7c173980e931f577a6ef0c366ee3c27c8316e750cc54d8a13d936", "generation_attempts": 2, "gold_answer": "Kevin Spacey", "matched_aliases": ["Kevin Spacey"], "query_id": "test3234", "question_hash": "c053e050897f5078310322ef91ae8a1580a840804d8313d7283d9231202c7574", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "f5edcc159e06bc74b9df0879bbfbedb15e0c330c9fa2cb631b4531817dc4fd9d", "scope": "all_answer_documents", "seed": 2118018474, "similarity": 0.29607250755287007, "source_content_hash": "a19fbcdc0926e84501fc41571ae472ed6bfa752467b499530a448beda490e2a7", "source_hash": "162edc7ba17e0e9e8a56adb25e1ad11c980223c7a6287ef66a173173cfccfdd1", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "d641ca23c32cf9c133ad53e2c6c3af14415a2f85909ca65bc4689760310e8d0e", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
