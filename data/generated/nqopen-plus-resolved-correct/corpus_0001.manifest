{"doc_id": "doc107274", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "We're Going on a Bear Hunt is a 1989 children's picture book written by Michael Rosen and illustrated by Helen Oxenbury. It has won numerous awards and was the subject of a Guinness World Record for \"Largest Reading Lesson\" with a book-reading attended by 1,500 children, and an additional 30,000 listeners online, in 2014.", "reason": "near_duplicate_of_source", "seed": 199601906, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "e763d73422cb5870a78d5919e482eca2cfdfdf812f51608ff592e730ed62ec1a", "generation_attempts": 2, "gold_answer": "Michael Rosen", "matched_aliases": ["Michael Rosen"], "query_id": "test3142", "question_hash": "1cf1c92a2454f0bed81e8c0b33a002782dd283c38d21d02dc5f9b040ec724005", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "52b55a43e58a925abfbb3822573a3ac4cd9fd4ff964f297b029121054e9b672b", "scope": "all_answer_documents", "seed": 130731835, "similarity": 0.4140786749482402, "source_content_hash": "3d390a7543f564451f8b7b4ffefc2126e437560702848dc3206b21c3fac46115", "source_hash": "5eea81103ad741ee05ed460be48a11ddd6dda85598b2c8793ecc5fb54468f0b3", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "478c39e8a2babd5351adc1e80d07e2128f9ffc5cfd817df21edc4c01220dd40b", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
