{"doc_id": "doc62606", "receipt": {"answer_in_original_body": false, "failed_attempts": [{"attempt": 1, "generated_text": "In recent years, McCallum has gained renewed international recognition and popularity for his role as NCIS medical examiner Dr. Donald \"Ducky\" Mallard in the American television series NCIS.", "reason": "missing_gold_answer", "seed": 1798161468, "similarity": null, "temperature": 0.3}], "fingerprint": "0322b2c71fea933f22874466cb2e5819474747e66452125db1d1480abc789697", "generation_attempts": 2, "gold_answer": "David McCallum", "matched_aliases": ["David McCallum"], "query_id": "test1776", "question_hash": "b7f342c0899248127323eb49122201267bc5f45c44f37325c7fb00bb0f1828eb", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "bfeac2b6a5980803e04587e56a8ed2ecba64bf64b67b434049ccc0c13f4fe352", "scope": "all_answer_documents", "seed": 441741482, "similarity": 0.24691358024691357, "source_content_hash": "dec570f920caeadd78ea055c3b7eee5ff38c86360b8bd08d891b51ca15074a23", "source_hash": "0e0df896d47a4803f61b069b03c8bdd7e7547320d2ac0129138f2a78060c3ff2", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "2e538f2c767c6579ee4c71eb9db94f493dfcae7989afcc5eca894881a36cfa43", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc62759", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"A Change Is Gonna Come\" is a song by American recording artist Sam Cooke, released on December 22, 1964, by RCA Victor. Produced by Hugo & Luigi and arranged and conducted by René Hall, the song was the B-side to \"Shake\".", "reason": "near_duplicate_of_source", "seed": 379301329, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "c4136c790880fe6d0fb562646eee8cb5071afad0d3b22c263cf5ff02ef31cac4", "generation_attempts": 2, "gold_answer": "Hugo & Luigi", "matched_aliases": ["Hugo & Luigi"], "query_id": "test1779", "question_hash": "0c6e6f9e733881b77f63c1f3ec5ba80d7d0b375764a9347f1600ff14e7867870", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "e89e698bb246fc70d50869c54f750baaa32c0219f7596a38f7f673762ae09c42", "scope": "all_answer_documents", "seed": 1473390656, "similarity": 0.5963060686015831, "source_content_hash": "b804faceadc800969d2992c70f6285f17dd041484dbe5c9ac1699f6b00687f78", "source_hash": "6f24a5f239e20092a4bc23cc0b6ac38fe5f7f0c5de04ad644620a78f78c6f48c", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "1bcdf1d6a01eda75cc97e6d998bfb803b6d99a1a8c8b5b8980af0ef06d42503f", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc62895", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"Knockin' on Heaven's Door\" is a song written and sung by Bob Dylan, for the soundtrack of the 1973 film Pat Garrett and Billy the Kid. Released as a single, it reached No. 12 on the Billboard Hot 100 singles chart. Described by Dylan biographer Clinton Heylin as \"an exercise in splendid simplicity\",[1] the song, in terms of the number of other artists who have covered it, is one of Dylan's most popular post-1960s compositions.", "reason": "near_duplicate_of_source", "seed": 1378257259, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "20f2710d935de831a0480d86ce06bd6229a4d4e94578bfa60ccc8b821a3ee665", "generation_attempts": 2, "gold_answer": "Bob Dylan", "matched_aliases": ["Bob Dylan"], "query_id": "test1782", "question_hash": "88203bdcc0108ea2842b65ef01575ce74959838155276d0d3c6a9c92b5b46f96", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "541f1062e5fecd1a2de95886c89903b2448f9b231f57d7405ff3113e70910223", "scope": "all_answer_documents", "seed": 352089510, "similarity": 0.21205357142857142, "source_content_hash": "89e5f59da791d6da705ca0d2781f7cef04630a381e19f4afcf2a7c105f6b84f9", "source_hash": "87ee16fee1c50f21048e1756c1e215c1af7cb0bffd9886045e4ff4a9b6034c0b", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "7235fb6d89ebe01cf04acd3c7b3ea4245705eb3c0e2aecb2c2b816254dacd834", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
