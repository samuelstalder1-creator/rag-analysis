{"doc_id": "doc24282", "receipt": {"answer_in_original_body": true, "failed_attempts": [], "fingerprint": "7818b03dcb665f18808be3f4e167dc8327332fab75d210d82c91881c378e2c3d", "generation_attempts": 1, "gold_answer": "Carol Ann Susi", "matched_aliases": ["Carol Ann Susi"], "query_id": "test679", "question_hash": "b20ed804197e31486dd070b5be06348342d59102b9bebe95e6fa1018a03b1a14", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "065f42bd93967cedc4c9e4a2912ce1a2af5a8724554dfeb102b18a1deac6b170", "scope": "all_answer_documents", "seed": 373717029, "similarity": 0.9114470842332614, "source_content_hash": "8e8716b13d282ca6eb0c6b80e5d7c2efdba83deaf4d585f415437c924bd6569c", "source_hash": "340d5b04df3b03135730bb3a452d8da736e03b9ad910cc40841d8df2656527b3", "target_answer": null, "temperature": 0.3, "validation": {"answerability_verified": false, "evidence_hash": "f5356e7a8bc122391dc64c03a30209a8b116452a87bccccda1e97158552ea6ae", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc24302", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Beast is not of any one species of animal, but a chimera (a mixture of several animals), who would probably be classified as a carnivore overall. He has the head structure and horns of a buffalo, the arms and body of a bear, the eyebrows of a gorilla, the jaws, teeth, and mane of a lion, the tusks of a wild boar and the legs and tail of a wolf. He also bears resemblance to mythical monsters like the Minotaur or a werewolf. He also has blue eyes, the one physical feature that does not change whether he is a beast or a human.", "reason": "near_duplicate_of_source", "seed": 1814633883, "similarity": 1.0, "temperature": 0.3}, {"attempt": 2, "generated_text": "The Beast from Beauty and the Beast is not a single species but a unique chimera, a creature composed of various animals. He physically resembles a carnivore, possessing the head structure and horns of a buffalo, the arms and body of a bear, the eyebrows and mane of a gorilla, and the tusks and legs of a wolf. Additionally, he features the jaws, teeth, and blue eyes of a lion. Although he bears resemblance to mythical monsters like the Minotaur or a werewolf, his most distinct trait is his blue eyes, which remain unchanged whether he is in beast or human form.", "reason": "missing_gold_answer", "seed": 825552957, "similarity": null, "temperature": 0.5}], "fingerprint": "f0e863cf955ad227e380cb59a1a47cf397cf7b837b63431dc8809c630fe18fcb", "generation_attempts": 3, "gold_answer": "a chimera", "matched_aliases": ["a chimera"], "query_id": "test681", "question_hash": "efd01a738ede9c6be18aeed2c54ae15b8e33d3c29355c7b8d112897cf8d25a31", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "e478eee2f0d524178926fe7c77100ac57d02c109e848c42482296059e01cefd4", "scope": "all_answer_documents", "seed": 1456093651, "similarity": 0.043557168784029036, "source_content_hash": "9c3877ad839e6a1becca2741577f628dcc2d15f219fffd3086b2965b11c3aabb", "source_hash": "02f03cbff9c0481f6e3dc3ca6ef289785b122c6bad79d1600f0aad74dfaee61a", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "68d01e71bd50739505c969d07d05bd712e1060f7c845a8d4c5e4fc6b924bf7d6", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc24420", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "A touchdown is worth six points. The scoring team is also awarded the opportunity for an extra point or a two-point conversion.[2] Afterwards, the team that scored the touchdown kicks off to the opposing team, if there is any time left.", "reason": "near_duplicate_of_source", "seed": 1034085083, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "55a7a7bf3a342bea563925ba10afb12cde780a9e325057a692e578780a1c42e7", "generation_attempts": 2, "gold_answer": "six", "matched_aliases": ["six", "six points"], "query_id": "test685", "question_hash": "93a7bf1d5bd95058b749cabc4a07eaf7d200dcdbd8786d02e578dd06c83824c0", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "01c6b54ce288737ef853f8991e80e1345cfa1ee75246ce6ee3f9682f60a08355", "scope": "all_answer_documents", "seed": 1599734399, "similarity": 0.18181818181818182, "source_content_hash": "058811436681b7cb7619925fb91cfbda99c0448b4a757a3f22b997c341ce9092", "source_hash": "30baf0e527fbeb412aab0f2130b38ba274c14ab1685a3ba88d179dfbbf7bc4fb", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "bfd811634bbecb319d587d66883598e0528c52400a1e0fe313240433b3fbd924", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc24427", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "A further distancing between the concepts of \"Tridentine Mass\" and \"Latin Mass\" was brought about by the 1964 Instruction on implementing the Constitution on Sacred Liturgy of the Second Vatican Council, which laid down that \"normally the epistle and gospel from the Mass of the day shall be read in the vernacular\". Episcopal conferences were to decide, with the consent of the Holy See, what other parts, if any, of the Mass were to be celebrated in the vernacular.[4] Permissions were thus granted from 1967 onwards to celebrate most of the Tridentine Mass in vernacular languages, including the Canon.", "reason": "near_duplicate_of_source", "seed": 133381850, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "9680c9d51e1021480ccc8d48e249e8d3bf9dbb95aee776fb8d01af7c21b3e48b", "generation_attempts": 2, "gold_answer": "from 1967 onwards", "matched_aliases": ["from 1967 onwards", "1967"], "query_id": "test686", "question_hash": "afbd5ee1d8648440cb0d19dae6f2142c074b9fd1816e3b8ca709ad6d568d1ed0", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "f0adc3801c2e14a1f4e760a3995165e3e55f1f6c618d45a7f3e1cd769f93a3ad", "scope": "all_answer_documents", "seed": 1030082525, "similarity": 0.4704724409448819, "source_content_hash": "3d80c1aec832383706af94cb3e6f8d57e81150f0b8f5243cd976c16af695c8a8", "source_hash": "20c56a96d60daab297d8e4edc2d82d733ee7037b54a744835cc933197b149e13", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "9167809ddb7732982a0a9a19400a9c13d9d9680012ff87a8f2bacc81cc7b47bb", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02b