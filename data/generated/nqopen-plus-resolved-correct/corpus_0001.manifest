{"doc_id": "doc102098", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Hot Coffee is a normally inaccessible mini-game in the 2004 video game Grand Theft Auto: San Andreas, developed by Rockstar North. Public awareness of the existence of the mini-game arrived with the release of the Hot Coffee mod, created for the Microsoft Windows port of GTA: San Andreas in 2005. This mod enables access to the mini-game.", "reason": "near_duplicate_of_source", "seed": 1882034123, "similarity": 1.0, "temperature": 0.3}, {"attempt": 2, "generated_text": "The Hot Coffee mod serves as an entry point to a feature that is normally inaccessible within the 2004 video game Grand Theft Auto: San Andreas. This specific mini-game, developed by Rockstar North, became publicly known following its inclusion in the Microsoft Windows port released in 2005.", "reason": "missing_gold_answer", "seed": 539875133, "similarity": null, "temperature": 0.5}], "fingerprint": "1a61618679bfb7dff403c005155562e7f16bd42b65f8abf92573ea05c78ac96f", "generation_attempts": 3, "gold_answer": "a normally inaccessible mini-game", "matched_aliases": ["a normally inaccessible mini-game"], "query_id": "test2975", "question_hash": "417c0a9c9643e2133999c92092e15656df1bb41ce2410f95c343aeeca2b77d77", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "bca301b52c996d3043daece69322a88ace45f33fcd84f74c210c65912d7465a0", "scope": "all_answer_documents", "seed": 1945756895, "similarity": 0.4698205546492659, "source_content_hash": "17283c55f3b64729362aac60dc17f54dd3f29514c6c5104446bd51ff74ead300", "source_hash": "0918c1056756f481d63a6a90349da60fbbc3ce15c05222ca7e0d528244817e03", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "07172a7eff796c01d6be68c4a488facbc69749e7ef746a9dd9e5ea4603869b7a", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode