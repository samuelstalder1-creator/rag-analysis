{"doc_id": "doc46266", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Driving or hiking to the summit of Cadillac Mountain to see \"the nation's first sunrise\" is a popular activity among visitors of Acadia National Park. However, Cadillac only sees the first sunrise in the fall and winter, when the sun rises south of due east. During most of the spring and summer, the sun rises first on Mars Hill, 150 miles (240 km) to the northeast. For a few weeks around the equinoxes, the sun rises first at West Quoddy Head in Lubec, Maine.", "reason": "near_duplicate_of_source", "seed": 722290048, "similarity": 0.9935344827586207, "temperature": 0.3}], "fingerprint": "1baa6f9db1e44e5740fc8845b950fd484a190e85c9dc1b88c0213ac5131f2552", "generation_attempts": 2, "gold_answer": "the summit of Cadillac Mountain", "matched_aliases": ["the summit of Cadillac Mountain"], "query_id": "test1305", "question_hash": "8e467f43c7b1b01696db3ec61d083c5eb13ef2a858cedc2acf54cf7775fe2732", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "17539a302e7e719b5cdc63d5c1e6c29526554eba279e60e48382f7b402e58cd5", "scope": "all_answer_documents", "seed": 1372863430, "similarity": 0.06768558951965066, "source_content_hash": "4c02fe78c05ea976159be8730cb4221e7f01d49f1a10815e804cd1145a1924df", "source_hash": "b339087cbb6ee168d21731b1c850bcf22d0ee62639bff98479c8d5d6b1bfb8fe", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "e553addff279cd0ae174a65feef2ab5195fd9cfd8826809e4deeb57d39c92a66", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc46317", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The flag of Hungary (Hungarian: Magyarország zászlaja) is a horizontal tricolour of red, white and green. In this exact form, it has been the official flag of Hungary since May 23, 1957. The flag's form originates from national republican movements of the 18th and 19th centuries, while its colours are from the Middle Ages. The current Hungarian tricolour flag is the same as the republican movement flag of the United Kingdom (used since 1816).", "reason": "near_duplicate_of_source", "seed": 922985264, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "73933df109af6de9ce4a083c5c6fcd926b410b4b7d70476c209fbb6b57d49bdc", "generation_attempts": 2, "gold_answer": "Hungary", "matched_aliases": ["Hungary"], "query_id": "test1307", "question_hash": "b3e2f2cc1593bdef8e91620b95b221d0849140dcfb53754b39c1ea04ab8b0db7", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "5579a4be1abf71d677af7243002a4482350b4fde216bb86f627a55bba9c768a7", "scope": "all_answer_documents", "seed": 564432123, "similarity": 0.40981856990394877, "source_content_hash": "d80aba991da15cc9a639149a3ef0c193b45e4930b1ae9c0d95ab14bdad3d7931", "source_hash": "193f65b0a25976f213bf80897a19296da11216b3ed43a36eabe52880a24acf88", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "8b4435a717b9918f93d5c4f949ae4d55ceb365c020f153bc48b7d854f6890aed", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
