{"doc_id": "doc108246", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "In the developing fetus, the ductus arteriosus, also called the ductus Botalli, is a blood vessel connecting the main pulmonary artery to the proximal descending aorta. It allows most of the blood from the right ventricle to bypass the fetus's fluid-filled non-functioning lungs. Upon closure at birth, it becomes the ligamentum arteriosum. There are two other fetal shunts, the ductus venosus and the foramen ovale.", "reason": "near_duplicate_of_source", "seed": 368909663, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "d4a22da4b1de0c5fbc3400c71c38a2918865196fdab5761d24c7ec93694c653c", "generation_attempts": 2, "gold_answer": "at birth", "matched_aliases": ["at birth", "birth"], "query_id": "test3172", "question_hash": "46379d1fec9b4213529d61197bd4f3ee29d21b9183ede66064abfa7eed81f7b9", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "7eaad4c80880ef8f0d5953a778cc704eb86bbfd502e7460994c334b1f577049d", "scope": "all_answer_documents", "seed": 2061218920, "similarity": 0.6426155580608793, "source_content_hash": "11507da37984c1dec3b2d919c6e117aa0f8fcf791dd23c6644d4621b58acec39", "source_hash": "63433e858dfc7e940b09c91db61ac19bf8f5f1c73fd5c60f9a612381c5b7f9f6", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "bf25db3ce624b046045053e42732be97c624f0b0ad25e8361a27da07e3ee1123", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc108253", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "David Gahan (/ɡɑːn/; born David Callcott; 9 May 1962) is an English singer-songwriter, best known as the baritone lead singer of the electronic band Depeche Mode since their debut in 1980. He is also a successful solo artist, releasing albums in 2003 (Paper Monsters) and 2007 (Hourglass).", "reason": "near_duplicate_of_source", "seed": 932778451, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "d98e517a900aad00b628d89e44699503eac9519cbc9ce5440dc962ca77c23181", "generation_attempts": 2, "gold_answer": "David Gahan", "matched_aliases": ["David Gahan"], "query_id": "test3173", "question_hash": "75831037338fee359177368fc4690eb8b9606f6e554b978df0958c776fc18638", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "cf46db1618013b67e0628996431a3f564c1da3b22934f01bac641943698d9d46", "scope": "all_answer_documents", "seed": 2086908870, "similarity": 0.5263157894736842, "source_content_hash": "6486c2e7925ef2d7180a525083a5ac9e230b33ff87caccd0d8c9921730784498", "source_hash": "06c60af90e226e43d75151ba40b4d2328bf3774dac5e416adac43f6c05c98c80", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "97514c3fd4948e3b018a6c98341f7507f70f45664ccd9c24b2690e82d95ebb4d", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
