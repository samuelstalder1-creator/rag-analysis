{"doc_id": "doc105407", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "A Walk to Remember is a novel by American writer Nicholas Sparks, released in October 1999. The novel, set in 1958–1959 in Beaufort, North Carolina, is a story of two teenagers who fall in love with each other despite the disparity of their personalities. A Walk to Remember is adapted in the film of the same name.", "reason": "near_duplicate_of_source", "seed": 2100439109, "similarity": 0.9936708860759493, "temperature": 0.3}], "fingerprint": "a12da97ed9ed63925ef4ec26cf87e4288372889c81a4e94a86032936b1954020", "generation_attempts": 2, "gold_answer": "American writer Nicholas Sparks", "matched_aliases": ["American writer Nicholas Sparks", "Nicholas Sparks"], "query_id": "test3084", "question_hash": "66101aecf291d7fc94fd76a9e7a175cea1312f9edec6cc07aef3108fd9a0ca0c", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "5684f8d98a286293bd77695369d873b2b3ffc5bd63d1cf8c082a128ba388c02d", "scope": "all_answer_documents", "seed": 1331941988, "similarity": 0.3448275862068966, "source_content_hash": "748e4921b1e7bb48aa4348675749469767b815eae6ebaab11d9caf3eb93dc2dd", "source_hash": "70f27e4cc9659fc598185b4dd0a93927e9c6d83c7e9c0aac0c9cd23d8105de54", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "f977c24066bb92fb82b890f944b27e08ea8c9d2d7a2af89862a56c148ad29e2e", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
