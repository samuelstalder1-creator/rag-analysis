{"doc_id": "doc78331", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "According to Indian folklore, Delhi was the site of the magnificent and opulent Indraprastha, capital of the Pandavas in the Indian epic Mahabharata, founded around 3500 BC. It was, one of the five prasthas or `plains', which included Sonepat, Panipat, Tilpat (near Faridabad), and Baghpat.[15] 16th-century, Persian historian, Firishta, recorded a tradition that Delhi or Dilli was founded by a Raja Dhilu before the Yavana (Greek) invasions. However, it should be noted that the kings then referred to the initial Muslim invaders as Yavanas.[15]", "reason": "near_duplicate_of_source", "seed": 1899156367, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "1681cd1f69993ffa6cd43b47a60ff5921c740cfb620ba89c71e864a5ed6aa8d2", "generation_attempts": 2, "gold_answer": "the Pandavas", "matched_aliases": ["the Pandavas"], "query_id": "test2260", "question_hash": "7daa4efa5a096719a1dfce0e067a5dbcc3b9986aea2dbb47db4b105506b4e58e", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "6bf48b6c46fac2d9ac07d3ef660467e25eee4714f9364a2ca0522024982b382c", "scope": "all_answer_documents", "seed": 132595367, "similarity": 0.36495031616982837, "source_content_hash": "fbe5ce8b139e92cd867e61af29ad1d308ca246ce2b215e689855d32da559d0a9", "source_hash": "3f57caabe215b7687f838b5277f323c9b2c93251e45b5dade146250d9e6f731f", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "f2aac4f214fc0f0d388b66e32948473b326bd816091fb4c728901b78cb687b6c", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"},