{"doc_id": "doc136", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"Can't Help Falling in Love\" is a pop ballad originally recorded by American singer Elvis Presley and published by Gladys Music, Presley's publishing company. It was written by Hugo Peretti, Luigi Creatore, and George David Weiss.[2] The melody is based on \"Plaisir d'amour\",[4] a popular romance by Jean-Paul-Égide Martini (1784). The song was featured in Presley's 1961 film, Blue Hawaii. During the following four decades, it was recorded by numerous other artists, including Tom Smothers, Swedish pop group A-Teens, and the British reggae group UB40, whose 1993 version topped the U.S. and UK charts.", "reason": "near_duplicate_of_source", "seed": 1589498756, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "bc915783d7ab505abc899efaf3c45d1bc4072ad03ab8d94b0ff1f3e85979ef5b", "generation_attempts": 2, "gold_answer": "Elvis Presley", "matched_aliases": ["Elvis Presley"], "query_id": "test11", "question_hash": "5de42e397a533f9c8b6a9683a6e84557cd96d2e998260285cf46e34ad325579a", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "d90badae7b63f220bf438e0fd4a5514b2ef4ca03e192fa3cba6c29872e8c5a2f", "scope": "all_answer_documents", "seed": 1495889480, "similarity": 0.6490939044481054, "source_content_hash": "8a1b87dd12eebc5fd5064227e3176df69b8acac715d24578655caa24ae09d8b8", "source_hash": "3573a1f575e92c9574e94d3e9632e84ac795432b9785e7446c5688c0038ccad5", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "d425c471617b2031712efb3fc36cc5337adb085d9871a542612b87718d5d269a", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9