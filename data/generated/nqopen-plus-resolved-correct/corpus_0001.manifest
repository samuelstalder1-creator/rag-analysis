{"doc_id": "doc56305", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Dollree Mapp was an employee in the illegal gambling rackets dominated by Cleveland rackets kingpin Shon Birns. On May 23, 1957, police officers in Cleveland, Ohio, received an anonymous tip by phone that Virgil Ogletree, a numbers operator who was wanted for questioning in the bombing of rival numbers racketeer and future boxing promoter Don King's home three days earlier, might be found at Mapp's house, as well as illegal betting slips and equipment employed in the \"California Gold\" numbers operation set up by Mapp's boyfriend Edward Keeling.[1] Three officers went to the home and asked for permission to enter, but Mapp, after consulting her lawyer by telephone, refused to admit them without a search warrant. Two officers left, and one remained, watching the house from across the street.", "reason": "near_duplicate_of_source", "seed": 1399129251, "similarity": 1.0, "temperature": 0.3}, {"attempt": 2, "generated_text": "Dollree Mapp was an employee in the illegal gambling rackets dominated by Cleveland rackets kingpin Shon Birns. On May 23, 1957, police officers in Cleveland, Ohio, received an anonymous tip by phone that Virgil Ogletree, a numbers operator who was wanted for questioning in the bombing of rival numbers racketeer and future boxing promoter Don King's home three days earlier, might be found at Mapp's house, as well as illegal betting slips and equipment employed in the \"California Gold\" numbers operation set up by Mapp's boyfriend Edward Keeling.[1] Three officers went to the home and asked for permission to enter, but Mapp, after consulting her lawyer by telephone, refused to admit them without a search warrant. Two officers left, and one remained, watching the house from across the street.", "reason": "near_duplicate_of_source", "seed": 1599627768, "similarity": 1.0, "temperature": 0.5}], "fingerprint": "6783b9bf03f1faf9cf62554d37ff37ee05d0f05784f7dba811fc74271a2a9444", "generation_attempts": 3, "gold_answer": "Dollree Mapp", "matched_aliases": ["Dollree Mapp"], "query_id": "test1582", "question_hash": "940392064225d3b5cab30298e385eee85f59674fe833fd17e8a41f60cec8f263", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "6a393f0fd7d3c2c699e604b5b698956934f48574c963df93037b6560750e034c", "scope": "all_answer_documents", "seed": 964494946, "similarity": 0.07864302235929067, "source_content_hash": "a558bf2ee379b208d5bc3895846d916eddc57e0d7b7dcf219575f71c7aab6e16", "source_hash": "3995778f7038cfcedb5dbdc34d83ed8ce611233f9c91405d65dc57a2487415f5", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "c033ca582f9a6dfca200d821823b2363a8fe99178b0ba04594f3d30011d27488", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
