{"doc_id": "doc117680", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The rivalry includes several notable games, such as the 1966 game, arguably one of the greatest college football games ever played. Notre Dame currently leads the series. Games played prior to 1949 also appear on the trophy to commemorate the entire series. Notre Dame is the current holder of the trophy, with a 38–18 victory on September 23, 2017. They will hold the Megaphone Trophy until 2026 when the two teams are scheduled to play again.", "reason": "near_duplicate_of_source", "seed": 1818693015, "similarity": 0.9888392857142857, "temperature": 0.3}], "fingerprint": "d8a59e2fc60cd86a24dd9ed1482afe3f0156c09fba30abb74a466a3f6512e8b3", "generation_attempts": 2, "gold_answer": "2026", "matched_aliases": ["2026"], "query_id": "test3451", "question_hash": "1d58312c595a9784a0d73b153ddb0d52e55c08abd0c95543ba1b4e9e7b358df7", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "880823a744812e0af43a8872832b47d33c7fad552bbaec21ea9f07cca890d6e3", "scope": "all_answer_documents", "seed": 899674132, "similarity": 0.08592592592592592, "source_content_hash": "2f640d2f3f175dd70e1e902b39679e237e81e1824ec2343594d64b75a5a7a70d", "source_hash": "deb3282361c89486e8d91a526e50f4bcd7514fa858893126037579071b6238f3", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "a344de1c3d92ae460a47b5927a4450e8036f41059143313adbabb0f4125bc801", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
