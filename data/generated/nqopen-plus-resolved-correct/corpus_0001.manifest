{"doc_id": "doc95524", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Skat (German pronunciation: [ˈskaːt]) is a 3-player trick-taking card game devised in early 19th-century Germany. Along with Doppelkopf it is the most popular card game in Germany and Silesia.", "reason": "near_duplicate_of_source", "seed": 1073200977, "similarity": 0.9576059850374065, "temperature": 0.3}], "fingerprint": "c79f5c58e4599b23afca19158b783fe682dc6ad6c3705f887bdcddae17433652", "generation_attempts": 2, "gold_answer": "Skat", "matched_aliases": ["Skat"], "query_id": "test2785", "question_hash": "196e8245a220b6efb4baa26407c160511c5d1728152690cb589a734062da6812", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "a72d18d66bd7591314d748820d61491af60e2ed964103a5f19f4df097076686b", "scope": "all_answer_documents", "seed": 1818123080, "similarity": 0.29831932773109243, "source_content_hash": "76bf2b099266885e6859f0d619bad5e1c97da53bd287e79eacfba793a2f28836", "source_hash": "0c06da5c4075ce9f14c65ef04473679d5282dbadca8f4edf887e74f41b7fecc8", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "9ecbf8984edb56e82608f00fb0189953be84c9f1c038e74bc10c95e688ab749e", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
