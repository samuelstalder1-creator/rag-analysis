{"doc_id": "doc57154", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Quebec Winter Carnival, also known as the Carnaval de Québec, is a pre-Lenten festival held in Quebec City. After being held intermittently since 1894, the Carnaval de Québec has been celebrated annually since 1955. That year Bonhomme Carnaval, the mascot of the festival, made his first appearance. Up to one million people attended the Carnaval de Québec in 2006 making it the largest winter festival in the world.", "reason": "near_duplicate_of_source", "seed": 493962886, "similarity": 0.9699879951980792, "temperature": 0.3}], "fingerprint": "88c2c9e1f0a447c60de7f416b2898ff2df97fc976509a08a9129d295323648a8", "generation_attempts": 2, "gold_answer": "Bonhomme Carnaval", "matched_aliases": ["Bonhomme Carnaval"], "query_id": "test1614", "question_hash": "289a9600b72b93f89e4d3f777aff953651d99f3d522ac47406962f5b6e9f546a", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "a6d878ad7a9acd8dfa6f099bdf19e0e421c9896c55b6096143e253296efb7aba", "scope": "all_answer_documents", "seed": 729223864, "similarity": 0.21846553966189858, "source_content_hash": "015e5df956cc47deafbe65681adaf759046c13428f65bab53a2b62024f53af90", "source_hash": "9d68c9251cbb250641b8a58e4b0a85ce29ee7922a8d5cc3743a3063bbb6ed539", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "888b7462ebbb62d30bbc6e98b2fa5fd5afe177f7a647f3d97136fde4bf4f4112", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc57207", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Country Music Hall of Fame and Museum in Nashville, Tennessee, is one of the world's largest museums and research centers dedicated to the preservation and interpretation of American vernacular music. Chartered in 1964, the museum has amassed one of the world's most extensive musical collections.", "reason": "near_duplicate_of_source", "seed": 830173, "similarity": 0.9950413223140496, "temperature": 0.3}], "fingerprint": "46885e1c409cd1fb2db06139921e83cb92cb85804dbbf9ef0fba9f12c4200b80", "generation_attempts": 2, "gold_answer": "Nashville, Tennessee", "matched_aliases": ["Nashville, Tennessee"], "query_id": "test1617", "question_hash": "75e5d155be152ab9893b52e2374a7546a437973d0ca29bc9146954247fb1a92a", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "5ced6d979a4bacde5a885ded134c15ee540848e804e94c7a73933d9521c09221", "scope": "all_answer_documents", "seed": 1460227132, "similarity": 0.3153526970954357, "source_content_hash": "731379478faccf189b18206f3f31b81c58a6b2f1554845fd2340d4df37690828", "source_hash": "8988e6268d44c687431ce558598479d6a9b2eea728759b61bbc1968b27c46b34", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "8a6f688bb3418be5e6ba8fadfaae6b16fa00bad698d9bbcfcc75ffbd298fcb90", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc57263", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The film is based loosely on Eminem's actual upbringing, and follows white rapper B-Rabbit (Eminem) and his attempt to launch a career in a genre dominated by African-Americans. The title is derived from 8 Mile Road, the highway between the predominantly black city of Detroit and Wayne County and the predominantly White Oakland County and Macomb County suburbs. It was filmed mostly on location.", "reason": "near_duplicate_of_source", "seed": 1427081174, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "90d381b1971f482651b330e433b2aa8f4ece878d5ceabe046c9238f7c1142e4a", "generation_attempts": 2, "gold_answer": "loosely on Eminem", "matched_aliases": ["loosely on Eminem"], "query_id": "test1619", "question_hash": "316e73dc8b16f186f79826bf1811c8bcfe33ea4c61837e4888aecc2c5c74d7ca", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "4cbf6aa1ddd5f5f2fff30684444a1fc7b9536f290bb3ffaab342c7fb26a99e09", "scope": "all_answer_documents", "seed": 640410524, "similarity": 0.9211195928753181, "source_content_hash": "2c11fc7465dad70e61494bc0df04a0acf58a4e18d5a48de09d10b7f09b939eb4", "source_hash": "a8fe6aa010825ae67a32cf3d150fb66875f18b5740218fadef54fd0e4ec7df92", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "9e416c96a3ae822d54cbd647be12878e43486a70231a834ecbddbd3bc54dfe9b", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc57669", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"Bad Boys\" is a 1987 song by the Jamaican reggae band Inner Circle, which obtained high popularity in the United States after its re-release in 1993, peaking at number 8 on the Billboard Hot 100 and number 7 on the Top 40 Mainstream.[1] It is well known as the opening theme to the U.S. TV show Cops.", "reason": "near_duplicate_of_source", "seed": 485399857, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "c5d84fb5aa516acf324b7887e79ee68e175d604ac46123d8a2ff5fea1755a204", "generation_attempts": 2, "gold_answer": "Inner Circle", "matched_aliases": ["Inner Circle", "Jamaican reggae band Inner Circle"], "query_id": "test1623", "question_hash": "e7c134f59ab4b83c9beafa0f1f5f6a051aa403a5d15afd3c5dd934de6cf70e63", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "2847e73c4e51a5d16c6a84d7ae91b83d8c08620f8b3a9126964fb6498155fe45", "scope": "all_answer_documents", "seed": 548609384, "similarity": 0.5227606461086637, "source_content_hash": "f0b1f6b888714c6a626c4f4eacc6f9223741870c5ed7c9bf84ff4d6e46ff4682", "source_hash": "7137a311d1dd93dc717480aa07bc1fdc75e9f1c65274885a9d62b16acafb0285", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "39f4acd00ebc45a98f159bab4bb92a65912f60c9368d893b8ff99ee9220e015c", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc57903", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Regina Spektor wrote and recorded the main title theme song, \"You've Got Time,\" for the Netflix Original series Orange Is the New Black, which premiered in July 2013. It was nominated in the Best Song Written for Visual Media category at the 56th Annual Grammy Awards.", "reason": "near_duplicate_of_source", "seed": 243732292, "similarity": 0.9683426443202979, "temperature": 0.3}], "fingerprint": "22dca72fc1e7f82a77cc8d6e10ddff7c003c0544c5ae37362f65c83a949c6fc3", "generation_attempts": 2, "gold_answer": "Spektor", "matched_aliases": ["Spektor"], "query_id": "test1629", "question_hash": "016d841a79eb6996869ce667ca81d796b4b531834af5d7f4187b005bdcbdcf5d", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "3d39d4ace58842739cd70be3c39290fee61afd02abc4c7dce874c80528d7f0ac", "scope": "all_answer_documents", "seed": 624203854, "similarity": 0.6917808219178082, "source_content_hash": "193f83913532e0a1dbbb13d4dad6a1b8ad94c2f79cbcd2bc1e1955198afd4943", "source_hash": "3b0ccb138cf0f2b8d1cf87d306d27fe6ba81f3eca606ee5c56721a0458fc2b2b", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "4cbce03ae911ec0f0dfb93f4d09b776de7da2c7f859d287e137d8a7c0e1f9154", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
