{"doc_id": "doc66934", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"Put Your Hand in the Hand\" is a gospel pop song composed by Gene MacLellan and first recorded by Canadian singer Anne Murray from her third studio album Honey, Wheat and Laughter.", "reason": "near_duplicate_of_source", "seed": 2077303141, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "254debd65b7b6f1c00d96da6484f82de482f3c4240b8e747b6bf2338a1bf4114", "generation_attempts": 2, "gold_answer": "Gene MacLellan", "matched_aliases": ["Gene MacLellan"], "query_id": "test1910", "question_hash": "0a02e66ee7be99820031fc6ab16624183c6f722167d5d0cfecc416f1d5dc97dd", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "c4e950cce68c3bd46abc494f1a4c42612313c2cba802c4c5b4996ad0c1338dc8", "scope": "all_answer_documents", "seed": 2050459018, "similarity": 0.8825214899713467, "source_content_hash": "55898b9190ad147141b58dc1e41eaea16cd59ba447505ecef8d19bc5ecf62b34", "source_hash": "6ee9833002d59ef75763850504390659efc655b910e31f638a7a8088560cbb08", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "7b296e11ff156a079567d075d6495fa5abd3b737ce5991014b1993d094d44d76", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc66958", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "In early March 1971, approximately ~300 Biharis were slaughtered in rioting by Bengali mobs in Chittagong alone. The Government of Pakistan used the \"Bihari massacre\" to justify its deployment of the military in East Pakistan on 25 March when it initiated its military crackdown. President Yahya Khan then called on the military, which was overwhelming led by West Pakistanis, to suppress dissent in the East after accepting the resignation of Lieutenant-General Yaqub Ali Khan, the chief of staff of the East-Pakistani military.", "reason": "near_duplicate_of_source", "seed": 1464125443, "similarity": 0.9841860465116279, "temperature": 0.3}], "fingerprint": "2236960917ee30cb52403eae131d712483635c1786afc072887ef5c9afbfac8e", "generation_attempts": 2, "gold_answer": "President Yahya Khan", "matched_aliases": ["President Yahya Khan", "Yahya Khan"], "query_id": "test1911", "question_hash": "c698fcbc49552604559f07b2b4564ba7c1c2cf8fdab390a437230ebda1cdfb83", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "cbb65d0e78e6f9c6cc678f401dd1b71a9c3cdd99437cffc1f36b36777c6cb155", "scope": "all_answer_documents", "seed": 1351782495, "similarity": 0.20512820512820512, "source_content_hash": "772842376d9f33260233822371013c02814681d4d3b7e09480154c34749a59b8", "source_hash": "68b573e467688a7dba553083e2c28150ef521fde8f6b73e26544c66762c8014d", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "0a317597ca2429526b06ddc152d0e649fef27664aed97bd5453726f9661494ab", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550