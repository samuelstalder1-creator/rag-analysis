{"doc_id": "doc41757", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Following its commercial introduction by businessman Elijah Bond on July 1, 1890, the ouija board was regarded as a parlor game unrelated to the occult until American spiritualist Pearl Curran popularized its use as a divining tool during World War I. Spiritualists believed that the dead were able to contact the living and reportedly used a talking board very similar to a modern ouija board at their camps in Ohio in 1886 to ostensibly enable faster communication with spirits.", "reason": "near_duplicate_of_source", "seed": 1835386221, "similarity": 0.9907120743034056, "temperature": 0.3}], "fingerprint": "13b135255bfdbd3ece034a9a9292c2b7bab0a9e8050bef93f8c68abc2c7ecc61", "generation_attempts": 2, "gold_answer": "July 1, 1890", "matched_aliases": ["July 1, 1890"], "query_id": "test1178", "question_hash": "b12a564966330a831e2fe624a2219923b33183e944a7cd7b0beaffda89ba8a14", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "b3867fef80d821c59931c7819da103dea1b04b09fb74daa63b472385b6f46208", "scope": "all_answer_documents", "seed": 90550766, "similarity": 0.2153163152053274, "source_content_hash": "b0af86b65a50fc4c3cb9ddb1fb8b5da07671cb4b5e86e4e1bbec053157e226ee", "source_hash": "004f12ee650cf93ca8e7864f4be0b5d41746e08236d46169f027ef44c101a7a5", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "b00c57aaa610b3e99904aa33507f7eec3497e2cb41654c12eb23d871c089f049", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
