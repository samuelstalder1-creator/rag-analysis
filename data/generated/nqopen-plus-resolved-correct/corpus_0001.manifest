{"doc_id": "doc75550", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Reconstruction of the temple under Herod began with a massive expansion of the Temple Mount. Religious worship and temple rituals continued during the construction process. When the Roman emperor Caligula planned to place his own statue inside the temple, Herod's grandson Agrippa I was able to intervene and convince him against this.", "reason": "near_duplicate_of_source", "seed": 1177671984, "similarity": 0.9940652818991098, "temperature": 0.3}], "fingerprint": "35338ade92f5a70077940803a774e13a1659db2df00a35c4c361860d90881350", "generation_attempts": 2, "gold_answer": "Herod", "matched_aliases": ["Herod"], "query_id": "test2162", "question_hash": "ea2f8bfa5c086302801f0d29137577594fc1bc435aa8220bd963041fee25a35f", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "1d7b154ba4125f68d0edb970cd44b0abc8e355f06a52d6dd2860d81663724be2", "scope": "all_answer_documents", "seed": 1767488849, "similarity": 0.05361930294906166, "source_content_hash": "fe39290d0da1d02a1ca87787c0d85f3fdc00fedbde0bb22ee58c3ce422010a6c", "source_hash": "26e148e3a4a7a46a4e68c0a1b81aefa59446410558cced8d12173c25cb897867", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "206827a05e339432117f29fe5420b7d7ff8492f15f8a7b54e001e2982b47b949", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc75584", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Nathan Hale (June 6, 1755 – September 22, 1776) was an American soldier and spy for the Continental Army during the American Revolutionary War. He volunteered for an intelligence-gathering mission in New York City but was captured by the British and executed. Hale has long been considered an American hero and, in 1985, he was officially designated the state hero of Connecticut.", "reason": "near_duplicate_of_source", "seed": 941508704, "similarity": 0.9908496732026144, "temperature": 0.3}], "fingerprint": "dae36be305ee3a13c8b27bf54fc923f590c5690d43d206f0209db3886b520357", "generation_attempts": 2, "gold_answer": "Nathan Hale", "matched_aliases": ["Nathan Hale"], "query_id": "test2163", "question_hash": "4520929438d66867d56f32f1f6f177ac4a9182c930065e2d4215e89d91b904ed", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "b26416b00062377fe805a02c347f9f831acd0645702da2075a726d906981e52b", "scope": "all_answer_documents", "seed": 407304167, "similarity": 0.07848837209302326, "source_content_hash": "49123ddb54de252cd5b9c9c4b19811af12aad7a803c9e7aa3d5c6940ac43b196", "source_hash": "6387d6ac364344fe5635db9c130b217fdfb5dd0de32cfbbc930245fa96fa7c9a", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "f5a8692fb343841625e7df52758b1e5bc874898179900b47712baf02cff955aa", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
