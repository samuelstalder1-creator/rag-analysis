{"doc_id": "doc12651", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Walking Dead is mostly filmed in Georgia. Since 2002, the state has offered a tax incentive for large film productions to drive producers to the state and bolster its economy.", "reason": "near_duplicate_of_source", "seed": 462914695, "similarity": 0.9781420765027322, "temperature": 0.3}], "fingerprint": "86b7643cfbd545060f94366022545a4317ac070da5db4ae3982adc8e962923ea", "generation_attempts": 2, "gold_answer": "Georgia", "matched_aliases": ["Georgia"], "query_id": "test329", "question_hash": "03af363dbd15d4ea45505122140274a4792b329995724aae0f20ca05cc24ca38", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "836f52caef82ab22758beb6619f364d375bc734fd821825cbd33f0503820775f", "scope": "all_answer_documents", "seed": 1568481257, "similarity": 0.3208020050125313, "source_content_hash": "40605cf1a051b0f072358721500f099397859fb9f096468fd1f42145c12e5900", "source_hash": "eb19cbe63d392172c2479a6890566840fc3ee3b461efcd392f817e5f81483f65", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "1cb5579dd5aa84db9576779ad20144fccb2942d1266f78e6bc9836d0a588dcf7", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc12693", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The original act provided for lifetime Secret Service protection for former presidents. In 1997, it was reduced to 10 years for presidents taking office after 1997. The 1997 amendment was reverted by the Former Presidents Protection Act of 2012 (Pub.L. 112–257). All living former presidents and their spouses are now entitled to receive lifetime Secret Service protection.", "reason": "near_duplicate_of_source", "seed": 22133038, "similarity": 0.986737400530504, "temperature": 0.3}], "fingerprint": "eae32bfeba54bb4a28dc8f64b7ebfc98d6417c33280c486444fa42c3d68a5ead", "generation_attempts": 2, "gold_answer": "lifetime protection", "matched_aliases": ["lifetime protection", "lifetime"], "query_id": "test330", "question_hash": "a762a444e3ccf0b77fb7b438d9b113ea1b99403b16241e4e0b54482eae441f9e", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "5403ea9015ba35f63cd1ae142732525cb778ed1e7d0249ee0f463918f599fcee", "scope": "all_answer_documents", "seed": 24971990, "similarity": 0.1684981684981685, "source_content_hash": "698c3ff26a8c450ce35324e379ffff0b1a4006ff3dd8d836eec353455d2d00e3", "source_hash": "5cdeb61b6d3db8d26dce44cd04f0478836456906a745d3993494b78f0721ddfc", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "d7df3b02370a94f62fb5e29ecaf6e65f32a80668979df6df88b0664f733eada8", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc12699", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Former presidents were entitled from 1965 to 1996 to lifetime Secret Service protection, for themselves, spouses, and children under 16. A 1994 statute, Pub.L. 103-329, limited post-presidential protection to ten years for presidents inaugurated after January 1, 1997. Under this statute, Bill Clinton would still be entitled to lifetime protection, and all subsequent presidents would have been entitled to ten years' protection. On January 10, 2013, President Barack Obama signed the Former Presidents Protection Act of 2012, reinstating lifetime Secret Service protection for his predecessor George W. Bush, himself, and all subsequent presidents.", "reason": "near_duplicate_of_source", "seed": 796748920, "similarity": 0.9885757806549885, "temperature": 0.3}], "fingerprint": "697364c30da0c65d55eee0ec0a6e38229979cacce84e1aadec0cbefbabbe3260", "generation_attempts": 2, "gold_answer": "lifetime protection", "matched_aliases": ["lifetime protection", "lifetime"], "query_id": "test330", "question_hash": "a762a444e3ccf0b77fb7b438d9b113ea1b99403b16241e4e0b54482eae441f9e", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "66aac422d6978bef81a2cec22367723ee1ede50d2100a85c5f3b7d4004549087", "scope": "all_answer_documents", "seed": 951917217, "similarity": 0.26058631921824105, "source_content_hash": "506a597f54ee8be8147584c4a81f60b121f6d1fe9d9df15a7fb218fb0480b186", "source_hash": "9dd401f09684920ad50acbb07a4ca1649a1497375b5319e55d7bccbf17819e95", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "7d51ac888d6b7599396894b3e17ad1a6a7ddd79dd263ab454e53cf119a59f23f", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
