{"doc_id": "doc74079", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The earliest credible evidence of either coffee drinking or knowledge of the coffee tree appears in the middle of the 15th century, in Yemen's Sufi monasteries.", "reason": "near_duplicate_of_source", "seed": 1146063856, "similarity": 0.9907120743034056, "temperature": 0.3}], "fingerprint": "972bc71e03526f7e5cf9b87df6284dc673f24b6883cc2e2bae9416faaa2392c9", "generation_attempts": 2, "gold_answer": "15th century", "matched_aliases": ["15th century"], "query_id": "test2130", "question_hash": "ec47ca021f92c36fd70d852db9c8713d8a54dffc82d0f37d2410d25a5bd76da9", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "24e7894a2411c650bbcf5196c8a1cfeaae2f2d3e37964347695a239b40a1218d", "scope": "all_answer_documents", "seed": 1070347369, "similarity": 0.8333333333333334, "source_content_hash": "cc3f39bae561ff3985518fed5c12a1c4fe515e3ce97f2d6886ee5e21fddf9034", "source_hash": "744dc62eb27b404f7f8b631d8a6d4ba9ced1e46d526aad99506de32338a4e1b7", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "13288db0aad74fcbd48fd9bcdec67fa8cc0c6ba15d65aba3d2634c708f84abc7", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc74206", "receipt": {"answer_in_original_body": true, "failed_attempts": [], "fingerprint": "8cbabe1edb5d23f14a8cd882e4163b5b8bb86bf49cab5d7d6d5f7d754bdb1a4e", "generation_attempts": 1, "gold_answer": "1981", "matched_aliases": ["1981"], "query_id": "test2132", "question_hash": "763fffdfc46eaa4499dcd01c22d5ec1013cc0eeb3c77ca3c8ace744ab50c433c", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "6b4a9eb977a836797fa406131da110cbfcdfed155879d83480426165eb104b7c", "scope": "all_answer_documents", "seed": 1217746059, "similarity": 0.12271259418729817, "source_content_hash": "7f990fc3d5ff251d1f3caa93eb41ab9ac674383a394ba31af0257a25a34dd01c", "source_hash": "e5cbfbc722730e4d57554f79c0fef810d6463fa736b16b5910873e327cef6752", "target_answer": null, "temperature": 0.3, "validation": {"answerability_verified": false, "evidence_hash": "e444cec517bc5c98948f0a3629e623b4d39d88510cbae7b3712146d494de86d6", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc74383", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Spanish conquest of the Inca Empire was one of the most important campaigns in the Spanish colonization of the Americas. After years of preliminary exploration and military skirmishes, 180 Spanish soldiers under conquistador Francisco Pizarro, his brothers, and their native allies captured the Sapa Inca Atahualpa in the 1532 Battle of Cajamarca. It was the first step in a long campaign that took decades of fighting but ended in Spanish victory in 1572 and colonization of the region as the Viceroyalty of Peru. The conquest of the Inca Empire (called \"Tahuantinsuyu\"[1] or \"Tawantinsuyu\"[2] in Quechua, meaning \"Realm of the Four Parts\"),[3] led to spin-off campaigns into present-day Chile and Colombia, as well as expeditions towards the Amazon Basin.", "reason": "near_duplicate_of_source", "seed": 1209505955, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "03695f1027b629f58c2a5392cb9d6bf566286f3a93b29e1bc97bf990a2f69cc1", "generation_attempts": 2, "gold_answer": "Francisco Pizarro", "matched_aliases": ["Francisco Pizarro", "conquistador Francisco Pizarro"], "query_id": "test2136", "question_hash": "9a14327e27346a6327d2957a886780df3b9c704067c8e09eb738fa507d51a714", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "d8068fb103e22a4fee068a8b6a66c21a4f2f7ed35037b6588a2d04b0e7862d2e", "scope": "all_answer_documents", "seed": 392175370, "similarity": 0.289171974522293, "source_content_hash": "005b4dc4ca007a3a8b3f86c5e3c828bd4557d8fba8ff645cb717b078a9a751a1", "source_hash": "144a608fa4b73aa5129159cbf28afce646576855276007e1537f3ff5a1463195", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "fd6905f761d64629730f0a4fadc2bee62b844354daecb80f32da235738dcc69b", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc74444", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Jason Paige (born January 6, 1969) is an American singer, writer, record producer, stage, film, and television actor. Paige is best known for singing the first theme song for the English version of the Pokémon television series.", "reason": "near_duplicate_of_source", "seed": 491718538, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "58f917ead11fdaa7b54c35893ba4ad44a0306f2b0bd283b76707b96b59fcfc63", "generation_attempts": 2, "gold_answer": "Jason Paige", "matched_aliases": ["Jason Paige"], "query_id": "test2137", "question_hash": "4f1203c31b67a1a8c8e314f0453b023c6f31a95a372c69be2160ee3991209c86", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "fa136aa5586288086110765662da16306f3f48ccd089285324e1e80e56ab76ff", "scope": "all_answer_documents", "seed": 1760816973, "similarity": 0.5210918114143921, "source_content_hash": "5889e937f7f120327903c56b2f60078a69245143d6077166e3070ab7d1bab3c0", "source_hash": "345105c82c06e0ca5777cb96f5143b0265844a5588a2e5bc070b0419b0537fe9", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "d69e37ad5f9b18f3b96e4725da82e6b45d957f799430598846c03641416073c4", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc74477", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Sockeye salmon (Oncorhynchus nerka), also called red salmon, kokanee salmon, or blueback salmon, is an anadromous species of salmon found in the Northern Pacific Ocean and rivers discharging into it. This species is a Pacific salmon that is primarily red in hue during spawning. They can grow up to 84 cm (2 ft 9 in) in length and weigh 2.3 to 7 kg (5.1–15.4 lb). Juveniles remain in freshwater until they are ready to migrate to the ocean, over distances of up to 1,600 km (990 mi). Their diet consists primarily of zooplankton. Sockeye salmon are semelparous, dying after they spawn. Some populations, referred to as kokanee, do not migrate to the ocean and live their entire lives in freshwater.", "reason": "near_duplicate_of_source", "seed": 1419902367, "similarity": 0.9885386819484241, "temperature": 0.3}], "fingerprint": "a2c7dfe5a2928ce2d32ce077dc6ecf23baf43fcab0534af30512d765aa3daa92", "generation_attempts": 2, "gold_answer": "the Northern Pacific Ocean", "matched_aliases": ["the Northern Pacific Ocean"], "query_id": "test2139", "question_hash": "047feb23dc46ba1b039e3c571286f5cfd13becd487b17ebcebf6ad580b3257f0", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "7b4b231703b15000f8138f393c65909242c5ad55160b5d9bb0f24747ab1fa544", "scope": "all_answer_documents", "seed": 788696018, "similarity": 0.83765752409192, "source_content_hash": "6ace3f5241cbdfaf69859125794608e78fbd5c0ac2d37928d3605f4b045cdf51", "source_hash": "e4cf6ae741ef6a6879d19d2f8692dd17ce802dc6b37e5174dd120182e20e3bd5", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "a42c93387bd4368b2162a6196ae68df12bffac045d395de68059dcfc50a6c28e", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc74515", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "In 1969, to accommodate the growing number of reporters assigned to the White House, President Richard Nixon had the indoor swimming pool, which had been installed by the March of Dimes for Franklin D. Roosevelt, covered and turned into press offices and a lounge that could double as a briefing room.", "reason": "near_duplicate_of_source", "seed": 1929652039, "similarity": 0.9901315789473685, "temperature": 0.3}], "fingerprint": "eb414e6361c5431e135a3a2170e6d313ae2bd84daa6386c7613405bc7b035749", "generation_attempts": 2, "gold_answer": "Richard Nixon", "matched_aliases": ["Richard Nixon", "President Richard Nixon"], "query_id": "test2140", "question_hash": "b4fffc4809cfa1fb7f04f0bf5c429d199774d705853b00715682b3745cabedef", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "abacc5b5653dfc64291192d5858c179bbefa85aaff31005c920e0d1f9819c3b9", "scope": "all_answer_documents", "seed": 1348891566, "similarity": 0.09104704097116843, "source_content_hash": "5125e8ce2b12aba7f244c8dce9e3043021040d1721099b20f13ed6f44ed1bc08", "source_hash": "765ad7d64915793fd4823fd271241b53f634445008f7d556bda57d7ba3be047c", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "6c82a94293f3ba5d0f3e2d54ef5aeb4e30e702595baa2d7683391ae46c3edc54", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc74531", "receipt": {"answer_in_original_body": true, "failed_attempts": [], "fingerprint": "af06bace176ae44460c712c1d2a3360042149dac47dffac9180219fa5db7fe5b", "generation_attempts": 1, "gold_answer": "the Zoroastrian religion", "matched_aliases": ["the Zoroastrian religion", "Zoroastrian"], "query_id": "test2141", "question_hash": "b80283c6b7dce94720dc9d2b18d13e2ac970a7db35e82d37ea9f0797b19c7f7e", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "019430f7a8516048ab84cfd8e1725a0a31ff1d2966441804ede04eb7e60271ed", "scope": "all_answer_documents", "seed": 107204194, "similarity": 0.21604938271604937, "source_content_hash": "f86a8504a0c464df4c2fd25bf1e9aac427bf79bb04338208c3c1036ee104faa2", "source_hash": "9838f33c154c3b3ced68a41e44297fae8e53404cb31f783f29f49afd4b26349d", "target_answer": null, "temperature": 0.3, "validation": {"answerability_verified": false, "evidence_hash": "b339890ced2e2950202d6509df970e9d4e045c025d963ddc9884d4da7ed66c05", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc74608", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "A flat-wick lamp is a simple type of kerosene lamp, which burns kerosene drawn up through a wick by capillary action. If this type of lamp is broken, it can easily start a fire. A flat-wick lamp has a fuel tank (fount), with the lamp burner attached. Attached to the fuel tank, four prongs hold the glass chimney, which acts to prevent the flame from being blown out and enhances a thermally induced draft. The glass chimney needs a \"throat\", or slight constriction, to create the proper draft for complete combustion of the fuel; the draft carries more air (oxygen) past the flame, helping to produce a smokeless light, which is brighter than an open flame would produce.", "reason": "near_duplicate_of_source", "seed": 1431088602, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "50de3023bb947ca81e721fa35deb5a4c528492356abf223bb9193a619d3b1ef7", "generation_attempts": 2, "gold_answer": "capillary action", "matched_aliases": ["capillary action"], "query_id": "test2142", "question_hash": "d25c65dd880e00e0c38a2fea3e30cffeed61eb6fbdac2b1fb15c1ff1a6831b3d", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "90247fdf0c0e0f11c8f09c6b68b0d84629386b733c80d052eda73b427a1d28d7", "scope": "all_answer_documents", "seed": 94887733, "similarity": 0.23431952662721894, "source_content_hash": "cc77096c91a2af7163ef75fb6e32843f694200d737d9b5a7106b45abb714eacf", "source_hash": "85c35114deed083f25c29ccc5923807eff26fe1eff1c0719e8881f049ea81937", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "0cb4447033691f73cd2191b53762494435f3b5e2b723956695c6a993c1894763", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation