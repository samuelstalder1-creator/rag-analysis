{"doc_id": "doc90332", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Hector was a ship famous for having been part of the first significant migration of Scottish settlers to Nova Scotia in 1773. The replica of the original ship is located at the Hector Heritage Quay, a heritage center run by local volunteers, in Pictou.", "reason": "near_duplicate_of_source", "seed": 1931231542, "similarity": 0.9940828402366864, "temperature": 0.3}], "fingerprint": "34bb2af346204e7178f9e798effca7e4f1ecd04fdc90abdeb35c157c4890d9a9", "generation_attempts": 2, "gold_answer": "1773", "matched_aliases": ["1773"], "query_id": "test2638", "question_hash": "aa7d08f3786263e96239fe255682391af2a761779eb513996ed9ae8e8dcfbf14", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "9ee97d8c4a12f2ad3d02218e96c0e61b496f886d203fedf48aeddfd465ed523c", "scope": "all_answer_documents", "seed": 1277404971, "similarity": 0.40601503759398494, "source_content_hash": "9e2837e3b3b8624774c28c7594143a0d8c3dd5c8115b26d62693d3a0ad96173b", "source_hash": "e57982713d18a2805c92e0b001a717ff6e8f778b76a9a797fc9e39e5c4958dd3", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "897e8fdc79f5e946fe07313c7272289b1e0abf62ed733a0624d8a5e35d945e11", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
