{"doc_id": "doc114461", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "After Burgess's death, the PreCrime system is shut down. All the prisoners are unconditionally pardoned and released, although they are kept under occasional surveillance. Anderton and Lara are soon to have a new child together. The Precogs are sent to an undisclosed location to live their lives in peace.", "reason": "near_duplicate_of_source", "seed": 477005339, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "c1deb9cc918efc19429d7a6b7d668cc2c8a0a6ef5e56ecc16c1aef0eb78f09ad", "generation_attempts": 2, "gold_answer": "an undisclosed location", "matched_aliases": ["an undisclosed location"], "query_id": "test3353", "question_hash": "df1e38ab5c0bcb0f93bd40cdcf82f530aadb6d0a9ef94aab85cde5ca32ab86df", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "6adcd4edfc5b3ce91225c4963d5c6c68824f3ff358fe6d77f240514f3901b0eb", "scope": "all_answer_documents", "seed": 1427109481, "similarity": 0.12786885245901639, "source_content_hash": "e6e7e51b09071bc66fd1dbcb09f9cc471e8c75ce48f4e536fbfb697b586af119", "source_hash": "8670745f8d06da4ed88daafbe2e7186ee3d11722374d8ff6ed8a483c51058016", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "ea3de2e74b96bf05f23520616bc892c0ab76d3b6d068172fcf61b79944ff245a", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
