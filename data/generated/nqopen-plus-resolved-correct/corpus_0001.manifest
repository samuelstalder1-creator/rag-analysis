{"doc_id": "doc38199", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "American Idol is an American singing competition television series created by Simon Fuller, produced by FremantleMedia North America and 19 Entertainment, and distributed by FremantleMedia North America. It initially aired on Fox from June 11, 2002 to April 7, 2016 for 15 seasons. On March 11, 2018, the 16th season made its debut on ABC.", "reason": "near_duplicate_of_source", "seed": 1798654755, "similarity": 0.9955947136563876, "temperature": 0.3}, {"attempt": 2, "generated_text": "American Idol is an American singing competition television series created by Simon Fuller, produced by FremantleMedia North America and 19 Entertainment, and distributed by FremantleMedia North America. It initially aired on Fox from June 11, 2002 to April 7, 2016 for 15 seasons. On March 11, 2018, the 16th season made its debut on ABC.", "reason": "near_duplicate_of_source", "seed": 444074312, "similarity": 0.9955947136563876, "temperature": 0.5}], "fingerprint": "daabe6b89eb2f26b06d0985a413534547de19292ec13429172a46683406b0758", "generation_attempts": 3, "gold_answer": "April 7, 2016", "matched_aliases": ["April 7, 2016"], "query_id": "test1093", "question_hash": "c52650cda6e2fc3926b28efefdbdbc43702ccf6b261224cb24d4af0358a91a44", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "510b64fb58244ce5de85e59381d0d0fde85f8cbe08d6965c6f0da9a85e033db6", "scope": "all_answer_documents", "seed": 165582640, "similarity": 0.050473186119873815, "source_content_hash": "36472111e67ffca11ac7b683d6f26a9940212787c076b9fdb35137f8a11df27b", "source_hash": "ae38a874e1b9ab5ca43663fdc704e2845c3735dd444a015cdea803c7aa3c45e7", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "586bd393a5a49b254462a9baa898b9617ed9389977d2931ce7f7072b7858ccd2", "format_attempts": [], "judgment": {"gold_alias_present":