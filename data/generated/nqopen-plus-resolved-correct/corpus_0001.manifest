{"doc_id": "doc98791", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "It (also known as Stephen King's It) is a 1990 American supernatural horror drama miniseries directed by Tommy Lee Wallace and adapted by Lawrence D. Cohen from the Stephen King novel of the same name. It is the first of two adaptations of the novel; the second being the 2017 film adaptation and its upcoming 2019 sequel.", "reason": "near_duplicate_of_source", "seed": 1749835422, "similarity": 0.9938080495356038, "temperature": 0.3}, {"attempt": 2, "generated_text": "It (also known as Stephen King's It) is a 1990 American supernatural horror drama miniseries directed by Tommy Lee Wallace and adapted by Lawrence D. Cohen from the Stephen King novel of the same name. It is the first of two adaptations of the novel; the second being the 2017 film adaptation and its upcoming 2019 sequel.", "reason": "near_duplicate_of_source", "seed": 381019508, "similarity": 0.9938080495356038, "temperature": 0.5}], "fingerprint": "d8232af4d5de8a6324efb64dfb945fd2bc886e2c63864c9007e8357f0ded721e", "generation_attempts": 3, "gold_answer": "1990", "matched_aliases": ["1990"], "query_id": "test2889", "question_hash": "e425ff91caef8b6c7e4a223a6efa792a1770734405e890080770a325e9a9f5a5", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "704affc2aa776fd104ec48603c7294d8325075a77366db67851cd8e66de13360", "scope": "all_answer_documents", "seed": 348548748, "similarity": 0.9448584202682563, "source_content_hash": "66cf00ce681acbdb666948f57f93f999c50a1f5adc771509d3716c8fa415163e", "source_hash": "54d7b50e724101ce58ce65b38a8b22b2ff07b05d54c63fd1221114afb57907b1", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "a81ae79547a75cb56af1ca7e6ef514304e85eb302e6640d04aff05451ea3d767", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "determini