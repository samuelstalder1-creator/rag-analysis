{"doc_id": "doc43250", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"Things That Make You Go Hmmm...\" is a song by American dance group C+C Music Factory. It was released in June 1991 as the third single from the album Gonna Make You Sweat. The single features Freedom Williams and he is also seen in the song's music video. The song inspired a running gag on The Arsenio Hall Show, where Arsenio, while allegedly on a long drive, pondered certain thoughts and referred to them as \"things that make you go hmmm....\"", "reason": "near_duplicate_of_source", "seed": 673363576, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "0c4649c5941a0171c837e4036a65ee9506bc56be84d9cb327427ef6be84503f8", "generation_attempts": 2, "gold_answer": "June 1991", "matched_aliases": ["June 1991"], "query_id": "test1213", "question_hash": "90846e6de9fc01ab7d93297af3cbb93e6e8991a1252aa4db4266f326dab0dd77", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "14b62f13fbf6822e5e5e3ddd28e895fd96a56258c86f662edfc6538b7007d012", "scope": "all_answer_documents", "seed": 744141285, "similarity": 0.2558139534883721, "source_content_hash": "f0aa3edad7888c2d8e1c172cb9eab6c9a089f89dbb6c3f082ee0ae5a6fc450d4", "source_hash": "5f833cce6e68faafbf7219429c929f8ae48c833ddf47f42afa7c0c3d045761b6", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "d2fde71df1cfa4b22523cba1095a3d59ffafaedd2cbe7123df24a51315512d79", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc43260", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Formed in 1896, the program has over 700 wins and has achieved two consensus Division I Football National Championships in the modern era and was College Football Playoff National Championship Finalists in 2015 and 2016, winning the championship game over the Alabama Crimson Tide for the 2016 season. Clemson has had 6 undefeated seasons including 3 perfect seasons, 23 conference championships, 6 divisional titles since 2005, and has produced over 100 All-Americans, 17 Academic All-Americans, and over 200 NFL players.[3][4] Clemson has had seven members inducted into the College Football Hall of Fame, including former players Banks McFadden, Terry Kinard, Jeff Davis, and former coaches John Heisman, Jess Neely, Frank Howard, and Danny Ford.", "reason": "near_duplicate_of_source", "seed": 2078189247, "similarity": 0.9966644429619747, "temperature": 0.3}], "fingerprint": "eeb2e97222e36cc4bb8a657f475e24b020889a0735678febe1be8d61368b2252", "generation_attempts": 2, "gold_answer": "2016", "matched_aliases": ["2016"], "query_id": "test1214", "question_hash": "cd803e863dd903e37321f71626e0a779d245a2ea6ef639126a2b6bd9a954960d", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "2ec2dd5656a04d26dd063cee9d9695277a79bedddd3d39046beaa7fb4db51572", "scope": "all_answer_documents", "seed": 203963933, "similarity": 0.2891125343092406, "source_content_hash": "6a6316dfc66220c7d9187a483061e864b91c352c32ea80f42e2df81dd293f327", "source_hash": "081a609cd6189cbcac21e96ef7da0b1b59d8519398908d01eefb58171c4f102c", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "abb107564658948b1f80b025eaa2cb5bcd2f6d9dcd30602acd842fe29b9f7eab", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "sem