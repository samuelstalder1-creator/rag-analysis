{"doc_id": "doc79392", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Robert James Anderson (March 6, 1933 – June 6, 2008) was an American actor and television producer, most famous for his role as the young George Bailey in It's a Wonderful Life.", "reason": "near_duplicate_of_source", "seed": 931510314, "similarity": 0.9887640449438202, "temperature": 0.3}], "fingerprint": "260a30f355467637994310704cf8bfec04423b0a12a4a14f2510fc4d3fefea7d", "generation_attempts": 2, "gold_answer": "Robert James Anderson", "matched_aliases": ["Robert James Anderson"], "query_id": "test2289", "question_hash": "2813da5d0d40a6e6199caa0b2a82a7554e20b3b0a65a91162c8b6dfe1b0f171b", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "552305c85d63aec5698d3fe8278a5157a21b6f1361d0b2689cc7b485c31def66", "scope": "all_answer_documents", "seed": 64684917, "similarity": 0.3064935064935065, "source_content_hash": "898f4afa9b1d40b8f11861542ace6a852df6601031712be4070193fcfeee3d72", "source_hash": "65afd34d3b2752e6f36f6d09cecd93a94bb93ddf73ee0ee4c9ee960173b4d329", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "28ea4ac158d86a5e77a2ab2115363241e9af8ce05776b66cbc939220c8f2370e", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc79422", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "According to the bible, both the first shattered set and the second unbroken set were stored in the Ark of the Covenant (the Aron Habrit in Hebrew).", "reason": "near_duplicate_of_source", "seed": 322382799, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "c2e663aa1ea249b0bd0fe1f1f44ebb41c0f4df8ac7181aacce3adef1861a65e7", "generation_attempts": 2, "gold_answer": "Ark of the Covenant", "matched_aliases": ["Ark of the Covenant"], "query_id": "test2291", "question_hash": "608cb9180bf041a6a6145bdbe58941cb33c2e1bc67ca961022c736b82caaa36a", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "20a9d30885ac412d3f9552f484a590455aac5cf15a9bd3318aa6fcefe8e14772", "scope": "all_answer_documents", "seed": 1250152273, "similarity": 0.5844155844155844, "source_content_hash": "8276067952be065c89720fffaf985b0bee46185a7e1a9cdfce456ad6105b1b39", "source_hash": "18ea3b501cc993354999c0e0bb35b885e49b775c25be2b369d6f134c5f982b8d", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "7495cf1cf6e25fadca245bc14f1f0c25443fc137eaadeb86a824e448d42c44af", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc79470", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "After Margaret Thatcher became Prime Minister in May 1979, the legislation to implement the Right to Buy was passed in the Housing Act 1980. Michael Heseltine, in his role as Secretary of State for the Environment, was in charge of implementing the legislation. Some 6,000,000 people were affected; about one in three actually purchased their housing unit. Heseltine noted that \"no single piece of legislation has enabled the transfer of so much capital wealth from the state to the people\". He said the right to buy had two main objectives: to give people what they wanted, and to reverse the trend of ever-increasing dominance of the state over the life of the individual.", "reason": "near_duplicate_of_source", "seed": 686597440, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "1f68284a220e52a62ba0491481eeab6fa321c94fafb8cfda01dbe9d3c8cc6687", "generation_attempts": 2, "gold_answer": "1980", "matched_aliases": ["1980"], "query_id": "test2293", "question_hash": "55b4789ed4b856964472ceb945cd4780565d465c86a8210e7a82e0f7e7569fc5", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "19155ec6c2fe6eee94db34d7386e593618d57bdd8d60a863802dcaf088b348d3", "scope": "all_answer_documents", "seed": 1063086675, "similarity": 0.09049079754601227, "source_content_hash": "ee46ee319cd758c3ca0a8560297cc12e35990718d6c5c5f55c55919d686cec84", "source_hash": "eef1dace37721dacb35555920071a53238124ea7a71ab60cd68a21fc8f259267", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "e7a761bb1762a6fdc1db5f651be9e3118cb535141ddb69aa3a7796d7e6bb0969", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc79545", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Laura Jane Haddock (born 21 August 1985) is an English actress who is best known for portraying Kacie Carter in Honest, Lucrezia in Da Vinci's Demons, Meredith Quill in Guardians of the Galaxy and its sequel Guardians of the Galaxy Vol. 2, Alison in The Inbetweeners Movie and Viviane Wembly in Transformers: The Last Knight.", "reason": "near_duplicate_of_source", "seed": 1734384835, "similarity": 0.9861751152073732, "temperature": 0.3}], "fingerprint": "d8c0ee04b5d115704ea8008fd3167f4fd52962a8aa6798bbfad616c18497762a", "generation_attempts": 2, "gold_answer": "Laura Jane Haddock", "matched_aliases": ["Laura Jane Haddock"], "query_id": "test2298", "question_hash": "a7f2c7a2258b80108e90b9647cd954193668d266c1e989eecbce1ff95f469f42", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "385501f9ec452cb6b13b0dfc81ba9db880dd7af3157de643b1e0458869329789", "scope": "all_answer_documents", "seed": 284807206, "similarity": 0.555984555984556, "source_content_hash": "c91b99a47f351733bba2932a51d48a26b4c126616e490c8be82b1de9563b0bd2", "source_hash": "9c3a10ac92cb659574b8d44648545b6107c922264421180a736b5b3e27feab38", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "3ab40e41c8ecf7125f8802ae65877d011fd9a9ef7c2b46f3779c225d69ab0a9d", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
