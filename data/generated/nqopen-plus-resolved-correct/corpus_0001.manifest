{"doc_id": "doc115529", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Nicholas \"Nick\" Bakay (/bəˈkeɪ/ bə-KAY; born October 8, 1959) is an American actor, voice actor, writer, comedian and sportscaster. He is known as the voice of Salem Saberhagen on ABC/The WB's Sabrina the Teenage Witch and Sabrina: The Animated Series, and Norbert Beaver on The Angry Beavers. He played Karl on the Fox series 'Til Death as well as serving as a producer of the show until it was cancelled by Fox.", "reason": "near_duplicate_of_source", "seed": 295853499, "similarity": 0.9927884615384616, "temperature": 0.3}], "fingerprint": "adc96870e7bc4edf4f18f15a404bdc1f909e9773c1d8e6369e8054b185e0091e", "generation_attempts": 2, "gold_answer": "Nicholas \"Nick\" Bakay", "matched_aliases": ["Nicholas \"Nick\" Bakay"], "query_id": "test3385", "question_hash": "129cf4beed5aa74ab115e2f72f808800d82adbfedbb62f343ef70681a84c2fad", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "91707992f1da3912bc519a1c874fd0e9b207555cdc044b2c63383386b3b39854", "scope": "all_answer_documents", "seed": 1865473006, "similarity": 0.03571428571428571, "source_content_hash": "ea05531b4be2f28269ab6ae92d6031f136c5e14dbbd3da7a00216cc005f721e4", "source_hash": "ae8a0ea0212bae101712af9e9a63fb7f98a14994f35563942ea62d9d21947256", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "a249ab1324c76eb22ae9c6a71c1877ced3cfa0672ae05d1b0e1bd2cd3e136a7f", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc115555", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "June Gable (born June 5, 1945) is an American character actress, perhaps best known for her role as Joey's agent Estelle Leonard in the NBC sitcom Friends. She received one Tony Award nomination for her work on Broadway.", "reason": "near_duplicate_of_source", "seed": 44199832, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "3939e1ff77e5988e50ee6f539ebea25d957d5073c5d483c3dcfd2a9a8772e8e4", "generation_attempts": 2, "gold_answer": "June Gable", "matched_aliases": ["June Gable"], "query_id": "test3387", "question_hash": "c9efabf68c56065c5c00407a5a70e381aef2b7fd2b2ec77937801a472072844a", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "c92f4df87617174b18ec952ceb5c129f8318712269fdd8d4d716a23fb7e848e1", "scope": "all_answer_documents", "seed": 277317452, "similarity": 0.04824561403508772, "source_content_hash": "1be5d17232c806df59c6bd91ecac4448be425336afaffec717abfbd7c0175738", "source_hash": "37daff975dc7bb5e741f26054c85c96391c84f4f2369880a91d1da5839a75eec", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "efd3af09eb409f50f41a6ff05749d9dde5dd2db674b433ef1433a0adb552d093", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
