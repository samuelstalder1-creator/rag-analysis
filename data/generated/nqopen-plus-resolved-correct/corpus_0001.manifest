{"doc_id": "doc17784", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "An unsaturated fat is a fat or fatty acid in which there is at least one double bond within the fatty acid chain. A fatty acid chain is monounsaturated if it contains one double bond, and polyunsaturated if it contains more than one double bond.", "reason": "near_duplicate_of_source", "seed": 107342865, "similarity": 1.0, "temperature": 0.3}], "fingerprint": "ef4bec37511f71f9aabfa3cb6966f8fbb7a3857329aab931b75e802a353cf6e1", "generation_attempts": 2, "gold_answer": "double bond", "matched_aliases": ["double bond", "at least one double bond"], "query_id": "test483", "question_hash": "5b733840ef462a35cb0f8cbfc024e6fd4d63168ea87851d8425ced0c820f0667", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "60bcb62e2de37f2ec979bc78c2762159fb44d0c334d55f92dd7559c82123d4ff", "scope": "all_answer_documents", "seed": 1647179659, "similarity": 0.10214168039538715, "source_content_hash": "47f0580bd34a173413b62555efc14d306074f0ef6397982427d1e562dc1bff9f", "source_hash": "04497033c9084e74afbe34efda7cabbf0394740f50ae176c562496cad265539c", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "8529d56b881e679997e5bc24e5f316c7398efdf683d5834fb6d71c42bcffbb92", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc17794", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Ghosts of Girlfriends Past is a 2009 American romantic comedy film whose plot is based on Charles Dickens' A Christmas Carol. Mark Waters directed a script by Jon Lucas and Scott Moore. Filming spanned February 19, 2008 to July 2008 in Massachusetts with stars Matthew McConaughey, Breckin Meyer, Jennifer Garner, Lacey Chabert and Michael Douglas. The film was released on May 1, 2009.", "reason": "near_duplicate_of_source", "seed": 807442863, "similarity": 0.9961290322580645, "temperature": 0.3}], "fingerprint": "afc4bac17623520099a584cd98b6369596f86dff2cce67f759ac517e26555a0d", "generation_attempts": 2, "gold_answer": "Massachusetts", "matched_aliases": ["Massachusetts"], "query_id": "test484", "question_hash": "66daf927dbce38a93556525eebe98b7f195425ebf0beb9efab69b24b0b32d559", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "row_hash": "6a577ddaeefdfa8af3a8802e6131900b3c365e1dc25e14e5e7573a658d5f1f8c", "scope": "all_answer_documents", "seed": 629474165, "similarity": 0.21508034610630408, "source_content_hash": "14e4402cb6444aff0d7e3434ae5584d2263f6a1ccbde613c599026d6a0d95d0a", "source_hash": "1f1221bfcd6386c0aa135d8dcc8f39537a7ac1af5862f7f63435d4f6b3f2fbd9", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "28166748da14a40d8374e4069b6f108dd40980c1e53404803586c2283e9bb726", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
