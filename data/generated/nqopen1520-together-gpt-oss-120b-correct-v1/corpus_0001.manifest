{"doc_id": "doc74884", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The 2017 Wonder Woman film became available for home viewing in several formats—Blu‑ray, Blu‑ray 3D, 4K Ultra‑HD Blu‑ray and DVD—on September 19, 2017, following its Digital HD launch on August 29, 2017.", "reason": "missing_gold_answer", "seed": 743829124, "similarity": null, "temperature": 0.3}], "fingerprint": "0d40e4ee26adf69c347958c339d5e230f479aeebd333fab22394c5e949f5a05f", "generation_attempts": 2, "gold_answer": "September 19, 2017", "matched_aliases": ["September 19, 2017"], "query_id": "test2150", "question_hash": "274e2387895186d6442cc0bb533882c26765f759c94206e5a3d5cdff0d8d5b02", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "d0cc775c0891ee1c419220b05ce7dd978c215de5dc89b0469403c7d9e26dbef2", "scope": "all_answer_documents", "seed": 1352001897, "similarity": 0.53125, "source_content_hash": "74606763a728ddace2102ed8e079ccd62a821aad0189672c4b3a2f113bc6fbc4", "source_hash": "fb5cdb916ccd204dabab64e03ef8d93fe8fb9de6daa694b42314c650f708bdc9", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "981f03e80a86e992dd1c18766d9fda3d7f9eb1deabda9ad6c1adf1f1a8df330b", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc75038", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Confederation Bridge, which crosses the Abegweit Passage of the Northumberland Strait and links Prince Edward Island with mainland New Brunswick, is 12.9‑kilometre long. Construction proceeded from October 1993 to May 1997, and the bridge was opened on 31 May 1997.", "reason": "missing_gold_answer", "seed": 928097108, "similarity": null, "temperature": 0.3}, {"attempt": 2, "generated_text": "The Confederation Bridge, which connects Prince Edward Island to the mainland province of New Brunswick by spanning the Abegweit Passage of the Northumberland Strait, measures 12.9‑kilometre in length. Construction proceeded from October 1993 to May 1997, and the bridge was opened to traffic on 31 May 1997.", "reason": "missing_gold_answer", "seed": 1838442157, "similarity": null, "temperature": 0.5}], "fingerprint": "b067c47084128eca3173dfeca6051fa939e06cb927c137f00642ba2697d14257", "generation_attempts": 3, "gold_answer": "12.9-kilometre", "matched_aliases": ["12.9-kilometre"], "query_id": "test2153", "question_hash": "28e71a65ed495211c8bf04da4574a8dfb47292640b81e28fb7f12422b2b24967", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "ec1364cc971e700ef7a8ed51c7af82ca090c0ea8028fa8c74933c66c3623bd50", "scope": "all_answer_documents", "seed": 1055531049, "similarity": 0.4681404421326398, "source_content_hash": "4dfe2b9a7cd51bab17227bc350db97ed36ab4fede7fec7df61b8f137f163bf59", "source_hash": "77a6fba8a7607c208d359fd980faaf9d6b92744ecc6b106842d35720a460a297", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "5ed1a3975ecdee73a0a42a70709b818b4211e8a95323a1f7ff91be3578b6f51a", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false,