{"doc_id": "doc69946", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Born Anna Muttathupadathu on 19 August 1910, Saint Alphonsa was an Indian religious sister and educator who died on 28 July 1946. She is distinguished as the first woman of Indian origin to be canonised by the Catholic Church and also as the first saint of the Syro‑Malabar Catholic Church, an Eastern Catholic Church based in India. Her feast day is observed on 28 July.", "reason": "missing_gold_answer", "seed": 2036192084, "similarity": null, "temperature": 0.3}], "fingerprint": "4b547e0e046eb4da36a52497ba0d9e30414f950b4b8156fee28700523e548cee", "generation_attempts": 2, "gold_answer": "Saint Alphonsa", "matched_aliases": ["Saint Alphonsa"], "query_id": "test1995", "question_hash": "57c4011c44d9a2a6470c42a8001e98da4585d932ee06c7564619a9e18cbdfae1", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "53a2536127bb278c9fe45ae816f8d55104121baea3fa31cdad497f6c06409115", "scope": "all_answer_documents", "seed": 1543169445, "similarity": 0.45144356955380577, "source_content_hash": "e6c54d6ca3a40b30cf1a36ef6a706198119a26381a4b71007d26a0f9dd7974d8", "source_hash": "869ced4bd866ec4c0deb7b6bad8424ad2e1967bef42e2d035e42946ef079270a", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "3c41c6a1426bf78af12a0ae481fff9df50510c9544f065a12217d95172b26e05", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
