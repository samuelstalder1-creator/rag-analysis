{"doc_id": "doc107157", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Indoor toilets were initially a luxury reserved for the wealthy and only slowly spread to broader segments of society. By the late 19th century, many working‑class homes still lacked indoor facilities, and some early 20th‑century houses even placed the toilet outside the main living areas. However, the pattern changed dramatically with new construction standards: **After World War I**, all newly built houses in the city and its suburbs were required to include indoor toilets, making them a common feature in residential architecture.", "reason": "missing_gold_answer", "seed": 245365933, "similarity": null, "temperature": 0.3}], "fingerprint": "d6607c049c52807226a49338367681e8da2e14e03618379b3a447d390c6de73f", "generation_attempts": 2, "gold_answer": "After World War I", "matched_aliases": ["After World War I"], "query_id": "test3140", "question_hash": "f5bb8cf346d1ae557ba5f60ee99508a1bd9787bd2ac79a3539e87c77e1a81365", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "341e07b8fa91e265b334fc54f609ef1b5158ba1eedeb442af79b792d9664c620", "scope": "all_answer_documents", "seed": 1488099822, "similarity": 0.10632911392405063, "source_content_hash": "2a55e1e5ca572ff0740ecdbf69081710e4d2be3a87215e7a0649993e1d1b0f11", "source_hash": "b38f42d902db2c76f5ce683f4847a250cc4b54279ded7fccd30ddfe789a0eb6e", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "a647537d48fe821d4d30f6322d697bec039722e3fe7604a27225c3046463fc16", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "v