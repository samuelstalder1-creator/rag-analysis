{"doc_id": "doc16745", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Only Fools and Horses Christmas special in which Del and Rodney turn up at a fancy‑dress party dressed as Batman and Robin is the episode titled **“Heroes and Villains.”** It premiered on 25 December 1996 as the first instalment of the 1996 Christmas trilogy and the thirteenth Christmas special, attracting a record‑breaking UK audience of 21.3 million viewers.", "reason": "missing_gold_answer", "seed": 1939764533, "similarity": null, "temperature": 0.3}], "fingerprint": "2df2fca6b04cf680f06a6c7417f0d108fbb97c278f1f92b16dcc9847b61ed53d", "generation_attempts": 2, "gold_answer": "\"Heroes and Villains\"", "matched_aliases": ["\"Heroes and Villains\""], "query_id": "test453", "question_hash": "a1cdc09486adda922caec3f7edd20c931271320028f9337a279cb2f4728882bb", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "8ad787868171a287dea637ac012a45adf77e3cc99087947632cdc9137b9093cf", "scope": "all_answer_documents", "seed": 1918638242, "similarity": 0.38786279683377306, "source_content_hash": "6e3f4821af39a5a1d46794114a9b6c61389e78d6f5b35407d1a48a5d5b06bbb9", "source_hash": "ca1ba0ccab81bc5d38dceb41855bf1ba0ba44b66b97bf49a1c35f5f14dfee409", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "5e9de0738e309528787923d46b5d883e6b04cbe4cf7f6023f64d2fabd7fe6da8", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
