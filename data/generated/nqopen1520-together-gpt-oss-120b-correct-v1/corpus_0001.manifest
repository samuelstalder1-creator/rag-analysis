{"doc_id": "doc81099", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "George II (born 30 October 1683, died 25 October 1760) held the throne of Great Britain and Ireland from 11 June 1727 until his death; consequently, the reigning monarch of England in the year 1756 was George II.", "reason": "missing_gold_answer", "seed": 1026550467, "similarity": null, "temperature": 0.3}], "fingerprint": "3e5586d5d05b652bdb8b2cae4b46346d00a675896dfe90486f37d3985b47ae1b", "generation_attempts": 2, "gold_answer": "George II", "matched_aliases": ["George II"], "query_id": "test2348", "question_hash": "bf06395d17509d6ada0fea990e846416e1aa6f5e34ef045526cedad20e92d157", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 2, "row_hash": "dc44201c6c9069c8b611e85ff16e63074c0ee61d7132ce405f4d9b93dde62a72", "scope": "all_answer_documents", "seed": 1419331526, "similarity": 0.18773946360153257, "source_content_hash": "42aa74dcac0e2e95202597fbcd69e5cfcd7a5f7064ec0ec864b82cf0150751b0", "source_hash": "346eaf4d6c6eb56ec8f270e8ed060db5cee9afd0a27d72d616dae882606f9b57", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "87fa3a35734a729138be5c80159e187eb90ca1b5939266b11b44b700917a08ce", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc85127", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Principal photography for The Book of Eli began in February 2009, with the entire shoot taking place in New Mexico.", "reason": "missing_gold_answer", "seed": 546993213, "similarity": null, "temperature": 0.3}, {"attempt": 2, "generated_text": "In May 2007 Columbia Pictures and Warner Bros. tapped the Hughes brothers to direct The Book of Eli, a project built around Gary Whitta’s screenplay. After Anthony Peckham polished the script, Denzel Washington secured the lead role in September 2008, and Gary Oldman was added to the cast the following October. Production kicked off in February 2009, and the movie’s principal photography was carried out in New Mexico. Alcon Entertainment provided financing and co‑produced the film with Silver Pictures.", "reason": "missing_gold_answer", "seed": 1226658995, "similarity": null, "temperature": 0.5}], "fingerprint": "3ec624da6377d55bcae2adecc81242907a749e87f7b791f9ccb3819147b74d72", "generation_attempts": 3, "gold_answer": "New Mexico", "matched_aliases": ["New Mexico", "in New Mexico"], "query_id": "test2470", "question_hash": "a515d90e90faa300c77ea63260009affc918e70acd3800f84d2f81f30978fb15", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 2, "row_hash": "4c263d06816d1d7b4d354d8f64bc81acbe9192dd7392f2f16eaa25e164743b08", "scope": "all_answer_documents", "seed": 966165982, "similarity": 0.19760479041916168, "source_content_hash": "3639402721c58764bd9428583e1bf57ad6080b0a36d0e173a384f2ef4afa3732", "source_hash": "3ac115ba9237337a74b6635f8dd31fac161be123d94c143b373c4c2f86416be1", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "691c542466484ca583067d990aad58f55647264596158b0a1206e3891433d243", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc86182", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "In an effort to improve the estate’s finances during the Great Depression, Cornelia Vanderbilt and her husband answered a request from the City of Asheville and opened the Biltmore Estate to visitors in March 1930.", "reason": "missing_gold_answer", "seed": 703245713, "similarity": null, "temperature": 0.3}], "fingerprint": "e56b48e6a539eeac359395a4073080e2304ce22946fcb488abb7d98b7718f1eb", "generation_attempts": 2, "gold_answer": "March 1930", "matched_aliases": ["March 1930"], "query_id": "test2495", "question_hash": "c1d5bc24bfdda7aab51e97205eaf8db3ad2a8e39217d575046053b0ada7dae59", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 2, "row_hash": "977359ed5f47301e7085621e8a1421c9d8d484d9c152e60a91dbf18d21021c82", "scope": "all_answer_documents", "seed": 1579789912, "similarity": 0.11840411840411841, "source_content_hash": "36d8bcaecd6195b560b53b030ca77a4f02e7bc01d33e372b71b06eb0c4b22e19", "source_hash": "4dbe71f061ba2cfa1e8d2c8df448920d4b3784e2c356cfc5c4fc50041c82f29d", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "9dfc34bad00e9f85a5d39007c96dbc42548a1e447ea8c403d24b9b2d138da96b", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc91765", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The movie I Can Only Imagine opened in American theaters on March 16, 2018. It later grossed roughly $80 million worldwide against a $7 million production budget, making it the third‑highest‑grossing music biopic ever in the United States.", "reason": "missing_gold_answer", "seed": 894429025, "similarity": null, "temperature": 0.3}], "fingerprint": "848d4e13fbad4a4ccbadd414ed6c871fca439173d928a6d49c4fff30fa1644a0", "generation_attempts": 2, "gold_answer": "March 16, 2018", "matched_aliases": ["March 16, 2018"], "query_id": "test2679", "question_hash": "7181d68458686f6304589a3eee2a2001161a13d216180a9ecc8ea53e8ecced0e", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 2, "row_hash": "cfd0659af3b50975495571e766b474f1d061214ba26e91c324016a530a37e7f2", "scope": "all_answer_documents", "seed": 387626043, "similarity": 0.31266846361185985, "source_content_hash": "269dfcdfa63e9769e7c8a1e62ec9094c26a1365e25cce540561f5680aaa92e67", "source_hash": "d2f7cb4b14123b3cfc9b372e988d5f9ef7c30ec953e12a176016844b6b8aa129", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "3a0853741b89ed84efb74ac491f3c4740cf82e787de5855b5822f883ccea0edb", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
