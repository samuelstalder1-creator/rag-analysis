{"doc_id": "doc21751", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "A United States Marine Corps Lockheed KC‑130T Hercules went down in Mississippi on Monday, July 10, 2017, at roughly 4 p.m. The aircraft, assigned to Marine Aerial Refueler Transport Squadron 452 and based at Stewart Air National Guard Base in New York, broke apart with all 16 crew members killed. Wreckage was later recovered in Leflore County, Mississippi, and the incident is being investigated as a Marine Corps “mishap.”", "reason": "missing_gold_answer", "seed": 1255717398, "similarity": null, "temperature": 0.3}, {"attempt": 2, "generated_text": "On Monday, July 10, 2017, at about 4 p.m., a United States Marine Corps Lockheed KC‑130T Hercules aircraft crashed, killing all sixteen people on board. Debris from the downed plane was later discovered in Leflore County, Mississippi, and the accident is still being investigated.", "reason": "missing_gold_answer", "seed": 406817423, "similarity": null, "temperature": 0.5}], "fingerprint": "7e735f8da3b27b0eecdf083201fd2542857e3fbeb67ba7b802e7014957380574", "generation_attempts": 3, "gold_answer": "July 10, 2017", "matched_aliases": ["July 10, 2017"], "query_id": "test611", "question_hash": "2c3287b8b0628caa595b9d926079a3507c8a78060b6f3f92f130912e36b793df", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "37c24b262119be1370ce21efccdc288b5809f4d74325c91509733c90aadb571c", "scope": "all_answer_documents", "seed": 1406555013, "similarity": 0.15494636471990464, "source_content_hash": "a54e51d4ccf3dbf02adbb6fa3b1aa5f8675a3fb23e3761b78658abe2818e9b4e", "source_hash": "9654f7f60f9d50fe13b3f44dcd885f2f0dc7245f4a7968d363e29b25402f4d4f", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "06cff16895cfca3ab82f1f8d3ccb5fc4357eac00f7b6e510ecf8f574f893e833", "format_attempts": [], "judgment": {"gold_alias_pre