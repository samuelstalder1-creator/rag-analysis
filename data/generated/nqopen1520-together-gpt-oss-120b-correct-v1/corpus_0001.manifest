{"doc_id": "doc9074", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Lincoln Highway, inaugurated on October 31 1913, was a coast‑to‑coast automobile route that began at Times Square in New York City and extended westward until it reached its western terminus at Lincoln Park in San Francisco.", "reason": "missing_gold_answer", "seed": 1919277303, "similarity": null, "temperature": 0.3}, {"attempt": 2, "generated_text": "The Lincoln Highway, planned by Carl G. Fisher in 1912 and officially opened on October 31, 1913, was a coast‑to‑coast automobile route that began at Times Square in New York City and terminated at Lincoln Park in San Francisco. Throughout its history the road crossed a dozen‑plus states, linking the eastern metropolis with the western terminus at Lincoln Park in San Francisco.", "reason": "missing_gold_answer", "seed": 1763322834, "similarity": null, "temperature": 0.5}], "fingerprint": "929fc3190bc158dcf5a3cc7d7a92a26e0705a748fda62d3f55c47a348a035ecc", "generation_attempts": 3, "gold_answer": "Lincoln Park in San Francisco", "matched_aliases": ["Lincoln Park in San Francisco"], "query_id": "test246", "question_hash": "c555edc9279dc79cb26a6b3b566c7cec4f54f3cb94912a8c7b923bc565c36cee", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 1, "row_hash": "afda4bd3f5fe0bdd38d79aca0a728d510596c440c990a324743134320c0a96b9", "scope": "all_answer_documents", "seed": 1042440019, "similarity": 0.23596419853539463, "source_content_hash": "21f130086bf62050a0511877a337cd656b62070a5059d12e6b318f940dca5756", "source_hash": "f2d5588d0d7de54287e0ca4c2eb366122bfaaf0f85e948ecdfe6a7e2ae18e395", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "ee741203f0e0f5b27ee7cb5c2cc1c6450939decfbd27fbe9bb6815c4ca14badf", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc13111", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "In the first 28‑minute unaired pilot of *Charmed*, the part of the youngest Halliwell sister, Phoebe, was originally assigned to Lori Rom. Following Rom’s departure, a second pilot was produced in which Alyssa Milano assumed the role of Phoebe.", "reason": "missing_gold_answer", "seed": 1042374347, "similarity": null, "temperature": 0.3}], "fingerprint": "168642761047432e3a049b45cd4061c64fc6f4594c0f8d4d954afa4ce0b5d43b", "generation_attempts": 2, "gold_answer": "Lori Rom", "matched_aliases": ["Lori Rom"], "query_id": "test345", "question_hash": "cddc2c296a1966c9304e808a7e1fd17d36990cb4caa712c0c4773bd39fd2b308", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 1, "row_hash": "befa4e71df3de8a17ea36edd7acedbd7f9d316ba845da00674ffba2a1b6aca60", "scope": "all_answer_documents", "seed": 1055919760, "similarity": 0.015469613259668509, "source_content_hash": "404021ce7f7dd753768295f41f4c9f3fd07da063fbbf5db5e7279a3bf4173093", "source_hash": "170d1d4e715502f975405bf62073ecb66554f72f64b289c305c1f2fd621b14a8", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "594c7e32d21b43d3241e97e2d594ba73136f8e63559c24d9777600fc62f4c7fa", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
