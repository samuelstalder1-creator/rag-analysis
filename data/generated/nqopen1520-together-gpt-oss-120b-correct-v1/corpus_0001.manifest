{"doc_id": "doc35283", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "In 1872 the disorder was described in greater detail by the physician George Huntington, and the disease subsequently took his name. Earlier, a likely first description had appeared in 1841 by Charles Oscar Waters, but it was Huntington’s work that led to the eponym.", "reason": "missing_gold_answer", "seed": 1539596522, "similarity": null, "temperature": 0.3}], "fingerprint": "9a9bb2fadec2e0e307611b9a273374137da5291dc4d12242028e855a4943cf0d", "generation_attempts": 2, "gold_answer": "the physician George Huntington", "matched_aliases": ["the physician George Huntington"], "query_id": "test999", "question_hash": "20d5a11915c9e40c39fd75c7d97cdea4b89465d79955ce050dfa7b0fea842024", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "2806cc3b93534fc9aab347652aaf398a532a7ed11cc11d433f81ab353a14feeb", "scope": "all_answer_documents", "seed": 738274977, "similarity": 0.23858794887401097, "source_content_hash": "32c1d025c71ffcfc45a9a2f9cafe4dfddcd267957375fd57158213420fe4b774", "source_hash": "94455a727b5b55f8d4366268221042c57077398cbee40469d39bfed3454e942a", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "21879da36e0b1d96fb67a9a0e15f530a3338aea539bdf2d6edf91222feabe7ab", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc35415", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The inaugural season of America’s Got Talent ran from June 21 to August 17, 2006, following an audition tour in April that visited Los Angeles, New York, and Chicago. Hosted by Regis Philbin, the panel of judges was composed of David Hasselhoff, Brandy Norwood, and Piers Morgan. When the competition wrapped up, the title was awarded to Bianca Ryan.", "reason": "missing_gold_answer", "seed": 716494497, "similarity": null, "temperature": 0.3}, {"attempt": 2, "generated_text": "America's Got Talent season 1 ran from June 21, 2006, through August 17, 2006. The audition tour took place in April 2006, with stops in Los Angeles, New York, and Chicago. Regis Philbin served as the host, while the judging panel consisted of David Hasselhoff, Brandy Norwood, and Piers Morgan. When the competition ended, Bianca Ryan was declared the winner.", "reason": "missing_gold_answer", "seed": 1361267588, "similarity": null, "temperature": 0.5}], "fingerprint": "e4403b7c63ee7d878ed72ddd211c7c5de3abb5bf5d273f8b94e70bbc17c2293e", "generation_attempts": 3, "gold_answer": "Bianca Ryan", "matched_aliases": ["Bianca Ryan"], "query_id": "test1003", "question_hash": "186a27352742d7eabf6a3fbd7230952dac57cfdb29035947c23c3705b8e68bff", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "a0ee87bef159003dbf25b880a049e4a50f76da3a847a6ebc8dec55c34b42ed92", "scope": "all_answer_documents", "seed": 759567318, "similarity": 0.16467065868263472, "source_content_hash": "3a8e695592d0bbb50d94bc80e778e98dcba818128284689f5626095d0f59f955", "source_hash": "4333f56a8e4d389cfd57b77ef7b475cf21e98d91f513aaa739f008cc86f5d5a3", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "a11e2a44459601bb46118bd5b45e6ed633358c70bab90e5fa95736caa9e5c26f", "format_attempts": [], "judgment": {"gold_alias_pre