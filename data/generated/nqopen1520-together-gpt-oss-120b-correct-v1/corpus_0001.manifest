{"doc_id": "doc19267", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Jyotirindra Basu (8 July 1914 – 17 January 2010), popularly known as Jyoti Basu, was an Indian politician of the Communist Party of India (Marxist) from West Bengal. He occupied the post of Chief Minister of West Bengal from 1977 to 2000, and this period of service makes Jyotirindra Basu the longest‑serving Chief Minister in the history of India, a record that still held true as of January 2015.", "reason": "missing_gold_answer", "seed": 2059025924, "similarity": null, "temperature": 0.3}], "fingerprint": "8eaa7e4dfdcb484e0d96dd177df86adbe305e32d7c45a4185300cc5db96b5df0", "generation_attempts": 2, "gold_answer": "Jyotirindra Basu", "matched_aliases": ["Jyotirindra Basu"], "query_id": "test532", "question_hash": "9793cd20e39501d3cd1c607fd333d495315d48897717db6cd204d18f9986991b", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "05945c9ce321f1422c191d990fdc0ccb39a487431ff072395c6cf3bd86576003", "scope": "all_answer_documents", "seed": 209126874, "similarity": 0.16122448979591836, "source_content_hash": "aea672058c9b1f7320dca541276c9ef70f0a428565ce03f02627d27f01a66285", "source_hash": "72c4668e5dc70fa68c8d93c57db17738689f6ab51f89c097aeed5ea9ab1fa843", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "c958cee90281c82d631c33d451a22f2087cf6319d9c27a256e766ef6c6f00bd1", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
