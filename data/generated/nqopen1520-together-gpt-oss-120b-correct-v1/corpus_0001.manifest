{"doc_id": "doc11426", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "A 2007 study conducted by the Environmental Change Institute at Oxford University estimated that the overall contribution of worldwide aviation to anthropogenic climate change is about a **4 percent cumulative effect**. This figure reflects the total impact of civil aircraft operating at high altitudes, taking into account both CO₂ emissions and additional altitude‑sensitive effects.", "reason": "missing_gold_answer", "seed": 703753009, "similarity": null, "temperature": 0.3}], "fingerprint": "219d6dd089c997714773bcc516cc2d09edf9dab3526c3c7c5cb4d401f0f5fecd", "generation_attempts": 2, "gold_answer": "4 percent cumulative effect", "matched_aliases": ["4 percent cumulative effect"], "query_id": "test300", "question_hash": "d3ec4e06ce8abdb90584f9c76aae1ce62b39c939874b9dd27df08c4bea51a7dc", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "011b837d740dba8f3bd09b4a45efc82ddc48723a650a79071b5b03cf32207dd9", "scope": "all_answer_documents", "seed": 1223834104, "similarity": 0.17037037037037037, "source_content_hash": "fe2e891be747476a1d7de4a99f3aaaf4fa1e7697a01081d80567988720437484", "source_hash": "af980c6deb276265c98ececc206294e76f7caec5a222e37e56342439a23cb328", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "12eb965264fd1550d425a617d6149552f3ef971beb3687557ba385e575b1f630", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
