{"doc_id": "doc30933", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Apollo 11’s historic flight carried the first humans to the Moon, and its mission commander, Neil Armstrong, was the first to walk on the lunar surface. After the Eagle lunar module touched down on 20 July 1969, Armstrong stepped out of the spacecraft at 02:56:15 UTC on 21 July 1969, becoming the inaugural person to set foot on the Moon.", "reason": "missing_gold_answer", "seed": 1954436989, "similarity": null, "temperature": 0.3}], "fingerprint": "f36dc751a226596cf9d81aca4e2dea5008429f71c073a0b0db075c13f3c40aba", "generation_attempts": 2, "gold_answer": "Neil Armstrong", "matched_aliases": ["Neil Armstrong"], "query_id": "test865", "question_hash": "fc5474b5e69211df12251f7bb4fcb933462ae6f07f278b8f67fad16c6ea83fe1", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "85695e79095b2f9df64b43ba1fd0a0ce8101f81be39b93598b9d011b599b1a60", "scope": "all_answer_documents", "seed": 923479713, "similarity": 0.26843657817109146, "source_content_hash": "50b1d5283711e0d69a9c9190a8ef3d09dca50c8d80dde1365bee0b243eb5fb53", "source_hash": "818a9121c944ceadd9de393169a78db949f2b9375931cc6ca0284193f46bb4e3", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "74eb4b1e984c4a471daadc38efc9ac2164d0c4d8c8e8952cb15ff59386f7a890", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
