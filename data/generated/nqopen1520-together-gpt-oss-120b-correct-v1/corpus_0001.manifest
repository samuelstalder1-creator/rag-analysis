{"doc_id": "doc102453", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "In the Celsius temperature scale—established after Jean‑Pierre Christin’s 1743 revision that inverted the earlier thermometer arrangement—the freezing point of water is fixed at 0 °C, while the boiling point of water at a pressure of one atmosphere is defined as 100 °C. This definition remains the basis for teaching the scale in schools today.", "reason": "missing_gold_answer", "seed": 570038100, "similarity": null, "temperature": 0.3}, {"attempt": 2, "generated_text": "The Celsius temperature scale defines the boiling point of water at a pressure of one atmosphere as 100 °C.", "reason": "missing_gold_answer", "seed": 37767250, "similarity": null, "temperature": 0.5}], "fingerprint": "ecbf99a99e1489cd1fbd545579cfbf92c36eeb56918c03a6049fc0f87cd8e63d", "generation_attempts": 3, "gold_answer": "100 °C", "matched_aliases": ["100 °C"], "query_id": "test2988", "question_hash": "855a80cb5b982d790663c18356a58e6ef1fb114dde67d0c845b117618708668a", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "2ea05b4308a30cc927a54a46b63bc2d7c0c43dcea5e5f765d9733f3431efa3cb", "scope": "all_answer_documents", "seed": 1491164937, "similarity": 0.08431952662721894, "source_content_hash": "ca07ad044d2be48ab59dce8a46d97222cbeb9e3116fd3146408d8d68cd19cf88", "source_hash": "f76ffa3cb15e126474d6783d3841970607d87be2faba6f400ce032e2d99c30aa", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "f3c4fdfc56eac363ec59e785a6c7e26030ba0f08849a82f8609ecd331bdbadca", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403