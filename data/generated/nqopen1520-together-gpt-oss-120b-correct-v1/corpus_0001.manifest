{"doc_id": "doc5819", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Ranjit Sagar Dam, also referred to as the Thein Dam, is a hydroelectric installation built by the Government of Punjab on the Ravi River, straddling the border between the Indian states of Jammu and Kashmir and Punjab. About 60 % of the reservoir lies within Jammu and Kashmir. The project is situated near Pathankot city in Punjab’s Pathankot district and close to Kathua city and Basholi tehsil in Jammu and Kashmir’s Kathua district, and the surrounding township is known as Shah pur Kandi. It is the largest hydroelectric dam in Punjab. Feasibility studies began in 1953, geotechnical investigations continued until 1980, construction started in 1981, the generators were commissioned in 2000, and the entire project was completed in March 2001.", "reason": "missing_gold_answer", "seed": 1438492791, "similarity": null, "temperature": 0.3}], "fingerprint": "3fc63ffa58810160008b0f5e9ec7307d35074911e8a8d044e03c740ca6d7ff90", "generation_attempts": 2, "gold_answer": "Ravi River", "matched_aliases": ["Ravi River"], "query_id": "test158", "question_hash": "4aeeee693e3cbe71f9eaa4365e22b0fe6f09cee86241054385cee97408bedf90", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 1, "row_hash": "403a24fd8101f568422589ecbb2876fd44983be7cb25dfa577954fe0a6489d45", "scope": "all_answer_documents", "seed": 90788724, "similarity": 0.16654904728299225, "source_content_hash": "92cc60c87752a7849a5919410876333138d3c22cf610b41b5a7cfcfc12edba7d", "source_hash": "9a60e55eb3a247165c62ad7cd39835f6322f153c2b08b2682145098d3bee111f", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "d2bab95ce2674cfba3b5df70f0622139b0f913b7308976a158836e3942b7eb3c", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
