{"doc_id": "doc99141", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "According to reports dated October 29 , 2015, the Chinese Communist Party announced that the one‑child rule would be replaced by a two‑child rule. Following approval by the standing committee of the National People’s Congress on December 27 , 2015, the revised law took effect on **January 1 , 2016**.", "reason": "missing_gold_answer", "seed": 402356368, "similarity": null, "temperature": 0.3}], "fingerprint": "b33cd47e69dc882af6e0228767f2cbf3befe3ad2095c6b410768971f92081790", "generation_attempts": 2, "gold_answer": "January 1, 2016", "matched_aliases": ["January 1, 2016"], "query_id": "test2903", "question_hash": "e82c1a3f99492d1329d7264387d2464e948954ab9db5ec1d24dd8c752773e308", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "228e7cddf2caf6d86bdbfc39bc6b5d585f214625263b65b3d2941a42c3a41dc9", "scope": "all_answer_documents", "seed": 94974462, "similarity": 0.1519756838905775, "source_content_hash": "295eb5681e44ba0aed550559869b1a00366fb8a41564a3ccbe1a2f839100a3dc", "source_hash": "d887698bd6dd3c9603bc0b0cbd3947b07c23408655bf968a45350e8258983b19", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "f4757536316cebc104c5afdf747e1f3596dcf0852cb38072f5b6988697b8f737", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
