{"doc_id": "doc35963", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "In early 2016, after T. K. stepped down, Wipro appointed Abid Ali Neemuchwala as its chief executive officer.", "reason": "missing_gold_answer", "seed": 727958854, "similarity": null, "temperature": 0.3}, {"attempt": 2, "generated_text": "In early 2016, after T. K. stepped down, Wipro appointed Abid Ali Neemchwala as its chief executive officer.", "reason": "missing_gold_answer", "seed": 2008247266, "similarity": null, "temperature": 0.5}], "fingerprint": "49ec3b2469279e21da00f1d86726cdc7c3405a1a013c899358b78ac5aede280c", "generation_attempts": 3, "gold_answer": "Abid Ali Neemuchwala", "matched_aliases": ["Abid Ali Neemuchwala"], "query_id": "test1019", "question_hash": "244842794a3e18eaefdbe9680ddb0fd3520dc08fe28c1f2c1f51bf3c8d6b6c5f", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "940034330009e892f5196e7ff50c64f6bfb9dd5cd0f5ece84a914d1d4334cad8", "scope": "all_answer_documents", "seed": 193057461, "similarity": 0.37142857142857144, "source_content_hash": "bc238a245fb2cfb33109147114ad12f179da9915562b51c5a2f56f0eef128a9d", "source_hash": "8ba79f66d48df3a80728bf94fc0846d2634937245ab457494a266928673ce8f0", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "ffd9b9af62ffeaafc7ae59a1ebe55e404679e24de34bc5a64fa64c519cca8b81", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc35964", "receipt": {"answer_in_original_body": true, "failed_attempts": [], "fingerprint": "5ae0cb74a53c225434a2923bfc3cef82b77acd50be265bddf9666e8750d3c35a", "generation_attempts": 1, "gold_answer": "adenosine diphosphate (ADP)", "matched_aliases": ["adenosine diphosphate (ADP)"], "query_id": "test1020", "question_hash": "fde30c2b2fb67218591d16866414199788e10a5de849678bc33a98f571e4a1bc", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "314c3e913ffe85ce4582d0069285c52e6ba80203bdd319689912931f3a6103a3", "scope": "all_answer_documents", "seed": 1298812264, "similarity": 0.26126126126126126, "source_content_hash": "057459f759ef0e4ac2d331908e9b408a0f949279f25af772647b31a7be5b2ae1", "source_hash": "c545d0cf6cd5ce4c06777fcf56bbea9352564ba98cdfc19bf5d450d43314a868", "target_answer": null, "temperature": 0.3, "validation": {"answerability_verified": false, "evidence_hash": "5acb859478e63ca771021b46dc1847e08161652fbaafc35b76de425ddadfeab6", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc35979", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Bull sharks have teeth that are shaped like needles. Their needle‑like teeth are well suited for seizing small, slippery prey such as fish, squid, flounder, stingrays and even other sharks. This narrow, pointed form allows the shark to grip the narrow bodies of its victims efficiently.", "reason": "missing_gold_answer", "seed": 1710379862, "similarity": null, "temperature": 0.3}, {"attempt": 2, "generated_text": "Bull sharks possess needle‑like teeth, a shape that enables them to grasp and hold slippery, narrow prey such as small fish, squid, and other marine animals. This needle‑like form is characteristic of sharks that feed on relatively small or soft‑bodied organisms, allowing the teeth to penetrate and retain the prey efficiently. Modern sharks like the blue shark share this same tooth morphology, using their sharp, slender points to capture and process their meals.", "reason": "missing_gold_answer", "seed": 217834226, "similarity": null, "temperature": 0.5}], "fingerprint": "a98b107cbc63039fd42041a7c2b2a0f10bd40c3cf0cd90df3a3cad675d806ef1", "generation_attempts": 3, "gold_answer": "needle-like teeth", "matched_aliases": ["needle-like teeth", "needle-like"], "query_id": "test1021", "question_hash": "b492641c674e444faf2e11a6ce3ce741230c343f379f800797df076ad817733a", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "7458a6a4fcb447285fcc85d52f378000a83a7b2ed7ada577cfd62bade751f9cd", "scope": "all_answer_documents", "seed": 1834886496, "similarity": 0.045662100456621, "source_content_hash": "99c9701e71cf784d15eea7a2ad029437dd8fb7b0f0bc2b4cc4c7506a196e00e1", "source_hash": "c797eea1a82d463e4d21c5ed67ceb27cbc15a9a073e03a633c08321103f54450", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "37253d09bb4bafa4466cd7a8695af5164e5ef9e6d3a65046df