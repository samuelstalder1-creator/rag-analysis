{"doc_id": "doc107870", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The sitcom *Malcolm in the Middle* centers on a chaotic household of six (later seven) children and their parents. While Frankie Muniz stars as the gifted teen Malcolm, his mother Lois is played by Jane Kaczmarek. The father, Hal—who is often immature yet affectionate—is portrayed by Bryan Cranston. The brothers Francis, Reese, Dewey and later baby Jamie are played by Christopher Kennedy Masterson, Justin Berfield, Erik Per Sullivan, and a newborn actor, respectively.", "reason": "missing_gold_answer", "seed": 544983872, "similarity": null, "temperature": 0.3}], "fingerprint": "56189da35df57efdcd085f0b9679d21aec027745ad3fa8dfa656ed14b8662318", "generation_attempts": 2, "gold_answer": "Bryan Cranston", "matched_aliases": ["Bryan Cranston"], "query_id": "test3159", "question_hash": "60a36372f98ec946cf9dec151852a44b98eb146c707649d8fc71a50c9a47c88d", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "4196626296145759c7d24a97ef1f1f0df41966380e4904cbcc6ba8b97737c833", "scope": "all_answer_documents", "seed": 1573841190, "similarity": 0.02757715036112935, "source_content_hash": "8e1dd7b7d70c70b9ff3b1fdc18cb96e7a2c73f23ca52664c7d3a0523e30cf6c6", "source_hash": "836a7366fdf52e1d1d843c0792c46eb294d625c7d799b199688afb88fca45ad4", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "9d32a31fab53713c0b305d272fb8a5f18d3c7d19a5fc292ab369fca73340fa0f", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
