{"doc_id": "doc7921", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The biblical account is the only source for the First Temple, which the Tanakh says Solomon built during the united monarchy of Israel and Judah. 1 Kings 6:1 records that construction started in Solomon’s fourth year, and scholars generally date Solomon’s reign to roughly 970–931 BCE. Accordingly, the temple’s construction is placed in the mid‑10th century BCE. The sanctuary itself required seven years to complete, while the entire building program—including the royal palace—took twenty years.", "reason": "missing_gold_answer", "seed": 1990695385, "similarity": null, "temperature": 0.3}], "fingerprint": "a2197dee3bf140a44eb4f619571757581a9dbf7e36d3edefe407b1676eb37154", "generation_attempts": 2, "gold_answer": "the mid-10th century BCE", "matched_aliases": ["the mid-10th century BCE"], "query_id": "test219", "question_hash": "6e3976f28f846d0a5a88cd2e4c2b30fec1dce95bf13b54b26d65d6dfeb7d61eb", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "795a24085046d41f507576a01ce0900c1f2008af120f095c7db8162ffa2f38c1", "scope": "all_answer_documents", "seed": 1689261503, "similarity": 0.06445406445406446, "source_content_hash": "4893e7ef5099468e56efe01164575a1518f3ddbdb33083eed12db9ed2a0e7bfd", "source_hash": "2f595e29b3f63457b92cf48fd3bc1fbf0f3ce156f6403af93ff87828d1123ee9", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "03b12995cb34b0fc36ceeb37234bdc01892d24a092062a78e90513bbe67dd3cd", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_