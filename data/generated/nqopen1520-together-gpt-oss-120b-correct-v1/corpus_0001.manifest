{"doc_id": "doc24903", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Earth completes one full turn with respect to the Sun in about 24 hours, while its rotation relative to the distant stars takes 23 hours, 56 minutes, 4 seconds. This solar‑day length has been lengthening very slightly over time because tidal forces from the Moon slow Earth’s spin; atomic clocks show that a contemporary day is roughly 1.7 milliseconds longer than it was a century ago, and analyses of ancient astronomical observations reveal a slowdown of about 2.3 milliseconds per century since the 8th century BCE.", "reason": "missing_gold_answer", "seed": 1980465222, "similarity": null, "temperature": 0.3}], "fingerprint": "cac30d0c85f65be83a530273cfb6936d96805422ab3e73df85b90a695505de0c", "generation_attempts": 2, "gold_answer": "about 24 hours", "matched_aliases": ["about 24 hours"], "query_id": "test697", "question_hash": "1ebe12d58400da70cb1e67cbd325399caed72e8d40e9761157efd5874f6dfafa", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "ce3212bb6c13fe12eb4afaa762d4176ae313970f4dd3b8070889d35dbd2a003c", "scope": "all_answer_documents", "seed": 810821496, "similarity": 0.04104903078677309, "source_content_hash": "8afadbc04262cce2e0a059f895917ba89bf3a2f266b53cb35c54d89ba2598d65", "source_hash": "3fa27668945dd22aabea55b3dcd341e1ed6f5ede2373dc23e99cced0b1ada97e", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "e576f0037bed9d80007faa850981c0882182865e78cf768be826084f9e1adc2d", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation