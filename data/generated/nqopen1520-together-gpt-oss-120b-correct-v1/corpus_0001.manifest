{"doc_id": "doc43497", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "In the fifth U.S. season of *Hell’s Kitchen*, the competition was claimed by Executive Chef Danny Veltri. He earned a sous‑chef position working with Stephen Kalt at Fornelletto, an Italian restaurant in the Borgata casino in Atlantic City, New Jersey, and also received a $250,000 cash prize.", "reason": "missing_gold_answer", "seed": 1028350910, "similarity": null, "temperature": 0.3}], "fingerprint": "aa03f31038d18a8a5ae587ddcb96e15b271b7bcd5f518a3cc9bcc5cdc437b15a", "generation_attempts": 2, "gold_answer": "Executive Chef Danny Veltri", "matched_aliases": ["Executive Chef Danny Veltri", "Danny Veltri"], "query_id": "test1222", "question_hash": "ffa4c4cf0f858ad6aab1d5a1ff8d8de38bc6d1c1a10b3ea5c37882df3ba3c1c9", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 1, "row_hash": "52dcdde9ae4c2a84793281c07f3d6469cf31c1079170e5bc1912505a479d3abf", "scope": "all_answer_documents", "seed": 1541772692, "similarity": 0.16829745596868884, "source_content_hash": "cd99e0bfebf27d792d42ee2b0b8121f785bceeb531282fcea1a5ebb80e6728f0", "source_hash": "64070801c99f5b4017dc2c19577bb4add7bc4083b559b289adee403644a2070c", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "cfa8fc6aa588d6f5e65d146c04b9f3462eeb36327c24db776ba3aa302609dbe0", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc46605", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "On 15 October 1997 the Thrust SSC established the world land‑speed record, attaining a velocity of 1,228 km/h (763 mph). This achievement made it the first land vehicle to officially surpass the sound barrier.", "reason": "missing_gold_answer", "seed": 2055234441, "similarity": null, "temperature": 0.3}], "fingerprint": "7eb9a1aa18b5bd3535a68442db02fb5bd4ced9c9ed82979b13880299c6e67cb3", "generation_attempts": 2, "gold_answer": "1,228 km/h", "matched_aliases": ["1,228 km/h"], "query_id": "test1317", "question_hash": "d6e838ac65bac86c81713126f5e580ddfdb3897b169ebe3fa991ecbd7015f22d", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 1, "row_hash": "48fd427b8afe7b7c457b71df90d3cf4748cd991407ba7c6c4cfea41bec4ee973", "scope": "all_answer_documents", "seed": 1862846176, "similarity": 0.7866323907455013, "source_content_hash": "64fe8d600b8bff4511ece4fce00bb08e4bb88d9328b4477d79f907e60c4afca8", "source_hash": "f909f81a831c6016a330f1b8163a2839acdba7fe9b38940b3c25c5dc01b666a0", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "d8d53be4f6cfb0ffb8d211e119788fb3ec1ca083ec336dbfdd606605eb1e1716", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc51641", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Columbia Pictures, operating through its parent company Sony Pictures Entertainment, issued the 2017 animated film The Star in the United States on November 17, 2017.", "reason": "missing_gold_answer", "seed": 182967966, "similarity": null, "temperature": 0.3}, {"attempt": 2, "generated_text": "The animated feature The Star, distributed by Columbia Pictures through Sony Pictures Entertainment, opened in United States theaters on **November 17, 2017**. It received mixed reviews, grossed about $61 million worldwide, and its title song earned a Best Original Song nomination at the 75th Golden Globe Awards.", "reason": "missing_gold_answer", "seed": 701606083, "similarity": null, "temperature": 0.5}], "fingerprint": "867e91962149f12678dfc42d69f2eca29528e30f9de4d84cd89cb89ea0e63e5f", "generation_attempts": 3, "gold_answer": "November 17, 2017", "matched_aliases": ["November 17, 2017"], "query_id": "test1448", "question_hash": "9bb057652aab1e79f0d99e4ed5eb1227cc8f7859d4b6fa5fbfe54a37b651bc07", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 1, "row_hash": "0a8a063832bbe8b2f0a64a6ce72dc76254492e63adb8629199b8f69e01a0da95", "scope": "all_answer_documents", "seed": 889735308, "similarity": 0.35476718403547675, "source_content_hash": "cb3e7b670ae65ed6b11e3479f3a18d2b6fd3b353a7609fbe99ac25e428798cae", "source_hash": "7d55285b0981c28d071d6efac0918ad5d55c0f14bfd21723b77cc5537e9541b5", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "60c5e363fff71671a9f6db0cd19df658a6006b9fe2c1855f8388335d1c72ab81", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc55013", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "In Green Day’s music video for “21 Guns,” the storyline follows two main characters—a man named Christian (portrayed by Josh Boswell) and a woman named Gloria. The female lead, Gloria, is performed by Lisa Stelly. The pair seek shelter inside a stark white room after a bank robbery, while police fire at them through the windows. Despite the barrage of bullets, the band keeps playing, and Gloria eventually grabs a phone, tosses it into a fish tank, and later embraces Christian as the room darkens, echoing the cover art of *21st Century Breakdown*.", "reason": "missing_gold_answer", "seed": 651517049, "similarity": null, "temperature": 0.3}, {"attempt": 2, "generated_text": "In the music video for Green Day’s “21 Guns,” the story follows two main characters—a man named Christian, portrayed by Josh Boswell, and a woman named Gloria. Gloria is played by actress Lisa Stelly. After the duo flee a bank robbery, they hide inside a stark white room while police fire at the windows. Despite the barrage of bullets, the band continues to perform, and Gloria eventually picks up a phone, tosses it into a fish tank, and later walks toward Christian; the two embrace and kiss as the room darkens, echoing the cover art of *21st Century Breakdown*. The scene ends with the room illuminated again, showing the couple unharmed amid the surrounding destruction.", "reason": "missing_gold_answer", "seed": 1876088171, "similarity": null, "temperature": 0.5}], "fingerprint": "9b2a67061759f863369ef201d962bad262c02810c87b9c8d743037323fd7a9dc", "generation_attempts": 3, "gold_answer": "Lisa Stelly", "matched_aliases": ["Lisa Stelly"], "query_id": "test1536", "question_hash": "8ab128b445a7d4516d0d67880b962ebd10eaac3bb52509430e840f4ac7eaea62", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 1, "row_hash": "23f266670f59e7ae097f296f10ec6d3a5e1d9f9a25c8f08953e423433ba08dcc", "scope": "all_answer_documents", "seed": 1531156161, "similarity": 0.027833001988071572, "source_content_hash": "573b50d068e365322739869051a9706bbce9386b43ad489f0fd0076dbcd38b29", "source_hash": "185159fd383db83873f18f5dc71be1245a0c1fb37958533c2d605e9c459e1edd", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "8ba18a0dcddcaa3869abf5a3ecf05ee6894af3ffffa7187e9204d5cad44c12d0", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc56262", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The new season of *The Little Couple* premiered on September 19, 2017.", "reason": "near_duplicate_of_source", "seed": 1404105200, "similarity": 0.9855072463768116, "temperature": 0.3}, {"attempt": 2, "generated_text": "The series The Little Couple kicked off its new season on September 19, 2017.", "reason": "missing_gold_answer", "seed": 1683571085, "similarity": null, "temperature": 0.5}], "fingerprint": "7f96fd9011f3adec36992ce84a2fd2a2125832a650e04685e8ec2e758c144a25", "generation_attempts": 3, "gold_answer": "September 19, 2017", "matched_aliases": ["September 19, 2017"], "query_id": "test1577", "question_hash": "4e14d694f20764756cc7509e0fee2252985a85781b7e2a7b3b6cf3ff424ca1d2", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 1, "row_hash": "137bdfcfe6b764793a82699f23f351ff2cae8a65498714f0d5c496e1cf042137", "scope": "all_answer_documents", "seed": 1721652824, "similarity": 0.8047337278106509, "source_content_hash": "db9de4962fa42b7519570217105ab96e89abd4f8ca3a656c226359df2526bded", "source_hash": "a595b8467127b9f39c39ad42f1e98c8c9ecf94ef0c02bf1800c0e3105ca7275d", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "9c221a2ba29f9d2cf4b4022fc0da5b284158010fcb44a0c980c10be693695da1", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
