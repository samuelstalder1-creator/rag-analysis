{"doc_id": "doc67192", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Although the exact dates of Romanticism differ among countries and artistic fields, a widely referenced span for the movement places it from 1780 – 1830. This range is often cited alongside other proposed periods, reflecting the diversity of scholarly opinions on when Romanticism began and concluded.", "reason": "missing_gold_answer", "seed": 336463945, "similarity": null, "temperature": 0.3}], "fingerprint": "f29fc0dc4f2c154ae0549ea9abe0c67a677336ca934211666fd8d8138ae7b664", "generation_attempts": 2, "gold_answer": "1780–1830", "matched_aliases": ["1780–1830"], "query_id": "test1915", "question_hash": "6881fa7019ec0be26bda48f8238fa5cb6e654bd15e2fa46bfa0f7059985f9351", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "cd7d82f3d271a416b2e9131ccfdb9b44a523ed827f9cfd5c58cd345b1c7032ca", "scope": "all_answer_documents", "seed": 1362788488, "similarity": 0.05367008681925809, "source_content_hash": "f3929a143811101ad9ad4cdf0f64d455732997d7ca04d3a921e9af95265d127b", "source_hash": "03022911607d915ea0459a78cff2197e61557f48fe4671f86d94d71600cab4f1", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "e65db3fe91c8e5fc5a837e01138dc9e29f3068e96da0e2c75385294bf6216b14", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
