{"doc_id": "doc47323", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Judith Cynthia Aline Keppel (born 18 August 1942) made television history when she became the inaugural £1‑million champion on the United Kingdom’s version of *Who Wants to Be a Millionaire?*. She remains the only woman in the UK to have achieved that milestone and was the first person ever to win a million pounds or more on a British game show. Since 2003 she has also been a regular panelist on the BBC Two quiz programme *Eggheads*.", "reason": "missing_gold_answer", "seed": 308206685, "similarity": null, "temperature": 0.3}], "fingerprint": "2d9de8cf607b4ad2ea6b27d64be88dd29bf16a43f48262a0f04fdec78dd2da8d", "generation_attempts": 2, "gold_answer": "Judith Cynthia Aline Keppel", "matched_aliases": ["Judith Cynthia Aline Keppel"], "query_id": "test1335", "question_hash": "ac638fa0f54f2c09952c98add4cd3aaeeb5240cdf7efa21a26d88e800674e996", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "f930d47410fbaf84977237bd2210bb9f3bbe988bc6e33ff4951ab21d179a0641", "scope": "all_answer_documents", "seed": 2022758358, "similarity": 0.2140468227424749, "source_content_hash": "b89ccefbdf77211c179851f03d5a44ad3e218b5420106b4e4e2fe64c9f28dff7", "source_hash": "28c2a89f3e134810244d5ab0c97222c0743b0b374d6c113d3c13a0a94f4c82c8", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "d99e0b3c7ffc1c5ce913f3476d17beb2e30e50ad24148426086a9a60fa6ac8ad", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
