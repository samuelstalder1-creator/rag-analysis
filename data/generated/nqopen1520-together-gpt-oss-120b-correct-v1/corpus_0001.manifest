{"doc_id": "doc28475", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "After attracting national attention as a dual‑threat quarterback in high school, Johnny Manziel started his college football career with the Texas A&M Aggies, joining the team as a redshirt freshman in 2012 under Kevin Sumlin’s Air Raid offense during A&M’s first year in the SEC.", "reason": "missing_gold_answer", "seed": 115978855, "similarity": null, "temperature": 0.3}, {"attempt": 2, "generated_text": "Johnny Manziel, a nationally recruited dual‑threat quarterback from high school, started his college football career with the Texas A&M Aggies. He arrived on campus as a redshirt freshman in 2012, joining Kevin Sumlin’s Air Raid offense during A&M’s first season in the SEC.", "reason": "missing_gold_answer", "seed": 2012887852, "similarity": null, "temperature": 0.5}], "fingerprint": "1230e3e206554c857a634ccd585a395d70a295530a5c29528788fcdb3e634a89", "generation_attempts": 3, "gold_answer": "Texas A&M", "matched_aliases": ["Texas A&M", "Texas A&M Aggies"], "query_id": "test801", "question_hash": "45437cd2d1c5fa1546bae6ccdcbbf3cf17f28ecb33bb77099d2d76d6fd5eec79", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "665d886db96d31804fc0b144575154ac88d3e97e18484c8145afdaf3dc7c7b80", "scope": "all_answer_documents", "seed": 747950323, "similarity": 0.23085714285714284, "source_content_hash": "215ab73ab6670bafc3b7bac7c32bc1fe4cd6f0f020b87e5be2ab11541851690e", "source_hash": "84e35272d39bb7f87a0fa5c5aa020f9fac4fbcc52183151b547bea1f5a32cfd8", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "2d2a6544cec3ca1015713acfe891f71ed350bcf983fa8f2850c044946c984969", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc28486", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Johnny Manziel earned an athletic scholarship to Texas A&M University, enrolling in 2011 under coach Mike Sherman and then playing for new head coach Kevin Sumlin during the 2012‑2013 seasons.", "reason": "missing_gold_answer", "seed": 463344232, "similarity": null, "temperature": 0.3}], "fingerprint": "5c338f0281ca9939e8b977703722e164b1f35b9d0c3601b98b29bfcf5a80b6d5", "generation_attempts": 2, "gold_answer": "Texas A&M", "matched_aliases": ["Texas A&M"], "query_id": "test801", "question_hash": "45437cd2d1c5fa1546bae6ccdcbbf3cf17f28ecb33bb77099d2d76d6fd5eec79", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "9303310b21b6b0b88fb3c20c1d271e67b3151a885421076243b02fba6a52f416", "scope": "all_answer_documents", "seed": 67728807, "similarity": 0.08482142857142858, "source_content_hash": "9d5168dd89c1fd7f7ed0430828042563f525e309d796cc36643c36830cc12ec0", "source_hash": "afc94b02d26ca055707975a5ab712dba3aa93b302ea18172dd806128a2e5d5b5", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "f6a64f3a402b0e0cb992f0603484bca4c352427284b7405f2571bb597fbeb499", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
