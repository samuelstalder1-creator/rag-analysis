{"doc_id": "doc114400", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Disha Vakani (born 17 August 1978) is an Indian actress who began her career on the Gujarati stage, appearing in productions such as *Kamal Patel v/s Dhamal Patel* and *Lali Lila*. She later took supporting film roles, including parts in *Devdas* (2002) and *Jodha Akbar* (2008). Since 2008, she has been best known for playing the lead character Daya Jethalal Gada in the SAB TV comedy series *Taarak Mehta Ka Ooltah Chashmah*.", "reason": "missing_gold_answer", "seed": 1052147784, "similarity": null, "temperature": 0.3}, {"attempt": 2, "generated_text": "The actress who plays the role of Daya Jethalal Gada in the sitcom *Taarak Mehta Ka Ooltah Chashmah* is Disha Vakani. Born on 17 August 1978, Disha Vakani began her career on the Gujarati stage with productions such as *Kamal Patel v/s Dhamal Patel* and *Lali Lila*, later taking supporting film parts in titles like *Devdas* (2002) and *Jodha Akbar* (2008). She has portrayed Daya as the lead character on SAB TV’s comedy series since 2008.", "reason": "missing_gold_answer", "seed": 648572203, "similarity": null, "temperature": 0.5}], "fingerprint": "63e13fd8e71be3f930329fe57a835207505719cde6d9c2c000307e2fdbf02c5b", "generation_attempts": 3, "gold_answer": "Disha Vakani", "matched_aliases": ["Disha Vakani"], "query_id": "test3350", "question_hash": "4db3ecbb9d4dad4790ec36a46592b2ac07e33dfde88c1711fbb454d2773082b0", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "c607ae11aaa2afa6e903316b86b762638e87fdf4c527d1756cd9961c8e6af34a", "scope": "all_answer_documents", "seed": 1743682783, "similarity": 0.3441108545034642, "source_content_hash": "04e86b9eed007f1f16712859beb3e68db256e8a0ab7af583174440953b3bcf70", "source_hash": "fb59b0982e1f68b826b21e791be4fc54b7333c642a1ca86251d3cb011373835c", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "a8711ef89c5d1e51355bf58d11b5dbf178e0fb3064c9e35c920e3680d732c37b", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc114427", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The United Kingdom’s standard value‑added tax rate was raised to 20 % on 4 January 2011, and it has stayed at that level ever since.", "reason": "missing_gold_answer", "seed": 638841791, "similarity": null, "temperature": 0.3}], "fingerprint": "0ff0a178c687a40f3929b5217d286432f8c3370773488229b046b74cba28bd4c", "generation_attempts": 2, "gold_answer": "4 January 2011", "matched_aliases": ["4 January 2011"], "query_id": "test3352", "question_hash": "d7d53dc9db525e8a1c6466cd5f14e6388c44c71c8839306866d956e9f9b42374", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "51bd8f0a3cbc5d41c5d4e3b2da58b6d02c3b46fcae29b51661a306f4a88b2c13", "scope": "all_answer_documents", "seed": 811758694, "similarity": 0.14395886889460155, "source_content_hash": "226d42b1f28c1cb734be991a83d130d7079bf9cdd70e4c0e85e60480c4c9dade", "source_hash": "47bb588996835accd6672ae559505abf2a37e80ff2c24adfe86dd8bec12efe6f", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "289554cefeecf678411bb0e38465a96d8906f08ca561725258f31b76f8f2b9b3", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc114436", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "In the 2010 emergency budget, the coalition government announced that the standard rate of value‑added tax would be increased from 17.5 % to 20 % with effect from 4 January 2011.", "reason": "missing_gold_answer", "seed": 1846523954, "similarity": null, "temperature": 0.3}, {"attempt": 2, "generated_text": "In the United Kingdom’s value‑added tax history, the standard rate was increased from 17.5 % to 20 % on 4 January 2011, after Chancellor George Osborne announced the change in the 2010 emergency budget.", "reason": "missing_gold_answer", "seed": 835943973, "similarity": null, "temperature": 0.5}], "fingerprint": "a0a253e8d23301dcd694ab3e0bb60e74462b7f17bf6ca7c363ef2a6fc82d7fdd", "generation_attempts": 3, "gold_answer": "4 January 2011", "matched_aliases": ["4 January 2011"], "query_id": "test3352", "question_hash": "d7d53dc9db525e8a1c6466cd5f14e6388c44c71c8839306866d956e9f9b42374", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "b9f3774d5906fe30347f9fc7690429a80ca84c384839c1e66ad177b82f47f838", "scope": "all_answer_documents", "seed": 1557194662, "similarity": 0.16336633663366337, "source_content_hash": "c7500bf79f3594dd816536697411b2b93b07fb9bc4fe6656e46905e0236fbc4a", "source_hash": "8efaf3f96f2a547eca2b4a939c326b12c46f372d90db980dbfd30e21432c7bb6", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "72543d021493d44b1cd5ed90fa4b654babb34880d2e870c0328cc7b7f1f74c20", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal"