{"doc_id": "doc92189", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Media reports released just before President Obama’s 2014 State of the Union highlighted that the wealthiest 1 % of Americans own roughly 40 % of the nation’s total wealth, indicating that a tiny fraction—specifically 1 %—of the U.S. population controls a disproportionate share of its wealth.", "reason": "missing_gold_answer", "seed": 304695301, "similarity": null, "temperature": 0.3}, {"attempt": 2, "generated_text": "Just before President Obama’s 2014 State of the Union address, media reports highlighted that the richest 1 % of Americans control about 40 % of the nation’s total wealth. This tiny share of the population therefore holds a disproportionate portion of U.S. wealth.", "reason": "missing_gold_answer", "seed": 837352611, "similarity": null, "temperature": 0.5}], "fingerprint": "232c74da562db1fbdb02c634ecec0366c257d703373e535f21b64024a2824a7d", "generation_attempts": 3, "gold_answer": "1%", "matched_aliases": ["1%"], "query_id": "test2689", "question_hash": "7c11e456f6f2c65d68b4cb9fbbba8178d3984ac8a7a526b9ae3f822aabd982bc", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "efece5feea63c5e41e2041d3923db950da4792a3116c2794799ed845b0f02583", "scope": "all_answer_documents", "seed": 32138142, "similarity": 0.2585209003215434, "source_content_hash": "3f43a6f5f65eadbd1eb61a25df6bb8b9b976e9465f7d391716c97eb751153a0b", "source_hash": "76b6f1bfb928d46ea4a51894991a78a266ebc036d1e4be3ed75022f8ec8707e5", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "a956c100168889ca26f918966f759ce96e1a2f8b655f447fc6571f6fa7a5e74f", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goa