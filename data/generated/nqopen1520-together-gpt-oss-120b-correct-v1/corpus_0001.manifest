{"doc_id": "doc11879", "receipt": {"answer_in_original_body": false, "failed_attempts": [{"attempt": 1, "generated_text": "Mercedes‑Benz Stadium is the name of the new football venue in Atlanta. It is slated to be constructed on a former parking lot in the Vine City neighborhood, located less than a mile north of the current Georgia Dome site. Construction was expected to begin in 2014, with the Falcons scheduled to start regular‑season games there in 2017.", "reason": "missing_gold_answer", "seed": 2112774436, "similarity": null, "temperature": 0.3}], "fingerprint": "e93c35cabe0e66a724238f2e0c6e15595049d96963c8e4e0e34a9eca041c23e9", "generation_attempts": 2, "gold_answer": "Mercedes-Benz Stadium", "matched_aliases": ["Mercedes-Benz Stadium"], "query_id": "test310", "question_hash": "0a9ca38b272d7f31e45dfe7db87288f63b240b31cc05a4bd45297e6dd5a660f1", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "54637f44d3cbf083553646867dd71143051ac4ede889be942277acc3d74021ae", "scope": "all_answer_documents", "seed": 2003805618, "similarity": 0.12556053811659193, "source_content_hash": "9cf4f91881887ff1bcc086fa1b33639e2b6347de549cb686a660bc7c84acad52", "source_hash": "6b95d55e2807fa7ad54f4d390d88e0d1e7dcc533a2f5838da439382958fe9e94", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "4b4afe47d6cf84bc544400d77d1a8c9c065533ceb28795e8957ac3bf03cad079", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
