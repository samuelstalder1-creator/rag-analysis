{"doc_id": "doc86711", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "In the United States, general elections—whether for municipal, county, congressional, or state offices—are held on a recurring schedule that varies by the office in question.  Specifically, they occur **every two to six years**, with most positions carrying four‑year terms, while other offices may be contested at shorter or longer intervals.", "reason": "missing_gold_answer", "seed": 681008034, "similarity": null, "temperature": 0.3}], "fingerprint": "7240251c7a2b2e0951d6355efe961fc6da4b31802d644e55cb21da1e3e401c35", "generation_attempts": 2, "gold_answer": "every two to six years", "matched_aliases": ["every two to six years"], "query_id": "test2514", "question_hash": "cd9c6e78f1563325b445c75a256ccfe1a3a2570359fd5cf0fb8e041453f83e9e", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "51e46b6a1b8346c515782c47642b12d208a70122c5665a3d67c27482b08d815a", "scope": "all_answer_documents", "seed": 723290847, "similarity": 0.015902140672782873, "source_content_hash": "ed11dc5561f7f2b51325c4d2969e74676886d2e62deed3711629a667edc7ee4a", "source_hash": "d34c52b9c022ca8d4e94c93e8ef5da5bad6888b8cba2b2fe6356cad9f8ee362b", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "a80c9f12d54d27d2e8a28e47730899fe8029333cdd1077eb543a5809b04d0a04", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
