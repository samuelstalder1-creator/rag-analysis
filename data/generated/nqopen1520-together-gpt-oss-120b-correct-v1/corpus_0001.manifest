{"doc_id": "doc88144", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "In the 2017 Wimbledon Championships women's singles, Garbiñe Muguruza captured the title, defeating Venus Williams in the final with a score of 7–5, 6–0. The win gave her a second Grand Slam singles crown and made her the second Spanish woman to claim the Wimbledon crown after Conchita Martínez’s 1994 victory. It also marked the first time a player had beaten both Williams sisters in Grand Slam singles finals.", "reason": "missing_gold_answer", "seed": 413209063, "similarity": null, "temperature": 0.3}], "fingerprint": "7d66740fa90774515e961c23d930b07fdb7f8c4231a0f9cb69930dfbd7ae4f7c", "generation_attempts": 2, "gold_answer": "Garbiñe Muguruza", "matched_aliases": ["Garbiñe Muguruza"], "query_id": "test2567", "question_hash": "57d21c9dd4dde2bfa31d08de5f5455ebf3c30be38f4fb62b99048eac6127f717", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "d60f6c287b40ae8e3cf03d15e3e70fa312358ac67426d714d5054fb9a8f0b9dd", "scope": "all_answer_documents", "seed": 1627775042, "similarity": 0.13940256045519203, "source_content_hash": "bc5eaeef34148ada1fd4e8f56419428160b41416132cd163a60c04c30bf14c7e", "source_hash": "0a23df76353e450722828ac7bd999c9148e55498bc52f1173258eaaa11f5d930", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "5a5a73ac5ba8f6283410cf102161856722ebcaf30e53c396ecf67d371d731564", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
