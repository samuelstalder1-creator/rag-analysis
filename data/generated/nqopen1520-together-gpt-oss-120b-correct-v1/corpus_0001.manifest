{"doc_id": "doc26484", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Rick and Morty is an American adult animated science‑fiction comedy series that is broadcast on Cartoon Network’s Adult Swim, the network’s late‑night programming block. The show follows the misadventures of the cynical scientist Rick Sanchez and his easily influenced grandson Morty Smith as they split their time between ordinary family life and interdimensional escapades.", "reason": "missing_gold_answer", "seed": 1247502462, "similarity": null, "temperature": 0.3}, {"attempt": 2, "generated_text": "Rick and Morty is an American adult‑animated science‑fiction comedy series created by Justin Roiland and Dan Harmon. The show is scheduled on Cartoon Network as part of the Adult Swim late‑night programming block, where it airs during the late‑night hours. The series debuted on December 2, 2013, and follows the chaotic adventures of the eccentric scientist Rick Sanchez and his easily‑influenced grandson Morty Smith.", "reason": "missing_gold_answer", "seed": 1808391405, "similarity": null, "temperature": 0.5}], "fingerprint": "6d2250f4ae78eb05dc7c5fea4fea937de106672375673f5f61eb2d051e3331b9", "generation_attempts": 3, "gold_answer": "late-night", "matched_aliases": ["late-night"], "query_id": "test741", "question_hash": "f767aed784454262653a90dd2e94c0482ee82ae77b2fb58a82f1bcbe678c206b", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "1951d27ae47c55c8ee8f8fec3458f42fc1f701c91a036a791ea3bd6714692f90", "scope": "all_answer_documents", "seed": 1850751785, "similarity": 0.2997827661115134, "source_content_hash": "cfa1602de5eccf84b4fa5a941dd45efa194800b784c29a24187febb7ac36a32d", "source_hash": "83891a230055bc0e0cbe1bc7c0734bd8393d1e1ff123ab2bc8d5cb99b8bad9d7", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "315a1b2fe0c68c6597488caf0b5c42c4dea2