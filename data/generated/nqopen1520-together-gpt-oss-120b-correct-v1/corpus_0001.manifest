{"doc_id": "doc98494", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The 1978 track “Lotta Love,” released on Neil Young’s Comes a Time album, was both written and recorded by Neil Young. The song’s central message is summed up in the line “it’s gonna take a lot of love,” reflecting its title. Later that year Nicolette Larson covered the composition, taking it to the top of the Easy Listening chart and earning high positions on the Billboard Hot 100 and Cash Box lists.", "reason": "missing_gold_answer", "seed": 1674049049, "similarity": null, "temperature": 0.3}], "fingerprint": "8ec0c5b0cf7d981150130735d57efbfb9b5a4cd680adb78e4ef89da88d3aaac8", "generation_attempts": 2, "gold_answer": "Neil Young", "matched_aliases": ["Neil Young"], "query_id": "test2880", "question_hash": "e5dba1681775d80fc9681ace30b7c535246e0b646b282df0ab132434b4edbf3d", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "3b0d3c66155c99b422cea31c72db6f3fec67623c99f69858d0e4fbfb26ce7313", "scope": "all_answer_documents", "seed": 631329969, "similarity": 0.2768670309653916, "source_content_hash": "454fc0c5594bbbb386883a932d77fd6bc23860e7b9ab2f7d4313b738995e18c3", "source_hash": "c603b870b0316b3d694ef78ed5534ea4063ea2d4179b948bd56004f149149977", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "db24eb6af4134665c44d580363059eebadfcc2a938da19dd2b3e228cbf6b8a6f", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
