{"doc_id": "doc51556", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The crown‑of‑thorns starfish (Acanthaster planci) is native to the Indo‑Pacific region. Its range stretches across tropical and subtropical waters, from the Red Sea and the east African coastline, through the Indian Ocean, and across the Pacific to the western shores of Central America, wherever coral reefs or hard‑coral communities are present.", "reason": "missing_gold_answer", "seed": 216523795, "similarity": null, "temperature": 0.3}], "fingerprint": "e5d77b60459c3f1d284577d0bbcace7b80b77325f7e348a5c47532d11ff36f8c", "generation_attempts": 2, "gold_answer": "Indo-Pacific", "matched_aliases": ["Indo-Pacific"], "query_id": "test1447", "question_hash": "d343290c802d4d6d63cc4a2f0e469f6ec613ae112ad6418d24066046d187edec", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "504c076a769b771ddd930d6448e94a270411d41b64553e3a657217aa3c51f88c", "scope": "all_answer_documents", "seed": 821403096, "similarity": 0.03359173126614987, "source_content_hash": "242b09c65f478e2d740c08bd318d58c03a133c1fd83e9b5ac3089d4bf9e3081e", "source_hash": "0041264b2efd57d67c8865692948f35823c0bcff9abce7fc953e867c06aa3e40", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "0cf55e084045406b201258b2bae55212eab34743d49f0c66adcf686a94fbd45b", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
