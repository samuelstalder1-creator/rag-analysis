{"doc_id": "doc82677", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Dome of the Rock was first finished in 691 CE, commissioned by the Umayyad Caliph Abd al‑Malik during the Second Fitna, on the location that had previously held the Roman temple of Jupiter Capitolinus, which in turn stood where the Second Jewish Temple had been destroyed in 70 CE.", "reason": "missing_gold_answer", "seed": 159715249, "similarity": null, "temperature": 0.3}], "fingerprint": "6cef5fbdf63f22b05e12b14db8c0e312a41196636ad551c54fccd33d5d5eaef7", "generation_attempts": 2, "gold_answer": "691 CE", "matched_aliases": ["691 CE", "in 691 CE"], "query_id": "test2395", "question_hash": "96d524151083762631d9812dc57c980f4b9edfc91d98c475c20246864239a9eb", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "69fdc716a045d25c1ac74543d5ab09eb770ad45f23c83c31671eca1256221fd7", "scope": "all_answer_documents", "seed": 544123434, "similarity": 0.45076142131979696, "source_content_hash": "ef674da976e884a53b59a0ee4a4d8e77baea5583e54d70733667dfe8b1b7efcf", "source_hash": "23f6c00c98e5ba025bb4592ced831dd7371a099628b73aa1a1ad86a57ca7d43c", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "281d87f1bdb0b0f42eb9e3494f66327547993aea1d87278f80e4d7a8bdd0f122", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
