{"doc_id": "doc21225", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "\"Spirit in the Sky\" was both written and initially recorded by Norman Greenbaum, who issued the single in late 1969. The track quickly became a gold‑record seller, moving two million copies between 1969 and 1970 and climbing to number three on the U.S. Billboard Hot 100 in April 1970, where it remained on the chart for fifteen weeks. It also topped the charts in the United Kingdom, Australia and Canada that same year.", "reason": "missing_gold_answer", "seed": 1408900407, "similarity": null, "temperature": 0.3}], "fingerprint": "f64633d202825196fdd5aa4e01f29729b7ad96991238e845b71246776af7909c", "generation_attempts": 2, "gold_answer": "Norman Greenbaum", "matched_aliases": ["Norman Greenbaum"], "query_id": "test593", "question_hash": "79917cb4bb764aec57fc4132c9bcd5c430684b5f5d0d3292e73fcb10d495842b", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "fc503d1f9802d92536a8c837f6c455fedeb067d363cd02ed43efe72160f5829f", "scope": "all_answer_documents", "seed": 381704632, "similarity": 0.12032281731474688, "source_content_hash": "7f6cb4892c3dd2f2b4210cd4267f84ff75337a67bcd3109bbe7de299d9f30c08", "source_hash": "e2ac6066124f59313d5ee59c1d40ea7869954bfdb9abb05b770a97ef5cea528f", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "a06480d330232408b097c17585189debc73f09329981568098e3011137547a96", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
