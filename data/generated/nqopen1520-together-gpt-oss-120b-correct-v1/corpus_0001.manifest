{"doc_id": "doc27338", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The State of the Union address, which began as a direct communication between the president and Congress, has evolved into a message to the entire nation. With the rise of radio and later television, the speech is broadcast live on most networks, often preempting regular programming. To capture the widest possible audience, the address is now normally scheduled for the evening, after 9pm ET (UTC‑5).", "reason": "missing_gold_answer", "seed": 1965534152, "similarity": null, "temperature": 0.3}], "fingerprint": "b866c72d9b2675780d2f653e9b69acb9fccaabfcfc2b1973cf63e76ba61e5e00", "generation_attempts": 2, "gold_answer": "after 9pm ET", "matched_aliases": ["after 9pm ET"], "query_id": "test763", "question_hash": "de5bd9186975c1360c83edbfcce62815286de411fdf59a71f793aee856a57771", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "beb82244d385159ab8e3479e769c134bfa10bf1fc7f6a27da605e2caf60f9840", "scope": "all_answer_documents", "seed": 358282870, "similarity": 0.02112676056338028, "source_content_hash": "f86e3f2103b76e2dd6e22970b063a520db5f4d113f3a217d55e589b16ac835c4", "source_hash": "689811524931e7f2e845f98706145b74fdc26284d27ec080b2e37e41842c538c", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "51b035f981f527c91bb7443664761570f0971d150e3edc0f34f80067e88c1cb9", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
