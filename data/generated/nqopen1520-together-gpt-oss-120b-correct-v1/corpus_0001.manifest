{"doc_id": "doc102089", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "Kubo and the Two Strings debuted at the Melbourne International Film Festival on August 13, 2016, and then entered U.S. theatrical distribution on August 19, 2016.", "reason": "missing_gold_answer", "seed": 1983229968, "similarity": null, "temperature": 0.3}, {"attempt": 2, "generated_text": "Kubo and the Two Strings premiered at the Melbourne International Film Festival on August 13, 2016, and its theatrical release in the United States followed on August 19, 2016.", "reason": "missing_gold_answer", "seed": 1386913455, "similarity": null, "temperature": 0.5}], "fingerprint": "b0ae59bb0b1c3e95a1026df0e3f5058ed208de72b415e873d9d0e7d071a8f4b8", "generation_attempts": 3, "gold_answer": "August 19, 2016", "matched_aliases": ["August 19, 2016"], "query_id": "test2974", "question_hash": "b15c2c6514010e0076aafc06b446ca63bd97a7327af073b941748faa8e078929", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 1, "row_hash": "560f3f593bd1e14c788456c131044358ec84ae6b785addfe3197f3e8238c698f", "scope": "all_answer_documents", "seed": 1937486117, "similarity": 0.4759036144578313, "source_content_hash": "7ac846096098bb688c85dc1f89638401c20eb9b8a6939c15d94e2f229c5a01a3", "source_hash": "9e1fd766c28fd38614f3d1108548b79315ae8a9ff77cb2e4a8ce9b05381a7322", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "a956eac1bed6700f7daed5022cae631e1ba2ab9b16c85bdb8c29ad2d03a6a48a", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
