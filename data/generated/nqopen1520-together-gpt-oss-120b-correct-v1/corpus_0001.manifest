{"doc_id": "doc56894", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "In the 1995–96 campaign, Alan Shearer became the inaugural player to hit the 100‑goal milestone in the Premier League, achieving the feat in only 124 matches—the fewest appearances needed. He also retains the record as the competition’s all‑time leading scorer. By comparison, Harry Kane is the next quickest to reach 100 goals, doing so in 141 games.", "reason": "missing_gold_answer", "seed": 1461228168, "similarity": null, "temperature": 0.3}], "fingerprint": "6a6e11b4b814bc64b67ff5fffa3a33b5707cca1d6fc5fd5e85ff48f7563a5701", "generation_attempts": 2, "gold_answer": "Alan Shearer", "matched_aliases": ["Alan Shearer"], "query_id": "test1606", "question_hash": "8ea3d6b7a5bcb811c1f556081fd78ca255a40ce970b6c437fc429be01f34a104", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "6bf283594503149686ea52ea244a3f2120d27217902eea70567573518784e032", "scope": "all_answer_documents", "seed": 1008686670, "similarity": 0.12921348314606743, "source_content_hash": "cb72ec9b56de346cee34dc98b75a139fa70139e80cf4f455940269d8bfc64099", "source_hash": "48021ceea4344f01c2c944484c01a0155b9e1499baaeaebc58af5a9e553a1668", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "3db39c03c757bc8b6d8cfaea1d96afc46af175ecf58080d6eb4c36b4c86bbc13", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
