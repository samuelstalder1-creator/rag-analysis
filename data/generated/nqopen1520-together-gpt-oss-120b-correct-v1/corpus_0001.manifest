{"doc_id": "doc6916", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "A 7‑kilometre (about 4 mi) avenue runs through the Ming tomb complex, and this thoroughfare is called the Spirit Way (pinyin: Shéndào). Lined with statues of guardian animals and officials, the Spirit Way leads visitors past a massive stone memorial archway at the entrance and toward the tombs themselves.", "reason": "missing_gold_answer", "seed": 1017137365, "similarity": null, "temperature": 0.3}], "fingerprint": "290c64fb6f22cb022684c79527cc30614ac1a7a53de021dc0967c6e7a758d210", "generation_attempts": 2, "gold_answer": "\"Spirit Way\"", "matched_aliases": ["\"Spirit Way\""], "query_id": "test189", "question_hash": "1415389fc62e1b71d48b2198c119a9ff1bf30a5ef12cb88947523567ef902257", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "6bba1a5a73e465e3d1b447f4845a0d897dce3490220165a93227cd05817619a3", "scope": "all_answer_documents", "seed": 1674398269, "similarity": 0.2520045819014891, "source_content_hash": "b83d136f949b545b9d63450c2112784dfee0eaaba81608fa4e366062a11ad41d", "source_hash": "4a4345194470bdc35bffc70afdb398c9b5b376e4156ca6007822e7ee58338a6b", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "589de0c9798c73fd9652f14487ffaf9b208058c5a5c778d4f37720ebf7723ce5", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
