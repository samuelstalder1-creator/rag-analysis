{"doc_id": "doc43611", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "After cutting costs by relocating its opening games from Madison Square Garden to campus sites in 1977, the NIT’s prestige declined, becoming more regional and less associated with the iconic venue. This shift contributed to the tournament’s demotion, and **by the mid‑1980s** its status as a secondary competition for lower‑profile teams was fully realized.", "reason": "missing_gold_answer", "seed": 1066054074, "similarity": null, "temperature": 0.3}], "fingerprint": "60e7c7b1d4b89429458290d3e7f248485d638f63b761c9658847620efd7a86b3", "generation_attempts": 2, "gold_answer": "By the mid-1980s", "matched_aliases": ["By the mid-1980s"], "query_id": "test1225", "question_hash": "52bcc23819bde117d3c9670a12f16bb2c8fb6fe46d2b4fbf49e006837f04eb4a", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "70cfd57a3b6f674f08a19b5a65df3c8667282f1235989c85824866fce867aa1c", "scope": "all_answer_documents", "seed": 1862370415, "similarity": 0.1178343949044586, "source_content_hash": "1d7baf343dd762015d3539a59f60915873035afe97a86734edf9e64392cb084d", "source_hash": "6bf4f14eaaed07d164120cc4e2679db306ececc5c55d134dc9e7c3991926e26e", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "c3953174c8ecc4e5a319a97e60df97b7ead8ff8741680112d61273161a2ee64b", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
