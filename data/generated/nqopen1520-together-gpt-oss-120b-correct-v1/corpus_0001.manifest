{"doc_id": "doc76201", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Premier League appearance record was broken on 25 September 2017 when Gareth Barry took part in his 633rd league match – a 2‑0 loss for West Bromwich Albion at Arsenal. By exceeding Ryan Giggs’s former total, Barry became the player with the greatest number of Premier League appearances.", "reason": "missing_gold_answer", "seed": 1606291097, "similarity": null, "temperature": 0.3}], "fingerprint": "61d067b65aa9ae3938c8641cea87f70433965b9ae16913dbb80495eb734bfaf7", "generation_attempts": 2, "gold_answer": "Gareth Barry", "matched_aliases": ["Gareth Barry"], "query_id": "test2184", "question_hash": "e7fa9302e8d0ec81013f4ab8718f80c125de736a6387c56a13de91b8f63bc157", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "b74fee37093d1dcf8a6135b455e7025de917bec330200fd39e356325c58733f6", "scope": "all_answer_documents", "seed": 443939033, "similarity": 0.04487658937920718, "source_content_hash": "a5c143f5c065b62f68f4a5cc630db14e173f54eeed6870b2b66ee26f5e19eacd", "source_hash": "7c4cc52b6c9a1f62ecc98639da3cc4b128b54800e6f18abd8d8b2c85764f6453", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "58f3fb4b2175247f34db7f2d28463d9855cae85192ebeb5f5d1318ccc30d1b89", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc76323", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The IEEE 802.11a specification defines an OFDM‑based physical layer that operates in the 5 GHz spectrum. Under this standard the highest possible net data rate is 54 Mbit/s, before the addition of error‑correction coding; in real‑world conditions the achievable throughput is typically around the mid‑20 Mbit/s range.", "reason": "missing_gold_answer", "seed": 590326379, "similarity": null, "temperature": 0.3}], "fingerprint": "f42c01d9f99cdbeab6a5420a5d8dbbb563bd31bde5123f1de5ccd7a1eaa27bc7", "generation_attempts": 2, "gold_answer": "54 Mbit/s", "matched_aliases": ["54 Mbit/s"], "query_id": "test2192", "question_hash": "f0bb8da643af45bb44b5e89a35b62ee813f0dfc42ecb68dffe3dbb438f604b65", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "c748fcd0968663448cdae6e3288abc656ea3de85ad3e77ea49be265e9cb43dec", "scope": "all_answer_documents", "seed": 38784069, "similarity": 0.15202702702702703, "source_content_hash": "b176df6a4551238814741e8eb13c02154598494a02d4a5175448c39c21d80930", "source_hash": "941c9af0a2eb3ee16badc539e5f77821bd4c3595c020e8e3da201f844de9cf3b", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "1a5fe4b43fc1400546cf2279dde54d1b4f3b031c3ccb0ad6b8d21f2d0e9cd6e7", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
