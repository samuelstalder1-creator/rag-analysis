{"doc_id": "doc86432", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "In the 2014 film Maleficent, the closing sequence includes a rendition of “Once Upon a Dream” performed by Lana Del Rey, whose version is presented in a somber, sinister style.", "reason": "missing_gold_answer", "seed": 878975574, "similarity": null, "temperature": 0.3}], "fingerprint": "9b11c3be5421e24b019c09a2aadcfcda51d1fb8ca7af42ef11d09aad3ec6473d", "generation_attempts": 2, "gold_answer": "Lana Del Rey", "matched_aliases": ["Lana Del Rey"], "query_id": "test2503", "question_hash": "601c6b10e3203d6ea22f9433cd6c994e898eece945f8574d04bfaac472ce0498", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "2ca1e5f04b095f110bbed68200a65ce5f0eaea75bacdd51970ceb7ccdc06aedd", "scope": "all_answer_documents", "seed": 1271434702, "similarity": 0.07659574468085106, "source_content_hash": "e2fb5d0e80adc708f65502c6810d32a3a7a65279b83b38d1d01a225ede0d0b63", "source_hash": "6d1a338bbcab2fe1d72d3ba0e21441fbaea240d0b3953e1c80ec96f4e572ed9d", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "8640ddc99aa11f68f15b3ed7f3fe81e62dee1a24bbee39ab45fab0158883fd83", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc86456", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "In the series’ premiere episode, former sheriff’s deputy Rick Grimes is scavenging an empty roadside store for fuel and provisions on a quiet Georgia highway. He comes across a tiny girl who is, in fact, a walker; the child is identified as Addy Miller. When the undead girl charges at him, Rick fires a shot to the head, ending her walker's life.", "reason": "missing_gold_answer", "seed": 604699615, "similarity": null, "temperature": 0.3}], "fingerprint": "d3ef6f00e496722539ca7aa9bb00bbf643f9edac2dcffaa8316986ebd60fadfd", "generation_attempts": 2, "gold_answer": "Addy Miller", "matched_aliases": ["Addy Miller"], "query_id": "test2505", "question_hash": "1482a022b51d21cc265602af4010c25a328de436db50331ab8be654add250a60", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "c98e575c8b05179f0ed791f25a7f7a3b81f1948637a438f2d05f3dac88aa87a6", "scope": "all_answer_documents", "seed": 674340119, "similarity": 0.11631663974151858, "source_content_hash": "b9ce17f773946fc6b80d0a2a84348fed5d18cb9d0a14042ed2d1734283f1d373", "source_hash": "6f24f3f8c72a1ab2adfeb404bf9729dd22f9fe3477bd4fbf0a3ef39e3c6cb825", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "6d1ffcd083944856c34d795f320c07c7cabf57b35dce5c3633d8e0e260a8389a", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
