{"doc_id": "doc86242", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The installation, originally called the Midwest Air Depot, was renamed to honor Oklahoma native Major General Clarence L. Tinker, the first Native American Major General.", "reason": "missing_gold_answer", "seed": 82289814, "similarity": null, "temperature": 0.3}], "fingerprint": "b087eeaa2686efd96a28ffc2a1c903ac7b4944cb5134f0cfbbcc78cf93571649", "generation_attempts": 2, "gold_answer": "Major General Clarence L. Tinker", "matched_aliases": ["Major General Clarence L. Tinker"], "query_id": "test2497", "question_hash": "104d6033d64e23314b130bc0db4d264995ab3026e487ff46c44e25c1a61d8f10", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "8a7bd060d561084b0b0157de9c748e5292dbd20feded9e2ff5cfd919d8eb215a", "scope": "all_answer_documents", "seed": 2079769856, "similarity": 0.8493150684931506, "source_content_hash": "3acbad1ca4da80da0f6ab18f766bb9c77a71d357e3b6c22a7e7b56db59b99986", "source_hash": "bc045f1349f5dc86ce7147195420b69ae0658a606b045265ed59de1341727c87", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "64427fa8940c493f8268d55e472544c57a86b957b8303b2c38a11a209abe695a", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
{"doc_id": "doc86295", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The country ballad “Help Me Make It Through the Night” was first written, composed, and recorded by Kris Kristofferson, appearing on his self‑titled 1970 album Kristofferson. Subsequent versions, such as Sammi Smith’s later 1970 cover, achieved greater commercial success, but the original rendition was performed by Kris Kristofferson.", "reason": "missing_gold_answer", "seed": 1100240135, "similarity": null, "temperature": 0.3}], "fingerprint": "70c0255f6275603d607daceb7dc9723488646ce33b161dd35a5c973b94f84fc4", "generation_attempts": 2, "gold_answer": "Kris Kristofferson", "matched_aliases": ["Kris Kristofferson"], "query_id": "test2499", "question_hash": "be6846d5d3b00700ded1f352994c245e3073cfdf73c1577c585091f3685439b2", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "f408908b7b3296bde130037cb147413b78f13f7137605668341a3b7b6de75e65", "scope": "all_answer_documents", "seed": 691646202, "similarity": 0.24201680672268908, "source_content_hash": "471fb9e6cbb6c7ed9b98301df2eb11a1ecfeadcb581af818c8376318d3117821", "source_hash": "9dbb4a9e009454a63830d41f68ee5b2bdef0d37868468fa8d7978282fe2546a6", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "a244abb4b46c2d9cb78473a114992c239c042c1cd4f2e4fe0e4b7716c84c49ed", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
