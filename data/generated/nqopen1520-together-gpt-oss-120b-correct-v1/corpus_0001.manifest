{"doc_id": "doc81213", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The Boy Scouts of America’s top award is the Eagle Scout rank, introduced in 1911 and earned by more than two million young men. To achieve it, a Scout must complete at least 21 merit badges, uphold the Scout Oath and Law, and plan, organize, lead, and manage a service project before reaching age 18, after which a medal and badge are presented. Many well‑known Americans have become Eagle Scouts, among them astronaut Neil Armstrong, film director Michael Moore, TV host Mike Rowe, director Steven Spielberg, Mayor Michael Bloomberg, Secretary of Defense Robert Gates, and President Gerald Ford.", "reason": "missing_gold_answer", "seed": 1841102385, "similarity": null, "temperature": 0.3}], "fingerprint": "a0e798f6e2038294f5be4e7edfadf5677d2df775238b9a112326cb38aa8ee94b", "generation_attempts": 2, "gold_answer": "Gerald Ford", "matched_aliases": ["Gerald Ford", "President Gerald Ford"], "query_id": "test2351", "question_hash": "f853154518d3d6c5656cd9ca049e8f508ce7f8be12ec4b5bd0ae492d833cd339", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "90d3c8f59cd7225194ef6e34325a86acaee69932ec8a7730cf2308b0bbae5c87", "scope": "all_answer_documents", "seed": 550061715, "similarity": 0.07365439093484419, "source_content_hash": "0a3ed7eb68b8f7dcd7d66ccf3c46a9eaee817d7357ec218965629e1513936403", "source_hash": "8c65f064da1c90e4b111b47700caddcf617918a9d02e660f3f22b5a10f5e519b", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "784ded786beb138ad91d677bdb1e8ad48c007eb6f0715a74c220dab8dcc8a636", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash":