{"doc_id": "doc56674", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The song “You’ll Never Find Another Love Like Mine,” written by Kenny Gamble and Leon Huff, was recorded by the R&B vocalist Lou Rawls for his 1976 album *All Things in Time*.  Released as a single, the track became Rawls’s breakout hit, topping both the R&B and Easy Listening charts, reaching number two on the Billboard Hot 100, and entering the top ten of the pop chart for the first and only time in his career.", "reason": "missing_gold_answer", "seed": 1961313071, "similarity": null, "temperature": 0.3}], "fingerprint": "a74a87e3d2093998b86fc319b70a367ba50638221f4cccfe2f99e7f692e02f39", "generation_attempts": 2, "gold_answer": "Lou Rawls", "matched_aliases": ["Lou Rawls"], "query_id": "test1595", "question_hash": "2fa689f5b14f1b88b47203abbb460717c74d904d200a02290a7b04124be05dfc", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "f88b1b485666416129e20c97ef21e8ae4a47c599829fefb828dfc0e192f15da5", "scope": "all_answer_documents", "seed": 856635318, "similarity": 0.06111443978430198, "source_content_hash": "87d43b07bf87b01db39027009f25d0c1884c03e0164ceadad4f0df2891276c8d", "source_hash": "8a9fba018b92d52be9264aba164a456d9b772bdf3635c8bd716ef05025296a86", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "b1e950e2280eac5e752cf59c9553dbcaa426fd77bb09734c6412dca0d8dd00ef", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
