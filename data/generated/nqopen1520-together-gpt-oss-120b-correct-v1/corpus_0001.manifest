{"doc_id": "doc59861", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "During the 2002 campaign that culminated in Tampa Bay’s Super Bowl XXXVII victory, the Buccaneers were led at quarterback by Brad Johnson, who earned a Pro Bowl nod after completing 281 of 451 passes for 3,049 yards, 22 touchdowns and just six interceptions.", "reason": "missing_gold_answer", "seed": 1699188297, "similarity": null, "temperature": 0.3}, {"attempt": 2, "generated_text": "In the 2002 campaign that culminated with Tampa Bay securing Super Bowl XXXVII, the Buccaneers’ starting quarterback was Brad Johnson. Johnson posted a Pro‑Bowl season, completing 281 of 451 attempts for 3,049 yards, 22 touchdowns and just six interceptions.", "reason": "missing_gold_answer", "seed": 32483608, "similarity": null, "temperature": 0.5}], "fingerprint": "e22f9d13dbde689ecf04cf48496a6c856e4600d5a27c2f4fd64c3cf252666448", "generation_attempts": 3, "gold_answer": "Brad Johnson", "matched_aliases": ["Brad Johnson"], "query_id": "test1690", "question_hash": "070267cba5c7e3bb1e81b3479b6764f6320c334a646244f5a185b77320e1d5ee", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "d07f1d3f93ebee88a6b1b96b8a2ee1b4c677180db202c7b1346ef5a408a5287c", "scope": "all_answer_documents", "seed": 1474188121, "similarity": 0.5929380413057961, "source_content_hash": "11291fd9d96703e2973727e1de097d2bd40d7d6fb3d214e996ba1cdcb16015e6", "source_hash": "872ee95e330c1e50f9941b0e4c37c55b287ba83913971723c7da95f9c6488595", "target_answer": null, "temperature": 0.7, "validation": {"answerability_verified": false, "evidence_hash": "4c6223ba31aaf38bc818e1c77d85a32c4540a15bf6b0919d243693497f7fb40d", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerab