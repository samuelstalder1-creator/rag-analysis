{"doc_id": "doc13558", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "At the Open University, module outcomes are sometimes reported using a graded scale. The scale includes four pass grades: grade 1 (a distinction, threshold 85 %), grade 2 (70 %–84 %), grade 3 (55–69 %), and grade 4 (40 %–54 %). A grade 3 pass is awarded when the mark falls within the 55–69 % range, calculated as the lower of the overall continuous‑assessment score (OCAS) and the overall examination score (OES). Marks below 40 % are recorded as a fail.", "reason": "missing_gold_answer", "seed": 571888767, "similarity": null, "temperature": 0.3}], "fingerprint": "0e4818832cdd4946302bdf0f231333458240eaa95e8a81d2999faef2639ba627", "generation_attempts": 2, "gold_answer": "55–69%", "matched_aliases": ["55–69%"], "query_id": "test355", "question_hash": "bb79665d6e435a6eb6659f076673a5458a07ed08e613a308f1f33ec2ccb4c4a5", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 2, "row_hash": "af40144d2df92731e3eb2f94ea6a75d5f769337d1d1c8577b8a349d42071b878", "scope": "all_answer_documents", "seed": 812215440, "similarity": 0.07155025553662692, "source_content_hash": "1ac470a50f18ae10e96dd9e9116303ace5e45168c9078be0ff1c1cde5b0b77c7", "source_hash": "40256f49ea2bb10d6bae20c431cb44f7faf445391114bdceccf5cd35001c7732", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "c7e9a46b1b7a89865e5651f211e8671466ffb86c2c7c71dbb3ee75ee57c7d2a0", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
