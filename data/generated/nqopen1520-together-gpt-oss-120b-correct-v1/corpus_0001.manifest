{"doc_id": "doc4958", "receipt": {"answer_in_original_body": true, "failed_attempts": [{"attempt": 1, "generated_text": "The human settlement of the Hawaiian Islands is dated to a span between 124 CE and 800 CE, with some theories suggesting Polynesian arrivals as early as the 10th or 13th centuries. Around 1200, Tahitian explorers discovered the islands and began establishing settlements, initiating the rise of Hawaiian civilization. This early community remained isolated from the wider world for roughly five centuries.", "reason": "missing_gold_answer", "seed": 1749772389, "similarity": null, "temperature": 0.3}], "fingerprint": "62cb2f4174397e138e07d362047e5b8a11abb2c9022cdb95f1c0ca99d52615cc", "generation_attempts": 2, "gold_answer": "Around 1200", "matched_aliases": ["Around 1200"], "query_id": "test131", "question_hash": "49e618af2d57ed9b3526eeb58fc7c70ac643986f3e7335a5d2abe70b2f5e56f3", "repair_from": null, "replaced_row_hash": null, "replaced_text": null, "retry_seed": 0, "row_hash": "5bcf2966590664e41293643de63cd1b500a42c6f07e40a689484c85a6d37f02b", "scope": "all_answer_documents", "seed": 220804699, "similarity": 0.1586021505376344, "source_content_hash": "15713fcae2831ca13a4a70e0655ddb9b4b509e09f461d4affcfaac95dd119300", "source_hash": "b82267aef73a78f13609a6ab771f1d86bdece660522dbb0a14062058c211c6e9", "target_answer": null, "temperature": 0.5, "validation": {"answerability_verified": false, "evidence_hash": "c84c4ac4a084ed27e232ab8ef9fb14a3b21ba8f286bdf7b154156a87692df533", "format_attempts": [], "judgment": {"gold_alias_present": true, "not_near_duplicate": true}, "mode": "deterministic", "model": null, "provider": null, "semantic_verified": false, "stage": "correct_generation", "validation_goal": "query_answerability", "validator_hash": "a02bd2beee5a12b1acaa721f9e5fc6aa8fe87d0fc104e403231550d93996298f", "version": "v2"}, "validation_goal": "query_answerability"}}
