        "k": 1,
        "mode": "add",
        "source": "false_det"
      },
      "query_ratio": 0.1
    }
  },
  "data": {
    "human_corpus": "data/cocktail/nq/corpus/human.jsonl",
    "nqplus_dir": "data/nqplus/clean"
  },
  "evaluation": {
    "cutoffs": [
      1,
      10,
      100
    ],
    "relevance_modes": [
      "strict",
      "relaxed"
    ]
