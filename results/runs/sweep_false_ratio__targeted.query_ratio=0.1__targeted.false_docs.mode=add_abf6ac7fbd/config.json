  "experiment": "sweep_false_ratio__targeted.query_ratio=0.1__targeted.false_docs.mode=add",
  "output": {
    "dir": "results/runs"
  },
  "queries": "generation",
  "retrieval": {
    "b": 0.75,
    "k1": 1.5,
    "remove_query_stopwords": true,
    "top_k": 100
  },
  "retrievers": [
    "bm25",
    "tfidf"
  ],
  "seed": 13
