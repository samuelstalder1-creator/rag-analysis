{
  "corpus": {
    "background": {
      "qwen_correct": {
        "mode": "add",
        "ratio": 0.0
      }
    },
    "seed": 13,
    "sources": {
      "false_det": {
        "path": "data/generated/false-deterministic"
      },
      "qwen_correct": {
        "path": "data/generated/qwen35-2b-all"
      }
    },
    "targeted": {
      "correct_docs": {
        "k": 0,
        "mode": "add",
        "source": "qwen_correct"
      },
      "false_docs": {
        "k": 0,
        "mode": "add",
        "source": "false_det"
      },
      "query_ratio": 1.0
    }
  },
  "data": {
    "human_corpus": "data/cocktail/nq/corpus/human.jsonl",
    "nqplus_dir": "data/nqplus/clean"
  },
  "evaluation": {
    "cutoffs": [
      1,
      10,
      100
    ],
    "relevance_modes": [
      "strict",
      "relaxed"
    ]
  },
  "experiment": "variants_false_correct",
  "output": {
    "dir": "results/runs"
  },
  "queries": "generation",
  "retrieval": {
    "b": 0.75,
    "k1": 1.5,
    "remove_query_stopwords": true,
    "top_k": 100
  },
  "retrievers": [
    "bm25",
    "tfidf"
  ],
  "seed": 13,
  "sweep_output": {
    "dir": "results/sweeps"
  },
  "variants": {
    "correct_only": {
      "corpus.targeted.correct_docs.k": 1
    },
    "false_and_correct": {
      "corpus.targeted.correct_docs.k": 1,
      "corpus.targeted.false_docs.k": 1
    },
    "false_in_contaminated": {
      "corpus.background.qwen_correct.ratio": 0.5,
      "corpus.targeted.false_docs.k": 1
    },
    "false_only": {
      "corpus.targeted.false_docs.k": 1
    },
    "false_replace": {
      "corpus.targeted.false_docs.k": 1,
      "corpus.targeted.false_docs.mode": "replace"
    },
    "human_only": {}
  }
}
